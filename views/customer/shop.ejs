    <script>
      (function () {
        'use strict';

        const BOOT = window.__SHOP_BOOT__ || {};
        const STATE = {
          pageType: String(BOOT.pageType || 'shop').toLowerCase(),
          scope: BOOT.scope || { type: 'shop' },
          params: BOOT.params || {},
          query: BOOT.query || {},
          payload: null,
          items: [],
          parents: [],
          selectedParent: '',
          selectedCategory: '',
          selectedBrands: [],
          selectedRating: '',
          selectedAttrFilters: {},
          sort: 'latest',
          search: '',
          minPrice: '',
          maxPrice: '',
          inStockOnly: true,
          page: 1,
          limit: 12,
          total: 0,
          totalPages: 1,
          cartMap: new Map(),
          wishlistMap: Object.create(null),
          cartBusy: new Set(),
          favBusy: new Set(),
        };

        const EL = {
          filterPanel: document.getElementById('filter-panel'),
          backdrop: document.getElementById('filter-backdrop'),
          openBtn: document.getElementById('mobile-filter-open'),
          closeBtn: document.getElementById('mobile-filter-close'),
          openBtn2: document.getElementById('mobile-filter-open-2'),
          sortMobileOpen: document.getElementById('mobile-sort-open'),
          sortMobileOpen2: document.getElementById('mobile-sort-open-2'),
          parentStrip: document.getElementById('parent-strip'),
          priceMin: document.getElementById('price-min'),
          priceMax: document.getElementById('price-max'),
          priceMinLabel: document.getElementById('price-min-label'),
          priceMaxLabel: document.getElementById('price-max-label'),
          sortSelect: document.getElementById('sort-select'),
          pageSize: document.getElementById('page-size'),
          activeChips: document.getElementById('active-chips'),
          resultsCount: document.getElementById('results-count'),
          resultsCountToolbar: document.getElementById('results-count-toolbar'),
          scopeNote: document.getElementById('scope-note'),
          scopeNoteToolbar: document.getElementById('scope-note-toolbar'),
          resultsTitle: document.getElementById('results-title'),
          pageHeading: document.getElementById('page-heading'),
          pageSubtitle: document.getElementById('page-subtitle'),
          cardsGrid: document.getElementById('cards-grid'),
          dynamicGate: document.getElementById('dynamic-filter-gate'),
          lockedNote: document.getElementById('dynamic-locked-note'),
          categorySection: document.getElementById('category-section'),
          brandSection: document.getElementById('brand-section'),
          attributeSection: document.getElementById('attribute-section'),
          priceSection: document.getElementById('price-section'),
          ratingSection: document.getElementById('rating-section'),
          btnReset: document.getElementById('btn-reset'),
          viewAllBtn: document.getElementById('view-all-btn'),
          searchInput: document.getElementById('search-input'),
          searchClear: document.getElementById('search-clear'),
          wishlistCount: document.getElementById('wishlist-count'),
          cartCount: document.getElementById('cart-count'),
          pagination: document.getElementById('pagination'),
          pageInfo: document.getElementById('page-info'),
        };

        const API_BASE = '/customer/shop/api';
        const DETAIL_BASE = BOOT.productDetailUrl || '/customer/product/product-details';
        const CART_ADD_URL = BOOT.cartAddUrl || '/customer/cart/add';
        const CART_UPDATE_URL = BOOT.cartUpdateUrl || '/customer/cart/update';
        const CART_REMOVE_URL = BOOT.cartRemoveUrl || '/customer/cart/remove';
        const FAV_TOGGLE_URL = BOOT.favToggleUrl || '/wishlist/toggle';
        const WISHLIST_DATA_URL = BOOT.wishlistDataUrl || '/wishlist/data';
        const GUEST_KEY = 'guest_wishlist_token';
        const CSRF = document.querySelector('meta[name="csrf-token"]')?.content || null;

        const GUEST_TOKEN = (() => {
          try {
            const existing = localStorage.getItem(GUEST_KEY);
            if (existing) return existing;
            const token = 'guest_' + Math.random().toString(36).slice(2, 12);
            localStorage.setItem(GUEST_KEY, token);
            return token;
          } catch {
            return 'guest_' + Math.random().toString(36).slice(2, 12);
          }
        })();

        const qs = (sel, root = document) => root.querySelector(sel);
        const qsa = (sel, root = document) => Array.from(root.querySelectorAll(sel));
        const esc = (v) => String(v ?? '').replace(/[&<>"']/g, (m) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m]));
        const lower = (v) => String(v ?? '').toLowerCase().trim();
        const toNum = (v, d = 0) => {
          const n = Number(String(v ?? '').replace(/,/g, ''));
          return Number.isFinite(n) ? n : d;
        };
        const uniq = (arr) => Array.from(new Set((arr || []).filter(Boolean)));
        const debounce = (fn, ms = 220) => {
          let t;
          return (...args) => { clearTimeout(t); t = setTimeout(() => fn(...args), ms); };
        };

        const safeAsset = (folder, file) => {
          const v = String(file || '').trim();
          if (!v) return '/uploads/products/default.jpg';
          if (/^(https?:)?\/\//i.test(v) || v.startsWith('/')) return v;
          return `${folder}/${encodeURIComponent(v)}`;
        };

        function setQueryValue(params, key, value) {
          if (value === undefined || value === null || value === '') params.delete(key);
          else params.set(key, Array.isArray(value) ? value.join(',') : String(value));
        }

        async function apiFetch(url, method = 'GET', body = null, timeout = 15000) {
          const headers = { 'x-guest-token': GUEST_TOKEN };
          if (method !== 'GET') {
            headers['Content-Type'] = 'application/json';
            if (CSRF) headers['x-csrf-token'] = CSRF;
          }

          const controller = new AbortController();
          const timer = setTimeout(() => controller.abort(), timeout);
          try {
            const res = await fetch(url, {
              method,
              headers,
              credentials: 'same-origin',
              signal: controller.signal,
              body: method === 'GET' ? undefined : JSON.stringify(body || {})
            });
            clearTimeout(timer);
            let json = null;
            try { json = await res.json(); } catch (_) { }
            if (!res.ok || (json && json.success === false)) {
              const err = new Error((json && (json.message || json.error)) || `HTTP ${res.status}`);
              err.status = res.status;
              err.body = json;
              throw err;
            }
            return json;
          } catch (err) {
            if (err.name === 'AbortError') throw new Error('Request timeout');
            throw err;
          }
        }

        async function fetchJson(url) {
          const res = await fetch(url, { credentials: 'same-origin' });
          const json = await res.json().catch(() => null);
          if (!res.ok) throw new Error((json && json.message) || 'Request failed');
          return json;
        }

        function parseQuery() {
          const url = new URL(window.location.href);
          const out = {};
          url.searchParams.forEach((value, key) => {
            if (out[key] === undefined) out[key] = value;
            else if (Array.isArray(out[key])) out[key].push(value);
            else out[key] = [out[key], value];
          });
          return out;
        }

        function normalizeAttrFilters(filters) {
          const result = {};
          if (!filters) return result;
          if (Array.isArray(filters)) {
            filters.forEach((g) => {
              const key = lower(g.heading || g.key || '').replace(/\s+/g, '_');
              if (!key) return;
              if (!result[key]) result[key] = { heading: g.heading || g.key || key, values: [] };
              (g.values || []).forEach((v) => {
                const item = typeof v === 'object' ? { value: String(v.value ?? '').trim(), count: toNum(v.count, 0) } : { value: String(v).trim(), count: 0 };
                if (item.value) result[key].values.push(item);
              });
            });
          } else if (typeof filters === 'object') {
            Object.entries(filters).forEach(([k, v]) => {
              const key = lower(k).replace(/\s+/g, '_');
              if (!key) return;
              const vals = Array.isArray(v) ? v : [v];
              result[key] = { heading: k, values: vals.map((x) => ({ value: String(x?.value ?? x).trim(), count: toNum(x?.count, 0) })).filter((x) => x.value) };
            });
          }
          Object.values(result).forEach((g) => {
            const seen = new Set();
            g.values = g.values.filter((x) => {
              const k = x.value.toLowerCase();
              if (seen.has(k)) return false;
              seen.add(k);
              return true;
            });
          });
          return result;
        }

        function splitAttributeValues(raw) {
          if (raw === undefined || raw === null) return [];
          if (Array.isArray(raw)) return uniq(raw.flatMap(splitAttributeValues));
          return uniq(String(raw).split(',').map((s) => s.trim()).filter(Boolean));
        }

        function normalizeItem(raw) {
          const attrs = Array.isArray(raw.attributes)
            ? raw.attributes
            : Array.isArray(raw.attribute_groups)
              ? raw.attribute_groups.flatMap((g) => (g.values || []).map((v) => ({ heading: g.heading || g.key, value: v })))
              : [];

          const attrMap = {};
          attrs.forEach((a) => {
            const key = lower(a.heading || a.name || a.key).replace(/\s+/g, '_');
            if (!key) return;
            if (!attrMap[key]) attrMap[key] = [];
            const values = splitAttributeValues(a.value ?? a.values ?? a.attribute_value ?? '');
            values.forEach((v) => { if (v) attrMap[key].push(v); });
          });
          Object.keys(attrMap).forEach((k) => (attrMap[k] = uniq(attrMap[k])));

          return {
            ...raw,
            id: String(raw.id || raw.variant_id || raw.variantId || ''),
            product_id: String(raw.product_id || raw.productId || raw.master_id || ''),
            parent_category_id: String(raw.parent_category_id || raw.parent_id || ''),
            category_id: String(raw.category_id || raw.subgroup_id || ''),
            parent_category_name: raw.parent_category_name || 'Uncategorized',
            category_name: raw.category_name || raw.subgroup_name || '',
            parent_category_slug: raw.parent_category_slug || '',
            category_slug: raw.category_slug || '',
            name: raw.name || raw.variant_name || raw.title || 'Product',
            slug: raw.product_slug || raw.slug || raw.master_slug || '',
            image: raw.image || raw.main_image || raw.variant_image || 'default.jpg',
            brand: raw.brand || '',
            model: raw.model || raw.mpn || '',
            final_price: toNum(raw.final_price ?? raw.price, 0),
            original_price: toNum(raw.original_price ?? raw.price, toNum(raw.final_price ?? raw.price, 0)),
            discount_percent: toNum(raw.discount_percent ?? 0, 0),
            stock: toNum(raw.stock, 0),
            rating: toNum(raw.rating ?? raw.review_rating ?? 0, 0),
            reviews: toNum(raw.reviews ?? raw.review_count ?? 0, 0),
            attributes: attrMap,
            is_fav: !!raw.is_fav,
            vat_included: !!raw.vat_included,
            in_cart_qty: toNum(raw.in_cart_qty ?? raw.quantity ?? 0, 0)
          };
        }

        function normalizeFacetList(list) {
          return (Array.isArray(list) ? list : []).map((x) => ({
            id: x.id != null ? String(x.id) : (x.value != null ? String(x.value) : ''),
            parent_category_id: x.parent_category_id != null ? String(x.parent_category_id) : (x.parent_id != null ? String(x.parent_id) : ''),
            name: String(x.name || x.value || x.heading || 'Uncategorized'),
            value: String(x.value || x.name || x.heading || ''),
            slug: String(x.slug || x.code || ''),
            count: toNum(x.count, 0),
            image: String(x.image || x.icon || ''),
          }));
        }

        function normalizePayload(json) {
          const data = json?.data || json?.cards || [];
          const filters = json?.filters || {};
          let items = [];
          if (Array.isArray(data)) {
            if (data.length && data[0] && Array.isArray(data[0].items)) items = data.flatMap((g) => (g.items || []).map(normalizeItem));
            else items = data.map(normalizeItem);
          } else if (data && typeof data === 'object' && Array.isArray(data.items)) {
            items = data.items.map(normalizeItem);
          }
          return {
            items,
            filters: {
              ...filters,
              parent_categories: normalizeFacetList(filters.parent_categories || []),
              categories: normalizeFacetList(filters.categories || []),
              brands: normalizeFacetList(filters.brands || []).map((x) => ({ value: x.value || x.name, count: x.count })),
              ratings: normalizeFacetList(filters.ratings || []).map((x) => ({ value: x.value || x.name, count: x.count })),
              attributes: normalizeAttrFilters(filters.attributes || []),
              price_range: filters.price_range || { min: 0, max: 0 },
            },
            pagination: json?.pagination || { page: 1, limit: STATE.limit, total: 0, total_pages: 1 },
          };
        }

        function buildApiUrl() {
          const type = String(STATE.scope?.type || STATE.pageType || 'shop').toLowerCase();
          let url = API_BASE;
          if (type === 'group') {
            const slug = STATE.params.groupSlug || STATE.params.groupId;
            if (slug) url += '/group/' + encodeURIComponent(slug);
          } else if (type === 'subgroup') {
            const slug = STATE.params.subgroupSlug || STATE.params.subgroupId;
            if (slug) url += '/subgroup/' + encodeURIComponent(slug);
          } else if (type === 'product') {
            const slug = STATE.params.productSlug || STATE.params.productId;
            if (slug) url += '/product/' + encodeURIComponent(slug);
          }

          const p = new URLSearchParams();
          setQueryValue(p, 'search', STATE.search);
          setQueryValue(p, 'q', STATE.search);
          setQueryValue(p, 'sort', STATE.sort);
          setQueryValue(p, 'page', STATE.page);
          setQueryValue(p, 'limit', STATE.limit);
          setQueryValue(p, 'price_min', STATE.minPrice);
          setQueryValue(p, 'price_max', STATE.maxPrice);
          setQueryValue(p, 'parent_category_id', STATE.selectedParent);
          setQueryValue(p, 'category_id', STATE.selectedCategory);
          setQueryValue(p, 'brand', STATE.selectedBrands.join(','));
          setQueryValue(p, 'rating', STATE.selectedRating);
          setQueryValue(p, 'in_stock_only', STATE.inStockOnly ? 'true' : 'false');
          Object.entries(STATE.selectedAttrFilters || {}).forEach(([k, vals]) => {
            if (vals && vals.length) setQueryValue(p, `attr_${k}`, vals.join(','));
          });
          const extra = p.toString();
          if (extra) url += '?' + extra;
          return url;
        }

        function syncUrl() {
          const p = new URLSearchParams();
          setQueryValue(p, 'search', STATE.search);
          setQueryValue(p, 'q', STATE.search);
          setQueryValue(p, 'sort', STATE.sort);
          setQueryValue(p, 'page', STATE.page);
          setQueryValue(p, 'limit', STATE.limit);
          setQueryValue(p, 'price_min', STATE.minPrice);
          setQueryValue(p, 'price_max', STATE.maxPrice);
          setQueryValue(p, 'parent_category_id', STATE.selectedParent);
          setQueryValue(p, 'category_id', STATE.selectedCategory);
          setQueryValue(p, 'brand', STATE.selectedBrands.join(','));
          setQueryValue(p, 'rating', STATE.selectedRating);
          setQueryValue(p, 'in_stock_only', STATE.inStockOnly ? 'true' : 'false');
          Object.entries(STATE.selectedAttrFilters || {}).forEach(([k, vals]) => {
            if (vals && vals.length) setQueryValue(p, `attr_${k}`, vals.join(','));
          });
          const url = new URL(window.location.href);
          url.search = p.toString();
          history.replaceState({}, '', url.toString());
        }

        function flashToast(message) {
          let toast = document.getElementById('shop-toast');
          if (!toast) {
            toast = document.createElement('div');
            toast.id = 'shop-toast';
            toast.className = 'shop-toast';
            document.body.appendChild(toast);
          }
          toast.textContent = message;
          toast.classList.add('show');
          clearTimeout(window.__shopToastTimer);
          window.__shopToastTimer = setTimeout(() => toast.classList.remove('show'), 2200);
        }

        function isFav(item) { return !!STATE.wishlistMap[String(item.id || '')]; }
        function qtyFor(variantId) { return toNum(STATE.cartMap.get(String(variantId)) ?? 0, 0); }

function buildDetailUrl(item) {
  let url = DETAIL_BASE;

  // Ensure no trailing slash issues
  url = url.replace(/\/$/, '');

  if (item.product_id && item.id) {
    url += `/${encodeURIComponent(item.product_id)}/${encodeURIComponent(item.id)}`;
  } else if (item.product_id) {
    url += `/${encodeURIComponent(item.product_id)}`;
  }

  return url;
}

        function parentImageSrc(parent) { return safeAsset('/uploads/categories', parent.image || parent.slug || 'default.jpg'); }

function buildParentsStrip() {
  EL.parentStrip.innerHTML = STATE.parents.length ? STATE.parents.map((p) => `
    <button type="button"
      class="parent-pill ${String(p.id) === String(STATE.selectedParent) ? 'is-active' : ''}"
      data-parent-id="${esc(p.id)}">
      <span class="pill-name" style="display:block; width:100%; text-align:center;">
        ${esc(p.name)}
      </span>
    </button>
  `).join('') : '<div class="empty-full" style="min-height:110px;">No parent categories found</div>';
}

       function facetRowHtml(label, value, count, inputType, groupName, checked) {
  return `
    <label class="facet-row ${checked ? 'is-active' : ''}">
      <input
        type="${inputType}"
        name="${esc(groupName)}"
        value="${esc(value)}"
        data-label="${esc(label)}"
        ${checked ? 'checked' : ''}
      />
      <span>${esc(label)}</span>
      <small>${esc(count)}</small>
    </label>
  `;
}

        function buildCategoryList(list) {
          const el = EL.categorySection?.querySelector('.section-content');
          if (!el) return;
          const items = Array.isArray(list) ? list : [];
          el.innerHTML = items.length
            ? items.map((c) => facetRowHtml(
  c.name,
  c.id,
  c.count,
  'radio',
  'category-filter',
  String(c.id) === String(STATE.selectedCategory)
)).join('')
            : '<div class="empty-full" style="min-height:88px;">No categories available</div>';
          el.classList.remove('hidden');
        }

        function buildBrandList(list) {
          const el = EL.brandSection?.querySelector('.section-content');
          if (!el) return;
          const brands = Array.isArray(list) ? list : [];
          el.innerHTML = brands.length
            ? brands.map((b) => facetRowHtml(
  b.value,
  b.value,
  b.count,
  'checkbox',
  'brand-filter',
  STATE.selectedBrands.map(lower).includes(lower(b.value))
)).join('')
            : '<div class="empty-full" style="min-height:88px;">No brands available</div>';
          el.classList.remove('hidden');
        }

        function buildAttributeList(attrs) {
          const el = EL.attributeSection?.querySelector('.section-content');
          if (!el) return;
          const groups = attrs && typeof attrs === 'object'
            ? Object.entries(attrs).map(([key, g]) => ({ heading: g.heading || key, key, values: Array.isArray(g.values) ? g.values : [] }))
            : [];

          if (!groups.length) {
            el.innerHTML = '<div class="empty-full" style="min-height:88px;">No attributes available</div>';
            el.classList.remove('hidden');
            return;
          }

          el.innerHTML = groups.map((group) => `
      <div class="attribute-group">
        <div class="facet-label" style="margin-bottom:6px; font-weight:700; font-size:13px;">${esc(group.heading)}</div>
        <div class="facet-list">
          ${(group.values || []).map((v) => {
            const value = String(v.value ?? v).trim();
            const count = toNum(v.count, 0);
            const checked = (STATE.selectedAttrFilters[group.key] || []).map(lower).includes(lower(value));
            return facetRowHtml(
  value,
  value,
  count,
  'checkbox',
  `attr-${group.key}`,
  checked
);
          }).join('')}
        </div>
      </div>
    `).join('');
          el.classList.remove('hidden');
        }

        function setFilterMeta(filters) {
          const priceRange = filters?.price_range || { min: 0, max: 0 };
          if (EL.priceMinLabel) EL.priceMinLabel.textContent = `AED ${toNum(priceRange.min, 0).toFixed(0)}`;
          if (EL.priceMaxLabel) EL.priceMaxLabel.textContent = `AED ${toNum(priceRange.max, 0).toFixed(0)}`;
          if (EL.priceMin && !EL.priceMin.value) EL.priceMin.placeholder = `Min ${toNum(priceRange.min, 0).toFixed(0)}`;
          if (EL.priceMax && !EL.priceMax.value) EL.priceMax.placeholder = `Max ${toNum(priceRange.max, 0).toFixed(0)}`;
        }

        function renderChips() {
          const chips = [];
          const parentName = STATE.parents.find((p) => String(p.id) === String(STATE.selectedParent))?.name || STATE.selectedParent;
          if (STATE.selectedParent) chips.push(['Parent', parentName]);
         if (STATE.selectedCategory) {
  const category = buildFacetCategories(currentFacetSource())
    .find(c => String(c.id) === String(STATE.selectedCategory));

  chips.push([
    'Category',
    category?.name || STATE.selectedCategory
  ]);
}
          if (STATE.search) chips.push(['Search', STATE.search]);
          if (STATE.minPrice || STATE.maxPrice) chips.push(['Price', `${STATE.minPrice || 0} - ${STATE.maxPrice || '∞'}`]);
          STATE.selectedBrands.forEach((v) => chips.push(['Brand', v]));
          if (STATE.selectedRating) chips.push(['Rating', `${STATE.selectedRating}+`]);
          Object.entries(STATE.selectedAttrFilters || {}).forEach(([k, vals]) => { if (vals && vals.length) chips.push([k.replace(/_/g, ' '), vals.join(', ')]); });

          EL.activeChips.innerHTML = chips.length
            ? chips.map(([label, value]) => `<button type="button" class="chip" data-chip="${esc(label.toLowerCase())}">${esc(label)}: <strong>${esc(value)}</strong> <span>×</span></button>`).join('')
            : '<span class="chip chip-empty">No active filters</span>';
        }

        function shouldUnlockFilters() { return !!(STATE.selectedParent || STATE.search); }

        function setDynamicVisibility() {
          const unlocked = shouldUnlockFilters();
          if (EL.dynamicGate) EL.dynamicGate.style.display = 'block';
          if (EL.lockedNote) EL.lockedNote.style.display = unlocked ? 'none' : 'block';
          [EL.categorySection, EL.brandSection, EL.attributeSection, EL.priceSection, EL.ratingSection].forEach((sec) => {
            if (!sec) return;
            const content = sec.querySelector('.section-content');
            if (content) content.classList.toggle('hidden', !unlocked);
          });
        }

        function currentFacetSource() {
          return STATE.items.filter((item) => {
            if (STATE.selectedParent && String(item.parent_category_id || '') !== String(STATE.selectedParent)) return false;
            if (STATE.selectedCategory && String(item.category_id || '') !== String(STATE.selectedCategory)) return false;
            if (STATE.search) {
              const hay = [item.name, item.brand, item.model, item.slug, item.parent_category_name, item.category_name].join(' ').toLowerCase();
              if (!hay.includes(STATE.search.toLowerCase())) return false;
            }
            return true;
          });
        }

        function itemMatchesFilters(item) {
          if (STATE.selectedParent && String(item.parent_category_id || '') !== String(STATE.selectedParent)) return false;
          if (STATE.selectedCategory && String(item.category_id || '') !== String(STATE.selectedCategory)) return false;
          if (STATE.inStockOnly && toNum(item.stock, 0) <= 0) return false;
          if (STATE.minPrice !== '' && toNum(item.final_price, 0) < toNum(STATE.minPrice, 0)) return false;
          if (STATE.maxPrice !== '' && toNum(item.final_price, 0) > toNum(STATE.maxPrice, Infinity)) return false;
          if (STATE.search) {
            const hay = [item.name, item.brand, item.model, item.slug, item.parent_category_name, item.category_name].join(' ').toLowerCase();
            if (!hay.includes(STATE.search.toLowerCase())) return false;
          }
          if (STATE.selectedBrands.length && !STATE.selectedBrands.map(lower).includes(lower(item.brand))) return false;
          if (STATE.selectedRating && toNum(item.rating, 0) < toNum(STATE.selectedRating, 0)) return false;
          for (const [key, values] of Object.entries(STATE.selectedAttrFilters || {})) {
            if (!values || !values.length) continue;
            const itemVals = (item.attributes && item.attributes[key]) ? item.attributes[key].map(lower) : [];
            if (!itemVals.length) return false;
            const hasAny = values.map(lower).some((v) => itemVals.includes(v));
            if (!hasAny) return false;
          }
          return true;
        }

        function sortItems(items) {
          const arr = [...items];
          arr.sort((a, b) => {
            switch (STATE.sort) {
              case 'oldest': return (a.id || '').localeCompare(b.id || '');
              case 'price_asc': return toNum(a.final_price, 0) - toNum(b.final_price, 0);
              case 'price_desc': return toNum(b.final_price, 0) - toNum(a.final_price, 0);
              case 'name_asc': return String(a.name || '').localeCompare(String(b.name || ''));
              case 'name_desc': return String(b.name || '').localeCompare(String(a.name || ''));
              case 'rating_desc': return toNum(b.rating, 0) - toNum(a.rating, 0);
              case 'rating_asc': return toNum(a.rating, 0) - toNum(b.rating, 0);
              case 'latest':
              default: return (b.id || '').localeCompare(a.id || '');
            }
          });
          return arr;
        }

        function buildCard(item) {
          const price = toNum(item.final_price, 0).toFixed(2);
          const oldPrice = toNum(item.original_price, 0).toFixed(2);
          const discount = toNum(item.discount_percent, 0);
          const rating = toNum(item.rating, 0).toFixed(1);
          const reviews = toNum(item.reviews, 0);
          const stock = toNum(item.stock, 0);
          const qty = qtyFor(item.id);
          const soldOut = stock <= 0;
          const link = buildDetailUrl(item);
          const favorite = isFav(item);
          const image = safeAsset('/uploads/products', item.image || 'default.jpg');

          return `
      <article class="product-card" data-variant-id="${esc(item.id)}" data-product-id="${esc(item.product_id || '')}" data-link="${esc(link)}" tabindex="0" role="link" aria-label="${esc(item.name)}">
        <div class="card-image-wrap">
          <a class="card-image-link" href="${esc(link)}" aria-label="Open product">
            <img src="${esc(image)}" alt="${esc(item.name)}" loading="lazy" onerror="this.src='/uploads/products/default.jpg'" />
          </a>
          <div class="badges-top-left">
            ${discount > 0 ? `<span class="deal-badge">${discount.toFixed(0)}% OFF</span>` : ''}
            ${soldOut ? '<span class="stock-badge sold">Sold out</span>' : stock <= 5 ? '<span class="stock-badge low">Low stock</span>' : ''}
          </div>
          <button type="button" class="fav-btn js-fav-btn ${favorite ? 'is-fav' : ''}" aria-pressed="${favorite ? 'true' : 'false'}">${favorite ? '♥' : '♡'}</button>
        </div>
        <div class="card-body">
          <a href="${esc(link)}" class="product-name" title="${esc(item.name)}">${esc(item.name)}</a>
          <div class="rating-row"><span class="star">★</span><span>${rating}</span><span class="reviews">(${reviews})</span></div>
          <div class="price-row">
            <div class="price-stack">
              <span class="price-current">AED ${price}</span>
              ${toNum(oldPrice, 0) > toNum(price, 0) ? `<span class="price-old">AED ${oldPrice}</span>` : ''}
            </div>
          </div>
          <div class="meta-row">Brand • ${esc(item.brand || '-')}</div>
          <div class="stock-row ${soldOut ? 'out' : ''}" style="display:inline-block;">
            ${soldOut ? 'Out of stock' : stock <= 5 ? `${stock} left` : `${stock} available`}
            ${item.vat_included ? `<span class="mini-vat" style="margin-left:6px;">VAT included</span>` : ''}
          </div>
          <div class="actions-row">
            ${qty > 0 ? `
              <div class="qty-controls" data-variant-id="${esc(item.id)}">
                <button type="button" class="qty-minus" aria-label="${qty === 1 ? 'Remove item' : 'Decrease quantity'}">${qty === 1 ? '🗑' : '–'}</button>
                <span class="qty-count">${qty}</span>
                <button type="button" class="qty-plus" aria-label="Increase quantity">+</button>
              </div>
            ` : `<button type="button" class="btn-cart" data-variant-id="${esc(item.id)}"><i class="fa fa-shopping-cart" aria-hidden="true"></i> Add</button>`}
          </div>
        </div>
      </article>
    `;
        }

        function renderCards(items) {
          if (!EL.cardsGrid) return;
          if (!items || !items.length) {
            EL.cardsGrid.innerHTML = '<div class="empty-full">No products match the selected filters.</div>';
            return;
          }
          EL.cardsGrid.innerHTML = items.map(buildCard).join('');
        }

        function renderPagination() {
          const totalPages = Math.max(1, toNum(STATE.totalPages, 1));
          const current = Math.min(Math.max(1, toNum(STATE.page, 1)), totalPages);
          STATE.page = current;
          if (EL.pageInfo) EL.pageInfo.textContent = `Page ${current} of ${totalPages}`;
          if (!EL.pagination) return;

          const pages = [];
          const addBtn = (label, page, active = false, disabled = false) => {
            pages.push(`<button type="button" class="btn-page ${active ? 'is-active' : ''}" data-page="${page}" ${disabled ? 'disabled' : ''}>${label}</button>`);
          };

          addBtn('Prev', Math.max(1, current - 1), false, current === 1);
          const maxSlots = 5;
          let start = Math.max(1, current - Math.floor(maxSlots / 2));
          let end = Math.min(totalPages, start + maxSlots - 1);
          start = Math.max(1, end - maxSlots + 1);

          if (start > 1) {
            addBtn('1', 1, current === 1);
            if (start > 2) pages.push('<span class="page-info">…</span>');
          }
          for (let p = start; p <= end; p += 1) addBtn(String(p), p, p === current);
          if (end < totalPages) {
            if (end < totalPages - 1) pages.push('<span class="page-info">…</span>');
            addBtn(String(totalPages), totalPages, current === totalPages);
          }
          addBtn('Next', Math.min(totalPages, current + 1), false, current === totalPages);
          EL.pagination.innerHTML = pages.join('');
        }

        function updateCounters() {
          const cartCount = Array.from(STATE.cartMap.values()).reduce((a, b) => a + toNum(b, 0), 0);
          const wishCount = Object.keys(STATE.wishlistMap).filter((k) => STATE.wishlistMap[k]).length;
          if (EL.cartCount) EL.cartCount.textContent = String(cartCount);
          if (EL.wishlistCount) EL.wishlistCount.textContent = String(wishCount);
        }

        function renderAll() {
          const payload = STATE.payload || {};
          const filters = payload.filters || {};
          const cards = STATE.items || [];
          STATE.total = toNum(payload.pagination?.total ?? cards.length, cards.length);
          STATE.totalPages = toNum(payload.pagination?.total_pages ?? 1, 1);
          STATE.page = toNum(payload.pagination?.page ?? STATE.page, STATE.page);
          STATE.limit = toNum(payload.pagination?.limit ?? STATE.limit, STATE.limit);

          renderChips();
          buildParentsStrip();
          setDynamicVisibility();

          const facetSource = currentFacetSource();
          if (STATE.selectedParent || STATE.search) {
            buildCategoryList(buildFacetCategories(facetSource));
            buildBrandList(buildFacetBrands(facetSource));
            buildAttributeList(buildFacetAttributes(facetSource));
            setFilterMeta(derivePriceRange(facetSource, filters));
          } else {
            if (EL.categorySection) EL.categorySection.querySelector('.section-content').innerHTML = '';
            if (EL.brandSection) EL.brandSection.querySelector('.section-content').innerHTML = '';
            if (EL.attributeSection) EL.attributeSection.querySelector('.section-content').innerHTML = '';
            if (EL.priceMinLabel) EL.priceMinLabel.textContent = 'AED 0';
            if (EL.priceMaxLabel) EL.priceMaxLabel.textContent = 'AED 0';
          }

          const filtered = sortItems(cards.filter(itemMatchesFilters));
          STATE.filtered = filtered;
          renderCards(filtered);
          renderPagination();
          updateCounters();
          syncUrl();

          const countText = `${STATE.total} item${STATE.total === 1 ? '' : 's'}`;
          if (EL.resultsCount) EL.resultsCount.textContent = countText;
          if (EL.resultsCountToolbar) EL.resultsCountToolbar.textContent = countText;
          if (EL.resultsTitle) EL.resultsTitle.textContent = STATE.selectedCategory ? STATE.selectedCategory : (STATE.selectedParent ? 'Filtered products' : 'All products');
          if (EL.scopeNote) EL.scopeNote.textContent = STATE.selectedParent || STATE.search ? 'Filters update instantly with your results' : 'Choose a category or search to unlock more filters';
          if (EL.scopeNoteToolbar) EL.scopeNoteToolbar.textContent = EL.scopeNote.textContent;
          const parent = STATE.parents.find((p) => String(p.id) === String(STATE.selectedParent));
          if (EL.pageHeading) EL.pageHeading.textContent = parent ? parent.name : (BOOT.pageType || 'Shop');
          if (EL.pageSubtitle) {
            EL.pageSubtitle.textContent = STATE.selectedParent || STATE.search
              ? 'Categories, brands, price, rating, and attributes are built from the current live results.'
              : 'Select a parent category or search a product to reveal the full filter set.';
          }
        }

        function buildFacetCategories(items) {
          const map = new Map();
          items.forEach((it) => {
            const key = String(it.category_id || it.category_name || 'null') + '::' + String(it.category_name || 'Uncategorized');
            if (!map.has(key)) map.set(key, { id: it.category_id || '', name: it.category_name || 'Uncategorized', count: 0 });
            map.get(key).count += 1;
          });
          return Array.from(map.values()).sort((a, b) => a.name.localeCompare(b.name));
        }

        function buildFacetBrands(items) {
          const map = new Map();
          items.forEach((it) => {
            const val = String(it.brand || '').trim();
            if (!val) return;
            const k = val.toLowerCase();
            if (!map.has(k)) map.set(k, { value: val, count: 0 });
            map.get(k).count += 1;
          });
          return Array.from(map.values()).sort((a, b) => a.value.localeCompare(b.value));
        }

        function buildFacetAttributes(items) {
          const map = new Map();
          items.forEach((it) => {
            const attrs = it.attributes || {};
            Object.entries(attrs).forEach(([key, values]) => {
              const attrKey = lower(key).replace(/\s+/g, '_');
              if (!attrKey) return;
              if (!map.has(attrKey)) map.set(attrKey, { heading: key, values: new Map() });
              const bucket = map.get(attrKey).values;
              (Array.isArray(values) ? values : [values]).forEach((v) => {
                const value = String(v || '').trim();
                if (!value) return;
                const valueKey = value.toLowerCase();
                if (!bucket.has(valueKey)) bucket.set(valueKey, { value, count: 0 });
                bucket.get(valueKey).count += 1;
              });
            });
          });
          return Object.fromEntries(Array.from(map.entries()).map(([k, g]) => [k, { heading: g.heading, values: Array.from(g.values.values()).sort((a, b) => a.value.localeCompare(b.value)) }]));
        }

        function derivePriceRange(items, fallbackFilters) {
          const prices = items.map((x) => toNum(x.final_price, 0)).filter((n) => Number.isFinite(n));
          if (!prices.length) return fallbackFilters?.price_range || { min: 0, max: 0 };
          return { min: Math.min(...prices), max: Math.max(...prices) };
        }

        function setDrawer(open) {
          if (!EL.filterPanel || !EL.backdrop) return;
          EL.filterPanel.classList.toggle('is-open', !!open);
          EL.backdrop.classList.toggle('is-open', !!open);
          EL.backdrop.hidden = !open;
        }

        function resetToPageOne() { STATE.page = 1; }

        function patchSelectedFromUI() {
          STATE.search = EL.searchInput ? String(EL.searchInput.value || '').trim() : STATE.search;
          STATE.sort = EL.sortSelect ? String(EL.sortSelect.value || 'latest') : STATE.sort;
          STATE.limit = [12, 24, 36].includes(toNum(EL.pageSize?.value || STATE.limit, 12)) ? toNum(EL.pageSize?.value || STATE.limit, 12) : 12;
          STATE.minPrice = EL.priceMin ? String(EL.priceMin.value || '') : STATE.minPrice;
          STATE.maxPrice = EL.priceMax ? String(EL.priceMax.value || '') : STATE.maxPrice;
          STATE.selectedRating = qs('input[name="rating"]:checked')?.value || '';
          STATE.selectedBrands = qsa('#brand-filter-list input:checked').map((x) => x.value);
          const selected = {};
          qsa('#attribute-filter-list input:checked').forEach((input) => {
            const name = input.name.replace(/^attr-/, '');
            if (!selected[name]) selected[name] = [];
            selected[name].push(input.value);
          });
          STATE.selectedAttrFilters = selected;
        }

        async function reloadFromServer() {
          try {
            const json = await fetchJson(buildApiUrl());
            const normalized = normalizePayload(json || {});
            STATE.payload = json;
            STATE.items = normalized.items || [];
            STATE.parents = normalized.filters.parent_categories || [];
            STATE.total = toNum(normalized.pagination.total, STATE.items.length);
            STATE.totalPages = toNum(normalized.pagination.total_pages, 1);
            STATE.page = toNum(normalized.pagination.page, STATE.page);
            STATE.limit = toNum(normalized.pagination.limit, STATE.limit);
            renderAll();
          } catch (err) {
            console.error(err);
            if (EL.cardsGrid) EL.cardsGrid.innerHTML = '<div class="empty-full">Unable to load products.</div>';
            flashToast('Unable to load products');
          }
        }

        const liveReload = debounce(async () => {
          patchSelectedFromUI();
          resetToPageOne();
          await reloadFromServer();
        }, 180);

        function buildStateFromQuery() {
          const q = parseQuery();
          STATE.query = q;
          STATE.sort = String(q.sort || 'latest');
          STATE.search = String(q.search || q.q || '');
          STATE.minPrice = String(q.price_min || '');
          STATE.maxPrice = String(q.price_max || '');
          STATE.selectedParent = String(q.parent_category_id || q.parent_id || '');
          STATE.selectedCategory = String(q.category_id || q.subgroup_id || '');
          STATE.selectedBrands = String(q.brand || '').split(',').filter(Boolean);
          STATE.selectedRating = String(q.rating || '');
          STATE.page = Math.max(1, toNum(q.page || 1, 1));
          STATE.limit = [12, 24, 36].includes(toNum(q.limit || 12, 12)) ? toNum(q.limit || 12, 12) : 12;
          STATE.selectedAttrFilters = (() => {
            const out = {};
            Object.entries(q).forEach(([k, v]) => {
              if (!k.startsWith('attr_')) return;
              const key = k.replace(/^attr_/, '').toLowerCase().replace(/\s+/g, '_');
              const vals = String(v || '').split(',').map((s) => s.trim()).filter(Boolean);
              if (vals.length) out[key] = vals;
            });
            return out;
          })();

          if (EL.searchInput) EL.searchInput.value = STATE.search;
          if (EL.sortSelect) EL.sortSelect.value = STATE.sort || 'latest';
          if (EL.pageSize) EL.pageSize.value = String(STATE.limit || 12);
          if (EL.priceMin) EL.priceMin.value = STATE.minPrice;
          if (EL.priceMax) EL.priceMax.value = STATE.maxPrice;
          qsa('input[name="rating"]').forEach((x) => x.checked = String(x.value) === String(STATE.selectedRating || ''));
        }

        async function loadCartMap() {
          try {
            const res = await apiFetch('/customer/cart/api', 'GET');
            const rows = Array.isArray(res?.data) ? res.data : Array.isArray(res?.items) ? res.items : Array.isArray(res) ? res : [];
            STATE.cartMap.clear();
            rows.forEach((row) => {
              const vid = row.variant_id ?? row.variantId ?? row.vid ?? row.id;
              const qty = toNum(row.qty ?? row.quantity ?? row.in_cart_qty ?? 0, 0);
              if (vid != null) STATE.cartMap.set(String(vid), qty);
            });
          } catch (_) { }
        }

        async function loadWishlistMap() {
          try {
            const local = localStorage.getItem('wishlist_map');
            if (local) {
              try { STATE.wishlistMap = JSON.parse(local) || {}; } catch (e) { localStorage.removeItem('wishlist_map'); }
            }

            const res = await apiFetch(WISHLIST_DATA_URL, 'GET');
            const list = Array.isArray(res?.data) ? res.data : (Array.isArray(res) ? res : []);
            if (!Object.keys(STATE.wishlistMap).length) STATE.wishlistMap = {};
            list.forEach((vid) => {
              const key = typeof vid === 'object' ? (vid.variant_id ?? vid.id ?? vid.variantId) : vid;
              if (key != null) STATE.wishlistMap[String(key)] = true;
            });
            try { localStorage.setItem('wishlist_map', JSON.stringify(STATE.wishlistMap || {})); } catch (e) { }
          } catch (_) {
            if (!STATE.wishlistMap || typeof STATE.wishlistMap !== 'object') STATE.wishlistMap = {};
          }
        }

        async function addToCart(item) {
          const vid = String(item.id || '');
          if (!vid || STATE.cartBusy.has(vid)) return;
          STATE.cartBusy.add(vid);
          const prevQty = qtyFor(vid);
          try {
            STATE.cartMap.set(vid, prevQty + 1);
            renderAll();
            await apiFetch(CART_ADD_URL, 'POST', { variant_id: Number(vid), quantity: 1 });
            await loadCartMap();
            renderAll();
            flashToast('Added to cart');
          } catch (err) {
            STATE.cartMap.set(vid, prevQty);
            renderAll();
            flashToast(err.message || 'Unable to add to cart');
          } finally {
            STATE.cartBusy.delete(vid);
          }
        }

        async function updateQty(variantId, qty) {
          if (!variantId) return;
          const vid = String(variantId);
          const prev = qtyFor(vid);
          try {
            if (qty < 1) {
              STATE.cartMap.set(vid, 0);
              renderAll();
              await apiFetch(CART_REMOVE_URL, 'POST', { variant_id: Number(vid) });
            } else {
              STATE.cartMap.set(vid, qty);
              renderAll();
              await apiFetch(CART_UPDATE_URL, 'POST', { variant_id: Number(vid), quantity: Number(qty) });
            }
            await loadCartMap();
            renderAll();
          } catch (err) {
            STATE.cartMap.set(vid, prev);
            renderAll();
            flashToast(err.message || 'Cart update failed');
          }
        }

        async function toggleFav(item) {
          const vid = String(item.id || '');
          if (!vid || STATE.favBusy.has(vid)) return;
          STATE.favBusy.add(vid);
          const prev = isFav(item);
          STATE.wishlistMap[vid] = !prev;
          renderAll();
          try {
            const res = await apiFetch(FAV_TOGGLE_URL, 'POST', { variant_id: Number(vid) });
            const fav = !!(res?.is_fav ?? (res?.action === 'added'));
            STATE.wishlistMap[vid] = fav;
            try { localStorage.setItem('wishlist_map', JSON.stringify(STATE.wishlistMap)); } catch (e) { }
            renderAll();
            flashToast(fav ? 'Added to wishlist' : 'Removed from wishlist');
          } catch (err) {
            STATE.wishlistMap[vid] = prev;
            renderAll();
            flashToast(err.message || 'Wishlist update failed');
          } finally {
            STATE.favBusy.delete(vid);
          }
        }

        function bindLiveInputs() {
          if (EL.searchInput) EL.searchInput.addEventListener('input', () => liveReload());
          if (EL.searchClear) {
            EL.searchClear.addEventListener('click', () => {
              if (EL.searchInput) EL.searchInput.value = '';
              STATE.search = '';
              liveReload();
            });
          }
          if (EL.sortSelect) {
            EL.sortSelect.addEventListener('change', () => {
              STATE.sort = EL.sortSelect.value;
              STATE.page = 1;
              reloadFromServer();
            });
          }
          if (EL.pageSize) {
            EL.pageSize.addEventListener('change', () => {
              STATE.limit = [12, 24, 36].includes(toNum(EL.pageSize.value, 12)) ? toNum(EL.pageSize.value, 12) : 12;
              STATE.page = 1;
              reloadFromServer();
            });
          }
          [EL.priceMin, EL.priceMax].forEach((el) => { if (!el) return; el.addEventListener('input', () => liveReload()); });
          document.addEventListener('change', (e) => {
            if (e.target.closest('#brand-filter-list')) return liveReload();
            if (e.target.closest('#attribute-filter-list')) return liveReload();
            if (e.target.name === 'rating') return liveReload();
            if (e.target.name === 'category-filter') return liveReload();
          });

          if (EL.parentStrip) {
            EL.parentStrip.addEventListener('click', (e) => {
              const btn = e.target.closest('.parent-pill');
              if (!btn) return;
              STATE.selectedParent = String(btn.getAttribute('data-parent-id') || '');
              STATE.selectedCategory = '';
              STATE.selectedAttrFilters = {};
              STATE.selectedBrands = [];
              STATE.selectedRating = '';
              STATE.page = 1;
              reloadFromServer();
            });
          }

          if (EL.categorySection) {
            EL.categorySection.addEventListener('change', (e) => {
              const input = e.target.closest('input[name="category-filter"]');
              if (!input) return;
              STATE.selectedCategory = String(input.value || '');
              STATE.page = 1;
              reloadFromServer();
            });
          }

          if (EL.btnReset) {
            EL.btnReset.addEventListener('click', () => {
              STATE.selectedParent = '';
              STATE.selectedCategory = '';
              STATE.selectedBrands = [];
              STATE.selectedRating = '';
              STATE.selectedAttrFilters = {};
              STATE.search = '';
              STATE.sort = 'latest';
              STATE.minPrice = '';
              STATE.maxPrice = '';
              STATE.page = 1;
              STATE.limit = 12;
              if (EL.searchInput) EL.searchInput.value = '';
              if (EL.sortSelect) EL.sortSelect.value = 'latest';
              if (EL.pageSize) EL.pageSize.value = '12';
              if (EL.priceMin) EL.priceMin.value = '';
              if (EL.priceMax) EL.priceMax.value = '';
              qsa('input[name="rating"]').forEach((x) => x.checked = x.value === '');
              reloadFromServer();
              setDrawer(false);
            });
          }

          if (EL.viewAllBtn) {
            EL.viewAllBtn.addEventListener('click', () => {
              STATE.selectedParent = '';
              STATE.selectedCategory = '';
              STATE.selectedAttrFilters = {};
              STATE.selectedBrands = [];
              STATE.selectedRating = '';
              STATE.page = 1;
              reloadFromServer();
            });
          }

          if (EL.openBtn) EL.openBtn.addEventListener('click', () => setDrawer(true));
          if (EL.openBtn2) EL.openBtn2.addEventListener('click', () => setDrawer(true));
          if (EL.closeBtn) EL.closeBtn.addEventListener('click', () => setDrawer(false));
          if (EL.backdrop) EL.backdrop.addEventListener('click', () => setDrawer(false));
          if (EL.sortMobileOpen) EL.sortMobileOpen.addEventListener('click', () => setDrawer(true));
          if (EL.sortMobileOpen2) EL.sortMobileOpen2.addEventListener('click', () => setDrawer(true));

          document.addEventListener('click', (e) => {
            const favBtn = e.target.closest('.js-fav-btn');
            if (favBtn) {
              e.preventDefault();
              e.stopPropagation();
              const card = favBtn.closest('.product-card');
              const item = card ? STATE.items.find((x) => String(x.id) === String(card.dataset.variantId)) : null;
              if (item) toggleFav(item);
              return;
            }

            const cartBtn = e.target.closest('.btn-cart');
            if (cartBtn) {
              e.preventDefault();
              e.stopPropagation();
              const card = cartBtn.closest('.product-card');
              const item = card ? STATE.items.find((x) => String(x.id) === String(card.dataset.variantId)) : null;
              if (item) addToCart(item);
              return;
            }

            const minus = e.target.closest('.qty-minus');
            if (minus) {
              e.preventDefault();
              e.stopPropagation();
              const card = minus.closest('.product-card');
              const variantId = card?.dataset?.variantId;
              const current = qtyFor(variantId);
              if (current <= 1) updateQty(variantId, 0);
              else updateQty(variantId, current - 1);
              return;
            }

            const plus = e.target.closest('.qty-plus');
            if (plus) {
              e.preventDefault();
              e.stopPropagation();
              const card = plus.closest('.product-card');
              const variantId = card?.dataset?.variantId;
              const item = STATE.items.find((x) => String(x.id) === String(variantId));
              const current = qtyFor(variantId);
              const stock = toNum(item?.stock, 0);
              if (current + 1 > stock) {
                flashToast(`Not enough stock. Available: ${stock}`);
                return;
              }
              updateQty(variantId, current + 1);
              return;
            }

            const pageBtn = e.target.closest('.btn-page');
            if (pageBtn) {
              e.preventDefault();
              const page = toNum(pageBtn.getAttribute('data-page'), 1);
              if (!page || page === STATE.page) return;
              STATE.page = page;
              reloadFromServer();
              return;
            }

            const chip = e.target.closest('.chip');
            if (chip) {
              const text = chip.textContent.toLowerCase();
              if (text.includes('parent')) STATE.selectedParent = '';
              if (text.includes('category')) STATE.selectedCategory = '';
              if (text.includes('search')) STATE.search = '';
              if (text.includes('price')) { STATE.minPrice = ''; STATE.maxPrice = ''; }
              if (text.includes('brand')) STATE.selectedBrands = [];
              if (text.includes('rating')) STATE.selectedRating = '';
              STATE.selectedAttrFilters = {};
              STATE.page = 1;
              if (EL.searchInput) EL.searchInput.value = STATE.search;
              if (EL.priceMin) EL.priceMin.value = STATE.minPrice;
              if (EL.priceMax) EL.priceMax.value = STATE.maxPrice;
              reloadFromServer();
            }
          });

          document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') setDrawer(false);
            const card = document.activeElement?.closest?.('.product-card');
            if (!card) return;
            if (e.key === 'Enter' || e.key === ' ') {
              if (document.activeElement && ['BUTTON', 'INPUT', 'SELECT', 'TEXTAREA'].includes(document.activeElement.tagName)) return;
              e.preventDefault();
              const link = card.dataset.link;
              if (link) window.location.href = link;
            }
          });

          document.addEventListener('click', (e) => {
            const card = e.target.closest('.product-card');
            if (!card) return;
            if (e.target.closest('button') || e.target.closest('a')) return;
            const link = card.dataset.link;
            if (link) window.location.href = link;
          });
        }

        async function init() {
          try {
            buildStateFromQuery();
            bindLiveInputs();
            const json = await fetchJson(buildApiUrl());
            const normalized = normalizePayload(json || {});
            STATE.payload = json;
            STATE.items = normalized.items || [];
            STATE.parents = normalized.filters.parent_categories || [];
            STATE.total = toNum(normalized.pagination.total, STATE.items.length);
            STATE.totalPages = toNum(normalized.pagination.total_pages, 1);
            STATE.page = toNum(normalized.pagination.page, STATE.page);
            STATE.limit = toNum(normalized.pagination.limit, STATE.limit);

            await Promise.allSettled([loadCartMap(), loadWishlistMap()]);
            setDynamicVisibility();
            updateCounters();
            renderAll();

            window.addEventListener('resize', debounce(() => {
              buildParentsStrip();
              renderAll();
            }, 150));
          } catch (err) {
            console.error(err);
            if (EL.cardsGrid) EL.cardsGrid.innerHTML = '<div class="empty-full">Unable to load products.</div>';
            flashToast('Unable to load products');
          }
        }

        document.addEventListener('DOMContentLoaded', init);
      })();
    </script>
