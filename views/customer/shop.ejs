  <body>
    <div class="shop-shell">
      <%- include('includes/header') %>

        <style>
          :root {
            --bg: #ffffff;
            --card: #ffffff;
            --text: #111827;
            --muted: #6b7280;
            --line: #d1d5db;
            --brand: #0d6efd;
            --brand-soft: rgba(13, 110, 253, 0.07);
            --warn: #fed700;
            --warn-hover: #f4c400;
            --danger: #dc3545;
            --danger-soft: rgba(220, 53, 69, 0.08);
            --radius: 14px;
            --sidebar-w: 290px;
          }

          *,
          *::before,
          *::after {
            box-sizing: border-box;
          }

          html {
            -webkit-text-size-adjust: 100%;
            text-size-adjust: 100%;
          }

          body {
            margin: 0;
            background: var(--bg);
            color: var(--text);
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
            font-size: 14px;
            line-height: 1.45;
          }

          a {
            color: inherit;
          }

          button,
          input,
          select {
            font: inherit;
          }

          button {
            -webkit-tap-highlight-color: transparent;
          }

          .shop-shell {
            min-height: 100vh;
            background: var(--bg);
            color: var(--text);
          }

          .shop-topbar {
            position: sticky;
            top: 0;
            z-index: 90;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 12px;
            background: rgba(255, 255, 255, 0.97);
            border-bottom: 1px solid var(--line);
          }

          .brand {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
            color: var(--text);
            font-weight: 700;
            white-space: nowrap;
            flex: 0 0 auto;
          }

          .brand-badge {
            width: 10px;
            height: 10px;
            border-radius: 999px;
            background: var(--brand);
            flex: 0 0 auto;
          }

          .search-wrap {
            flex: 1 1 auto;
            max-width: 680px;
            min-width: 0;
            position: relative;
            display: flex;
            align-items: center;
          }

          .search-wrap input {
            width: 100%;
            height: 42px;
            border: 1px solid var(--line);
            border-radius: 999px;
            padding: 0 44px 0 14px;
            background: #fff;
            color: var(--text);
            outline: none;
          }

          .search-wrap input:focus {
            border-color: rgba(13, 110, 253, 0.45);
            outline: 2px solid transparent;
          }

          .search-btn {
            position: absolute;
            right: 7px;
            width: 28px;
            height: 28px;
            border: 0;
            border-radius: 999px;
            background: #f3f4f6;
            color: #111;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            line-height: 1;
          }

          .top-actions,
          .mobile-controls {
            display: flex;
            align-items: center;
            gap: 8px;
            flex: 0 0 auto;
          }

          .top-action,
          .mobile-btn,
          .mini-btn,
          .btn-reset,
          .btn-page,
          .page-size {
            border: 1px solid var(--line);
            background: #fff;
            color: var(--text);
            border-radius: 999px;
            padding: 9px 12px;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            line-height: 1;
          }

          .top-action .count,
          .count {
            min-width: 20px;
            height: 20px;
            padding: 0 5px;
            border-radius: 999px;
            background: var(--brand);
            color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 700;
          }

          .mobile-btn {
            display: none;
          }

          .hero-bar {
            padding: 12px;
          }

          .hero-card {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: var(--radius);
            padding: 12px;
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 12px;
          }

          .hero-title {
            margin: 0;
            font-size: 20px;
            font-weight: 700;
            line-height: 1.15;
          }

          .hero-subtitle {
            margin: 6px 0 0;
            color: var(--muted);
            max-width: 760px;
          }

          .hero-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            justify-content: flex-end;
            align-items: center;
          }

          .hero-meta span,
          .compact-note,
          .results-count,
          .scope-note,
          .page-info {
            font-size: 12px;
            color: var(--muted);
            background: #f9fafb;
            border: 1px solid var(--line);
            border-radius: 999px;
            padding: 4px 8px;
            white-space: nowrap;
          }

          .content {
            display: grid;
            grid-template-columns: var(--sidebar-w) minmax(0, 1fr);
            gap: 12px;
            padding: 0 12px 12px;
            align-items: start;
          }

          .sidebar {
            position: sticky;
            top: 62px;
            display: grid;
            gap: 12px;
            align-self: start;
            max-height: calc(100vh - 76px);
            overflow: auto;
            padding-bottom: 8px;
            scrollbar-width: thin;
            scrollbar-color: rgba(107, 114, 128, 0.4) transparent;
          }

          .sidebar::-webkit-scrollbar,
          .parent-strip::-webkit-scrollbar,
          .section-content::-webkit-scrollbar,
          .pagination::-webkit-scrollbar {
            width: 8px;
            height: 8px;
          }

          .sidebar::-webkit-scrollbar-thumb,
          .parent-strip::-webkit-scrollbar-thumb,
          .section-content::-webkit-scrollbar-thumb,
          .pagination::-webkit-scrollbar-thumb {
            background: rgba(107, 114, 128, 0.35);
            border-radius: 999px;
          }

          .sidebar::-webkit-scrollbar-track,
          .parent-strip::-webkit-scrollbar-track,
          .section-content::-webkit-scrollbar-track,
          .pagination::-webkit-scrollbar-track {
            background: transparent;
          }

          .section-box,
          .panel {
            background: var(--card);
            border: 1px solid var(--line);
            border-radius: var(--radius);
          }

          .section-head,
          .panel-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            padding: 10px 12px;
            border-bottom: 1px solid var(--line);
            font-weight: 700;
          }

          .panel-title {
            margin: 0;
            font-size: 14px;
          }

          .panel-body {
            padding: 10px 12px 12px;
          }

          .parent-strip {
            padding: 10px;
            display: grid;
            gap: 8px;
            max-height: 380px;
            overflow: auto;
          }

.parent-pill {
  border: 1px solid var(--line);
  background: #fff;
  border-radius: 12px;
  padding: 8px;

  display: grid;
  grid-template-columns: auto 1fr; /* FIX */
  align-items: center;
  gap: 8px;

  cursor: pointer;
  text-align: left;
  transition: border-color .14s ease, background .14s ease;
}

          .parent-pill:hover,
          .parent-pill.is-active {
            border-color: rgba(13, 110, 253, 0.38);
            background: rgba(13, 110, 253, 0.04);
          }

          .pill-thumb {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            overflow: hidden;
            background: #f8fafc;
            border: 1px solid #eef2f7;
            display: inline-flex;
            align-items: center;
            justify-content: center;
          }

          .pill-thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
          }
/* 
          .pill-name {
            font-weight: 700;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
          } */

          .compact-note {
            margin-bottom: 10px;
            white-space: normal;
            border-radius: 12px;
            background: #f8fafc;
          }

          .hidden {
            display: none !important;
          }

          .facet-group {
            overflow: hidden;
          }

          .section-content {
            padding: 10px 12px 12px;
            display: grid;
            gap: 8px;
          }

          .facet-list {
            display: grid;
            gap: 8px;
          }

          .facet-row {
            display: grid;
            grid-template-columns: 16px minmax(0, 1fr) auto;
            align-items: center;
            gap: 8px;
            border: 1px solid var(--line);
            border-radius: 12px;
            padding: 8px 10px;
            background: #fff;
            cursor: pointer;
            transition: background .14s ease, border-color .14s ease;
            font-size: 13px;
          }

          .facet-row:hover {
            border-color: rgba(13, 110, 253, 0.32);
            background: #fbfdff;
          }

          .facet-row input {
            margin: 0;
            accent-color: var(--brand);
          }

          .facet-row span {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            font-weight: 700;
          }

          .facet-row small {
            color: var(--muted);
            font-weight: 700;
          }

          .range-row {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 8px;
          }

          .range-input,
          .sort-select,
          .page-size {
            width: 100%;
            height: 40px;
            border: 1px solid var(--line);
            background: #fff;
            border-radius: 12px;
            padding: 0 10px;
            outline: none;
          }

          .range-input:focus,
          .sort-select:focus,
          .page-size:focus,
          .search-wrap input:focus {
            border-color: rgba(13, 110, 253, 0.45);
            outline: 2px solid transparent;
          }

          .helper-inline {
            font-size: 12px;
            color: var(--muted);
          }

          .filter-summary {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 8px;
          }

          .chip {
            border: 1px solid var(--line);
            background: #fff;
            border-radius: 999px;
            padding: 7px 10px;
            font-size: 12px;
            font-weight: 700;
            color: var(--text);
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: background .14s ease, border-color .14s ease;
          }

          .chip:hover {
            border-color: rgba(13, 110, 253, 0.32);
            background: #fbfdff;
          }

          .chip strong {
            font-weight: 700;
          }

          .chip-empty {
            background: #f9fafb;
            color: var(--muted);
            cursor: default;
          }

          .main {
            min-width: 0;
            display: grid;
            gap: 12px;
          }

          .toolbar {
            background: rgba(255, 255, 255, 0.97);
            border: 1px solid var(--line);
            border-radius: var(--radius);
            padding: 10px 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
            position: sticky;
            top: 62px;
            z-index: 40;
          }

          .toolbar-left,
          .toolbar-right {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-wrap: wrap;
            min-width: 0;
          }

          .toolbar-right {
            justify-content: flex-end;
          }

          .results-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 10px;
            align-items: start;
          }

          .product-card {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: var(--radius);
            overflow: hidden;
            display: flex;
            flex-direction: column;
            min-height: 340px;
            transition: border-color .14s ease, background .14s ease;
            cursor: pointer;
          }

          .product-card:hover {
            border-color: rgba(13, 110, 253, 0.22);
            background: #fcfdff;
          }

          .card-image-wrap {
            position: relative;
            background: #fff;
            height: 156px;
            padding: 8px;
            overflow: hidden;
          }

          .card-image-link {
            display: block;
            width: 100%;
            height: 100%;
            border-radius: 12px;
            overflow: hidden;
            background: #fff;
            border: 1px solid #eef2f7;
          }

          .card-image-link img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            display: block;
          }

          .badges-top-left {
            position: absolute;
            top: 12px;
            left: 12px;
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            z-index: 2;
            max-width: calc(100% - 60px);
          }

          .deal-badge,
          .stock-badge,
          .mini-badge,
          .mini-vat {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 2px 5px;
            border-radius: 999px;
            font-size: 9px;
            font-weight: 600;
            white-space: nowrap;
          }

          .deal-badge {
            background: #fff4bf;
            color: #7a5b00;
            border: 1px solid rgba(122, 91, 0, 0.12);
          }

          .stock-badge.low {
            background: #fff0f0;
            color: #b42318;
            border: 1px solid rgba(180, 35, 24, 0.08);
          }

          .stock-badge.sold {
            background: #f3f4f6;
            color: #6b7280;
            border: 1px solid rgba(107, 114, 128, 0.08);
          }

          .fav-btn {
            position: absolute;
            top: 12px;
            right: 12px;
            width: 34px;
            height: 34px;
            border-radius: 999px;
            border: 1px solid rgba(220, 53, 69, 0.18);
            background: rgba(255, 255, 255, 0.95);
            color: var(--danger);
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            line-height: 1;
          }

          .fav-btn.is-fav {
            background: var(--danger);
            color: #fff;
            border-color: var(--danger);
          }

          .card-body {
            padding: 10px;
            display: flex;
            flex-direction: column;
            gap: 6px;
            flex: 1 1 auto;
            min-height: 0;
          }

          .product-name {
            color: var(--text);
            text-decoration: none;
            font-size: 11px;
            line-height: 1.35;
            font-weight: 600;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            min-height: 34px;
          }

          .rating-row,
          .meta-row,
          .stock-row {
            font-size: 10px;
            color: var(--muted);
            line-height: 1.35;
          }

          .rating-row {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-weight: 700;
          }

          .rating-row .star {
            color: #f59e0b;
            font-size: 13px;
          }

          .rating-row .reviews {
            color: var(--muted);
            font-weight: 700;
          }

          .price-row {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 10px;
          }

          .price-stack {
            display: flex;
            flex-wrap: wrap;
            align-items: baseline;
            gap: 8px;
          }

          .price-current {
            font-size: 11px;
            font-weight: 700;
          }

          .price-old {
            font-size: 10px;
            color: var(--muted);
            text-decoration: line-through;
            font-weight: 600;
          }

          .mini-vat {
            background: #eefbf1;
            color: #12713b;
            border: 1px solid rgba(18, 113, 59, 0.08);
            flex: 0 0 auto;
          }

          .stock-row.out {
            color: var(--muted);
            font-weight: 700;
          }

          .actions-row {
            margin-top: auto;
            display: grid;
            grid-template-columns: 1fr auto;
            gap: 8px;
            align-items: center;
            padding-top: 4px;
          }

          .btn-cart,
          .btn-view {
            height: 36px;
            border-radius: 12px;
            border: 0;
            padding: 0 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            text-decoration: none;
            transition: background .14s ease, border-color .14s ease;
          }

          .btn-cart {
            background: var(--warn);
            color: #111;
          }

          .btn-cart:hover {
            background: var(--warn-hover);
          }

          .btn-cart[disabled] {
            background: #e5e7eb;
            color: #9ca3af;
            cursor: not-allowed;
          }

          .btn-view {
            border: 1px solid var(--line);
            background: #fff;
            color: var(--text);
            min-width: 76px;
          }

          .qty-controls {
            height: 36px;
            display: inline-flex;
            align-items: center;
            gap: 2px;
            border: 1px solid var(--line);
            background: #fff;
            border-radius: 12px;
            overflow: hidden;
          }

          .qty-controls button {
            width: 32px;
            height: 36px;
            border: 0;
            background: transparent;
            cursor: pointer;
            font-size: 16px;
            font-weight: 700;
            color: var(--text);
          }

          .qty-count {
            min-width: 32px;
            text-align: center;
            font-weight: 700;
            font-size: 12px;
            color: var(--text);
          }

          .empty-full {
            grid-column: 1 / -1;
            background: #fff;
            border: 1px dashed var(--line);
            border-radius: var(--radius);
            min-height: 200px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--muted);
            padding: 18px;
            text-align: center;
          }

          .pagination-wrap {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
            padding: 0 2px 2px;
          }

          .pagination {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            align-items: center;
          }

          .btn-page {
            min-width: 38px;
            height: 38px;
            justify-content: center;
            padding: 0 10px;
            border-radius: 12px;
          }

          .btn-page.is-active {
            border-color: rgba(13, 110, 253, 0.38);
            background: var(--brand-soft);
          }

          .sticky-mobile-bar {
            display: none;
            position: fixed;
            left: 0;
            right: 0;
            bottom: 0;
            z-index: 95;
            padding: 10px 12px 12px;
            background: rgba(255, 255, 255, 0.98);
            border-top: 1px solid var(--line);
            gap: 10px;
          }

          .sticky-mobile-bar .btn {
