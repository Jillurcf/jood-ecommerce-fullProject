          <i class="fa fa-bars"></i>
        </button>
        <div class="topbar-title" style="display:flex; flex-direction:column; justify-content:center; gap:2px;">
          <div class="title">JOOD Billing</div>
          <div class="sub">Payments, details, and billing controls</div>
        </div>
      </div>
      <style>
        @media (max-width: 768px) {
          #openExportDrawerBtn,
          #exportPdfBtn {
            display: none !important;
          }
        }
      </style>
