<script>
(function () {
  const form = document.getElementById('billingForm');
  const layout = document.getElementById('accountLayout');
  const sidebar = document.getElementsByClassName('account-sidebar');
  const toggleBtn = document.getElementById('accountToggleBtn');
  const backdrop = document.getElementById('accountBackdrop');
  const billingSubSidebarInner = document.getElementById('billingSubSidebarInner');
  const toast = document.getElementById('toastMini');
  const savingDot = document.getElementById('savingDot');
  const savingText = document.getElementById('savingText');
  const lastUpdatedValue = document.getElementById('lastUpdatedValue');
  const lastLoginValue = document.getElementById('lastLoginValue');
  const lastAttemptValueRow = document.getElementById('lastAttemptValueRow');
  const topbarUserName = document.getElementById('topbarUserName');
  const inputs = form ? form.querySelectorAll('.js-autosave') : [];
  const otpButtons = document.querySelectorAll('.js-request-otp');
  const chartCanvas = document.getElementById('billingTrendChart');
  const mixCanvas = document.getElementById('paymentMixChart');

  const liveClockValue = document.getElementById('liveClockValue');
  const lastRefreshLabel = document.getElementById('lastRefreshLabel');
  const graphRange = document.getElementById('graphRange');
  const graphFromDate = document.getElementById('graphFromDate');
  const graphToDate = document.getElementById('graphToDate');
  const graphRangeLabel = document.getElementById('graphRangeLabel');
  const refreshLiveBtn = document.getElementById('refreshLiveBtn');

  const searchQuery = document.getElementById('searchQuery');
  const fromDate = document.getElementById('fromDate');
  const toDate = document.getElementById('toDate');
  const statusFilter = document.getElementById('statusFilter');
  const typeFilter = document.getElementById('typeFilter');
  const clearLiveFiltersBtn = document.getElementById('clearLiveFiltersBtn');
  const appliedFilterLabel = document.getElementById('appliedFilterLabel');
  const matchedCountLabel = document.getElementById('matchedCountLabel');
  const visibleCountLabel = document.getElementById('visibleCountLabel');
  const filterSummaryText = document.getElementById('filterSummaryText');
  const rangeLabelText = document.getElementById('rangeLabelText');
  const billingResultsWrap = document.getElementById('billingResultsWrap');
  const billingResultsEmpty = document.getElementById('billingResultsEmpty');
  const billingResultsTable = document.getElementById('billingResultsTable');
  const billingResultsBody = document.getElementById('billingResultsBody');
  const exportVisibleOrdersBtn = document.getElementById('exportVisibleOrdersBtn');
  const exportVisibleProductsBtn = document.getElementById('exportVisibleProductsBtn');
  const exportSingleSelectionBtn = document.getElementById('exportSingleSelectionBtn');

  const exportDrawer = document.getElementById('exportDrawer');
  const exportDrawerOverlay = document.getElementById('exportDrawerOverlay');
  const openExportDrawerBtn = document.getElementById('openExportDrawerBtn');
  const openExportDrawerBtn2 = document.getElementById('openExportDrawerBtn2');
  const closeExportDrawerBtn = document.getElementById('closeExportDrawerBtn');
  const exportMode = document.getElementById('exportMode');
  const recentLimit = document.getElementById('recentLimit');
  const recentLimitWrap = document.getElementById('recentLimitWrap');
  const orderQueryWrap = document.getElementById('orderQueryWrap');
  const productQueryWrap = document.getElementById('productQueryWrap');
  const dateRangeWrap = document.getElementById('dateRangeWrap');
  const orderQuery = document.getElementById('orderQuery');
  const productQuery = document.getElementById('productQuery');
  const exportFromDate = document.getElementById('exportFromDate');
  const exportToDate = document.getElementById('exportToDate');
  const applyExportFilterBtn = document.getElementById('applyExportFilterBtn');
  const exportPdfBtn = document.getElementById('exportPdfBtn');
  const exportPdfBtn2 = document.getElementById('exportPdfBtn2');
  const exportPdfDrawerBtn = document.getElementById('exportPdfDrawerBtn');
  const exportPreviewCount = document.getElementById('exportPreviewCount');
  const exportPreviewList = document.getElementById('exportPreviewList');

  const totalSpentValue = document.getElementById('totalSpentValue');
  const totalOrdersPaidValue = document.getElementById('totalOrdersPaidValue');
  const pendingPaymentsValue = document.getElementById('pendingPaymentsValue');
  const refundTotalValue = document.getElementById('refundTotalValue');
  const thisMonthSpentValue = document.getElementById('thisMonthSpentValue');
  const lastOrderLabelValue = document.getElementById('lastOrderLabelValue');
  const lastOrderDateValue = document.getElementById('lastOrderDateValue');

  if (!form || !layout || !sidebar || !toggleBtn) return;

  let timer = null;
  let isSaving = false;
  let lastPayload = '';
  let clockTimer = null;
  let refreshTimer = null;
  let chartTrend = null;
  let chartMix = null;
  let selectedResult = null;

  const report = {
    userName: <%- JSON.stringify(userName) %>,
    customerId: <%- JSON.stringify(customerId) %>,
    currency: <%- JSON.stringify(currency) %>,
    summary: {
      totalSpent: <%- JSON.stringify(totalSpent) %>,
      totalOrdersPaid: <%- JSON.stringify(totalOrdersPaid) %>,
      pendingPayments: <%- JSON.stringify(pendingPayments) %>,
      thisMonthSpent: <%- JSON.stringify(thisMonthSpent) %>,
      refundTotal: <%- JSON.stringify(refundTotal) %>
    },
    lastOrder: <%- JSON.stringify(lastOrder || {}) %>,
    recentOrders: <%- JSON.stringify(recentOrders) %>,
    allOrders: <%- JSON.stringify(allOrders) %>,
    monthlySeries: <%- JSON.stringify(monthlySeries) %>,
    paymentMethodStats: <%- JSON.stringify(paymentMethodStats) %>
  };

  const state = {
    data: {
      allOrders: Array.isArray(report.allOrders) ? report.allOrders.slice() : [],
      recentOrders: Array.isArray(report.recentOrders) ? report.recentOrders.slice() : [],
      monthlySeries: Array.isArray(report.monthlySeries) ? report.monthlySeries.slice() : [],
      paymentMethodStats: Array.isArray(report.paymentMethodStats) ? report.paymentMethodStats.slice() : []
    },
    filters: {
      q: '',
      from: '',
      to: '',
      status: 'all',
      type: 'all',
      graphRange: 'month'
    },
    filteredOrders: [],
    filteredRows: [],
    selectedExport: null,
    lastRefreshAt: null,
    liveMode: true
  };

  let exportState = { mode: 'all_orders', results: [], label: 'All Orders', details: '' };

  function showToast(message) {
    if (!toast) return;
    toast.textContent = message;
    toast.classList.add('show');
    clearTimeout(showToast._t);
    showToast._t = setTimeout(() => toast.classList.remove('show'), 2600);
  }

  function setSavingState(stateName, message) {
    if (!savingDot || !savingText) return;
    savingDot.classList.remove('is-saving', 'is-saved', 'is-error');
    if (stateName === 'saving') {
      savingDot.classList.add('is-saving');
      savingText.textContent = message || 'Saving...';
    } else if (stateName === 'saved') {
      savingDot.classList.add('is-saved');
      savingText.textContent = message || 'All changes saved';
    } else if (stateName === 'error') {
      savingDot.classList.add('is-error');
      savingText.textContent = message || 'Save failed';
    } else {
      savingText.textContent = message || 'All changes saved';
    }
  }

  function isMobile() { return window.innerWidth <= 991; }

  function closeMobileSidebar() {
    sidebar.classList.remove('open');
    backdrop?.classList.remove('show');
    document.body.style.overflow = '';
    toggleBtn.setAttribute('aria-expanded', 'false');
  }

  function applyBillingSidebarMode() {
    if (isMobile()) {
      closeMobileSidebar();
      layout.classList.remove('sidebar-expanded');
      layout.classList.add('sidebar-collapsed');
      sidebar.classList.add('collapsed');
      sidebar.classList.remove('expanded');
      if (billingSubSidebarInner) billingSubSidebarInner.style.display = 'block';
      return;
    }
    layout.classList.remove('sidebar-expanded');
    layout.classList.add('sidebar-collapsed');
    sidebar.classList.add('collapsed');
    sidebar.classList.remove('expanded');
    backdrop?.classList.remove('show');
    document.body.style.overflow = '';
    if (billingSubSidebarInner) billingSubSidebarInner.style.display = 'block';
  }

  function getFormDataObject() {
    const fd = new FormData(form);
    const obj = {};
    for (const [key, value] of fd.entries()) obj[key] = String(value).trim();
    return obj;
  }

  function formatDateTime(value) {
    if (!value) return 'Not available';
    const d = new Date(value);
    if (Number.isNaN(d.getTime())) return 'Not available';
    return d.toLocaleString('en-GB', { day:'2-digit', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit' });
  }

  function formatDate(value) {
    if (!value) return 'Not available';
    const d = new Date(value);
    if (Number.isNaN(d.getTime())) return 'Not available';
    return d.toLocaleDateString('en-GB', { day:'2-digit', month:'short', year:'numeric' });
  }

  function toDateKey(value) {
    const d = new Date(value);
    if (Number.isNaN(d.getTime())) return '';
    return d.toISOString().slice(0, 10);
  }

  function money(value, curr) {
    return `${Number(value || 0).toFixed(2)} ${curr || report.currency}`;
  }

  function escapeHtml(str) {
    return String(str ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }

  function getOrderProductIds(order) {
    const ids = [];
    if (!order) return ids;
    if (order.product_id) ids.push(order.product_id);
    if (order.product?.id) ids.push(order.product.id);
    if (order.product?.product_id) ids.push(order.product.product_id);
    if (Array.isArray(order.items)) {
      order.items.forEach(item => {
        if (!item) return;
        if (item.product_id) ids.push(item.product_id);
        if (item.product?.product_id) ids.push(item.product.product_id);
        if (item.product?.id) ids.push(item.product.id);
        if (item.id) ids.push(item.id);
      });
    }
    return [...new Set(ids.map(v => String(v)).filter(Boolean))];
  }

  function getOrderProductNames(order) {
    const names = [];
    if (!order) return names;
    if (order.product?.name) names.push(order.product.name);
    if (order.product_name) names.push(order.product_name);
    if (Array.isArray(order.items)) {
      order.items.forEach(item => {
        if (!item) return;
        if (item.product?.name) names.push(item.product.name);
        if (item.product_name) names.push(item.product_name);
        if (item.name) names.push(item.name);
      });
    }
    return [...new Set(names.map(v => String(v)).filter(Boolean))];
  }

  function getProductRowsFromOrder(order) {
    if (!order) return [];
    const rows = [];
    if (Array.isArray(order.items) && order.items.length) {
      order.items.forEach(item => {
        rows.push({
          order_number: order.order_number || order.tracking_id || '—',
          tracking_id: order.tracking_id || '—',
          customer_id: report.customerId,
          customer_name: report.userName,
          product_id: item.product_id || item.product?.product_id || item.product?.id || item.id || '—',
          product_name: item.product?.name || item.product_name || item.name || '—',
          quantity: Number(item.qty || item.quantity || 1),
          amount: Number(item.total || item.amount || item.price || item.unit_price || 0),
          created_at: order.created_at || null,
          order_status: order.order_status || '—',
          payment_status: order.payment_status || '—',
          payment_method: order.payment_method || '—',
          currency: order.currency || report.currency
        });
      });
      return rows;
    }
    rows.push({
      order_number: order.order_number || order.tracking_id || '—',
      tracking_id: order.tracking_id || '—',
      customer_id: report.customerId,
      customer_name: report.userName,
      product_id: order.product_id || order.product?.product_id || order.product?.id || '—',
      product_name: order.product?.name || order.product_name || '—',
      quantity: Number(order.qty || order.quantity || 1),
      amount: Number(order.grand_total || order.amount || 0),
      created_at: order.created_at || null,
      order_status: order.order_status || '—',
      payment_status: order.payment_status || '—',
      payment_method: order.payment_method || '—',
      currency: order.currency || report.currency
    });
    return rows;
  }

  function flattenOrders(orders) {
    return (Array.isArray(orders) ? orders : []).map((order, index) => {
      const row = {
        _key: `${order.order_number || order.tracking_id || index}-${index}`,
        raw: order,
        order_number: order.order_number || order.tracking_id || '—',
        tracking_id: order.tracking_id || '—',
        product_id: order.product_id || order.product?.id || order.product?.product_id || (Array.isArray(order.items) && order.items[0] ? (order.items[0].product_id || order.items[0].id || order.items[0].product?.product_id || order.items[0].product?.id || '—') : '—'),
        product_name: order.product?.name || order.product_name || (Array.isArray(order.items) && order.items[0] ? (order.items[0].product?.name || order.items[0].product_name || order.items[0].name || '—') : '—'),
        created_at: order.created_at || null,
        created_key: toDateKey(order.created_at),
        order_status: String(order.order_status || '—'),
        payment_status: String(order.payment_status || '—'),
        payment_method: String(order.payment_method || '—'),
        grand_total: Number(order.grand_total || order.amount || 0),
        currency: order.currency || report.currency,
        search_blob: [
          order.order_number,
          order.tracking_id,
          order.product_id,
          order.product_name,
          order.payment_method,
          order.payment_status,
          order.order_status,
          order.grand_total,
          order.amount,
          ...(getOrderProductIds(order) || []),
          ...(getOrderProductNames(order) || [])
        ].filter(Boolean).join(' ').toLowerCase(),
        order
      };
      return row;
    });
  }

  function getAllRows() {
    return flattenOrders(state.data.allOrders.length ? state.data.allOrders : state.data.recentOrders);
  }

  function startClock() {
    const tick = () => {
      const now = new Date();
      if (liveClockValue) liveClockValue.textContent = now.toLocaleTimeString('en-GB', { hour:'2-digit', minute:'2-digit', second:'2-digit' });
    };
    tick();
    clearInterval(clockTimer);
    clockTimer = setInterval(tick, 1000);
  }

  function formatRangeLabel(from, to) {
    if (from && to) return `Report from ${from} to ${to}`;
    if (from && !to) return `Report from ${from}`;
    if (!from && to) return `Report up to ${to}`;
    return 'Report from all available data';
  }

  function humanGraphLabel(value) {
    const map = { recent: 'Recent', '1w': '1 Week', '2w': '2 Weeks', '3w': '3 Weeks', month: 'Monthly', year: 'Yearly', custom: 'Custom Range' };
    return map[value] || 'Monthly';
  }

  function getGraphWindowRange() {
    const now = new Date();
    const end = new Date(now);
    let start = null;
    const mode = graphRange.value;
    if (mode === 'recent') { start = new Date(now); start.setDate(start.getDate() - 14); }
    else if (mode === '1w') { start = new Date(now); start.setDate(start.getDate() - 7); }
    else if (mode === '2w') { start = new Date(now); start.setDate(start.getDate() - 14); }
    else if (mode === '3w') { start = new Date(now); start.setDate(start.getDate() - 21); }
    else if (mode === 'month') { start = new Date(now); start.setMonth(start.getMonth() - 1); }
    else if (mode === 'year') { start = new Date(now); start.setFullYear(start.getFullYear() - 1); }
    else if (mode === 'custom') {
      if (graphFromDate?.value) start = new Date(graphFromDate.value + 'T00:00:00');
      if (graphToDate?.value) {
        const customEnd = new Date(graphToDate.value + 'T23:59:59');
        return { start, end: customEnd };
      }
      return { start, end };
    }
    return { start, end };
  }

  function filterRowsByState() {
    const q = String(searchQuery?.value || '').trim().toLowerCase();
    const status = String(statusFilter?.value || 'all');
    const type = String(typeFilter?.value || 'all');
    const from = fromDate?.value || '';
    const to = toDate?.value || '';

    const rows = getAllRows();
    const filtered = rows.filter(row => {
      const withinText = !q || row.search_blob.includes(q) || String(row.grand_total).includes(q) || String(row.created_at || '').toLowerCase().includes(q);
      const rowStatus = `${row.order_status} ${row.payment_status}`.toLowerCase();
      const withinStatus = status === 'all' || rowStatus.includes(status);
      const withinType = type === 'all' || (type === 'orders' ? true : true);
      const rowDate = row.created_key;
      const withinFrom = !from || (rowDate && rowDate >= from);
      const withinTo = !to || (rowDate && rowDate <= to);
      return withinText && withinStatus && withinType && withinFrom && withinTo;
    });

    state.filteredOrders = filtered.map(r => r.order);
    state.filteredRows = filtered;
    return filtered;
  }

  function getGraphSeriesFromFilteredRows(filteredRows) {
    const { start, end } = getGraphWindowRange();
    const filtered = filteredRows.filter(r => {
      if (!r.created_at) return false;
      const d = new Date(r.created_at);
      if (Number.isNaN(d.getTime())) return false;
      if (start && d < start) return false;
      if (end && d > end) return false;
      return true;
    });

    const mode = graphRange.value;
    const buckets = new Map();
    const labels = [];

    const addBucket = (key, label) => {
      if (!buckets.has(key)) buckets.set(key, { label, amount: 0, count: 0 });
      labels.push(key);
    };

    if (mode === 'year') {
      const months = [];
      const cursor = new Date(end || new Date());
      cursor.setMonth(cursor.getMonth() - 11);
      cursor.setDate(1);
      for (let i = 0; i < 12; i++) {
        const d = new Date(cursor);
        d.setMonth(cursor.getMonth() + i);
        const key = `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}`;
        const label = d.toLocaleDateString('en-GB', { month:'short', year:'2-digit' });
        months.push({ key, label });
        buckets.set(key, { label, amount: 0, count: 0 });
      }
      filtered.forEach(r => {
        const d = new Date(r.created_at);
        const key = `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}`;
        if (buckets.has(key)) buckets.get(key).amount += Number(r.grand_total || 0);
      });
      return months.map(m => ({ label: m.label, amount: buckets.get(m.key)?.amount || 0 }));
    }

    if (mode === '1w' || mode === '2w' || mode === '3w' || mode === 'recent') {
      const days = [];
      const span = mode === '1w' ? 7 : mode === '2w' ? 14 : mode === '3w' ? 21 : 14;
      const base = new Date(end || new Date());
      base.setHours(0,0,0,0);
      for (let i = span - 1; i >= 0; i--) {
        const d = new Date(base);
        d.setDate(d.getDate() - i);
        const key = d.toISOString().slice(0,10);
        const label = d.toLocaleDateString('en-GB', { day:'2-digit', month:'short' });
        days.push({ key, label });
        buckets.set(key, { label, amount: 0, count: 0 });
      }
      filtered.forEach(r => {
        const key = toDateKey(r.created_at);
        if (buckets.has(key)) buckets.get(key).amount += Number(r.grand_total || 0);
      });
      return days.map(d => ({ label: d.label, amount: buckets.get(d.key)?.amount || 0 }));
    }

    const monthKeys = [];
    const cursor = new Date(end || new Date());
    cursor.setDate(1);
    for (let i = 5; i >= 0; i--) {
      const d = new Date(cursor);
      d.setMonth(d.getMonth() - i);
      const key = `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}`;
      const label = d.toLocaleDateString('en-GB', { month:'short', year:'numeric' });
      monthKeys.push({ key, label });
      buckets.set(key, { label, amount: 0, count: 0 });
    }
    filtered.forEach(r => {
      const d = new Date(r.created_at);
      const key = `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}`;
      if (buckets.has(key)) buckets.get(key).amount += Number(r.grand_total || 0);
    });
    return monthKeys.map(m => ({ label: m.label, amount: buckets.get(m.key)?.amount || 0 }));
  }

  function renderSummaryFromFiltered(filteredRows) {
    const total = filteredRows.reduce((sum, r) => sum + Number(r.grand_total || 0), 0);
    const paidCount = filteredRows.filter(r => String(r.payment_status || '').toLowerCase().includes('paid') || String(r.order_status || '').toLowerCase().includes('completed')).length;
    const pendingCount = filteredRows.filter(r => String(r.payment_status || '').toLowerCase().includes('pending') || String(r.order_status || '').toLowerCase().includes('pending')).length;
    const refundCount = filteredRows.filter(r => String(r.payment_status || '').toLowerCase().includes('refund')).reduce((sum, r) => sum + Number(r.grand_total || 0), 0);
    const monthSpent = filteredRows.filter(r => {
      const d = new Date(r.created_at); if (Number.isNaN(d.getTime())) return false;
      const now = new Date(); return d.getMonth() === now.getMonth() && d.getFullYear() === now.getFullYear();
    }).reduce((sum, r) => sum + Number(r.grand_total || 0), 0);

    if (totalSpentValue) totalSpentValue.textContent = money(total, report.currency);
    if (totalOrdersPaidValue) totalOrdersPaidValue.textContent = String(paidCount);
    if (pendingPaymentsValue) pendingPaymentsValue.textContent = String(pendingCount);
    if (refundTotalValue) refundTotalValue.textContent = money(refundCount, report.currency);
    if (thisMonthSpentValue) thisMonthSpentValue.textContent = money(monthSpent, report.currency);
  }

  function getFilterSummaryText() {
    const q = String(searchQuery?.value || '').trim();
    const fd = fromDate?.value || '';
    const td = toDate?.value || '';
    const status = statusFilter?.value || 'all';
    const type = typeFilter?.value || 'all';
    const parts = [];
    if (q) parts.push(`Search: ${q}`);
    if (fd || td) parts.push(formatRangeLabel(fd ? formatDate(fd) : '', td ? formatDate(td) : ''));
    if (status !== 'all') parts.push(`Status: ${status}`);
    if (type !== 'all') parts.push(`Type: ${type}`);
    return parts.length ? parts.join(' • ') : 'Showing all billing history.';
  }

  function updateAppliedLabels() {
    const summary = getFilterSummaryText();
    if (filterSummaryText) filterSummaryText.textContent = summary;
    if (appliedFilterLabel) appliedFilterLabel.textContent = summary.length > 42 ? summary.slice(0, 42) + '…' : summary;
    const fromText = fromDate?.value ? formatDate(fromDate.value) : '';
    const toText = toDate?.value ? formatDate(toDate.value) : '';
    if (rangeLabelText) rangeLabelText.textContent = formatRangeLabel(fromText, toText);
  }

  function renderResults() {
    const filtered = filterRowsByState();
    updateAppliedLabels();
    if (matchedCountLabel) matchedCountLabel.textContent = String(filtered.length);
    if (visibleCountLabel) visibleCountLabel.textContent = String(filtered.length);

    renderSummaryFromFiltered(filtered);

    const graphSeries = getGraphSeriesFromFilteredRows(filtered);
    updateTrendChart(graphSeries);

    if (!billingResultsEmpty || !billingResultsTable || !billingResultsBody) return;

    if (!filtered.length) {
      billingResultsEmpty.classList.remove('d-none');
      billingResultsTable.classList.add('d-none');
      billingResultsEmpty.innerHTML = '<div class="billing-results-empty">No records match the current filter.</div>';
      state.selectedExport = null;
      selectedResult = null;
      exportState.results = [];
      updateExportPreview();
      updateExportButtons();
      return;
    }

    billingResultsEmpty.classList.add('d-none');
    billingResultsTable.classList.remove('d-none');
    billingResultsBody.innerHTML = filtered.map((row, idx) => `
      <tr data-row-index="${idx}">
        <td>
          <div><a class="order-link" href="/customer/u/orders/${encodeURIComponent(row.order_number || row.tracking_id || '')}">${escapeHtml(row.order_number || row.tracking_id || '—')}</a></div>
          <div class="muted">Tracking: ${escapeHtml(row.tracking_id || '—')}</div>
        </td>
        <td>
          <div>${escapeHtml(row.product_id || '—')}</div>
          <div class="muted">${escapeHtml(row.product_name || '—')}</div>
        </td>
        <td>${row.created_at ? escapeHtml(formatDateTime(row.created_at)) : 'Not available'}</td>
        <td><div>${escapeHtml(row.order_status || '—')}</div><div class="muted">${escapeHtml(row.payment_status || '—')}</div></td>
        <td class="amount">${escapeHtml(money(row.grand_total || 0, row.currency || report.currency))}</td>
        <td>${escapeHtml(row.payment_method || '—')}</td>
        <td>
          <div class="result-actions">
            <button type="button" class="btn btn-sm btn-outline-dark js-select-row" data-index="${idx}">Select</button>
            <button type="button" class="btn btn-sm btn-outline-primary js-export-row" data-index="${idx}">Export</button>
          </div>
        </td>
      </tr>
    `).join('');

    const currentFilterOrders = filtered.map(r => r.order);
    exportState = { mode: 'all_orders', results: currentFilterOrders, label: 'Visible Results', details: getFilterSummaryText() };
    updateExportPreview();
    updateExportButtons();
  }

  function updateExportButtons() {
    const hasMatch = Array.isArray(exportState.results) && exportState.results.length > 0;
    [exportPdfBtn, exportPdfBtn2, exportPdfDrawerBtn, exportVisibleOrdersBtn, exportVisibleProductsBtn, exportSingleSelectionBtn].forEach(btn => {
      if (!btn) return;
      btn.disabled = !hasMatch;
      btn.classList.toggle('export-disabled', !hasMatch);
    });
  }

  function updateExportPreview() {
    if (!exportPreviewCount || !exportPreviewList) return;
    const count = Array.isArray(exportState.results) ? exportState.results.length : 0;
    exportPreviewCount.textContent = `${count} result(s)`;
    if (!count) {
      exportPreviewList.innerHTML = '<div class="export-preview-item"><div class="k">No match</div><div class="v">No record found for the selected export condition.</div></div>';
      return;
    }
    const first = exportState.results[0];
    const items = [
      ['Export Type', escapeHtml(exportState.label)],
      ['Customer ID', escapeHtml(String(report.customerId))],
      ['Customer Name', escapeHtml(report.userName)],
      [exportState.mode === 'per_product' ? 'Product ID' : 'Order ID', escapeHtml(String(first.product_id || first.order_number || first.tracking_id || '—'))],
      [exportState.mode === 'per_product' ? 'Product Name' : 'Tracking ID', escapeHtml(String(first.product_name || first.tracking_id || '—'))],
      ['Generated Date', escapeHtml(new Date().toLocaleString('en-GB'))],
      ['Currency', escapeHtml(report.currency)]
    ];
    exportPreviewList.innerHTML = items.map(([k,v]) => `<div class="export-preview-item"><div class="k">${k}</div><div class="v">${v}</div></div>`).join('');
  }

  function setSelectedRow(index) {
    const row = state.filteredRows[index];
    selectedResult = row ? row.order : null;
    state.selectedExport = row ? row.order : null;
    if (!row) return;
    showToast(`Selected ${row.order_number || row.tracking_id || 'record'} for export`);
  }

  function applyLiveFilters() {
    renderResults();
    syncExportDrawerWithLiveFilters();
  }

  function syncExportDrawerWithLiveFilters() {
    if (!exportFromDate || !exportToDate) return;
    exportFromDate.value = fromDate?.value || exportFromDate.value || '';
    exportToDate.value = toDate?.value || exportToDate.value || '';
  }

  function getActiveOrdersList() {
    return Array.isArray(report.allOrders) && report.allOrders.length ? report.allOrders : (Array.isArray(report.recentOrders) ? report.recentOrders : []);
  }

  function applyExportFilter() {
    const mode = exportMode?.value || 'all_orders';
    const orders = getActiveOrdersList();
    let results = [];
    let label = 'All Orders';
    let details = '';

    if (mode === 'all_orders') {
      results = orders.slice();
      label = 'All Orders';
      details = `All available orders (${results.length})`;
    } else if (mode === 'recent_orders') {
      const limit = Math.max(1, Math.min(100, Number(recentLimit?.value || 10)));
      results = orders.slice(0, limit);
      label = 'Recent Orders';
      details = `Latest ${limit} order(s)`;
    } else if (mode === 'per_order') {
      const query = String(orderQuery?.value || '').trim().toLowerCase();
      if (query) {
        results = orders.filter(order => {
          const orderNo = String(order.order_number || '').toLowerCase();
          const trackId = String(order.tracking_id || '').toLowerCase();
          return orderNo === query || trackId === query || orderNo.includes(query) || trackId.includes(query);
        });
      }
      label = 'Per Order';
      details = query ? `Matching order: ${query}` : 'No order query entered';
    } else if (mode === 'per_product') {
      const query = String(productQuery?.value || '').trim().toLowerCase();
      const matches = [];
      if (query) {
        orders.forEach(order => {
          const productIds = getOrderProductIds(order).map(v => String(v).toLowerCase());
          const productNames = getOrderProductNames(order).map(v => String(v).toLowerCase());
          const hit = productIds.some(v => v === query || v.includes(query)) || productNames.some(v => v.includes(query));
          if (hit) getProductRowsFromOrder(order).forEach(row => matches.push(row));
        });
      }
      results = matches;
      label = 'Per Product';
      details = query ? `Matching product: ${query}` : 'No product query entered';
    } else if (mode === 'date_range') {
      const f = String(exportFromDate?.value || '').trim();
      const t = String(exportToDate?.value || '').trim();
      results = orders.filter(order => {
        const d = toDateKey(order.created_at);
        return (!f || d >= f) && (!t || d <= t);
      });
      label = 'Date Range';
      details = formatRangeLabel(f ? formatDate(f) : '', t ? formatDate(t) : '');
    }

    exportState = { mode, results, label, details };
    updateExportPreview();
    updateExportButtons();
  }

  function updateExportDrawerLabels() {
    const mode = exportMode?.value || 'all_orders';
    recentLimitWrap.style.display = mode === 'recent_orders' ? 'block' : 'none';
    orderQueryWrap.style.display = mode === 'per_order' ? 'block' : 'none';
    productQueryWrap.style.display = mode === 'per_product' ? 'block' : 'none';
    dateRangeWrap.style.display = mode === 'date_range' ? 'block' : 'none';
  }

  function openExportDrawer() {
    exportDrawer?.classList.add('show');
    exportDrawerOverlay?.classList.add('show');
    document.body.style.overflow = 'hidden';
  }

  function closeExportDrawer() {
    exportDrawer?.classList.remove('show');
    exportDrawerOverlay?.classList.remove('show');
    document.body.style.overflow = '';
  }

  function buildRowsForAllOrRecent(results) {
    return results.map(order => ([
      order.order_number || order.tracking_id || '—',
      (getOrderProductIds(order)[0] || '—'),
      order.created_at ? formatDateTime(order.created_at) : 'Not available',
      order.order_status || '—',
      order.payment_status || '—',
      money(order.grand_total || 0, order.currency || report.currency),
      order.payment_method || '—'
    ]));
  }

  function buildRowsForPerOrder(order) {
    const productIds = getOrderProductIds(order).join(', ') || '—';
    const productNames = getOrderProductNames(order).join(', ') || '—';
    return [
      ['Company', 'JOOD'],
      ['Customer ID', String(report.customerId)],
      ['Customer Name', report.userName],
      ['Generated Date', new Date().toLocaleString('en-GB')],
      ['Currency', report.currency],
      ['Order ID', order.order_number || '—'],
      ['Tracking ID', order.tracking_id || '—'],
      ['Product ID(s)', productIds],
      ['Product Name(s)', productNames],
      ['Order Date', order.created_at ? formatDateTime(order.created_at) : 'Not available'],
      ['Order Status', order.order_status || '—'],
      ['Payment Status', order.payment_status || '—'],
      ['Payment Method', order.payment_method || '—'],
      ['Grand Total', money(order.grand_total || 0, order.currency || report.currency)],
      ['Payment Reference', order.payment_reference || '—']
    ];
  }

  function buildRowsForPerProduct(results) {
    return results.map(row => ([
      row.order_number || '—',
      row.tracking_id || '—',
      row.product_id || '—',
      row.product_name || '—',
      row.quantity ?? 1,
      money(row.amount || 0, row.currency || report.currency),
      row.created_at ? formatDateTime(row.created_at) : 'Not available'
    ]));
  }

  function exportPdf(modeOverride, rowsOverride, selectedOrderOverride) {
    if (!window.jspdf || !window.jspdf.jsPDF) { showToast('PDF library is not loaded'); return; }

    const mode = modeOverride || exportState.mode || 'all_orders';
    const results = Array.isArray(rowsOverride) ? rowsOverride : (Array.isArray(exportState.results) ? exportState.results : []);
    if (!results.length) { showToast('No matching data found for export'); return; }

    const doc = new window.jspdf.jsPDF({ orientation: 'p', unit: 'pt', format: 'a4' });
    const pageWidth = doc.internal.pageSize.getWidth();
    const margin = 36;
    const right = pageWidth - margin;

    const titleMap = {
      all_orders: 'All Orders Export',
      recent_orders: 'Recent Orders Export',
      per_order: 'Per Order Export',
      per_product: 'Per Product Export',
      date_range: 'Date Range Export'
    };

    const filterLabelMap = {
      all_orders: 'All available orders',
      recent_orders: `Recent orders (${results.length})`,
      per_order: exportState.details || 'Matching order',
      per_product: exportState.details || 'Matching product',
      date_range: exportState.details || 'Date range'
    };

    doc.setFont('helvetica', 'bold'); doc.setFontSize(20); doc.text('JOOD Billing', margin, 46);
    doc.setFont('helvetica', 'bold'); doc.setFontSize(13); doc.text(titleMap[mode] || 'Billing Export', margin, 66);
    doc.setFont('helvetica', 'normal'); doc.setFontSize(10);
    doc.text(`Company: JOOD`, margin, 86);
    doc.text(`Customer ID: ${report.customerId}`, margin, 100);
    doc.text(`Customer Name: ${report.userName}`, margin, 114);
    doc.text(`Generated Date: ${new Date().toLocaleString('en-GB')}`, margin, 128);
    doc.text(`Currency: ${report.currency}`, margin, 142);
    doc.text(`Filter: ${filterLabelMap[mode]}`, margin, 156);
    doc.setDrawColor(229, 231, 235); doc.line(margin, 170, right, 170);

    if (mode === 'per_order') {
      const order = selectedOrderOverride || results[0] || {};
      doc.autoTable({ startY: 186, head: [['Field', 'Value']], body: buildRowsForPerOrder(order), theme: 'plain', styles: { font: 'helvetica', fontSize: 10, cellPadding: 6, textColor: [15, 23, 42] }, headStyles: { fillColor: [248, 250, 252], textColor: [15, 23, 42], fontStyle: 'bold' }, columnStyles: { 0: { cellWidth: 160 }, 1: { cellWidth: 330 } } });
      return doc.save(`JOOD_Billing_Per_Order_${String(order.order_number || order.tracking_id || 'Export').replace(/\s+/g, '_')}.pdf`);
    }

    if (mode === 'per_product') {
      doc.autoTable({ startY: 186, head: [['Order ID', 'Tracking ID', 'Product ID', 'Product Name', 'Qty', 'Amount', 'Date']], body: buildRowsForPerProduct(results), theme: 'grid', styles: { font: 'helvetica', fontSize: 8.6, cellPadding: 5, textColor: [15, 23, 42] }, headStyles: { fillColor: [248, 250, 252], textColor: [15, 23, 42], fontStyle: 'bold' } });
      return doc.save(`JOOD_Billing_Per_Product_${report.userName.replace(/\s+/g, '_')}.pdf`);
    }

    doc.autoTable({ startY: 186, head: [['Order ID', 'Product ID', 'Date', 'Status', 'Payment Status', 'Amount', 'Method']], body: buildRowsForAllOrRecent(results), theme: 'grid', styles: { font: 'helvetica', fontSize: 8.5, cellPadding: 5, textColor: [15, 23, 42] }, headStyles: { fillColor: [248, 250, 252], textColor: [15, 23, 42], fontStyle: 'bold' } });
    const fileName = mode === 'recent_orders' ? `JOOD_Billing_Recent_Orders_${report.userName.replace(/\s+/g, '_')}.pdf` : (mode === 'date_range' ? `JOOD_Billing_Date_Range_${report.userName.replace(/\s+/g, '_')}.pdf` : `JOOD_Billing_All_Orders_${report.userName.replace(/\s+/g, '_')}.pdf`);
    doc.save(fileName);
  }

  function updateTrendChart(series) {
    if (!chartCanvas || typeof Chart === 'undefined') return;
    const labels = series.map(x => x.label || '');
    const values = series.map(x => Number(x.amount || 0));
    const ctx = chartCanvas.getContext('2d');
    if (chartTrend) chartTrend.destroy();
    chartTrend = new Chart(ctx, {
      type: 'line',
      data: { labels, datasets: [{ label: 'Billing Amount', data: values, borderWidth: 3, tension: .35, fill: true, pointRadius: 3, pointHoverRadius: 5, borderColor: '#0f172a', backgroundColor: 'rgba(15,23,42,.08)' }] },
      options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false }, tooltip: { callbacks: { label: (ctx) => ` ${ctx.parsed.y} ${report.currency}` } } }, scales: { x: { grid: { color: 'rgba(148,163,184,.18)' }, ticks: { color: '#64748b' } }, y: { beginAtZero: true, grid: { color: 'rgba(148,163,184,.18)' }, ticks: { color: '#64748b' } } } }
    });
  }

  function updateMixChart() {
    if (!mixCanvas || typeof Chart === 'undefined') return;
    const ctx = mixCanvas.getContext('2d');
    if (chartMix) chartMix.destroy();
    chartMix = new Chart(ctx, {
      type: 'doughnut',
      data: { labels: <%- JSON.stringify(methodLabels) %>, datasets: [{ data: <%- JSON.stringify(methodValues) %>, borderWidth: 0, hoverOffset: 4 }] },
      options: { responsive: true, maintainAspectRatio: false, cutout: '68%', plugins: { legend: { position: 'bottom', labels: { usePointStyle: true, boxWidth: 8, color: '#334155' } }, tooltip: { callbacks: { label: (ctx) => ` ${ctx.label}: ${ctx.parsed} ${report.currency}` } } } }
    });
  }

  async function refreshLiveData(silent) {
    const endpoints = [
      '/customer/u/account/billing/live',
      '/customer/u/account/billing/summary',
      '/customer/u/account/billing/data'
    ];

    for (const url of endpoints) {
      try {
        const res = await fetch(url, { headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }, cache: 'no-store' });
        if (!res.ok) continue;
        const data = await res.json().catch(() => null);
        if (!data) continue;

        if (Array.isArray(data.allOrders)) state.data.allOrders = data.allOrders;
        if (Array.isArray(data.recentOrders)) state.data.recentOrders = data.recentOrders;
        if (Array.isArray(data.monthlySeries)) state.data.monthlySeries = data.monthlySeries;
        if (Array.isArray(data.paymentMethodStats)) state.data.paymentMethodStats = data.paymentMethodStats;
        if (data.user) applyServerUser(data.user);
        if (data.summary) {
          if (typeof data.summary.totalSpent !== 'undefined' && totalSpentValue) totalSpentValue.textContent = money(data.summary.totalSpent, report.currency);
          if (typeof data.summary.totalOrdersPaid !== 'undefined' && totalOrdersPaidValue) totalOrdersPaidValue.textContent = String(data.summary.totalOrdersPaid);
          if (typeof data.summary.pendingPayments !== 'undefined' && pendingPaymentsValue) pendingPaymentsValue.textContent = String(data.summary.pendingPayments);
          if (typeof data.summary.refundTotal !== 'undefined' && refundTotalValue) refundTotalValue.textContent = money(data.summary.refundTotal, report.currency);
          if (typeof data.summary.thisMonthSpent !== 'undefined' && thisMonthSpentValue) thisMonthSpentValue.textContent = money(data.summary.thisMonthSpent, report.currency);
        }
        state.lastRefreshAt = new Date();
        if (lastRefreshLabel) lastRefreshLabel.textContent = state.lastRefreshAt.toLocaleTimeString('en-GB', { hour:'2-digit', minute:'2-digit', second:'2-digit' });
        if (!silent) showToast('Billing data refreshed');
        applyLiveFilters();
        return;
      } catch (err) {
        // ignore and fallback to current data
      }
    }
    state.lastRefreshAt = new Date();
    if (lastRefreshLabel) lastRefreshLabel.textContent = state.lastRefreshAt.toLocaleTimeString('en-GB', { hour:'2-digit', minute:'2-digit', second:'2-digit' });
    applyLiveFilters();
  }

  function scheduleRefresh() {
    clearInterval(refreshTimer);
    refreshTimer = setInterval(() => refreshLiveData(true), 20000);
  }

  function applyServerUser(user) {
    if (!user) return;
    if (topbarUserName && user.full_name) topbarUserName.textContent = user.full_name;
    if (lastUpdatedValue && user.updated_at) lastUpdatedValue.textContent = formatDateTime(user.updated_at);
    if (lastLoginValue && user.last_login_at) lastLoginValue.textContent = formatDateTime(user.last_login_at);
    if (lastAttemptValueRow && user.last_attempt_time) lastAttemptValueRow.textContent = formatDateTime(user.last_attempt_time);
  }

  async function saveBilling() {
    if (isSaving) return;
    const payload = getFormDataObject();
    const payloadKey = JSON.stringify(payload);
    if (payloadKey === lastPayload) return;

    isSaving = true;
    setSavingState('saving', 'Saving changes...');
    try {
      const body = new URLSearchParams();
      Object.entries(payload).forEach(([k, v]) => body.append(k, v));
      const res = await fetch(form.action, { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8' }, body: body.toString() });
      const data = await res.json().catch(() => ({}));
      if (!res.ok || !data.ok) throw new Error(data.message || data.error || 'Save failed');
      lastPayload = payloadKey;
      setSavingState('saved', 'Saved');
      showToast(data.message || 'Billing updated successfully');
      applyServerUser(data.user || {});
    } catch (err) {
      console.error(err);
      setSavingState('error', 'Save failed');
      showToast(err.message || 'Save failed');
    } finally {
      isSaving = false;
    }
  }

  function scheduleSave() {
    setSavingState('saving', 'Typing...');
    clearTimeout(timer);
    timer = setTimeout(saveBilling, 850);
  }

  inputs.forEach(input => { input.addEventListener('input', scheduleSave); input.addEventListener('change', scheduleSave); });

  otpButtons.forEach(btn => {
    btn.addEventListener('click', async () => {
      const channel = btn.dataset.channel || 'email';
      const purpose = btn.dataset.purpose || 'billing_update';
      btn.disabled = true;
      try {
        const body = new URLSearchParams();
        body.append('channel', channel);
        body.append('purpose', purpose);
        const res = await fetch('/customer/u/account/billing/otp/request', { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8' }, body: body.toString() });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.ok) throw new Error(data.message || 'OTP request failed');
        showToast(data.message || 'OTP sent');
      } catch (err) {
        console.error(err);
        showToast(err.message || 'OTP request failed');
      } finally { btn.disabled = false; }
    });
  });

  toggleBtn.addEventListener('click', () => {
    if (isMobile()) {
      const isOpen = sidebar.classList.contains('open');
      if (isOpen) { sidebar.classList.remove('open'); backdrop?.classList.remove('show'); document.body.style.overflow = ''; }
      else { sidebar.classList.add('open'); backdrop?.classList.add('show'); document.body.style.overflow = 'hidden'; }
      return;
    }
    const expanded = layout.classList.toggle('sidebar-expanded');
    layout.classList.toggle('sidebar-collapsed', !expanded);
  });
  backdrop?.addEventListener('click', closeMobileSidebar);
  window.addEventListener('resize', applyBillingSidebarMode);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeMobileSidebar(); });

  function wireFiltering() {
    const inputsToWatch = [searchQuery, fromDate, toDate, statusFilter, typeFilter];
    inputsToWatch.forEach(el => el?.addEventListener('input', applyLiveFilters));
    inputsToWatch.forEach(el => el?.addEventListener('change', applyLiveFilters));

    graphRange?.addEventListener('change', () => {
      if (graphRangeLabel) graphRangeLabel.textContent = humanGraphLabel(graphRange.value);
      applyLiveFilters();
    });
    graphFromDate?.addEventListener('change', applyLiveFilters);
    graphToDate?.addEventListener('change', applyLiveFilters);
    refreshLiveBtn?.addEventListener('click', () => refreshLiveData(false));

    clearLiveFiltersBtn?.addEventListener('click', () => {
      if (searchQuery) searchQuery.value = '';
      if (fromDate) fromDate.value = '';
      if (toDate) toDate.value = '';
      if (statusFilter) statusFilter.value = 'all';
      if (typeFilter) typeFilter.value = 'all';
      applyLiveFilters();
    });

    billingResultsBody?.addEventListener('click', (e) => {
      const rowBtn = e.target.closest('.js-select-row');
      const exportBtn = e.target.closest('.js-export-row');
      if (rowBtn) {
        setSelectedRow(Number(rowBtn.dataset.index));
        return;
      }
      if (exportBtn) {
        const idx = Number(exportBtn.dataset.index);
        const row = state.filteredRows[idx];
        if (!row) return;
        exportPdf('per_order', [row.order], row.order);
      }
    });

    exportVisibleOrdersBtn?.addEventListener('click', () => exportPdf('all_orders', state.filteredRows.map(r => r.order)));
    exportVisibleProductsBtn?.addEventListener('click', () => {
      const productRows = state.filteredRows.flatMap(r => getProductRowsFromOrder(r.order));
      if (!productRows.length) return showToast('No product rows available for export');
      exportState = { mode: 'per_product', results: productRows, label: 'Visible Products', details: getFilterSummaryText() };
      updateExportPreview();
      updateExportButtons();
      exportPdf('per_product', productRows);
    });
    exportSingleSelectionBtn?.addEventListener('click', () => {
      if (!selectedResult && state.filteredRows[0]) selectedResult = state.filteredRows[0].order;
      if (!selectedResult) return showToast('Select one record first');
      exportPdf('per_order', [selectedResult], selectedResult);
    });
  }

  function wireExportButtons() {
    [exportPdfBtn, exportPdfBtn2, exportPdfDrawerBtn].forEach(btn => btn?.addEventListener('click', () => {
      const mode = exportState.mode || 'all_orders';
      if (mode === 'per_product') {
        exportPdf('per_product', exportState.results);
      } else if (mode === 'per_order' && state.selectedExport) {
        exportPdf('per_order', [state.selectedExport], state.selectedExport);
      } else {
        exportPdf(mode, exportState.results);
      }
    }));
    [openExportDrawerBtn, openExportDrawerBtn2].forEach(btn => btn?.addEventListener('click', openExportDrawer));
    closeExportDrawerBtn?.addEventListener('click', closeExportDrawer);
    exportDrawerOverlay?.addEventListener('click', closeExportDrawer);
    applyExportFilterBtn?.addEventListener('click', applyExportFilter);

    exportMode?.addEventListener('change', () => { updateExportDrawerLabels(); applyExportFilter(); });
    recentLimit?.addEventListener('input', applyExportFilter);
    orderQuery?.addEventListener('input', applyExportFilter);
    productQuery?.addEventListener('input', applyExportFilter);
    exportFromDate?.addEventListener('change', applyExportFilter);
    exportToDate?.addEventListener('change', applyExportFilter);
  }

  function init() {
    startClock();
    scheduleRefresh();
    wireFiltering();
    wireExportButtons();
    updateExportDrawerLabels(); 
    if (graphRangeLabel) graphRangeLabel.textContent = humanGraphLabel(graphRange?.value || 'month');
    lastPayload = JSON.stringify(getFormDataObject());
    setSavingState('saved', 'All changes saved');
    applyServerUser(<%- JSON.stringify(user || {}) %>);
    applyBillingSidebarMode();
    updateMixChart();
    applyLiveFilters();
    refreshLiveData(true);
  }

  init();
})();
</script>
</body>
</html>
