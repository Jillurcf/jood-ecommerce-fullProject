<body class="billing-page">
<%
  const safeDate = (v) => {
    const d = new Date(v);
    return Number.isNaN(d.getTime()) ? null : d;
  };
  const fmtDateTime = (v) => {
    const d = safeDate(v);
    return d ? d.toLocaleString('en-GB', { day:'2-digit', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit' }) : 'Not available';
  };
  const fmtDate = (v) => {
    const d = safeDate(v);
    return d ? d.toLocaleDateString('en-GB', { day:'2-digit', month:'short', year:'numeric' }) : 'Not available';
  };
  const fmtDayKey = (v) => {
    const d = safeDate(v);
    return d ? d.toISOString().slice(0, 10) : '';
  };

  const summary = typeof paymentSummary !== 'undefined' && paymentSummary ? paymentSummary : {};
  const totalSpent = Number(summary.totalSpent || 0);
  const totalOrdersPaid = Number(summary.totalOrdersPaid || 0);
  const pendingPayments = Number(summary.pendingPayments || 0);
  const thisMonthSpent = Number(summary.thisMonthSpent || 0);
  const refundTotal = Number(summary.refundTotal || 0);
  const lastOrder = summary.lastOrder || null;
  const recentOrders = Array.isArray(summary.recentOrders) ? summary.recentOrders : [];
  const monthlySeries = Array.isArray(summary.monthlySeries) ? summary.monthlySeries : [];
  const paymentMethodStats = Array.isArray(summary.paymentMethodStats) ? summary.paymentMethodStats : [];

  const allOrders = Array.isArray(summary.allOrders)
    ? summary.allOrders
    : (Array.isArray(summary.orders) ? summary.orders : recentOrders);

  const totalOrdersLabel = totalOrdersPaid > 0 ? totalOrdersPaid : 0;
  const lastOrderLabel = lastOrder?.order_number || lastOrder?.tracking_id || 'Not available';
  const lastOrderDateLabel = lastOrder?.created_at ? fmtDateTime(lastOrder.created_at) : 'Not available';
  const lastOrderStatus = lastOrder?.order_status || 'Not available';
  const lastPaymentStatus = lastOrder?.payment_status || 'Not available';
  const currency = user?.currency || lastOrder?.currency || 'AED';
  const chartLabels = monthlySeries.length ? monthlySeries.map(x => x.label || x.month || '') : ['Jan','Feb','Mar','Apr','May','Jun'];
  const chartValues = monthlySeries.length ? monthlySeries.map(x => Number(x.amount || x.total || 0)) : [0,0,0,0,0,0];
  const methodLabels = paymentMethodStats.length ? paymentMethodStats.map(x => x.label || x.method || 'Other') : ['Paid', 'Pending'];
  const methodValues = paymentMethodStats.length ? paymentMethodStats.map(x => Number(x.value || x.amount || 0)) : [totalSpent, pendingPayments];
  const userName = user?.full_name || user?.name || 'Customer';
  const customerId = user?.user_id || user?.id || '—';
%>



<div class="account-layout sidebar-collapsed" id="accountLayout">
