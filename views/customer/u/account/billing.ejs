<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <title>My Billing — JOOD | Quality Goods & Products</title>
  <meta name="description" content="Manage your JOOD billing details, review payment summary, and control account payment access securely." />
  <meta name="robots" content="noindex, nofollow" />

  <link rel="shortcut icon" href="/customer/images/web-img-vid/favicon.png" type="image/x-icon">

  <meta property="og:type" content="website" />
  <meta property="og:title" content="My Billing — JOOD Account Dashboard" />
  <meta property="og:description" content="Update billing details, review payment analytics, and manage account access securely." />
  <meta property="og:url" content="https://jood.com/customer/u/account/billing" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="My Billing — JOOD" />
  <meta name="twitter:description" content="Manage your JOOD billing details and payment access." />

  <link rel="stylesheet" href="/customer/css/font-awesome.min.css" />
  <link rel="stylesheet" href="/customer/css/bootstrap.min.css" />
  <link rel="stylesheet" href="/customer/css/account.css" />
  <link rel="stylesheet" href="/customer/css/style.css" />
  <link rel="stylesheet" href="/customer/css/responsive.css" />

  <script src="/customer/js/vendor/modernizr-2.8.3.min.js"></script>
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.4/jspdf.plugin.autotable.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

<style>
  :root {
    --bg: #ffffff;
    --card: #ffffff;
    --border: #e5eaf3;
    --border-strong: #cfd8e3;
    --text: #0f172a;
    --muted: #64748b;
    --primary: #f59e0b;
    --primary-hover: #d97706;
    --primary-soft: rgba(245, 158, 11, 0.12);
    --shadow: 0 12px 30px rgba(15, 23, 42, 0.08);
    --radius: 22px;
    --radius-sm: 14px;
    --sidebar-wide: 280px;
    --sidebar-collapsed: 78px;
    --topbar-height: 68px;
    --green-bg: #ecfdf5;
    --blue-bg: #eff6ff;
    --amber-bg: #fffbeb;
    --red-bg: #fef2f2;
    --success: #16a34a;
    --danger: #dc2626;
    --line-strong: var(--border-strong);
  }

  * {
    box-sizing: border-box;
    min-width: 0;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    width: 100%;
    max-width: 100%;
    min-height: 100%;
    overflow-x: hidden;
    background: var(--bg);
  }

  body {
    font-family: system-ui, Arial, sans-serif;
    color: var(--text);
    -webkit-text-size-adjust: 100%;
    text-rendering: optimizeLegibility;
    overflow: hidden;
  }

  a {
    text-decoration: none;
    color: inherit;
  }

  img,
  svg,
  canvas,
  video {
    max-width: 100%;
    height: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }

  .billing-page {
    background: var(--bg);
    color: var(--text);
  }

  .account-layout {
    width: 100%;
    max-width: 100%;
    min-height: 100vh;
    display: block;
    position: relative;
    background: #fff;
    overflow: hidden;
  }

  .account-sidebar {
    position: fixed;
    top: 0;
    left: 0;
    width: var(--sidebar-collapsed);
    height: 100vh;
    background: var(--card);
    border-right: 1px solid var(--border);
    z-index: 1040;
    overflow-x: hidden;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: transparent transparent;
    transition: width 0.25s ease, transform 0.25s ease;
  }

  .account-sidebar::-webkit-scrollbar {
    width: 6px;
  }

  .account-sidebar::-webkit-scrollbar-thumb {
    background: transparent;
    border-radius: 999px;
  }

  .account-sidebar:hover::-webkit-scrollbar-thumb {
    background: rgba(17, 24, 39, 0.25);
  }

  .account-sidebar-brand {
    padding: 14px 16px 8px;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .account-brand-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    max-width: 100%;
  }

  .account-logo {
    display: block;
    width: 100%;
    max-width: 150px;
    height: auto;
  }

  .account-sidebar-top {
    padding: 18px 16px;
    text-align: center;
    border-bottom: 1px solid var(--border);
  }

  .account-profile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .account-avatar {
    width: 45px;
    height: 45px;
    border-radius: 50%;
    overflow: hidden;
    background: #f3f4f6;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
  }

  .account-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .avatar-initials {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: #2d6cdf;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 15px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .account-name {
    font-weight: 700;
    font-size: 15px;
    line-height: 1.3;
    margin: 0;
    word-break: break-word;
  }

  .account-email {
    font-size: 13px;
    color: var(--muted);
    margin-top: 3px;
    word-break: break-word;
  }

  .account-nav {
    padding: 12px;
  }

  .account-nav-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border-radius: 12px;
    text-decoration: none;
    color: var(--text);
    font-weight: 600;
    transition: background 0.2s ease, transform 0.2s ease, color 0.2s ease;
    margin-bottom: 4px;
    min-width: 0;
  }

  .account-nav-link:hover {
    background: rgba(245, 158, 11, 0.10);
    transform: translateX(2px);
    color: #000;
  }

  .account-nav-link.active {
    background: var(--primary-soft);
    color: var(--text);
  }

  .account-nav-link i {
    width: 22px;
    text-align: center;
    color: var(--primary);
    font-size: 16px;
    flex: 0 0 auto;
  }

  .account-nav-link.logout i {
    color: #ef4444;
  }

  .account-layout.sidebar-collapsed .account-sidebar,
  .account-sidebar.collapsed {
    width: var(--sidebar-collapsed);
  }

  .account-layout.sidebar-expanded .account-sidebar,
  .account-sidebar.expanded {
    width: var(--sidebar-wide);
  }

  .account-layout.sidebar-collapsed .account-name,
  .account-layout.sidebar-collapsed .account-email,
  .account-layout.sidebar-collapsed .link-text,
  .account-sidebar.collapsed .account-name,
  .account-sidebar.collapsed .account-email,
  .account-sidebar.collapsed .link-text {
    display: none;
  }

  .account-layout.sidebar-collapsed .account-profile,
  .account-sidebar.collapsed .account-profile {
    align-items: center;
  }

  .account-layout.sidebar-collapsed .account-nav-link,
  .account-sidebar.collapsed .account-nav-link {
    justify-content: center;
    padding-left: 0;
    padding-right: 0;
  }

  .account-layout.sidebar-collapsed .account-nav-link i,
  .account-sidebar.collapsed .account-nav-link i {
    width: auto;
    min-width: 22px;
    font-size: 18px;
  }

  .account-layout.sidebar-collapsed .account-sidebar-brand,
  .account-sidebar.collapsed .account-sidebar-brand {
    padding-left: 0;
    padding-right: 0;
  }

  .account-right {
    min-width: 0;
    margin-left: var(--sidebar-collapsed);
    width: calc(100% - var(--sidebar-collapsed));
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: #fff;
    transition: margin-left 0.25s ease, width 0.25s ease;
  }

  .account-layout.sidebar-expanded .account-right {
    margin-left: var(--sidebar-wide);
    width: calc(100% - var(--sidebar-wide));
  }

  .account-topbar {
    position: fixed;
    top: 0;
    left: var(--sidebar-collapsed);
    right: 0;
    height: var(--topbar-height);
    min-height: var(--topbar-height);
    padding: 10px 18px;
    background: #fff;
    border-bottom: 1px solid var(--border);
    z-index: 1030;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    width: auto;
    transition: left 0.25s ease;
  }

  .account-layout.sidebar-expanded .account-topbar {
    left: var(--sidebar-wide);
  }

  .account-topbar-left,
  .account-topbar-right {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    flex-wrap: wrap;
  }

  .account-toggle-btn,
  .btn-export-wide,
  .btn-secure,
  .btn-ghost {
    height: 44px;
    border: 1px solid var(--border);
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #fff;
    color: var(--text);
    cursor: pointer;
    padding: 0 14px;
    font-weight: 800;
    transition: border-color 0.2s ease, color 0.2s ease, transform 0.2s ease, background 0.2s ease;
    white-space: nowrap;
    max-width: 100%;
    gap:10px;
  }

  .account-toggle-btn {
    width: 44px;
    padding: 0;
    flex: 0 0 auto;
  }

  .account-toggle-btn:hover,
  .btn-export-wide:hover,
  .btn-ghost:hover {
    border-color: var(--line-strong);
  }

  .btn-secure {
    border-color: var(--primary);
    background: var(--primary);
    color: #fff;
  }

  .btn-secure:hover {
    background: var(--primary-hover);
    color: #fff;
  }

  .account-toggle-btn i,
  .btn-export-wide i,
  .btn-secure i,
  .btn-ghost i {
    font-size: 16px;
    flex: 0 0 auto;
  }

  .topbar-title {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    overflow: hidden;
  }

  .topbar-title .title {
    font-size: 1rem;
    font-weight: 900;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .topbar-title .sub {
    font-size: 0.8rem;
    color: var(--muted);
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .account-user-mini {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    color: var(--text);
    white-space: nowrap;
    min-width: 0;
    max-width: 100%;
  }

  .account-user-mini i {
    font-size: 20px;
    color: #475569;
    flex: 0 0 auto;
  }

  .account-user-mini span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    display: inline-block;
    max-width: 220px;
  }

  .account-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.22);
    z-index: 1035;
  }

  .account-backdrop.show {
    display: block;
  }

  .account-content-wrap {
    flex: 1 1 auto;
    min-height: 0;
    overflow: auto;
    overflow-x: hidden;
    padding: calc(var(--topbar-height) + 18px) 18px 18px;
    background: #fff;
    width: 100%;
    max-width: 100%;
    -webkit-overflow-scrolling: touch;
  }

  .billing-page-shell {
    width: 100%;
    max-width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 280px) minmax(0, 1fr);
    gap: 16px;
    align-items: start;
  }

  .billing-subsidebar {
    position: sticky;
    top: calc(var(--topbar-height) + 18px);
    align-self: start;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 14px;
    overflow: hidden;
    min-width: 0;
  }

  .billing-subsidebar-mobilebar {
    display: none;
  }

  .billing-sidepanel {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-height: 100%;
    min-width: 0;
  }

  .billing-sidepanel-header {
    padding: 14px;
    border-radius: 16px;
    background: #fff;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }

  .billing-sidepanel-label {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 4px;
  }

  .billing-sidepanel-title {
    margin: 0;
    font-size: 16px;
    color: var(--text);
    line-height: 1.2;
  }

  .billing-sidepanel-subtitle {
    margin: 4px 0 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.5;
  }

  .billing-sidepanel-body {
    flex: 1 1 auto;
    border-top: 1px solid var(--border);
    background: #fff;
    overflow: hidden;
    text-align: left;
    min-width: 0;
  }

  .billing-main {
    min-width: 0;
    max-width: 100%;
  }

  .card-panel,
  .profile-card,
  .summary-box,
  .chart-card,
  .billing-results-card,
  .billing-toolbar,
  .billing-filter-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .card-panel {
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }

  .card-panel.pad {
    padding: 20px;
  }

  .header-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
    width: 100%;
    max-width: 100%;
  }

  .section-title {
    margin: 0;
    font-size: 1.05rem;
    color: var(--text);
    letter-spacing: -.01em;
    word-break: break-word;
  }

  .section-subtitle {
    margin: 6px 0 0;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.5;
    word-break: break-word;
  }

  .status-line {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: #fff;
    font-size: 0.82rem;
    color: #334155;
    white-space: nowrap;
    max-width: 100%;
  }

  .saving-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #94a3b8;
    flex: 0 0 auto;
  }

  .saving-dot.is-saving {
    background: #0f172a;
    animation: pulse 1.2s infinite;
  }

  .saving-dot.is-saved {
    background: #16a34a;
  }

  .saving-dot.is-error {
    background: #dc2626;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 11px;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 700;
    border: 1px solid transparent;
    white-space: nowrap;
    line-height: 1;
    max-width: 100%;
  }

  .pill-verified {
    background: var(--green-bg);
    color: var(--success);
    border-color: #c7eed6;
  }

  .pill-unverified {
    background: #f8fafc;
    color: #64748b;
    border-color: #e2e8f0;
  }

  .pill-neutral {
    background: #f8fafc;
    color: #64748b;
    border-color: #e2e8f0;
  }

  .summary-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    width: 100%;
    max-width: 100%;
  }

  .summary-box {
    padding: 16px;
    min-height: 132px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-width: 0;
    overflow: hidden;
  }

  .summary-box .label {
    font-size: 0.82rem;
    color: var(--dark);
    font-weight: 800;
    word-break: break-word;
  }

  .summary-box .value {
    line-height: 1.1;
    font-size: 20px;
    font-weight: 700;
    margin-top: 6px;
    color: #111827;
  }

  .summary-box .hint {
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.45;
    margin-top: 6px;
    word-break: break-word;
  }


  .analytics-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.95fr);
    gap: 16px;
    width: 100%;
    max-width: 100%;
  }

  .chart-card {
    padding: 20px;
    min-height: 360px;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  .chart-wrap {
    position: relative;
    width: 100%;
    max-width: 100%;
  }

  .chart-wrap canvas {
    width: 100% !important;
    height: 100% !important;
  }

  .mini-stat-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }

  .mini-stat {
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 14px;
    background: #fff;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    min-width: 0;
  }

  .mini-stat .k {
    font-size: 0.8rem;
    color: var(--muted);
    font-weight: 800;
    word-break: break-word;
  }

  .mini-stat .v {
    font-size: 0.95rem;
    font-weight: 900;
    color: var(--text);
    text-align: right;
    word-break: break-word;
  }

  .mini-stat .s {
    font-size: 0.78rem;
    color: var(--muted);
    margin-top: 4px;
    text-align: right;
    word-break: break-word;
  }


  .profile-card {
    padding: 20px;
    min-width: 0;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
  }

  .profile-card.fixed-card {
    min-height: 100%;
  }

  .form-label {
    font-weight: 800;
    color: var(--text);
    margin-bottom: 6px;
    font-size: 0.86rem;
    display: block;
    word-break: break-word;
  }

  .form-control,
  .form-select {
    width: 100%;
    max-width: 100%;
    min-height: 46px;
    border-radius: 14px;
    border: 1px solid #dbe3ec;
    font-size: 0.92rem;
    background: #fff;
    color: var(--text);
  }

  .form-control:focus,
  .form-select:focus {
    border-color: #b8c4d1;
    outline: none;
  }

  textarea.form-control {
    min-height: 118px;
    resize: vertical;
  }

  .readonly-box {
    min-height: 46px;
    display: flex;
    align-items: center;
    padding: 12px 14px;
    border: 1px solid var(--border);
    background: #f8fafc;
    border-radius: 14px;
    color: var(--muted);
    word-break: break-word;
    width: 100%;
    max-width: 100%;
    overflow: hidden;
  }

  .helper-text {
    display: block;
    margin-top: 6px;
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.4;
    word-break: break-word;
  }

  .otp-panel {
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 14px;
    background: #fff;
    width: 100%;
    max-width: 100%;
  }

  .otp-row {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }

  .otp-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    min-width: 0;
  }

  .account-info-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }

  .info-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 14px;
    padding: 10px 0;
    border-bottom: 1px solid #eef2f7;
    min-width: 0;
  }

  .info-row:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .info-label {
    color: var(--muted);
    font-size: 0.85rem;
    word-break: break-word;
  }

  .info-value {
    color: var(--text);
    font-weight: 800;
    text-align: right;
    word-break: break-word;
    font-size: 0.85rem;
    min-width: 0;
  }

  .detail-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    width: 100%;
    max-width: 100%;
  }

  .detail-box {
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 14px;
    background: #fff;
    min-width: 0;
    overflow: hidden;
  }

  .detail-box .k {
    font-size: 0.78rem;
    color: var(--muted);
    margin-bottom: 6px;
    font-weight: 800;
    word-break: break-word;
  }

  .detail-box .v {
    font-size: 0.92rem;
    color: var(--text);
    font-weight: 900;
    word-break: break-word;
  }

  .orders-table-wrap {
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: #fff;
  }

  .orders-table {
    width: 100%;
    margin: 0;
    min-width: 760px;
