  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.theme.default.min.css" />

  <script src="/customer/js/vendor/modernizr-2.8.3.min.js"></script>
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script src="/socket.io/socket.io.js"></script>

  <style>
    :root{
      --page-bg:#ffffff;
      --card-bg:#ffffff;
      --card-border:#e5eaf1;
      --line:#e8edf3;
      --text:#0f172a;
      --muted:#64748b;
      --shadow:0 8px 28px rgba(15, 23, 42, 0.04);
      --radius:18px;
    }

    *{ box-sizing:border-box; }

    body{
      background:var(--page-bg);
      color:var(--text);
    }

    .account-layout{ min-height:100vh; }
    .account-content{ background:transparent; }
    .account-page-content{ min-width:0; }

    .profile-wrap{
      display:flex;
      flex-direction:column;
      gap:14px;
    }

    .profile-card{
      background:var(--card-bg);
      border:1px solid var(--card-border);
      border-radius:var(--radius);
      padding:18px;
    }

    .section-title{
      margin:0 0 8px;
      font-size:.98rem;
      font-weight:700;
      color:var(--text);
    }

    .section-subtitle{
      margin:0 0 12px;
      color:var(--muted);
      font-size:.82rem;
      font-weight:400;
      line-height:1.45;
    }

    .wishlistx-page-container {
      max-width: 1250px;
      margin: 0;
      padding: 0;
    }

    .wishlistx-page-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      margin-bottom: 18px;
    }

    .wishlistx-page-header h2 {
      margin: 0;
      font-size: 28px;
      font-weight: 700;
      color: #222;
    }

    .wishlistx-page-subtitle {
      margin: 6px 0 0;
      color: #777;
      font-size: 14px;
    }


    .wishlistx-summary-bar {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
      margin-bottom: 20px;
    }

    .wishlistx-summary-box {
      background: #fff;
      border: 1px solid #e8e8e8;
      border-radius: 12px;
      padding: 14px 16px;
    }

    .wishlistx-summary-label {
      display: block;
      font-size: 13px;
      color: #777;
      margin-bottom: 6px;
    }

    .wishlistx-summary-value {
      font-size: 18px;
      font-weight: 700;
      color: #111;
    }

    .wishlistx-total-box {
      background: #111;
      border-color: #111;
    }

    .wishlistx-total-box .wishlistx-summary-label,
    .wishlistx-total-box .wishlistx-summary-value {
      color: #fff;
    }

    .wishlistx-table-wrap {
      width: 100%;
      overflow-x: auto;
      background: #fff;
      border: 1px solid #e8e8e8;
      border-radius: 14px;
    }

    .wishlistx-table {
      width: 100%;
      border-collapse: collapse;
      min-width: 980px;
    }

    .wishlistx-table th,
    .wishlistx-table td {
      padding: 14px 12px;
      border-bottom: 1px solid #eee;
      text-align: center;
      vertical-align: middle;
    }

    .wishlistx-table th {
      background: #fafafa;
      font-weight: 700;
      color: #333;
      font-size: 14px;
    }

    .wishlistx-table td {
      font-size: 14px;
      color: #222;
    }

    .wishlistx-table img {
      width: 70px;
      height: 70px;
      object-fit: cover;
      border-radius: 10px;
      border: 1px solid #eee;
      background: #f8f8f8;
    }

    .wishlistx-product-cell { text-align: left; }

    .wishlistx-product-name {
      display: block;
      font-weight: 700;
      color: #111;
      margin-bottom: 4px;
      text-decoration: none;
    }

    .wishlistx-product-name:hover { text-decoration: underline; }

    .wishlistx-product-meta {
      display: block;
      font-size: 12px;
      color: #777;
      line-height: 1.5;
    }

    .wishlistx-action-group {
      display: flex;
      gap: 8px;
      align-items: center;
      flex-wrap: wrap;
    }

    .wishlistx-action-btn {
      border: none;
      background: #d93025;
      color: #fff;
      padding: 10px 14px;
      border-radius: 8px;
      cursor: pointer;
      transition: 0.25s ease;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .wishlistx-action-btn:hover { background: #c2bab9; }


    .wishlistx-heart { font-size: 16px; line-height: 1; }

    .wishlistx-empty-cart { 
      padding: 40px 20px;
      text-align: center;
      color: #666;
    }

    .wishlistx-empty-cart h3 {
      margin: 0 0 10px;
      color: #222;
    }

    .wishlistx-empty-cart p { margin: 0 0 18px; }

    .wishlistx-empty-cart a {
      display: inline-block;
      text-decoration: none;
      background: #111;
      color: #fff;
      padding: 11px 18px;
      border-radius: 8px;
    }

    .js-move-to-cart{
          background: var(--yellow);
    color: #242424;
    border-radius: 5px;
    height: 35px;
    border: none;
    }
    .toast-mini{
      position:fixed;
      right:18px;
      bottom:18px;
      z-index:1060;
      min-width:220px;
      max-width:90vw;
      padding:12px 14px;
      border-radius:13px;
      background:#0f172a;
      color:#fff;
      font-size:.86rem;
      font-weight:400;
      transform:translateY(18px);
      opacity:0;
      pointer-events:none;
      transition:.25s ease;
      border:1px solid rgba(255,255,255,.08);
    }

    .toast-mini.show{ transform:translateY(0); opacity:1; }

    @media (max-width: 768px){
      .profile-card{ padding:16px; border-radius:15px; }
      .wishlistx-page-header{ flex-direction:column; align-items:flex-start; }
    }

    @media (max-width: 576px){
      .wishlistx-summary-bar { grid-template-columns: 1fr; }
    }
    .wishlistx-viewcart-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 16px;
      height: 45px;
      text-decoration: none;
      background-color: #111;
      color: #e5eaf1;
      
      font-weight: 600;
      transition: 0.2s ease;
      border-radius: 8px;
    }

    .wishlistx-viewcart-btn:hover{
      background: #ffc107;
      color: #111;
    }


    .wishlistx-viewcart-btn .item-icon {
      width: 16px;
      height: 16px;
      display: inline-block;
      background: currentColor;
      mask: url('/path-to-cart-icon.svg') no-repeat center / contain;
      -webkit-mask: url('/path-to-cart-icon.svg') no-repeat center / contain;
    }
  </style>
</head>

<body>
<%
  const safeUser = user || null;
%>

