<script src="/customer/js/jquery.nice-select.min.js"></script>
<script src="/customer/js/scrollUp.min.js"></script>
<script src="/customer/js/main.js"></script>

<script>
  (function () {
    "use strict";

    const API = "/wishlist/data";
    const API_TOGGLE = "/wishlist/toggle";
    const API_CART_ADD = "/customer/cart/add"; // change to your actual cart route
    const GUEST_KEY = "guest_wishlist_token";
    const DEFAULT_IMAGE = "/uploads/products/default.jpg";
    const CSRF = document.querySelector('meta[name="csrf-token"]')?.content || null;

    function escapeHtml(v) {
      return v == null ? "" : String(v)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#39;");
    }

    function normalizeImage(raw) {
      if (!raw) return DEFAULT_IMAGE;
      let img = String(raw).trim().replace(/\\/g, "/");
      if (img.startsWith("http://") || img.startsWith("https://") || img.startsWith("//")) return img;
      if (img.startsWith("/")) return img;
      if (img.startsWith("uploads/")) return "/" + img;
      return "/uploads/variants/" + img;
    }

    function getGuestToken() {
      try {
        const existing = localStorage.getItem(GUEST_KEY);
        if (existing) return existing;
        const token = "guest_" + Math.random().toString(36).slice(2, 12);
        localStorage.setItem(GUEST_KEY, token);
        return token;
      } catch (e) {
        return "guest_" + Math.random().toString(36).slice(2, 12);
      }
    }

    function setGuestToken(token) {
      if (!token) return;
      try {
        localStorage.setItem(GUEST_KEY, String(token));
      } catch (e) { }
    }

    let GUEST_TOKEN = getGuestToken();

    async function apiFetch(url, method = "GET", body = null) {
      const headers = { "x-guest-token": GUEST_TOKEN };
      if (method !== "GET") {
        headers["Content-Type"] = "application/json";
        if (CSRF) headers["x-csrf-token"] = CSRF;
      }

      const res = await fetch(url, {
        method,
        headers,
        credentials: "same-origin",
        body: method === "GET" || body == null ? undefined : JSON.stringify(body)
      });

      let json = null;
      try { json = await res.json(); } catch (e) { }

      if (!res.ok) {
        const msg = (json && json.message) ? json.message : `HTTP ${res.status}`;
        const err = new Error(msg);
        err.status = res.status;
        err.body = json;
        throw err;
      }

      return json;
    }

    function setStatus(text) {
      const el = document.getElementById("wishlistx-status-text");
      if (el) el.textContent = text;
    }

    function getItems(payload) {
      if (Array.isArray(payload?.items)) return payload.items;
      if (Array.isArray(payload?.rows)) return payload.rows;
      if (Array.isArray(payload?.wishlist)) return payload.wishlist;
      return [];
    }

    function getVariantId(item) {
      if (item == null) return "";
      if (typeof item === "number" || typeof item === "string") return item;
      return item?.variant_id ?? item?.pv_id ?? item?.id ?? item?.wishlist_variant_id ?? "";
    }

    function getProductId(item) {
      if (item == null) return "";
      return item?.product_id ?? item?.pv_product_id ?? item?.master_id ?? item?.cart_product_id ?? item?.product?.id ?? "";
    }

    function getName(item) {
      if (item == null) return "Wishlist Item";
      return item?.name || item?.variant_name || item?.pv_name || item?.product_name || item?.product?.name || "Wishlist Item";
    }

    function getBrand(item) {
      if (item == null) return "—";
      return item?.brand || item?.product_brand || item?.brand_name || item?.pv_brand || item?.product?.brand || item?.product?.brand_name || "—";
    }

    function getSku(item) {
      if (item == null) return "—";
      return item?.sku || item?.pv_sku || item?.barcode || item?.product_sku || item?.product?.sku || "—";
    }

    function getImagePath(item) {
      if (item == null) return DEFAULT_IMAGE;
      const raw = item?.image || item?.variant_image || item?.filename || item?.media_filename || item?.pv_image || item?.main_image || item?.product_image || item?.product?.image || "";
      return normalizeImage(raw);
    }

    function setBusy(el, busy) {
      if (!el) return;
      if (busy) {
        el.dataset.originalHtml = el.innerHTML;
        el.disabled = true;
        el.innerHTML = '<i class="fa fa-spinner fa-spin" aria-hidden="true"></i>';
      } else {
        el.disabled = false;
        if (el.dataset.originalHtml) {
          el.innerHTML = el.dataset.originalHtml;
          delete el.dataset.originalHtml;
        }
      }
    }

    function renderWishlist(payload) {
      const items = getItems(payload);
      const bodyEl = document.getElementById("wishlistx-table-body");
      const countEl = document.getElementById("wishlistx-items-count");
      const subtitleEl = document.getElementById("wishlistx-page-subtitle");

      if (payload?.guestId) setGuestToken(payload.guestId);
      if (payload?.guestToken) setGuestToken(payload.guestToken);

      if (countEl) countEl.textContent = String(items.length);

      if (subtitleEl) {
        subtitleEl.textContent = items.length
          ? `${items.length} item(s) saved in your wishlist`
          : "Your wishlist is currently empty";
      }

      if (!bodyEl) return;

      if (!items.length) {
        bodyEl.innerHTML = `
          <tr>
            <td colspan="4">
              <div class="wishlistx-empty-cart">
                <h3>Your wishlist is empty</h3>
                <p>Add products to save them here.</p>
                <a href="/">Continue Shopping</a>
              </div>
            </td>
          </tr>
        `;
        return;
      }

      bodyEl.innerHTML = items.map((item) => {
        const variantId = getVariantId(item);
        const productId = getProductId(item);
        const name = getName(item);
        const brand = getBrand(item);
        const sku = getSku(item);
        const img = getImagePath(item);

        const productUrl = productId ? `/customer/product/product-details/${productId}/${variantId}` : "#";

        return `
          <tr data-variant-id="${escapeHtml(String(variantId))}">
            <td class="wishlistx-product-cell">
              <a href="${productUrl}" class="wishlistx-product-name">${escapeHtml(name)}</a>
              <span class="wishlistx-product-meta">
                Variant ID: ${escapeHtml(variantId || "—")}<br>
                Product ID: ${escapeHtml(productId || "—")}
              </span>
            </td>

            <td>${escapeHtml(brand)}</td>
            <td>${escapeHtml(sku)}</td>

            <td>
              <div class="wishlistx-action-group">
                <button
                  type="button"
                  class=" js-move-to-cart"
                  data-variant-id="${escapeHtml(String(variantId))}"
                  data-product-id="${escapeHtml(String(productId))}"
                >
                  Move to Cart
                </button>

                <button
                  type="button"
                  class="wishlistx-action-btn js-wishlist-remove"
                  data-variant-id="${escapeHtml(String(variantId))}"
                  title="Remove from wishlist"
                >
                  <span class="wishlistx-heart">♥</span>
                </button>
              </div>
            </td>
          </tr>
        `;
      }).join("");
    }

    async function loadWishlist() {
      setStatus("Loading...");
      try {
        const json = await apiFetch(API, "GET");
        renderWishlist(json);
        setStatus("Ready");
      } catch (error) {
        console.error("Wishlist load error:", error);
        renderWishlist({ items: [] });
        setStatus("Error");
      }
    }

    async function removeFromWishlist(variantId) {
      return apiFetch(API_TOGGLE, "POST", { variant_id: Number(variantId) });
    }

    async function moveToCart(variantId, productId) {
      return apiFetch(API_CART_ADD, "POST", {
        variant_id: Number(variantId),
        product_id: productId ? Number(productId) : undefined,
        quantity: 1
      });
    }

    document.addEventListener("DOMContentLoaded", () => {
      loadWishlist();


      const bodyEl = document.getElementById("wishlistx-table-body");
      if (bodyEl) {
        bodyEl.addEventListener("click", async (e) => {
          const moveBtn = e.target.closest(".js-move-to-cart");
          const removeBtn = e.target.closest(".js-wishlist-remove");

          if (moveBtn) {
            e.preventDefault();
            const variantId = moveBtn.dataset.variantId;
            const productId = moveBtn.dataset.productId;

            if (!variantId) return;

            try {
              setBusy(moveBtn, true);

              await moveToCart(variantId, productId);

              // Amazon-like behavior: move from wishlist to cart
              await removeFromWishlist(variantId);

              await loadWishlist();
              alert("Moved to cart");
            } catch (err) {
              console.error("Move to cart failed:", err);
              alert(err?.body?.message || err.message || "Move to cart failed");
            } finally {
              setBusy(moveBtn, false);
            }

            return;
          }

          if (removeBtn) {
            e.preventDefault();

            const variantId = removeBtn.dataset.variantId;
            if (!variantId) return;

            try {
              setBusy(removeBtn, true);
              await removeFromWishlist(variantId);
              await loadWishlist();
            } catch (err) {
              console.error("Wishlist remove failed:", err);
              alert(err?.body?.message || err.message || "Remove failed");
            } finally {
              setBusy(removeBtn, false);
            }
          }
        });
      }

      const socket = typeof io !== "undefined" ? io({ transports: ["websocket"], withCredentials: true }) : null;
      const CURRENT_GUEST_ID = localStorage.getItem(GUEST_KEY) || null;

      if (socket) {
        socket.on("wishlistUpdated", (payload) => {
          const { guestId, guestToken } = payload || {};
          const incomingGuest = guestId || guestToken || null;

          if (incomingGuest && incomingGuest === CURRENT_GUEST_ID) {
            loadWishlist();
          }
        });
      }

      window.loadWishlist = loadWishlist;
    });
  })();
</script>
</body>
