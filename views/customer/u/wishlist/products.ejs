<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="csrf-token" content="<%= csrfToken %>">
  <title>Wishlist Products — JOOD | Quality Goods & Products</title>
  <meta name="description" content="View and manage products saved in your JOOD wishlist." />
  <meta name="robots" content="noindex, nofollow" />

    <link rel="shortcut icon" href="/customer/images/web-img-vid/favicon.png" type="image/x-icon">


  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
