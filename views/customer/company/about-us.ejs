  <style>
    /* --- Reset & typography --- */
    a {  color:#0b79f7;text-decoration:none; }
    a:hover { text-decoration:underline; }

    /* Container */
    .container { max-width:1150px; margin:0 auto; }

    /* Skip link */
    .skip { position:absolute; left:-999px; top:auto; width:1px; height:1px; overflow:hidden; }
    .skip:focus { position:static; width:auto; height:auto; padding:8px 12px; margin:12px; border-radius:6px; background:#111; color:#fff; }

    /* Hero */
    .site-hero { padding:80px 16px 60px; text-align:center; }
    .hero-inner { display:flex; flex-wrap:wrap; align-items:center; justify-content:center; gap:32px; max-width:1200px; margin:0 auto; }
    .hero-copy { flex:1; min-width:280px; text-align:left; }
    .kicker { font-size:.85rem; text-transform:uppercase; letter-spacing:.08em; color:#555; font-weight:600; margin-bottom:12px; }
    h1 { font-size:2.2rem; font-weight:700; margin-bottom:16px; color:#111; }
    p.lead { font-size:1.05rem; color:#555; margin-bottom:20px; }

    .trust-row { display:flex; flex-wrap:wrap; gap:12px; margin-bottom:20px; }
    .trust-badge { background:#f5f5f5; padding:10px 14px; border-radius:10px; font-size:.95rem; display:flex; gap:6px; align-items:center; border:1px solid #e5e5e5; }

    .hero-ctas { display:flex; flex-wrap:wrap; gap:12px; margin-top:16px; }
    .btn { padding:12px 22px; border-radius:8px; font-weight:600; transition:all .15s ease; text-align:center; display:inline-block; }
    .btn-primary { background:#0b79f7; color:#fff; }
    .btn-warning { background:#f97316; color:#fff; }
    .btn-danger { background:#dc2626; color:#fff; }
    .btn:hover { transform:translateY(-2px); opacity:.95; }

    .hero-media { flex:1; min-width:280px; display:flex; justify-content:center; align-items:center; }
    .hero-media img { max-width:500px; width:100%; height:auto; border-radius:12px; }

    /* Sections */
    section { padding:60px 16px; }
    h2 { font-size:1.6rem; margin-bottom:16px; font-weight:700; color:#111; }
    .muted { color:#6b7280; }

    /* Cards / Grid */
    .grid { display:grid; gap:24px; }
    .grid-2 { grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); }
    .card { background:#fff; padding:24px; border-radius:12px; border:1px solid #e5e5e5;  }

    .values { display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:16px; margin-top:16px; }
    .value { background:#fff; padding:18px; border-radius:10px; border:1px solid #e5e5e5; }

    .timeline { display:flex; flex-wrap:wrap; gap:16px; margin-top:16px; }
    .milestone { background:#fff; padding:16px; border-radius:10px; border:1px solid #e5e5e5; flex:1 1 200px; }
    .milestone .year { font-weight:700; color:black; margin-bottom:6px; }

    .team { display:grid; grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); gap:16px; margin-top:16px; }
    .member { text-align:center; background:#fff; padding:16px; border-radius:10px; border:1px solid #e5e5e5; }
    .member img { width:96px; height:96px; border-radius:50%; object-fit:cover; margin-bottom:8px; }

    .faq details { background:#fff; padding:14px; border-radius:8px; border:1px solid #e5e5e5; margin-bottom:10px; }
    .faq summary { font-weight:700; cursor:pointer; }

    /* Footer */
    footer.site-footer { padding:32px 16px; text-align:center; color:#6b7280; font-size:.95rem; border-top:1px solid #e5e5e5; }
    footer .links { display:flex; flex-wrap:wrap; gap:12px; justify-content:center; margin-top:12px; }

    /* Responsive */
    @media (max-width:768px){
      h1 { font-size:1.8rem; }
      h2 { font-size:1.3rem; }
      .hero-inner { flex-direction:column-reverse; align-items:center; }
      .hero-copy, .hero-media { text-align:center; }
      .hero-ctas { justify-content:center; }
      .trust-row { justify-content:center; }
    }
  </style>
</head>
<body>
  <%- include('../includes/header') %>

  <a href="#main-content" class="skip">Skip to content</a>

  <main id="main-content" class="container" role="main">
    <!-- HERO -->
    <header class="site-hero">
      <div class="hero-inner">
        <div class="hero-copy">
          <div class="kicker">About JOOD</div>
          <h1>Founded in 2025 · Trusted retail, curated for you</h1>
          <p class="lead">JOOD was established to remove friction from online shopping: carefully vetted products, clear policies, secure transactions, and responsive support. We focus on long-term trust — not quick wins.</p>

          <div class="trust-row">
            <div class="trust-badge"><strong>30-Day Money-Back</strong> — no-hassle returns</div>
            <div class="trust-badge"><strong>Secure Checkout</strong> — SSL & PCI-compliant payments</div>
            <div class="trust-badge"><strong>Verified Suppliers</strong> — rigorous quality checks</div>
          </div>

          <div class="hero-ctas">
            <a class="btn btn-sm btn-success" href="/shop">Explore Catalog</a>
            <a class="btn btn-sm btn-warning" href="/specials">Special Offers</a>
            <a class="btn btn-sm btn-danger" href="/customer/support-and-help/contact-us">Contact Support</a>
          </div>
        </div>

        <div class="hero-media">
          <img src="/customer/images/about-us/image/about-hero.png" alt="JOOD — trusted shopping">
        </div>
      </div>
    </header>

    <!-- Executive Summary -->
    <section>
      <h2>Executive Summary</h2>
      <p class="muted">JOOD is a responsible e-commerce company combining careful product selection with transparent policies. We partner with established suppliers, perform quality checks on inventory, and maintain clear fulfillment and return processes so customers can shop with confidence.</p>
    </section>

    <!-- Trust & Commitments -->
    <section>
      <div class="grid grid-2">
        <div class="card">
          <h2>Our Commitments</h2>
          <ul class="muted">
            <li><strong>30-Day Money-Back Guarantee:</strong> Return products within 30 days for a full refund.</li>
            <li><strong>Secure Payments:</strong> All transactions are encrypted and PCI-compliant.</li>
            <li><strong>Quality Assurance:</strong> Suppliers and products are vetted; random inspections ensure high standards.</li>
            <li><strong>Responsible Packaging:</strong> Smart and recyclable packaging to reduce waste.</li>
          </ul>
        </div>
        <div class="card">
          <h2>Trust Signals</h2>
          <p class="muted"><strong>Verified reviews, audited suppliers, and responsive support:</strong> Our team is available Mon–Sat, 09:00–18:00, monitoring satisfaction and acting on feedback.</p>
        </div>
      </div>
    </section>

    <!-- Mission / Vision / Values -->
    <section>
      <div class="grid grid-2">
        <div class="card">
          <h2>Mission</h2>
          <p class="muted">To make high-quality products accessible and reliable online by combining careful curation, clear policies, and exceptional service.</p>
        </div>
        <div class="card">
          <h2>Vision</h2>
          <p class="muted">To be the first choice for shoppers who value product integrity, transparent service, and a trustworthy experience.</p>
        </div>
      </div>
      <div style="margin-top:28px">
        <h2>Our Values</h2>
        <div class="values">
          <div class="value"><strong>Integrity</strong><p class="muted">We operate transparently and deliver what we promise.</p></div>
          <div class="value"><strong>Customer-first</strong><p class="muted">Decisions are made with the customer's best interest in mind.</p></div>
          <div class="value"><strong>Quality</strong><p class="muted">We partner with reputable suppliers and continuously audit performance.</p></div>
          <div class="value"><strong>Accountability</strong><p class="muted">We take ownership of issues and resolve them promptly.</p></div>
        </div>
      </div>
    </section>

    <!-- Timeline -->
    <section>
      <h2>Our Journey</h2>
      <div class="timeline">
        <div class="milestone">
          <div class="year">2025</div>
          <strong>Founded</strong>
          <p class="muted">Established to close the trust gap in online shopping.</p>
        </div>
        <div class="milestone">
          <div class="year">2025–2026</div>
          <strong>Initial growth</strong>
          <p class="muted">Launched curated categories and implemented quality assurance processes.</p>
        </div>
        <div class="milestone">
          <div class="year">Ongoing</div>
          <strong>Continuous improvement</strong>
          <p class="muted">Iterating logistics, supplier relationships, and support based on feedback.</p>
        </div>
      </div>
    </section>

    <!-- Leadership -->
    <section>
      <h2>Leadership Team</h2>
      <div class="team">
        <div class="member">
          <img src="/customer/images/about-us/image/ceo.png" alt="John Doe">
          <h4>Essa Al Mulla</h4>
          <p class="muted"><em>Founder & CEO</em></p>
          <p class="muted">Essa Al Mulla leads JOOD's customer-first strategy with extensive retail and logistics experience.</p>
        </div>
        <div class="member">
          <img src="/customer/images/about-us/image/team3.webp" alt="Jane Smith">
        <div class="profile-card">
          <h4>Syed Hasnain Raza</h4>
          <p class="muted"><em>Manager</em></p>
          <p class="muted">Syed oversees operations, ensuring reliable and timely fulfillment.</p>
        </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section>
      <h2>Frequently Asked Questions</h2>
      <div class="faq">
        <details>
          <summary>What is your returns policy?</summary>
          <p class="muted">We offer a 30-day money-back guarantee. Please consult the Returns page for full instructions.</p>
        </details>
        <details>
          <summary>How secure is checkout?</summary>
          <p class="muted">All payments are encrypted with TLS/SSL using trusted processors. Card data is never stored on our servers.</p>
        </details>
      </div>
    </section>

  </main>

