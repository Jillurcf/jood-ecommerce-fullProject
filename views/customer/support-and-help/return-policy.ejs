    * { box-sizing: border-box; }
    /* html,body{ height:100%;color:var(--text); background:#ffffff; margin:0; line-height:1.6; } */
    a{ color:var(--brand); text-decoration:none; }
    a:hover{ text-decoration:underline; }
    .container { max-width: var(--container); margin: 0 auto; }

    /* Accessibility skip link */
    .skip { position:absolute; left:-999px; top:auto; width:1px; height:1px; overflow:hidden; }
    .skip:focus { position:static; width:auto; height:auto; padding:8px 12px; margin:12px; border-radius:6px; background:#111; color:#fff; z-index:9999; }

    /* Hero */
    .site-hero{ background: var(--bg-hero); border-radius: var(--radius); padding:24px; margin:20px 0; box-shadow: 0 1px 2px rgba(16,24,40,0.03); }
    .hero-inner{ display:flex; gap:20px; align-items:center; justify-content:space-between; flex-wrap:wrap; }
    .hero-copy{ flex:1 1 480px; min-width:260px; }
    .kicker{ font-size:0.78rem; text-transform:uppercase; color:#475569; font-weight:700; margin-bottom:8px; letter-spacing:0.6px; }
    h1{ font-size:1.9rem; margin:0 0 8px; font-weight:800; color:var(--text); }
    p.lead{font-size:16px; color:#374151; margin:0 0 8px; }
    .hero-media{ flex:0 0 360px; display:flex; align-items:center; justify-content:center; }
    .hero-media img{ width:100%; max-width:360px; border-radius:10px; display:block; }

    /* Layout */
    main section{ padding:28px 0; }
    .grid{ display:grid; grid-template-columns: 1fr 340px; gap:28px; align-items:start; }
    .card{ background: var(--card-bg); border:1px solid var(--border); padding:20px; border-radius:10px; box-shadow: 0 1px 2px rgba(16,24,40,0.02); }
    h2{ font-size:1.125rem; margin-bottom:10px; }
    h3{ font-size:1rem; margin-top:14px; margin-bottom:8px; }
    .muted{ color:var(--muted); }
    .value-list{ margin-top:12px; list-style: disc; padding-left:20px; }
    .value-list li{ margin-bottom:10px; }
    .note{ font-size:.95rem; color:var(--muted); margin-top:12px; }

    .table{ width:100%; border-collapse:collapse; margin-top:12px; }
    .table th, .table td { border:1px solid #eef2f7; padding:10px 12px; text-align:left; }

    .contact-card{ display:flex; gap:12px; align-items:flex-start; flex-wrap:wrap; }
    .contact-meta{ flex:1; min-width:200px; }
    .contact-actions{ text-align:right; min-width:220px; }

    .btn-primary{ background:var(--brand); color:#fff; padding:10px 14px; border-radius:8px; border:none; display:inline-block; text-decoration:none; }
    .muted-small{ color:var(--muted); font-size:.95rem; }

    /* Responsive */
