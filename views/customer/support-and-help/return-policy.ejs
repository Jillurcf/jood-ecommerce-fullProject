  <style>
    :root{
      --brand: #0b79f7;
      --muted: #6b7280;
      --border: #e6eef8;
      --radius: 12px;
      --container: 1150px;
      --bg-hero: linear-gradient(180deg,#f7fbff 0%,#fff 100%);
      --text: #0f172a;
      --card-bg: #fff;
