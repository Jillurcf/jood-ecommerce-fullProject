  <style>
    :root {
      --brand: #0b79f7;
      --muted: #6b7280;
      --border: #e6eef8;
      --radius: 12px;
      --container: 1150px;
      --bg-hero: linear-gradient(180deg,#f7fbff 0,#fff 100%);
      --text: #0f172a;
      --card-bg: #fff;
    }
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    /* html,body{font-family:'Inter',sans-serif;color:var(--text);background:#fff;line-height:1.6} */
    a{color:var(--brand);text-decoration:none}
    a:hover{text-decoration:underline}
    .container{max-width:var(--container);margin:0 auto;}
    .skip{position:absolute;left:-999px}
    .skip:focus{position:static;padding:8px 12px;margin:12px;border-radius:6px;background:#111;color:#fff}

    /* Hero */
    .site-hero{background:var(--bg-hero);border-radius:var(--radius);padding:28px;margin:24px 0}
    .hero-inner{display:flex;gap:28px;align-items:center;justify-content:space-between;flex-wrap:wrap}
    .hero-copy{flex:1 1 540px}
    .kicker{font-size:.82rem;text-transform:uppercase;color:#475569;font-weight:700;margin-bottom:10px}
    h1{font-size:2.2rem;margin:0 0 8px;font-weight:800}
    p.lead{color:#374151;font-size:1rem;margin:0 0 8px}
    .hero-media{flex:0 0 420px;display:flex;align-items:center;justify-content:center}
    .hero-media img{width:100%;max-width:420px;border-radius:10px;display:block}

    /* Layout */
    section{padding:36px 0}
    .grid{display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:start}
    .card{background:var(--card-bg);border:1px solid var(--border);padding:24px;border-radius:12px}
    h2{font-size:18px;margin-bottom:12px}
    h3{font-size:16px;margin-top:14px;margin-bottom:8px}
    .muted{color:var(--muted)}
    .value-list{margin-top:12px;list-style:disc;padding-left:20px}
    .value-list li{margin-bottom:10px}
    .note{font-size:.95rem;color:var(--muted);margin-top:12px}

    .table{width:100%;border-collapse:collapse;margin-top:12px}
    .table th,.table td{border:1px solid #eef2f7;padding:10px 12px;text-align:left}

    .contact-card{display:flex;gap:12px;align-items:flex-start;flex-wrap:wrap}
    .contact-meta{flex:1;min-width:220px}
    .contact-actions{text-align:right;width:260px}

    @media (max-width:992px){
      .grid{grid-template-columns:1fr}
      .hero-media{display:none}
      .contact-actions{text-align:left;width:100%}
    }

    .btn-primary{background:var(--brand);color:#fff;padding:10px 14px;border-radius:8px;border:none;display:inline-block}
    .muted-small{color:var(--muted);font-size:.95rem}
  </style>
