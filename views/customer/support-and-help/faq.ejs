    .hero-media img{width:100%;max-width:420px;border-radius:10px;display:block}

    section{padding:36px 0}
    .grid{display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:start}
    .card{background:#fff;border:1px solid var(--border);padding:22px;border-radius:12px;}

    h2{font-size:18px;margin-bottom:12px;color:#0f172a}
