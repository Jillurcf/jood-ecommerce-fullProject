      /* Top promotional/nav yellow strip */
      .top-strip {
        background: var(--brand-yellow);
        color: var(--brand-dark);
        padding: 10px 16px;
        font-weight: 700;
        font-size: 0.95rem;
      }
      .top-strip .container { display:flex; align-items:center; justify-content:space-between; gap:12px; }

      /* Header area with search and cart (keeps original pattern) */
      header.site-header {
        border-top: 4px solid var(--brand-yellow);
        background: #fff;
        padding: 14px 0;
        border-bottom: 1px solid #eee;
      }
      .branding { font-weight:700; color:var(--brand-dark); font-size:1.15rem; letter-spacing:0.2px; }
      .search-box {
        display:flex;
        align-items:center;
        gap:8px;
        max-width:640px;
        width:100%;
      }
      .search-input {
        flex:1;
        border:1px solid #ddd;
        padding:10px 12px;
        border-radius:8px;
        font-size:0.95rem;
        outline:none;
      }
      .search-btn {
        border:0;
        padding:10px 14px;
        border-radius:8px;
        background:var(--brand-yellow);
        color:var(--brand-dark);
        font-weight:700;
        cursor:pointer;
      }
      .action-buttons { display:flex; align-items:center; gap:12px; }

      .cart-btn {
        background:var(--brand-red);
        color:#fff;
        padding:10px 14px;
        border-radius:8px;
        border:0;
        font-weight:700;
        cursor:pointer;
      }

      /* Main hero */
      .contact-hero{
        padding:60px 16px;
        text-align:center;
        background:linear-gradient(180deg, #fff 0%, #fbfbfb 100%);
        border-bottom: 1px solid #eee;
      }
      .contact-hero h1 { margin:0 0 8px; font-size:2rem; color:var(--brand-dark); font-weight:800; }
      .contact-hero p { margin:0; color:var(--muted); font-size:1rem; }

      /* Contact cards */
      .contact-details {
        display:flex;
        flex-wrap:wrap;
        gap:20px;
        justify-content:center;
        padding:36px 16px;
        max-width:1150px;
        margin:0 auto;
      }
      .contact-card {
        background: #fff;
        border:1px solid #eee;
        border-radius: var(--radius);
        padding:22px;
        min-width:260px;
        flex:1 1 280px;
        text-align:center;
      }
