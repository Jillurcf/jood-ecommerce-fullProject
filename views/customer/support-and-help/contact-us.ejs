  <body>
  <%- include('../includes/header') %>
    <main role="main">

      <!-- Hero -->
<section class="contact-hero" aria-labelledby="contact-heading">
    <h1 id="contact-heading">Contact JOOD</h1>
    <p>
        We’re here to assist you. Reach out via phone, email, or the contact form below.
    </p>
</section>

      <!-- Contact cards -->
      <section class="contact-details" aria-label="Contact details">
        <div class="contact-card" role="article" aria-label="Address">
          <h3>Address</h3>
          <p>13th Floor Office 1301</p>
          <p>Al Reem Tower, Dubai</p>
          <p><a href="https://www.google.com/maps/search/?api=1&query=13th+Floor+Office+1301+Al+Reem+Tower+Dubai" target="_blank" rel="noopener">View on Google Maps</a></p>
        </div>

        <div class="contact-card" role="article" aria-label="Phone">
          <h3>Phone</h3>
          <p>+971 4 337 2440</p>
          <p><a href="tel:+97143372440">Call Now</a></p>
        </div>

        <div class="contact-card" role="article" aria-label="Email">
          <h3>Email</h3>
          <p>info@jood.com</p>
          <p><a href="mailto:info@jood.com">Send Email</a></p>
        </div>
      </section>

      <!-- Map: use robust embed URL and explicit container height -->
      <div class="map-container" aria-hidden="false" aria-label="Map showing Al Reem Tower">
        <!--
          Using a simpler embed source (q=...&output=embed) is often more robust than a pb=.. complex string.
          If you prefer a specific Maps place embed code from Google Maps (Share -> Embed a map) you can paste it here.
        -->
        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d57731.42933740014!2d55.24576215820314!3d25.263374400000004!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3e5f5d10c15be145%3A0xf93e5c8b4f928d15!2sAl%20Reem%20Tower!5e0!3m2!1sen!2sae!4v1770798068841!5m2!1sen!2sae" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>

      <!-- Contact form -->
      <section class="contact-form" aria-labelledby="form-heading">
        <h2 id="form-heading" style="text-align:center; margin-bottom:20px;">Send Us a Message</h2>

        <form id="contactForm" action="/customer/support-and-help/contact-submit" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input class="form-control" type="text" name="name" placeholder="Your Name" required aria-required="true">
          <input class="form-control" type="email" name="email" placeholder="Your Email" required aria-required="true">
          <input class="form-control" type="text" name="subject" placeholder="Subject" required aria-required="true">
          <textarea class="form-control" name="message" rows="6" placeholder="Your Message" required aria-required="true"></textarea>
        <div style="text-align:center; margin-top:8px;">
      <button class="btn-primary" type="submit">
        <span id="btnText">Submit Message</span>
        <span id="btnLoader" style="display:none;">
          <img src="/customer/images/loader.gif" alt="Loading" style="height:20px; vertical-align:middle;">
          Sending...
        </span>
      </button>
    </div>
        </form>
        <div id="formMessage" style="text-align:center; margin-top:12px; font-weight:600;"></div>
      </section>

    </main>
