  <style>
    /* Keep original design tokens and spacing */
    *, *::before, *::after { box-sizing: border-box; margin:0; padding:0; }
    a { color:#0b79f7; text-decoration:none; }
    a:hover { text-decoration:underline; }
    .container { max-width:1150px; margin:0 auto; padding:0 16px; }

    .skip { position:absolute; left:-999px; top:auto; width:1px; height:1px; overflow:hidden; }
    .skip:focus { position:static; width:auto; height:auto; padding:8px 12px; margin:12px; border-radius:6px; background:#111; color:#fff; }

    /* Hero */
    .site-hero { text-align:center; background:linear-gradient(180deg, #f7fbff 0%, #ffffff 100%); border-radius:12px; }
    .hero-inner { display:flex; flex-wrap:wrap; align-items:center; justify-content:center; gap:28px; max-width:1200px; margin:0 auto; padding:32px 16px; }
    .hero-copy { flex:1; min-width:280px; text-align:left; }
    .kicker { font-size:.82rem; text-transform:uppercase; letter-spacing:.08em; color:#4b5563; font-weight:700; margin-bottom:10px; }
    h1 { font-size:2.2rem; font-weight:800; margin-bottom:12px; color:#0f172a; }
    p.lead { font-size:1.05rem; color:#374151; margin-bottom:16px; }
    .hero-media { flex:1; min-width:280px; display:flex; justify-content:center; align-items:center; }
    .hero-media img { max-width:420px; width:100%; height:auto; border-radius:10px; }

    /* Content layout */
    section { padding:40px 0; }
    .grid { display:grid; grid-template-columns:1fr 360px; gap:28px; align-items:start; }
    .card { background:#fff; padding:24px; border-radius:12px; border:1px solid #e6eef8; }

    h2 { font-size:1.3rem; margin-bottom:12px; font-weight:700; color:#0f172a; }
    h3 { font-size:1.02rem; margin-bottom:8px; font-weight:700; color:#0f172a; display:flex; align-items:center; gap:10px; }
    .muted { color:#4b5563; line-height:1.7; }
    .toc { margin:8px 0 16px 0; }
    .toc a { display:block; padding:6px 0; color:#0b79f7; }
    .value-list { margin-top:12px; list-style:disc; padding-left:20px; }
    .value-list li { margin-bottom:12px; }
    .support-grid { display:grid; grid-template-columns:repeat(2, 1fr); gap:16px; }
    .support-item { padding:18px; border-radius:10px; background:#fbfdff; border:1px solid #e6eef8; min-height:120px; }
    .small { font-size:.95rem; color:#6b7280; }

    /* Icon visuals */
    .icon-box { display:inline-flex; align-items:center; justify-content:center; width:36px; height:36px; border-radius:8px; background:#eef6ff; color:#0b79f7; font-size:18px; }
    .support-item h3 .icon-box { margin-right:8px; }

    .faq { margin-top:18px; }
    .faq dt { font-weight:700; margin-top:12px; }
    .faq dd { margin-left:0; margin-bottom:12px; color:#374151; }

    /* Contact card */
    .contact-card { display:flex; gap:12px; align-items:flex-start; flex-wrap:wrap; }
    .contact-meta { flex:1; min-width:220px; }
    .contact-actions { width:260px; text-align:right; }

    /* Form */
    .support-form { margin-top:18px; background:#ffffff; border:1px solid #e6eef8; padding:18px; border-radius:10px; }
    .form-row { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
    .form-control { width:100%; padding:10px 12px; border-radius:8px; border:1px solid #dbe8f8; background:#fbfdff; font-size:0.95rem; color:#0f172a; }
    .form-label { font-weight:600; font-size:.95rem; margin-bottom:6px; color:#0f172a; }
    .full { grid-column: 1 / -1; }
    .btn-primary { background:#f10000; border:none; color:#fff; padding:10px 14px; border-radius:0px; display:inline-block; }
    .helper { font-size:.92rem; color:#6b7280; margin-top:6px; }

    .note { font-size:.95rem; color:#6b7280; }

    .table { width:100%; border-collapse:collapse; margin-top:12px; }
    .table th, .table td { text-align:left; padding:10px 12px; border:1px solid #eef2f7; vertical-align:top; }

    footer.site-footer { padding:32px 16px; text-align:center; color:#6b7280; font-size:.95rem; border-top:1px solid #e6eef8; }

    @media (max-width:992px){
      .grid { grid-template-columns:1fr; }
      .hero-copy, .hero-media { text-align:center; }
      .support-grid { grid-template-columns:1fr; }
      .form-row { grid-template-columns:1fr; }
      .contact-actions { width:100%; text-align:left; }
    }
  </style>
</head>
<body>
  <%- include('../includes/header') %>
  <a href="#main-content" class="skip">Skip to content</a>

  <main id="main-content" class="container" role="main" aria-live="polite">
    <!-- HERO -->
    <header class="site-hero" aria-labelledby="support-title">
      <div class="hero-inner">
        <div class="hero-copy">
          <div class="kicker">Help &amp; Support</div>
          <h1 id="support-title">We're here to help — JOOD Support</h1>
          <p class="lead">Fast, professional support for orders, returns, technical issues and corporate enquiries. Choose the channel that suits you and we'll work to resolve your request quickly and transparently.</p>
          <p class="small"><strong>Business hours:</strong> Sunday — Thursday, 9:00 AM — 9:00 PM (GST). For urgent matters use the emergency contact provided below.</p>
        </div>
        <div class="hero-media" aria-hidden="true">
          <img src="/customer/images/help-support/help-support.png" alt="Customer Support at JOOD">
        </div>
      </div>
    </header>

    <!-- Main content grid -->
    <section aria-label="Help content">
      <div class="grid">
        <div>
          <article class="card" aria-labelledby="support-heading">
            <h2 id="support-heading">How we can help</h2>
            <p class="muted">Our Support team specialises in resolving a broad range of customer needs. Below are the most common categories — please consult the self-service resources first (fastest resolution).</p>

            <div class="support-grid" role="list">
              <div class="support-item" role="listitem" aria-labelledby="s1">
                <h3 id="s1"><span class="icon-box"><i class="fas fa-box"></i></span>Order &amp; Tracking</h3>
                <p class="small muted">Status updates, tracking numbers, delivery windows, change of delivery address.</p>
                <p class="muted">Self-service: Track your order via <strong>My Orders</strong> in your account. To update delivery details, contact support within 1 hour of placing the order.</p>
              </div>

              <div class="support-item" role="listitem" aria-labelledby="s2">
                <h3 id="s2"><span class="icon-box"><i class="fas fa-undo-alt"></i></span>Returns &amp; Refunds</h3>
                <p class="small muted">Eligibility checks, return labels, refund timelines and exceptions.</p>
                <p class="muted">Most items eligible for return within 14 days subject to our Returns Policy. Refunds processed within 5–10 business days upon receipt.</p>
              </div>

              <div class="support-item" role="listitem" aria-labelledby="s3">
                <h3 id="s3"><span class="icon-box"><i class="fas fa-credit-card"></i></span>Payments &amp; Billing</h3>
                <p class="small muted">Payment failures, refunds, invoices, and transaction disputes.</p>
                <p class="muted">We use PCI-compliant payment gateways. For disputes, provide transaction ID and supporting evidence for faster resolution.</p>
              </div>

              <div class="support-item" role="listitem" aria-labelledby="s4">
                <h3 id="s4"><span class="icon-box"><i class="fas fa-tools"></i></span>Technical Support</h3>
                <p class="small muted">Website issues, account access, password resets, and error reporting.</p>
                <p class="muted">Try clearing cache, incognito mode, or reset password first. If unresolved, attach screenshots and exact error messages to your ticket.</p>
              </div>

              <div class="support-item" role="listitem" aria-labelledby="s5">
                <h3 id="s5"><span class="icon-box"><i class="fas fa-shield-alt"></i></span>Warranty &amp; Product Care</h3>
                <p class="small muted">Manufacturer warranties, installation guidance, maintenance advice.</p>
                <p class="muted">Include SKU, purchase proof and clear photos/videos to speed verification and warranty processing.</p>
              </div>

              <div class="support-item" role="listitem" aria-labelledby="s6">
                <h3 id="s6"><span class="icon-box"><i class="fas fa-briefcase"></i></span>Corporate &amp; B2B</h3>
                <p class="small muted">Bulk orders, invoicing, reseller programmes, and partnership enquiries.</p>
                <p class="muted">Provide company details and procurement requirements; dedicated account managers available for enterprise engagements.</p>
              </div>
            </div>

            <hr style="border:none;border-top:1px solid #eef2f7;margin:18px 0;">

            <h2>Self-Service &amp; Resources</h2>
            <p class="muted">Before contacting support, many issues can be solved instantly:</p>
            <ul class="muted value-list">
              <li><strong>My Orders:</strong> Track, cancel or request returns for active orders.</li>
              <li><strong>Help Center Articles:</strong> Search guides and troubleshooting steps.</li>
              <li><strong>Account Settings:</strong> Manage addresses, payments, and communication preferences.</li>
            </ul>

            <h2>Priority &amp; Response SLAs</h2>
            <p class="muted">We prioritise requests by severity. These are our target response times (business hours):</p>
            <table class="table" role="table" aria-label="Support SLA table">
              <thead>
                <tr><th>Priority</th><th>Type</th><th>Initial Response</th><th>Resolution Target</th></tr>
              </thead>
              <tbody>
                <tr><td>Urgent</td><td>Safety, fraud, delivery failure</td><td>Within 1 hour</td><td>24 hours</td></tr>
                <tr><td>High</td><td>Payment failure, major account issues</td><td>Within 4 hours</td><td>48 hours</td></tr>
                <tr><td>Normal</td><td>Order questions, returns</td><td>Within 24 hours</td><td>3–5 business days</td></tr>
                <tr><td>Low</td><td>General enquiries</td><td>Within 48 hours</td><td>5–10 business days</td></tr>
              </tbody>
            </table>

            <h2>Escalation &amp; Complaints</h2>
            <p class="muted">If you are not satisfied with a resolution, escalate to a supervisor or the Customer Experience Team:</p>
            <ol class="muted value-list">
              <li>Submit a formal complaint via the support form or email with order/reference number and details.</li>
              <li>We acknowledge receipt within 24 hours and commence an investigation.</li>
              <li>We aim to provide a written response within 10 business days or keep you updated if more time is required.</li>
            </ol>

            <h2>FAQ — Quick Answers</h2>
            <dl class="faq">
              <dt>How do I track my order?</dt>
              <dd>Log into your account → My Orders → Select the order → View tracking link. If no tracking is available, contact support with your order number.</dd>

              <dt>How long will my refund take?</dt>
              <dd>Once we receive and inspect the returned item, refunds are issued within 5–10 business days depending on your payment provider.</dd>

              <dt>Can I change my delivery address after placing an order?</dt>
              <dd>We can attempt to update the address if the order has not been dispatched. Contact support immediately with the new address and order number.</dd>

              <dt>What should I include with a warranty claim?</dt>
              <dd>Include proof of purchase, product SKU, photos/videos of the issue, and a brief description of the problem.</dd>
            </dl>

            <hr style="border:none;border-top:1px solid #eef2f7;margin:18px 0;">

            <h2>How to contact us</h2>
            <p class="muted">Choose your preferred channel below. For faster service, include order number, screenshots, and a concise description.</p>

            <div class="card contact-card" style="padding:16px;margin-top:12px;">
              <div class="contact-meta">
                <p class="muted"><span class="icon-box"><i class="fas fa-envelope"></i></span> <strong>Email:</strong> <a href="mailto:support@jood.com">support@jood.com</a></p>
                <p class="muted"><span class="icon-box"><i class="fas fa-phone-alt"></i></span> <strong>Phone:</strong> +971-55-555-5555 (Support line)</p>
                <p class="muted"><span class="icon-box"><i class="fas fa-clock"></i></span> <strong>Business hours:</strong> Sun–Thu, 9:00 AM–9:00 PM GST</p>
                <p class="muted"><span class="icon-box"><i class="fas fa-building"></i></span> <strong>Address:</strong> Al Reem Tower, Dubai, UAE</p>
              </div>

              <div class="contact-actions">
                <a href="/customer/contact-us" class="btn btn-primary" style="padding:10px 14px;border-radius:8px;">Open Support Ticket</a>
                <p class="small muted" style="margin-top:8px">For urgent escalations call the support number and select option 2.</p>
              </div>
            </div>

            <p class="note" style="margin-top:14px">Note: Response times are targets and may vary during peak periods or public holidays. Please retain transaction receipts and order confirmations for faster handling.</p>

            <!-- Support Form -->
            <hr style="border:none;border-top:1px solid #eef2f7;margin:22px 0;">
            <h2>Submit a Support Request</h2>
            <p class="muted">Fill the form below — include order number and screenshots where applicable. Our support team will respond according to priority SLA.</p>

          <form id="supportForm"
      class="support-form"
      action="/customer/support/submit"
      method="POST"
      enctype="multipart/form-data"
      novalidate>

  <!-- CSRF Token (ENABLE if you use csurf) -->
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <div class="form-row">

    <!-- NAME -->
    <div>
      <label for="name" class="form-label">Full name</label>
      <input id="name" name="name" type="text"
             class="form-control"
             placeholder="Your full name"
             minlength="2" maxlength="150"
             required>
      <small class="error-msg"></small>
    </div>

    <!-- EMAIL -->
    <div>
      <label for="email" class="form-label">Email address</label>
      <input id="email" name="email" type="email"
             class="form-control"
             placeholder="you@example.com"
             required>
      <small class="error-msg"></small>
    </div>

    <!-- PHONE -->
    <div>
      <label for="phone" class="form-label">Phone (optional)</label>
      <input id="phone" name="phone" type="tel"
             class="form-control"
             placeholder="+971-5X-XXX-XXXX"
             pattern="^\+?[0-9\-\s]{6,20}$">
      <small class="error-msg"></small>
    </div>

    <!-- ORDER -->
    <div>
      <label for="order" class="form-label">Order number (if applicable)</label>
      <input id="order" name="orderNumber" type="text"
             class="form-control"
             placeholder="e.g. #12345678"
             maxlength="50">
    </div>

    <!-- CATEGORY -->
    <div class="full">
      <label for="category" class="form-label">Issue category</label>
      <select id="category" name="category" class="form-control" required>
        <option value="">Select category...</option>
        <option>Order & Tracking</option>
        <option>Returns & Refunds</option>
        <option>Payments & Billing</option>
        <option>Technical Support</option>
        <option>Warranty & Product Care</option>
        <option>Corporate & B2B</option>
        <option>Other</option>
      </select>
      <small class="error-msg"></small>
    </div>

    <!-- SUBJECT -->
    <div class="full">
      <label for="subject" class="form-label">Subject</label>
      <input id="subject" name="subject" type="text"
             class="form-control"
             placeholder="Short summary of your issue"
             minlength="3" maxlength="200"
             required>
      <small class="error-msg"></small>
    </div>

    <!-- MESSAGE -->
    <div class="full">
      <label for="message" class="form-label">Message / Description</label>
      <textarea id="message" name="message"
                rows="6"
                class="form-control"
                placeholder="Describe your issue in detail..."
                minlength="5" maxlength="5000"
                required></textarea>
      <small class="error-msg"></small>
    </div>

    <!-- ATTACHMENT -->
    <div>
      <label for="attachment" class="form-label">Attachment (optional)</label>
      <input id="attachment" name="attachment"
             type="file"
             class="form-control"
             accept=".jpg,.jpeg,.png,.pdf,.mp4" />
      <div class="helper">Max file size: 8MB.</div>
      <small class="error-msg"></small>
    </div>

    <!-- CONTACT METHOD -->
    <div>
      <label for="contactMethod" class="form-label">Preferred contact</label>
      <select id="contactMethod" name="preferredContact" class="form-control" required>
        <option value="email">Email</option>
        <option value="phone">Phone</option>
      </select>
    </div>

    <!-- SUBMIT -->
    <div class="full" style="margin-top:8px">
      <button type="submit" id="submitBtn" class="btn-primary">
        Send request
      </button>
      <span id="formStatus" class="helper" style="margin-left:12px"></span>
    </div>

  </div>
          </form>
<script>
document.addEventListener("DOMContentLoaded", () => {
  const form = document.getElementById("supportForm");
  const submitBtn = document.getElementById("submitBtn");
  const statusEl = document.getElementById("formStatus");
  const attachment = document.getElementById("attachment");
  const MAX_BYTES = 8 * 1024 * 1024; // 8MB
  const helperText = attachment.nextElementSibling;

  // Initialize button with loader
  if (!document.getElementById("btnText")) {
    submitBtn.innerHTML = `
      <span id="btnText">Send request</span>
      <span id="btnLoader" style="display:none;">
        <img src="/customer/images/loader.gif" alt="Loading" style="height:18px; vertical-align:middle;"> Sending...
      </span>
    `;
  }
  const btnText = document.getElementById("btnText");
  const btnLoader = document.getElementById("btnLoader");

  // Show selected file name
  attachment.addEventListener("change", () => {
    if (attachment.files && attachment.files[0]) {
      helperText.textContent = `Selected: ${attachment.files[0].name} (Max 8MB)`;
    } else {
      helperText.textContent = "Max file size: 8MB";
    }
  });

  // Submit handler
  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    statusEl.textContent = "";
    statusEl.style.color = "";
    btnText.style.display = "none";
    btnLoader.style.display = "inline-block";

    // File size validation
    if (attachment.files[0] && attachment.files[0].size > MAX_BYTES) {
      statusEl.textContent = "Attachment exceeds 8MB limit.";
      statusEl.style.color = "crimson";
      btnText.style.display = "inline";
      btnLoader.style.display = "none";
      return;
    }

    // CSRF token
    const csrfInput = form.querySelector('input[name="_csrf"]');
    const csrfToken = csrfInput ? csrfInput.value : null;
    if (!csrfToken) {
      statusEl.textContent = "CSRF token missing. Reload the page and try again.";
      statusEl.style.color = "crimson";
      btnText.style.display = "inline";
      btnLoader.style.display = "none";
      return;
    }

    const formData = new FormData(form);

    try {
     const response = await fetch(form.action, {
  method: "POST",
  body: formData,
  credentials: "same-origin",
  headers: {
    "Accept": "application/json",
    "CSRF-Token": csrfToken,
    "X-CSRF-Token": csrfToken
  }
});

// clone the response in case json() fails
let data;
try {
  data = await response.clone().json(); // try parse JSON
} catch (err) {
  try {
    const text = await response.text(); // fallback to raw text
    data = { success: false, message: text || "Server error. Please try again later." };
  } catch (e) {
    data = { success: false, message: "Server error. Failed to parse response." };
  }
}


      btnText.style.display = "inline";
      btnLoader.style.display = "none";

      if (data?.success) {
        form.reset();
        helperText.textContent = "Max file size: 8MB";
        statusEl.textContent = data.message || "Your request has been sent successfully!";
        statusEl.style.color = "green";
      } else {
        // Show exact HTTP status code if available
        const statusCode = response.status || "N/A";
        statusEl.textContent = `Error ${statusCode}: ${data.message || "Server error. Please try again later."}`;
        statusEl.style.color = "crimson";
        console.error("Support form error:", statusCode, data);
      }
    } catch (err) {
      btnText.style.display = "inline";
      btnLoader.style.display = "none";
      statusEl.textContent = `Network or server error: ${err.message}`;
      statusEl.style.color = "crimson";
      console.error("Support form fetch error:", err);
    }
  });
});
</script>


          </article>
