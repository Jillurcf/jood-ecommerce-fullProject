<style>
/* Button Wrapper */
.checkout-btn-wrapper{
    display: flex;
    justify-content: flex-end;
    width: 100%;
}

/* =========================
   Professional Checkout Button
========================= */
.checkout-btn{
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;

    width: 20%;
    max-width: 320px;
    height: 54px;
    padding: 0 22px;

    border-radius: 14px;
    border: none;

    /* Dark Warning Yellow */
    background: linear-gradient(135deg, #eab308, #eab308);
    color: #ffffff;

    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.3px;
    text-decoration: none;

    overflow: hidden;
    cursor: pointer;

    transition: all 0.25s ease;

    -webkit-tap-highlight-color: transparent;
    box-sizing: border-box;
}

/* Hover */
.checkout-btn:hover{
    background: linear-gradient(135deg, #fbbf24, #ea580c);
    transform: translateY(-2px);
    color: #fff;
    text-decoration: none;
}

/* Active */
.checkout-btn:active{
    transform: scale(0.98);
}

/* Shine Effect */
.checkout-btn::before{
    content: "";
    position: absolute;
    top: 0;
    left: -120%;
    width: 100%;
    height: 100%;
    background: rgba(255,255,255,0.18);
    transform: skewX(-25deg);
    transition: 0.7s;
}

.checkout-btn:hover::before{
    left: 120%;
}

/* Text */
.checkout-btn span{
    position: relative;
    z-index: 2;
}

/* Tablet */
@media (max-width: 768px){
    .checkout-btn{
        max-width: 220px;
        height: 50px;
        font-size: 15px;
    }
}

/* Mobile */
@media (max-width: 576px){
    .checkout-btn-wrapper{
        justify-content: flex-end;
    }

    .checkout-btn{
        max-width: 180px;
        height: 46px;
        font-size: 14px;
        border-radius: 10px;
    }
}
</style>
