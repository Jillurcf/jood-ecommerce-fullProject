  <script>
    (function () {
      "use strict";

      const API = "/customer/cart/api";
      const API_UPDATE = "/customer/cart/update";
      const API_REMOVE = "/customer/cart/remove";
      const GUEST_KEY = "guest_wishlist_token";
      const DEFAULT_IMAGE = "/uploads/products/default.jpg";
      const CSRF = document.querySelector('meta[name="csrf-token"]')?.content || null;

      function toNum(v) {
        const n = Number(v);
        return Number.isFinite(n) ? n : 0;
      }

      function escapeHtml(v) {
        return v == null ? "" : String(v)
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#39;");
      }

      function getItems(cart) {
        if (Array.isArray(cart?.items)) return cart.items;
        if (Array.isArray(cart?.data)) return cart.data;
        if (Array.isArray(cart?.cart)) return cart.cart;
        if (Array.isArray(cart?.rows)) return cart.rows;
        return [];
      }

      function normalizeImage(raw) {
        if (!raw) return DEFAULT_IMAGE;

        let img = String(raw).trim().replaceAll("\\", "/");

        if (img.startsWith("http://") || img.startsWith("https://") || img.startsWith("//")) {
          return img;
        }

        if (img.startsWith("/")) {
          return img;
        }

        img = img.replace(/^\/+/, "");

        if (img.startsWith("uploads/products/") || img.startsWith("uploads/")) {
          return "/" + img;
        }

        return "/uploads/products/" + img;
      }

      function getImagePath(item) {
        const raw =
          item?.variant_image ||
          item?.filename ||
          item?.media_filename ||
          item?.image ||
          item?.pv_image ||
          item?.main_image ||
          item?.product_image ||
          item?.product?.image ||
          "";
        return normalizeImage(raw);
      }

      function getName(item) {
        return item?.pv_name || item?.variant_name || item?.name || item?.product_name || "Unnamed Item";
      }

      function getBrand(item) {
        return (
          item?.product_brand ||
          item?.brand_name ||
          item?.brand ||
          item?.pv_brand ||
          item?.product?.brand ||
          item?.product?.brand_name ||
          "—"
        );
      }

      function getProductId(item) {
        return item?.pv_product_id ?? item?.cart_product_id ?? item?.product_id ?? item?.master_id ?? item?.id ?? "";
      }

      function getVariantId(item) {
        return item?.variant_id ?? item?.pv_id ?? item?.id ?? "";
      }

      function getQty(item) {
        return Number(item?.quantity ?? item?.qty ?? item?.in_cart_qty ?? 1) || 1;
      }

      function getOriginalPrice(item) {
        const p1 = toNum(item?.pv_price);
        const p2 = toNum(item?.price);
        const p3 = toNum(item?.original_price);
        return p1 > 0 ? p1 : (p2 > 0 ? p2 : p3);
      }

      function getSalePrice(item) {
        const s = toNum(item?.pv_sale_price);
        if (s > 0) return s;
        return 0;
      }

      function getDiscountPerUnit(item, originalPrice, effectivePrice) {
        const type = String(item?.pv_discount_type || "").toLowerCase().trim();
        const value = toNum(item?.pv_discount_value);

        if (value > 0) {
          if (type === "percent" || type === "percentage") {
            return (originalPrice * value) / 100;
          }
          return value;
        }

        return Math.max(originalPrice - effectivePrice, 0);
      }
function getVatPerUnit(item, priceAfterDiscount) {
  const vatRate = Number(item?.pv_vat_rate || 0);

  const vatIncluded =
    item?.pv_vat_included === true ||
    item?.pv_vat_included === 1 ||
    item?.pv_vat_included === "1" ||
    String(item?.pv_vat_included).toLowerCase() === "true";

  // ❌ FIX: proper guard
  if (vatRate <= 0) return 0;

  // if VAT already included in price → skip calculation
  if (vatIncluded) return 0;

  return (priceAfterDiscount * vatRate) / 100;
}

   function calcRow(item) {
  const qty = getQty(item);

  const originalPrice = getOriginalPrice(item);

  // FIXED DISCOUNT
  const discountPerUnit = getDiscountPerUnit(item, originalPrice, originalPrice);

  const priceAfterDiscount = Math.max(originalPrice - discountPerUnit, 0);

  // FIXED VAT BASED ON YOUR RULE
  const vatRate = Number(item?.pv_vat_rate || 0);

  const vatIncluded = false; 
  // (IMPORTANT: do NOT block VAT unless you really store inclusive pricing)

  const vatPerUnit = vatRate > 0
    ? (priceAfterDiscount * vatRate) / 100
    : 0;

  const lineSubtotal = originalPrice * qty;
  const lineDiscount = discountPerUnit * qty;
  const lineVat = vatPerUnit * qty;

  const lineTotal = (priceAfterDiscount + vatPerUnit) * qty;

  return {
    qty,
    originalPrice,
    discountPerUnit,
    priceAfterDiscount,
    vatPerUnit,
    lineSubtotal,
    lineDiscount,
    lineVat,
    lineTotal
  };
}   function getGuestToken() {
        try {
          const existing = localStorage.getItem(GUEST_KEY);
          if (existing) return existing;
          const token = "guest_" + Math.random().toString(36).slice(2, 12);
          localStorage.setItem(GUEST_KEY, token);
          return token;
        } catch (e) {
          return "guest_" + Math.random().toString(36).slice(2, 12);
        }
      }

      const GUEST_TOKEN = getGuestToken();

      async function apiFetch(url, method = "GET", body = null) {
        const headers = {
          "x-guest-token": GUEST_TOKEN
        };

        if (method !== "GET") {
          headers["Content-Type"] = "application/json";
          if (CSRF) headers["x-csrf-token"] = CSRF;
        }

        const res = await fetch(url, {
          method,
          headers,
          credentials: "same-origin",
          body: method === "GET" || body == null ? undefined : JSON.stringify(body)
        });

        let json = null;
        try {
          json = await res.json();
        } catch (e) {}

        if (!res.ok) {
          const msg = (json && json.message) ? json.message : `HTTP ${res.status}`;
          const err = new Error(msg);
          err.status = res.status;
          err.body = json;
          throw err;
        }

        return json;
      }

      function setBusy(el, busy) {
        if (!el) return;

        if (busy) {
          el.dataset.originalHtml = el.innerHTML;
          el.disabled = true;
          el.innerHTML = '<i class="fa fa-spinner fa-spin" aria-hidden="true"></i>';
        } else {
          el.disabled = false;
          if (el.dataset.originalHtml) {
            el.innerHTML = el.dataset.originalHtml;
            delete el.dataset.originalHtml;
          }
        }
      }

      function renderCart(cart) {
        const countEl = document.getElementById("cartx-items-count");
        const subtotalEl = document.getElementById("cartx-subtotal");
        const discountEl = document.getElementById("cartx-discount-total");
        const vatEl = document.getElementById("cartx-vat-total");
        const totalEl = document.getElementById("cartx-total-amount");
        const subtitleEl = document.getElementById("cartx-page-subtitle");
        const bodyEl = document.getElementById("cartx-table-body");

        const items = getItems(cart);

        const summary = items.reduce((acc, item) => {
          const row = calcRow(item);
          acc.items += row.qty;
          acc.subtotal += row.lineSubtotal;
          acc.discount += row.lineDiscount;
          acc.vat += row.lineVat;
          acc.total += row.lineTotal;
          return acc;
        }, { items: 0, subtotal: 0, discount: 0, vat: 0, total: 0 });

        if (countEl) countEl.textContent = String(summary.items);
        if (subtotalEl) subtotalEl.textContent = summary.subtotal.toFixed(2);
        if (discountEl) discountEl.textContent = summary.discount.toFixed(2);
        if (vatEl) vatEl.textContent = summary.vat.toFixed(2);
        if (totalEl) totalEl.textContent = summary.total.toFixed(2);

        if (subtitleEl) {
          subtitleEl.textContent = items.length
            ? `${items.length} line item(s) in your cart`
            : "Your cart is currently empty";
        }

        if (!bodyEl) return;

        if (!items.length) {
          bodyEl.innerHTML = `
            <tr>
              <td colspan="8">
                <div class="cartx-empty-cart">
                  <h3>Your cart is empty</h3>
                  <p>Browse products and add items to see them here.</p>
                  <a href="/">Continue Shopping</a>
                </div>
              </td>
            </tr>
          `;
          return;
        }

        bodyEl.innerHTML = items.map((item) => {
          const row = calcRow(item);
          const productId = getProductId(item);
          const variantId = getVariantId(item);
          const name = getName(item);
          const brand = getBrand(item);
          const img = getImagePath(item);

          return `
            <tr data-variant-id="${escapeHtml(String(variantId))}">
              <td>
                <a href="/customer/product/product-details/${productId}/${variantId}">
                  <img src="${img}" alt="${escapeHtml(name)}">
                </a>
              </td>

              <td class="cartx-product-cell">
                <a href="/customer/product/product-details/${productId}/${variantId}" class="cartx-product-name">
                  ${escapeHtml(name)}
                </a>
              </td>

              <td>${escapeHtml(brand)}</td>

              <td>
                <div class="cartx-price-wrap">
                  ${
                    row.discountPerUnit > 0
                      ? `
                        <span class="cartx-price-old">AED ${row.originalPrice.toFixed(2)}</span>
                        <span class="cartx-price-current">AED ${row.priceAfterDiscount.toFixed(2)}</span>
                        <span class="cartx-price-saved"> Discount: AED ${row.discountPerUnit.toFixed(2)} / item</span>
                        <span class="cartx-inline-note">VAT: AED ${row.vatPerUnit.toFixed(2)} / item</span>
                      `
                      : `
                        <span class="cartx-price-current">AED ${row.originalPrice.toFixed(2)}</span>
                        <span class="cartx-inline-note">VAT: AED ${row.vatPerUnit.toFixed(2)} / item</span>
                      `
                  }
                </div>
              </td>

              <td>
                <div class="cartx-qty-box">
                  <button type="button" class="cartx-qty-btn js-cartx-minus" data-variant-id="${escapeHtml(String(variantId))}">−</button>
                  <input class="cartx-qty-input" type="text" value="${row.qty}" readonly>
                  <button type="button" class="cartx-qty-btn js-cartx-plus" data-variant-id="${escapeHtml(String(variantId))}">+</button>
                </div>
              </td>

              <td>
                <strong>AED ${row.lineTotal.toFixed(2)}</strong>
                
              </td>

              <td>
                <button type="button" class="cartx-action-btn js-cartx-remove" data-variant-id="${escapeHtml(String(variantId))}">
                  <i class="fa-solid fa-trash"></i>
                </button>
              </td>
            </tr>
          `;
        }).join("");
      }

      async function loadCart() {
        try {
          const json = await apiFetch(API, "GET");
          renderCart(json);
        } catch (error) {
          console.error("Cart load error:", error);
          renderCart({ items: [] });
        }
      }

      async function updateCartQty(variantId, qty) {
        return apiFetch(API_UPDATE, "POST", {
          variant_id: Number(variantId),
          quantity: Number(qty)
        });
      }

      async function removeFromCart(variantId) {
        return apiFetch(API_REMOVE, "POST", {
          variant_id: Number(variantId)
        });
      }

      document.addEventListener("DOMContentLoaded", () => {
        loadCart();

        const refreshBtn = document.getElementById("cartx-refresh-btn");
        if (refreshBtn) {
          refreshBtn.addEventListener("click", loadCart);
        }

        const bodyEl = document.getElementById("cartx-table-body");

        if (bodyEl) {
          bodyEl.addEventListener("click", async (e) => {
            const target = e.target;
            if (!target) return;

            const plusBtn = target.closest(".js-cartx-plus");
            const minusBtn = target.closest(".js-cartx-minus");
            const removeBtn = target.closest(".js-cartx-remove");

            try {
              if (plusBtn) {
                e.preventDefault();
                const variantId = plusBtn.dataset.variantId;
                const row = plusBtn.closest("tr");
                const qtyInput = row?.querySelector(".cartx-qty-input");
                const currentQty = toNum(qtyInput?.value || 0);

                setBusy(plusBtn, true);
                await updateCartQty(variantId, currentQty + 1);
                await loadCart();
              }

              if (minusBtn) {
                e.preventDefault();
                const variantId = minusBtn.dataset.variantId;
                const row = minusBtn.closest("tr");
                const qtyInput = row?.querySelector(".cartx-qty-input");
                const currentQty = toNum(qtyInput?.value || 0);

                setBusy(minusBtn, true);

                if (currentQty <= 1) {
                  await removeFromCart(variantId);
                } else {
                  await updateCartQty(variantId, currentQty - 1);
                }

                await loadCart();
              }

              if (removeBtn) {
                e.preventDefault();
                const variantId = removeBtn.dataset.variantId;
                setBusy(removeBtn, true);
                await removeFromCart(variantId);
                await loadCart();
              }
            } catch (err) {
              console.error("Cart action failed:", err);
              alert(err?.body?.message || err.message || "Cart action failed");
            } finally {
              [plusBtn, minusBtn, removeBtn].forEach(btn => {
                if (btn) setBusy(btn, false);
              });
            }
          });
        }

        const socket = typeof io !== "undefined"
          ? io({ transports: ["websocket"], withCredentials: true })
          : null;

        const CURRENT_USER_ID = window.CURRENT_USER_ID || null;
        const CURRENT_GUEST_ID = localStorage.getItem(GUEST_KEY) || null;

        if (socket) {
          socket.on("cartUpdated", (payload) => {
            const { userId, guestId } = payload || {};
            if (userId === CURRENT_USER_ID || guestId === CURRENT_GUEST_ID) {
              loadCart();
            }
          });
        }

        window.loadCart = loadCart;
      });
    })();
  </script>

