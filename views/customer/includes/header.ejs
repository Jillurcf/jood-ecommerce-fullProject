<!-- Socket.IO -->
<script src="/socket.io/socket.io.js"></script>

<script>
document.addEventListener("DOMContentLoaded", () => {
    "use strict";

    const countEl = document.querySelector(".wishlist-item-count");
    if (!countEl) return;

    const CURRENT_USER_ID = window.CURRENT_USER_ID || null;

    /* =========================================================
       GUEST TOKEN
    ========================================================= */
    const GUEST_KEY = "guest_wishlist_token";

    function generateGuestToken() {
        return "guest_" +
            Math.random().toString(36).substring(2) +
            Date.now().toString(36);
    }

    const CURRENT_GUEST_ID = (() => {
        try {
            let token = localStorage.getItem(GUEST_KEY);

            if (!token) {
                token = generateGuestToken();
                localStorage.setItem(GUEST_KEY, token);
            }

            return token;
        } catch (err) {
            console.error("Guest token error:", err);
            return generateGuestToken();
        }
    })();

    /* =========================================================
       SOCKET
    ========================================================= */
    const socket = typeof io !== "undefined"
        ? io({
            transports: ["websocket"],
            withCredentials: true
        })
        : null;

    /* =========================================================
       HELPERS
    ========================================================= */
    function setCount(count) {
        countEl.textContent = Number(count || 0);
    }

    function updateWishlistCount(isFav) {
        let current = Number(countEl.textContent || 0);

        current = isFav
            ? current + 1
            : Math.max(0, current - 1);

        setCount(current);
    }

    function getHeaders() {
        const headers = {
            "Content-Type": "application/json"
        };

        // Only send guest token for guests
        if (!CURRENT_USER_ID) {
            headers["x-guest-token"] = CURRENT_GUEST_ID;
        }

        return headers;
    }

    /* =========================================================
       FETCH WISHLIST COUNT
    ========================================================= */
    async function fetchWishlistCount() {
        try {
            const response = await fetch("/wishlist/data", {
                method: "GET",
                credentials: "same-origin",
                headers: getHeaders()
            });

            if (!response.ok) {
                throw new Error("Failed to fetch wishlist count");
            }

            const data = await response.json();

            if (data && data.success) {
                setCount(data.total || 0);
            }
        } catch (err) {
            console.error("Wishlist count error:", err);
        }
    }

    /* =========================================================
       TOGGLE WISHLIST
    ========================================================= */
    async function toggleWishlist(variantId) {

        if (!variantId) {
            console.error("Variant ID missing");
            return;
        }

        try {

            const response = await fetch("/wishlist/toggle", {
                method: "POST",
                credentials: "same-origin",
                headers: getHeaders(),
                body: JSON.stringify({
                    variant_id: variantId
                })
            });

            if (!response.ok) {
                throw new Error("Wishlist request failed");
            }

            const data = await response.json();

            if (data.success) {

                if (typeof data.total !== "undefined") {
                    setCount(data.total);
                } else if (typeof data.is_fav !== "undefined") {
                    updateWishlistCount(data.is_fav);
                }

                // Optional: update button state
                const btns = document.querySelectorAll(
                    `[data-wishlist-variant="${variantId}"]`
                );

                btns.forEach(btn => {
                    btn.classList.toggle("active", !!data.is_fav);
                });

            } else {
                console.error(data.message || "Wishlist update failed");
            }

        } catch (err) {
            console.error("Toggle wishlist error:", err);
        }
    }

    /* =========================================================
       SOCKET EVENTS
    ========================================================= */
    if (socket) {

        socket.on("connect", () => {
            console.log("Wishlist socket connected");
        });

        socket.on("wishlistUpdated", (payload = {}) => {

            const {
                userId,
                guestId,
                total,
                is_fav
            } = payload;

            // Logged in user
            if (
                CURRENT_USER_ID &&
                String(userId) === String(CURRENT_USER_ID)
            ) {

                if (typeof total !== "undefined") {
                    setCount(total);
                } else if (typeof is_fav !== "undefined") {
                    updateWishlistCount(is_fav);
                }
            }

            // Guest user
            if (
                !CURRENT_USER_ID &&
                guestId === CURRENT_GUEST_ID
            ) {

                if (typeof total !== "undefined") {
                    setCount(total);
                } else if (typeof is_fav !== "undefined") {
                    updateWishlistCount(is_fav);
                }
            }
        });
    }

    /* =========================================================
       AUTO MERGE AFTER LOGIN
       Guest wishlist → user wishlist
    ========================================================= */
    async function mergeGuestWishlistAfterLogin() {

        if (!CURRENT_USER_ID) return;

        try {

            const guestToken = localStorage.getItem(GUEST_KEY);

            if (!guestToken) return;

            const response = await fetch("/wishlist/merge", {
                method: "POST",
                credentials: "same-origin",
                headers: {
                    "Content-Type": "application/json",
                    "x-guest-token": guestToken
                }
            });

            const data = await response.json();

            if (data.success) {

                // Remove old guest token
                localStorage.removeItem(GUEST_KEY);

                // Refresh count
                fetchWishlistCount();

                console.log("Wishlist merged successfully");
            }

        } catch (err) {
            console.error("Wishlist merge error:", err);
        }
    }

    /* =========================================================
       INIT
    ========================================================= */
    fetchWishlistCount();
    mergeGuestWishlistAfterLogin();

    /* =========================================================
       GLOBAL ACCESS
    ========================================================= */
    window.toggleWishlist = toggleWishlist;

});
</script>
