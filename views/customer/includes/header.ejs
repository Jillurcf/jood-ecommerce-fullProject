  width: 6px;
}

body:hover::-webkit-scrollbar-track {
  background: transparent;
}

body:hover::-webkit-scrollbar-thumb {
  background-color: rgba(0, 0, 0, 0.4);
  border-radius: 10px;
}

body:hover::-webkit-scrollbar-thumb:hover {
  background-color: rgba(0, 0, 0, 0.6);
}
