                                }

                                .minicart-product-list li a {
                                    display: flex;
                                    align-items: center;
                                    text-decoration: none;
                                    color: #333;
                                    flex: 1;
                                }

                                .minicart-product-list li .item-info {
                                    display: flex;
                                    flex-direction: column;
                                    justify-content: center;
                                }

                                .minicart-product-list li .item-qty-price {
                                    white-space: nowrap;
                                    margin-left: 10px;
                                }
                            </style>

                            <script>
                                (function () {
                                    "use strict";

                                    const API = "/customer/cart/api";
                                    const GUEST_KEY = "guest_wishlist_token";
                                    const DEFAULT_IMAGE = "/uploads/products/default.jpg";

                                    function toNum(v) {
                                        const n = Number(v);
                                        return Number.isFinite(n) ? n : 0;
                                    }

                                    function escapeHtml(v) {
                                        return v == null ? "" : String(v)
                                            .replaceAll("&", "&amp;")
                                            .replaceAll("<", "&lt;")
                                            .replaceAll(">", "&gt;")
                                            .replaceAll('"', "&quot;")
                                            .replaceAll("'", "&#39;");
                                    }

                                    function getItems(cart) {
                                        if (Array.isArray(cart?.items)) return cart.items;
                                        if (Array.isArray(cart?.data)) return cart.data;
                                        if (Array.isArray(cart?.cart)) return cart.cart;
                                        if (Array.isArray(cart?.rows)) return cart.rows;
                                        return [];
                                    }

                                    function normalizeImage(raw) {
                                        if (!raw) return DEFAULT_IMAGE;

                                        let img = String(raw).trim().replaceAll("\\", "/");

                                        if (
                                            img.startsWith("http://") ||
                                            img.startsWith("https://") ||
                                            img.startsWith("//")
                                        ) {
                                            return img;
                                        }

                                        if (img.startsWith("/")) {
                                            return img;
                                        }

                                        img = img.replace(/^\/+/, "");

                                        if (
                                            img.startsWith("uploads/products/") ||
                                            img.startsWith("uploads/")
                                        ) {
                                            return "/" + img;
                                        }

                                        return "/uploads/products/" + img;
                                    }

                                    function getImagePath(item) {
                                        const raw = item?.variant_image || item?.image || item?.main_image || item?.product_image || "";
                                        return normalizeImage(raw);
                                    }

                                    function getName(item) {
                                        return item?.variant_name || item?.name || item?.product_name || "Unnamed Item";
                                    }

                                    function getProductId(item) {
                                        return item?.product_id ?? item?.master_id ?? item?.id ?? "";
                                    }

                                    function getVariantId(item) {
                                        return item?.variant_id ?? item?.id ?? "";
                                    }

                                    function getQty(item) {
                                        return Number(item?.quantity ?? item?.qty ?? item?.in_cart_qty ?? 1) || 1;
                                    }

                                    function getPrice(item) {
                                        return Number(item?.final_price ?? item?.sale_price ?? item?.price ?? 0) || 0;
                                    }

                                    function renderMiniCart(cart) {
                                        const countEl = document.getElementById("cart-count");
                                        const totalEl = document.getElementById("cart-total");
                                        const subtotalEl = document.getElementById("cart-subtotal");
                                        const itemsEl = document.getElementById("cart-items");

                                        const items = getItems(cart);

                                        const count = toNum(
                                            cart?.count ??
                                            cart?.total_items ??
                                            items.reduce((s, x) => s + getQty(x), 0)
                                        );

                                        const subtotal = toNum(
                                            cart?.subtotal ??
                                            cart?.total ??
                                            cart?.cart_total ??
                                            items.reduce((s, x) => s + getPrice(x) * getQty(x), 0)
                                        );

                                        if (countEl) countEl.textContent = String(count);
                                        if (totalEl) totalEl.textContent = subtotal.toFixed(2);
                                        if (subtotalEl) subtotalEl.textContent = subtotal.toFixed(2);

                                        if (!itemsEl) return;

                                        if (!items.length) {
                                            itemsEl.innerHTML = `<li style="text-align:center;padding:20px;">Cart is empty</li>`;
                                            return;
                                        }

                                        itemsEl.innerHTML = items.map((item, index) => {
                                            const productId = getProductId(item);
                                            const variantId = getVariantId(item);
                                            const name = getName(item);
                                            const img = getImagePath(item);
                                            const qty = getQty(item);
                                            const price = getPrice(item).toFixed(2);

                                            return `
                                                <li ${index >= 5 ? 'style="display:none;"' : ''}>
                                                    <a href="/customer/product/product-details/${productId}/${variantId}">
                                                        <img src="${img}" alt="${escapeHtml(name)}">
                                                        <div class="item-info">
                                                            <span class="item-name">${escapeHtml(name)}</span>
                                                            <span class="item-qty-price">AED ${price} × ${qty}</span>
                                                        </div>
                                                    </a>
                                                </li>
                                            `;
                                        }).join("");

                                        if (items.length > 5) {
                                            itemsEl.style.maxHeight = "300px";
                                            itemsEl.style.overflowY = "auto";
                                        } else {
                                            itemsEl.style.maxHeight = "none";
                                            itemsEl.style.overflowY = "visible";
                                        }
                                    }

                                    async function loadMiniCart() {
                                        try {
                                            const guestToken = localStorage.getItem(GUEST_KEY) || "";

                                            const res = await fetch(API, {
                                                method: "GET",
                                                credentials: "same-origin",
                                                headers: {
                                                    "x-guest-token": guestToken
                                                }
                                            });

                                            const json = await res.json();
                                            renderMiniCart(json);
                                        } catch (error) {
                                            console.error("Mini cart error:", error);
                                            renderMiniCart({ items: [], count: 0, subtotal: 0 });
                                        }
                                    }

                                    function initSocket() {
                                        if (typeof io === "undefined") return null;

                                        const socket = io({
                                            transports: ["websocket"],
                                            withCredentials: true
                                        });

                                        socket.on("connect", () => {
                                            console.log("Mini cart socket connected:", socket.id);
                                        });

                                        socket.on("disconnect", () => {
                                            console.log("Mini cart socket disconnected");
                                        });

                                        socket.on("connect_error", (err) => {
                                            console.error("Mini cart socket error:", err?.message || err);
                                        });

                                        // Always refresh the mini cart when cart changes anywhere for this session.
                                        // The cart API already scopes by session / guest token, so this stays safe.
                                        socket.on("cartUpdated", () => {
                                            loadMiniCart();
                                        });

                                        return socket;
                                    }

                                    document.addEventListener("DOMContentLoaded", () => {
                                        loadMiniCart();
                                        initSocket();
                                    });

                                    window.loadMiniCart = loadMiniCart;
                                })();
                            </script>
