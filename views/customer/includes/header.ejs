<script>
    // const splash = document.getElementById("splash-screen");
    // const main = document.getElementById("main-content");
    // const video = document.getElementById("introVideo");

    // // Lock page
    // document.documentElement.classList.add("splash-active");
    // document.body.classList.add("splash-active");

    // // Slow down video
    // video.addEventListener("loadedmetadata", () => {
    //     video.playbackRate = 0.7;
    // });

    // // Function to reveal main site
    // function showWebsite() {
    //     splash.style.opacity = "0";
    //     splash.style.transition = "opacity 0.8s ease";

    //     setTimeout(() => {
    //         splash.style.display = "none";
    //         main.style.display = "block";

    //         // Unlock scroll
    //         document.documentElement.classList.remove("splash-active");
    //         document.body.classList.remove("splash-active");

    //     }, 800);
    // }

    // // When page fully loaded
    // window.addEventListener("load", () => {

    //     // If already played in this session
    //     if (sessionStorage.getItem("introPlayed")) {
    //         splash.style.display = "none";
    //         main.style.display = "block";

    //         document.documentElement.classList.remove("splash-active");
    //         document.body.classList.remove("splash-active");
    //         return;
    //     }

    //     sessionStorage.setItem("introPlayed", "true");

    //     // When video ends
    //     video.onended = showWebsite;

    //     // Fallback (in case video fails)
    //     setTimeout(showWebsite, 8000);
    // });

    (function () {
        let activeIndex = -1;

        function highlight(text, query) {
            const safe = query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
            return text.replace(new RegExp(`(${safe})`, 'gi'), '<mark>$1</mark>');
        }

        function renderResults(container, items, query) {
            container.innerHTML = '';

            if (!items.length) {
                container.innerHTML = `<li class="search-results-empty">No results found</li>`;
                container.style.display = 'block';
                return;
            }

            items.forEach((item, index) => {
                const li = document.createElement('li');
                li.className = 'search-item';
                li.dataset.index = index;

                const type = item.type === 'parent' ? 'Parent'
                    : item.type === 'category' ? 'Category'
                        : 'Product';

                li.innerHTML = `
        <div class="search-row">
          <div class="search-left">
            ${item.image ? `<img src="${item.image}" alt="">` : ''}
          </div>
          <div class="search-right">
            <div class="search-top">
              <span class="type-label">${type}</span>
            </div>
            <div class="search-name">
              ${highlight(item.name, query)}
            </div>
            ${item.brand ? `<div class="search-meta">${item.brand}</div>` : ''}
          </div>
        </div>
      `;

                li.addEventListener('click', () => navigate(item));
                container.appendChild(li);
            });

            activeIndex = -1;
            container.style.display = 'block';
        }

        function navigate(item) {
            const slug = item.slug || '';
            const id = item.id || '';
            if (!slug) return;

            // ✅ SET INPUT VALUE
            const queryEl = document.getElementById('search-query');
            if (queryEl) {
                queryEl.value = item.name;
            }

            // ✅ OPTIONAL: hide dropdown
            const resultsEl = document.getElementById('search-results');
            if (resultsEl) {
                resultsEl.style.display = 'none';
            }

            // ✅ NAVIGATION
            if (item.type === 'product') {
                window.location.href = `/customer/shop/product/${encodeURIComponent(slug)}`;
            } else if (item.type === 'parent') {
                window.location.href = `/customer/shop?parent_category_id=${encodeURIComponent(id)}`;
            } else {
                window.location.href = `/customer/shop?category_id=${encodeURIComponent(slug)}`;
            }
        } function debounce(fn, delay) {
            let timeout;
            return (...args) => {
                clearTimeout(timeout);
                timeout = setTimeout(() => fn(...args), delay);
            };
        }

        const queryEl = document.getElementById('search-query');
        const resultsEl = document.getElementById('search-results');

        const triggerSearch = debounce(async () => {
            const q = queryEl.value.trim();

            if (!q) {
                resultsEl.style.display = 'none';
                return;
            }

            resultsEl.innerHTML = `<li class="search-loading">Searching...</li>`;
            resultsEl.style.display = 'block';

            try {
                const res = await fetch(`/search/universal?q=${encodeURIComponent(q)}`);
                const data = await res.json();

                if (data.success && Array.isArray(data.items)) {
                    renderResults(resultsEl, data.items, q);
                }
            } catch (err) {
                console.error(err);
            }
        }, 250);

        // INPUT
        queryEl.addEventListener('input', triggerSearch);

        // KEYBOARD NAVIGATION
        queryEl.addEventListener('keydown', (e) => {
            const items = resultsEl.querySelectorAll('.search-item');

            if (!items.length) return;

            if (e.key === 'ArrowDown') {
                e.preventDefault();
                activeIndex = (activeIndex + 1) % items.length;
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                activeIndex = (activeIndex - 1 + items.length) % items.length;
            } else if (e.key === 'Enter') {
                if (activeIndex >= 0) {
                    const selectedItem = items[activeIndex];

                    // ✅ SET INPUT VALUE
                    const name = selectedItem.querySelector('.search-name')?.innerText;
                    if (name) queryEl.value = name;

                    selectedItem.click();
                }
                return;
            }

            items.forEach(el => el.classList.remove('active'));
            if (items[activeIndex]) {
                items[activeIndex].classList.add('active');
            }
        });

        // CLICK OUTSIDE
        document.addEventListener('click', (e) => {
            if (!e.target.closest('.header-search-inline')) {
                resultsEl.style.display = 'none';
            }
        });

    })();</script>
