    .hero-media img{width:100%;max-width:420px;border-radius:10px;display:block}

    section{padding:36px 0}
    .grid{display:grid;grid-template-columns:1fr 360px;gap:28px;align-items:start}
    .card{background:#fff;border:1px solid var(--border);padding:22px;border-radius:12px}
    h2{font-size:18px;margin-bottom:12px;color:#0f172a}
    .muted{color:var(--muted)}
    .sitemap-list{display:grid;grid-template-columns:repeat(2, minmax(0,1fr));gap:14px}
    .sitemap-block{border-left:4px solid #eef6ff;padding:12px;background:#fbfdff;border-radius:8px}
    .sitemap-block h3{margin:0 0 8px;font-size:15px;color:#0f172a}
    .sitemap-block ul{list-style:none;padding-left:0;margin:0}
    .sitemap-block li{margin:6px 0;font-size:14px}
    .meta-row{font-size:13px;color:var(--muted);margin-top:6px}
    .xml-link{display:inline-block;margin-top:10px;background:#f1f8ff;padding:8px 12px;border-radius:8px;border:1px solid #e9f3ff}
    @media (max-width:992px){ .grid{grid-template-columns:1fr} .sitemap-list{grid-template-columns:1fr} .hero-media{display:none} }
