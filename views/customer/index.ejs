            <!-- Begin Slider With Category Menu Area -->
   <%
  const data = typeof discountData !== 'undefined' && discountData ? discountData : {};

  console.log('[DISCOUNT] discountData =', data);

  const carouselItems = Array.isArray(data.carousel) ? data.carousel : [];
  const top2Items = Array.isArray(data.top2) ? data.top2 : [];
  const grid3Items = Array.isArray(data.grid3) ? data.grid3 : [];

  console.log('[DISCOUNT] carouselItems length =', carouselItems.length);
  console.log('[DISCOUNT] top2Items length =', top2Items.length);
  console.log('[DISCOUNT] grid3Items length =', grid3Items.length);

  const money = (value) => {
    const num = Number(value);
    return Number.isFinite(num)
      ? num.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
      : '0.00';
  };

  const safeText = (value, fallback = '') => {
    if (value === null || value === undefined) return fallback;
    return String(value);
  };

  const toNum = (value, fallback = 0) => {
    const n = Number(value);
    return Number.isFinite(n) ? n : fallback;
  };

  const getSlug = (item) => (item && item.slug ? safeText(item.slug) : '');
  const getTitle = (item) => (item && item.name ? safeText(item.name, 'New Product') : 'New Product');
  const getOriginalPrice = (item) => toNum(item && (item.original_price ?? item.price ?? item.base_price), 0);
  const getFinalPrice = (item) => toNum(item && (item.final_price ?? item.price), 0);
  const getDiscountPercent = (item) => toNum(item && item.discount_percent, 0);

  const getDiscountLabel = (item) => {
    const discount = getDiscountPercent(item);
    return discount > 0 ? `-${discount.toFixed(0)}% Off` : 'New Arrival';
  };

  const getImage = (item, fallback = '/customer/images/banner/placeholder.jpg') => {
    if (!item || !item.image) return fallback;
    const image = String(item.image).trim();
    if (image.startsWith('http://') || image.startsWith('https://') || image.startsWith('/')) {
      return image;
    }
    return `/uploads/products/${image}`;
  };

  const productUrl = (item, fallback = '/shop') => {
    const slug = getSlug(item);
    return slug ? `/product/${slug}` : fallback;
  };

  const productDetailUrl = (item, fallback = '/shop') => {
    const pid = item && (item.product_id ?? item.master_id ?? item.productId);
    const vid = item && (item.id ?? item.variant_id ?? item.variantId);
    if (pid && vid) return `/customer/product/product-details/${pid}/${vid}`;
    return productUrl(item, fallback);
  };

  const isInStock = (item) => toNum(item && (item.stock ?? item.available_stock), 0) > 0;

  const createdTime = (item) => {
    const raw = item && (item.created_at ?? item.variant_created_at ?? item.updated_at);
    const t = raw ? new Date(raw).getTime() : 0;
    return Number.isFinite(t) ? t : 0;
  };

  const keyFor = (item) =>
    String(item && (
      item.id ??
      item.variant_id ??
      item.variantId ??
      item.product_id ??
      item.master_id ??
      item.productId ??
      ''
    ));

  const preferredSort = (a, b) => {
    const ad = getDiscountPercent(a);
    const bd = getDiscountPercent(b);
    if (bd !== ad) return bd - ad;

    const at = createdTime(a);
    const bt = createdTime(b);
    if (bt !== at) return bt - at;

    const as = isInStock(a) ? 1 : 0;
    const bs = isInStock(b) ? 1 : 0;
    if (bs !== as) return bs - as;

    return 0;
  };

  const dedupeSort = (items) => {
    const seen = new Set();
    return (Array.isArray(items) ? items : [])
      .filter(Boolean)
      .slice()
      .sort(preferredSort)
      .filter((item) => {
        const k = keyFor(item);
        if (!k || seen.has(k)) return false;
        seen.add(k);
        return true;
      });
  };

  const allSourceItems = dedupeSort([
    ...carouselItems,
    ...top2Items,
    ...grid3Items,
  ]);

  const availableItems = allSourceItems
    .filter(isInStock)
    .filter((item) => getDiscountPercent(item) > 0);

  // Carousel: show up to 20 discounted, in-stock, unique, highest discount first
  const carouselViewItems = availableItems.slice(0, 20);

  // Outside carousel: max 5 total, first 2 on the right, next 3 below
  const featuredItems = availableItems.slice(20, 25).length > 0 ? availableItems.slice(20, 25) : availableItems.slice(0, 5);
  const rightItems = featuredItems.slice(0, 2);
  const bottomItems = featuredItems.slice(2, 5);

  // IMPORTANT:
  // Bottom row should ALWAYS keep the same col-md-4 width.
  // Only the height changes when there is a single item.
  const bottomColClass = 'col-12 col-md-4';
  const isSingleBottom = bottomItems.length === 1;

  const bannerFallbacks = [
    '/customer/images/banner/1_3.jpg',
    '/customer/images/banner/1_4.jpg',
    '/customer/images/banner/1_5.jpg'
  ];
%>

