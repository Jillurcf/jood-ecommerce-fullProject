                    #orders-freq-prev i,
                    #orders-freq-next i {
                        font-size: 14px;
                        line-height: 1;
                    }

                    /* Accessibility: ensure buttons are reachable and not hidden from assistive tech */
                    .orders-freq-nav[aria-hidden="true"] {
                        /* visually hidden flag won't affect display here; keep for devs */
                    }

                    /* -------------------- Responsive: show on tablet+desktop, hide on mobile -------------------- */
                    /* Hide nav on mobile (<=575.98px) */
                    @media (max-width:575.98px) {

                        .orders-freq-nav,
                        .orders-freq-nav-btn,
                        .orders-freq-prev,
                        .orders-freq-next,
                        #orders-freq-prev,
                        #orders-freq-next {
                            display: none !important;
                            pointer-events: none !important;
                        }

                        .single-product-compact .compact-image {
                            height: 92px;
                        }

                        .single-product-compact {
                            padding: 8px;
                            font-size: 13px;
                        }

                        .single-product-compact .price-current {
                            font-size: 12px;
                        }

                        .single-product-compact .price-old {
                            font-size: 10px;
                        }

                        .single-product-compact .btn-cart,
                        .single-product-compact .btn-fav,
                        .single-product-compact .btn-select {
                            padding: 6px 8px;
                            font-size: 12px;
                        }

                        #recent-products-section .recent-nav {
                            display: none !important;
                        }

                        #recent-products-section .swipe-hint {
                            display: flex;
                            animation: fadeHint 3s ease-in-out 2;
                        }

                        /* preserve pointer events on the carousel itself for swipe */
                        #recent-products-section .orders-freq-active {
                            pointer-events: auto;
                        }
                    }

                    /* Show on tablet and up (>=576px) */
                    @media (min-width:576px) {

                        .orders-freq-nav,
                        .orders-freq-prev,
                        .orders-freq-next,
                        .orders-freq-nav-btn,
                        #orders-freq-prev,
                        #orders-freq-next {
                            display: flex !important;
                            pointer-events: auto !important;
                        }
                    }

                    /* Tablet adjustments */
                    @media (min-width:576px) and (max-width:991.98px) {
                        .single-product-compact .compact-image {
                            height: 110px;
                        }

                        .single-product-compact {
                            padding: 10px;
                            font-size: 13px;
                        }

                        #recent-products-section .swipe-hint {
                            display: none;
                        }
                    }

                    /* Desktop adjustments */
                    @media (min-width:992px) {
                        .single-product-compact .compact-image {
                            height: 120px;
                        }

                        #recent-products-section .swipe-hint {
                            display: none;
                        }
                    }

                    /* -------------------- Keyframes -------------------- */
                    @keyframes swipeArrow {
                        0% {
                            transform: translateX(0);
                            opacity: 0.4;
                        }

                        50% {
                            transform: translateX(6px);
                            opacity: 1;
                        }

                        100% {
                            transform: translateX(0);
                            opacity: 0.4;
                        }
                    }

                    @keyframes fadeHint {
                        0% {
                            opacity: 0;
                        }

                        20% {
                            opacity: 1;
                        }

                        80% {
                            opacity: 1;
                        }

                        100% {
                            opacity: 0;
                        }
                    }

                    /* -------------------- Small utility to make sure nav sits above overlays -------------------- */
                    .frequent-orders-section .orders-freq-nav {
                        position: relative;
                        z-index: 25;
                        pointer-events: auto;
                    }
                </style>
                <!-- Parent groups will be inserted here -->
                <section id="frequent-orders-wrapper" class="frequent-orders-wrapper"></section>

                <script>
                    (function () {
                        "use strict";

                        // ---------- CONFIG & IDs ----------
                        const WRAPPER_ID = "frequent-orders-wrapper";
                        const WRAPPER = document.getElementById(WRAPPER_ID);
                        const DIAG_ID = "fo-diag-banner"; // frequent orders diag banner
                        const CSRF = document.querySelector('meta[name="csrf-token"]')?.content || null;
                        const GUEST_KEY = "guest_wishlist_token";

                        // Use variant routes: grouped endpoint (primary)
                        const API = {
                            cartGet: "/customer/cart/api",
                            cartAdd: "/customer/cart/add",
                            cartUpdate: "/customer/cart/update",
                            cartRemove: "/customer/cart/remove",

                            frequentGrouped: "/customer/variant-product/api/grouped",
                            frequentFlat: "/customer/variant-product/api",

                            wishlistToggle: "/wishlist/toggle",
                            wishlistGet: "/wishlist/data"
                        };
                        const REQUEST_TIMEOUT = 15000;
                        const REFRESH_DEBOUNCE_MS = 200;
                        const MIN_LOOP_ITEMS = 6;

                        if (!WRAPPER) {
                            console.warn("frequent-orders: wrapper not found:", WRAPPER_ID);
                            return;
                        }

                        // ---------- STATE ----------
                        const cartData = new Map();           // key e.g. "v:123" -> qty
                        const stockMap = new Map();           // variantId -> stock
                        const wishlistMap = Object.create(null); // variantId -> true/false
                        const requestLocks = new Map();
                        let lastFetchedGroups = []; // array of groups { heading, parent_category_id, items: [...] }
                        let socketRefreshTimer = null;
                        window.variantToMasterMap = window.variantToMasterMap || Object.create(null);

                        // ---------- HELPERS ----------
                        const escapeHtml = (v) => v == null ? "" : String(v)
                            .replaceAll("&", "&amp;").replaceAll("<", "&lt;")
                            .replaceAll(">", "&gt;").replaceAll('"', "&quot;")
                            .replaceAll("'", "&#39;");

                        const toInt = (v, d = 0) => { const n = parseInt(String(v ?? ""), 10); return Number.isFinite(n) ? n : d; };
                        const debounce = (fn, ms) => { let t = null; return (...args) => { if (t) clearTimeout(t); t = setTimeout(() => fn(...args), ms); }; };

                        function isVatIncludedFlag(v) {
                            if (v === true || v === 1) return true;
                            if (v === false || v === 0) return false;
                            if (typeof v === "string") {
                                const s = v.trim().toLowerCase();
                                return s === "true" || s === "t" || s === "1" || s === "yes";
                            }
                            return false;
                        }

                        const GUEST_TOKEN = (() => {
                            try {
                                const existing = localStorage.getItem(GUEST_KEY);
                                if (existing) return existing;
                                const token = "guest_" + Math.random().toString(36).slice(2, 12);
                                localStorage.setItem(GUEST_KEY, token);
                                return token;
                            } catch (e) {
                                return "guest_" + Math.random().toString(36).slice(2, 12);
                            }
                        })();

                        function showDiagBanner(title, message, details = {}) {
                            try {
                                let b = document.getElementById(DIAG_ID);
                                if (!b) {
                                    b = document.createElement("div");
                                    b.id = DIAG_ID;
                                    b.style.cssText = "background:#fff4e5;color:#6a3b00;padding:10px 12px;border-radius:6px;margin-bottom:10px;font-size:13px;border:1px solid #f0c27a";
                                    WRAPPER && WRAPPER.parentNode?.insertBefore(b, WRAPPER);
                                }
                                b.innerHTML = `<div style="font-weight:600">${escapeHtml(title)}</div><div style="margin-top:6px">${escapeHtml(message)}</div><details style="margin-top:8px"><summary>Details</summary><pre style="white-space:pre-wrap;margin-top:6px;font-size:12px">${escapeHtml(JSON.stringify(details, null, 2))}</pre></details>`;
                                setTimeout(() => { try { b.remove(); } catch (e) { } }, 30000);
                            } catch (e) { console.warn("showDiagBanner failed", e); }
                        }

                        function clearDiagBanner() { const b = document.getElementById(DIAG_ID); if (b) b.remove(); }

                        async function apiFetch(url, method = "GET", body = null, timeout = REQUEST_TIMEOUT) {
                            const headers = {};
                            if (GUEST_TOKEN) headers["x-guest-token"] = GUEST_TOKEN;
                            if (method !== "GET") {
                                headers["Content-Type"] = "application/json";
                                if (CSRF) headers["x-csrf-token"] = CSRF;
                            }
                            const controller = new AbortController();
                            const timer = setTimeout(() => controller.abort(), timeout);
                            const init = { method, headers, credentials: "same-origin", signal: controller.signal };
                            if (method !== "GET" && body != null) init.body = JSON.stringify(body);
                            try {
                                const res = await fetch(url, init);
                                clearTimeout(timer);
                                if (res.status === 204) return null;
                                let json = null;
                                try { json = await res.json(); } catch (_) { }
                                if (!res.ok) {
                                    const msg = (json && json.message) ? `${res.status} ${json.message}` : `HTTP ${res.status}`;
                                    const err = new Error(msg); err.status = res.status; err.body = json; throw err;
                                }
                                if (json && typeof json === "object" && ("success" in json) && json.success === false) {
                                    const err = new Error(json.message || "Server rejected request"); err.status = res.status; err.body = json; throw err;
                                }
                                return json;
                            } catch (err) {
                                if (err.name === "AbortError") throw new Error("Request timeout");
                                throw err;
                            }
                        }

                        function keyFor(variantId) { return `v:${String(variantId)}`; }
                        function parseKey(key) { const s = String(key || ""); if (!s.startsWith("v:")) return { variant: Number(s) || 0 }; return { variant: Number(s.slice(2) || 0) }; }
                        function lockKey(action, key) { return `${action}:${key}`; }
                        async function withLock(action, key, fn) {
                            const k = lockKey(action, key);
                            if (requestLocks.has(k)) return requestLocks.get(k);
                            const p = (async () => { try { return await fn(); } finally { requestLocks.delete(k); } })();
                            requestLocks.set(k, p);
                            return p;
                        }

                        function setStock(variantId, stockNum) {
                            if (variantId == null) return;
                            stockMap.set(String(variantId), Number(stockNum || 0));
                        }
                        function getStock(variantId) {
                            if (!variantId && variantId !== 0) return 0;
                            const idStr = String(variantId);
                            if (stockMap.has(idStr)) return Number(stockMap.get(idStr) ?? 0);
                            const legacy = stockMap.get(keyFor(variantId));
                            if (typeof legacy !== "undefined") return Number(legacy || 0);
                            return 0;
                        }

                        function findItemElement(variantIdOrCardId, cardId = null) {
                            try {
                                if (cardId) return WRAPPER.querySelector(`.item[data-card-id="${escapeHtml(String(cardId))}"]`);
                                const elByCard = WRAPPER.querySelector(`.item[data-card-id="${escapeHtml(String(variantIdOrCardId))}"]`);
                                if (elByCard) return elByCard;
                                const byVariant = WRAPPER.querySelector(`.item[data-variant-id="${escapeHtml(String(variantIdOrCardId))}"]`);
                                if (byVariant) return byVariant;
                                return WRAPPER.querySelector(`.item[data-product-id="${escapeHtml(String(variantIdOrCardId))}"]`);
                            } catch (e) { return null; }
                        }

                        function extractVariantIdFromEl(el) {
                            if (!el) return null;
                            const parse = (raw) => { if (raw == null) return null; const n = Number(raw); return Number.isFinite(n) ? n : null; };
                            const candidates = [];
                            try {
                                const ds = el.dataset ?? {};
                                candidates.push(ds.variantId ?? ds.variant_id ?? ds.cardId ?? ds.card_id ?? null);
                                if (el.getAttribute) {
                                    candidates.push(el.getAttribute("data-variant-id"));
                                    candidates.push(el.getAttribute("data-card-id"));
                                }
                                const variantNearest = el.closest && el.closest(".item, .variant-item");
                                if (variantNearest) {
                                    candidates.push(variantNearest.dataset?.variantId ?? variantNearest.getAttribute("data-variant-id"));
                                }
                                const qtyControls = el.closest && el.closest(".qty-controls");
                                if (qtyControls) {
                                    const qds = qtyControls.dataset ?? {};
                                    candidates.push(qds.variantId ?? qtyControls.getAttribute("data-variant-id") ?? qtyControls.getAttribute("data-card-id"));
                                }
                            } catch (e) { }
                            for (const c of candidates) {
                                const v = parse(c);
                                if (v) return v;
                            }
                            return null;
                        }
                        function getCartQtyByVariant(variantId) {
                            if (variantId == null) return 0;
                            return Number(cartData.get(keyFor(variantId)) ?? 0);
                        }
                        function createQtyControls(variantId, qty, cardId) {
                            const wrapper = document.createElement("div");
                            wrapper.className = "qty-controls";
                            wrapper.dataset.variantId = String(variantId);
                            if (cardId != null) wrapper.dataset.cardId = String(cardId);
                            wrapper.dataset.managed = "true";
                            const minus = document.createElement("button");
                            minus.className = "qty-minus";
                            if (qty === 1) minus.classList.add("bin");
                            minus.setAttribute("aria-label", qty === 1 ? "Remove item" : "Decrease quantity");
                            minus.dataset.variantId = String(variantId);
                            minus.innerHTML = qty === 1 ? `<i class="fa fa-trash"></i>` : "–";
                            const span = document.createElement("span");
                            span.className = "qty-count";
                            span.setAttribute("aria-live", "polite");
                            span.textContent = String(qty);
                            const plus = document.createElement("button");
                            plus.className = "qty-plus";
                            plus.setAttribute("aria-label", "Increase quantity");
                            plus.dataset.variantId = String(variantId);
                            plus.textContent = "+";
                            wrapper.appendChild(minus);
                            wrapper.appendChild(span);
                            wrapper.appendChild(plus);
                            return wrapper;
                        }

                        function createAddButton(variantId, cardId, label = "Add") {
                            const btn = document.createElement("button");
                            btn.className = "btn-cart";
                            btn.type = "button";
                            if (variantId != null && variantId !== undefined) btn.dataset.variantId = String(variantId);
                            if (cardId != null) btn.dataset.cardId = String(cardId);
                            btn.innerHTML = `<span class="btn-content"><i class="fa fa-shopping-cart" aria-hidden="true"></i> ${escapeHtml(label)}</span><span class="btn-spinner" style="display:none;margin-left:6px"><i class="fa fa-spinner fa-spin" aria-hidden="true"></i></span>`;
                            return btn;
                        }

                        function syncControlsForElement(itemEl) {
                            if (!itemEl) return;
                            const variantId = Number(itemEl.dataset?.variantId ?? itemEl.getAttribute("data-variant-id"));
                            if (!variantId || Number.isNaN(variantId)) { return; }
                            const key = keyFor(variantId);
                            const displayQty = Number(cartData.get(key) ?? 0);
                            const actionsArea = itemEl.querySelector(".product-actions") || itemEl;
                            if (!actionsArea) return;
                            const existing = actionsArea.querySelector(".qty-controls, .btn-cart");
                            if (displayQty > 0) {
                                if (existing?.dataset?.managed === "true" && existing.classList.contains("qty-controls")) {
                                    const cnt = existing.querySelector(".qty-count"); if (cnt) cnt.textContent = String(displayQty);
                                    const minusBtn = existing.querySelector(".qty-minus");
                                    if (minusBtn) {
                                        if (displayQty === 1) { minusBtn.classList.add("bin"); minusBtn.innerHTML = "<i class='fa fa-trash'></i>"; minusBtn.setAttribute("aria-label", "Remove item"); }
                                        else { minusBtn.classList.remove("bin"); minusBtn.textContent = "–"; minusBtn.setAttribute("aria-label", "Decrease quantity"); }
                                    }
                                    return;
                                }
                                const newControls = createQtyControls(variantId, displayQty, itemEl.dataset?.cardId ?? null);
                                existing ? existing.replaceWith(newControls) : actionsArea.appendChild(newControls);
                            } else {
                                const addBtn = createAddButton(variantId, itemEl.dataset?.cardId ?? null);
                                existing ? existing.replaceWith(addBtn) : actionsArea.appendChild(addBtn);
                            }
                        }

                        function syncControlsWithCart() {
                            try {
                                Array.from(WRAPPER.querySelectorAll(".item")).forEach(syncControlsForElement);
                            } catch (e) { console.warn("syncControlsWithCart failed", e); }
                        }

                        // Builds item HTML for a single variant — matches controller payload fields
                        function buildItemHtml(variant) {
                            const vid = Number(variant.id);
                            const pid = String(variant.product_id ?? variant.productId ?? variant.master_id ?? "");
                            const cardUniqueId = String(vid);
                            const name = escapeHtml(variant.variant_name ?? variant.name ?? variant.title ?? "");
                            const img = escapeHtml(variant.image ?? variant.main_image ?? "default.jpg");
                            const final = Number(variant.final_price ?? variant.price ?? 0);
                            const base = Number(variant.original_price ?? variant.price ?? 0);
                            const discountVal = Number(variant.discount_value ?? 0);
                            const discountPct = Number(variant.discount_percent ?? 0);
                            const priceNote = String(variant.price_note ?? "");
                            const vatIncluded = isVatIncludedFlag(variant.vat_included ?? variant.vatIncluded ?? priceNote);
                            const priceNoteClass = vatIncluded ? "vat" : "no-vat";
                            const vatBadge = vatIncluded ? `<span class="badge-vat" title="Price includes VAT">VAT included</span>` : "";
                            const discountBadge = discountPct > 0 ? `<span class="badge-red" title="${escapeHtml(String(discountPct))}% off">${escapeHtml(String(discountPct))}%</span>` : "";
                            const priceBlock = `<div class="price-line"><div class="price-current">AED ${final.toFixed(2)}</div>${discountVal > 0 ? `<div><div class="price-old">AED ${base.toFixed(2)}</div><div class="saved-small">(-${discountVal.toFixed(2)} AED)</div></div>` : ""}</div>`;
                            const stock = Number(variant.stock ?? variant.available_stock ?? 0);
                            const productStockHtml = stock <= 0 ? '<div class="stock-line"><span class="stock-out">Out of Stock</span></div>' : stock <= 5 ? `<div class="stock-line"><span class="stock-limited">${escapeHtml(String(stock))} (Limited)</span></div>` : `<div class="stock-line"><span class="stock-available">${escapeHtml(String(stock))} available</span></div>`;
                            const isFavOnRender = (typeof wishlistMap[String(vid)] !== "undefined") ? !!wishlistMap[String(vid)] : !!variant.is_fav;
                            const favClass = isFavOnRender ? "btn-fav is-fav" : "btn-fav";
                            const favHtml = `
                    <button class="${favClass}"
                            data-variant-id="${vid}"
                            aria-pressed="${isFavOnRender ? "true" : "false"}"
                            title="Add to wishlist">
                        <i class="fa fa-heart"></i>
                    </button>`;

                            try { setStock(vid, stock); if (pid) window.variantToMasterMap[vid] = Number(pid); } catch (e) { }

                            return `<div class="item" data-variant-id="${escapeHtml(String(vid))}" data-product-id="${escapeHtml(String(pid))}" data-card-id="${escapeHtml(cardUniqueId)}">
                    <div class="single-product-compact" data-href="/customer/product/product-details/${pid}/${vid}" role="group" aria-labelledby="prod-${escapeHtml(cardUniqueId)}" tabindex="0" style="position:relative;">
                        <div style="position:relative;">
                        <div class="compact-image"><img src="/uploads/products/${img}" alt="${name}" loading="lazy"></div>
                        <div class="badges"><span class="badge-green">Top</span>${discountBadge}</div>
                        </div>
                        <div style="padding:8px 4px;">
                        <div id="prod-${escapeHtml(cardUniqueId)}" class="prod-title">${name}</div>
                        ${priceBlock}
                        <div style="display:flex; justify-content:space-between; align-items:center;" class="small">
                            ${productStockHtml}
                            ${priceNote ? `<div class="price-note ${priceNoteClass}">${escapeHtml(priceNote)}</div>` : ""}
                            ${vatBadge ? `<div class="vat-badge-small">${vatBadge}</div>` : ""}
                        </div>
                        <div class="product-actions">${favHtml}</div>
                        </div>
                    </div>
                    </div>`;
                        }

                        function buildGroupHtml(group) {
                            const heading = escapeHtml(group.heading || "Uncategorized");
                            const containerId = `orders-freq-container-${escapeHtml(String(group.parent_category_id ?? heading))}`;
                            // header + carousel container
                            return `
                    <section class="frequent-orders-section" data-parent-category-id="${escapeHtml(String(group.parent_category_id ?? ""))}">
                        <div class="d-flex align-items-center justify-content-between mb-2 header-row">
                        <h5 class="mb-0 section-title">${heading}</h5>
                        <div class="orders-freq-nav" aria-hidden="true">
                            <button class="orders-freq-prev orders-freq-nav-btn" aria-label="Previous"><i class="fa fa-chevron-left"></i></button>
                            <button class="orders-freq-next orders-freq-nav-btn" aria-label="Next"><i class="fa fa-chevron-right"></i></button>
                        </div>
                        <div class="swipe-hint" aria-hidden="true"><span>Swipe to see more</span><i class="fa fa-arrow-right"></i></div>
                        </div>
                        <div id="${containerId}" class="orders-freq-active owl-carousel owl-theme" aria-live="polite">${group.items.map(buildItemHtml).join("")}</div>
                    </section>
                    `;
                        }

                        function showWidget() {
                            try { WRAPPER.style.display = ""; } catch (e) { /* ignore */ }
                        }
                        function hideWidget() {
                            try { WRAPPER.style.display = "none"; } catch (e) { /* ignore */ }
                        }

                        function renderAndShow(groups) {
                            try {
                                if (!Array.isArray(groups) || groups.length === 0) {
                                    WRAPPER.innerHTML = "";
                                    hideWidget();
                                    return;
                                }
                                // build HTML for groups
                                const html = groups.map(buildGroupHtml).join("");
                                WRAPPER.innerHTML = html;
                                // initialize carousels for each group's container
                                initAllOwls();
                                syncControlsWithCart();
                                showWidget();
                            } catch (e) {
                                console.error("renderAndShow error", e);
                                showDiagBanner("Render failed", "Check console for details.", { error: String(e) });
                            }
                        }

                        function normalizeCartRow(row) {
                            if (!row || typeof row !== "object") return null;
                            let vid = null;
                            vid = (typeof row.variant_id !== "undefined" && row.variant_id !== null) ? row.variant_id
                                : (typeof row.variantId !== "undefined" && row.variantId !== null) ? row.variantId
                                    : (typeof row.vid !== "undefined" && row.vid !== null) ? row.vid
                                        : (typeof row.variant !== "undefined" && row.variant !== null) ? row.variant
                                            : null;
                            if (vid == null && typeof row.cart_key === "string" && row.cart_key.length) {
                                const m = row.cart_key.match(/(\d+)/);
                                if (m) vid = Number(m[1]);
                            }
                            const vidNum = (vid == null || vid === "" || Number.isNaN(Number(vid))) ? null : Number(vid);
                            if (vidNum == null) return null;
                            const qty = Number(row.quantity ?? row.qty ?? row.in_cart_qty ?? row.qty_in_cart ?? 0) || 0;
                            return { vidN: vidNum, qty };
                        }

                        async function fetchCartMap() {
                            try {
                                const json = await apiFetch(API.cartGet, "GET", null);
                                let arr = [];
                                if (Array.isArray(json?.data)) arr = json.data;
                                else if (Array.isArray(json)) arr = json;
                                else if (Array.isArray(json?.items)) arr = json.items;
                                else if (Array.isArray(json?.cart)) arr = json.cart;
                                else if (json && typeof json === "object" && json.data && !Array.isArray(json.data) && typeof json.data === "object") arr = [json.data];
                                else arr = [];
                                cartData.clear();
                                for (const row of arr) {
                                    const n = normalizeCartRow(row);
                                    if (!n || n.vidN == null) continue;
                                    cartData.set(keyFor(n.vidN), Number(n.qty || 0));
                                }
                                syncControlsWithCart();
                                return cartData;
                            } catch (err) {
                                console.warn("fetchCartMap failed", err);
                                showDiagBanner("Cart fetch failed", "Unable to fetch cart data. Check console for details.", { error: String(err) });
                                return cartData;
                            }
                        }

                        // Fetch groups from the variant grouped endpoint (handles both map and array)
                        async function fetchFrequentProducts(limit = 12) {
                            try {
                                // prefer grouped route; fallback to flat if grouped returns unexpected shape
                                const url = new URL(API.frequentGrouped, window.location.origin);
                                url.searchParams.set("limit", String(limit));
                                const json = await apiFetch(url.toString(), "GET", null);
                                let groups = [];

                                // When route returned an object map keyed by heading: { heading: [items], ... }
                                if (json && typeof json === "object" && json.data && !Array.isArray(json.data) && typeof json.data === "object") {
                                    const map = json.data;
                                    groups = Object.keys(map).map((h) => {
                                        const items = Array.isArray(map[h]) ? map[h] : [];
                                        // if metadata attached (parent_category_id) keep it
                                        const parent_category_id = (Array.isArray(map[h]) && map[h].parent_category_id) ? map[h].parent_category_id : null;
                                        return { heading: h, parent_category_id, items };
                                    });
                                } else if (json && typeof json === "object" && Array.isArray(json.data)) {
                                    // controller-style grouped array: [{ heading, parent_category_id, items: [] }, ...]
                                    groups = json.data;
                                } else if (Array.isArray(json)) {
                                    // fallback: array of variant cards -> create single group
                                    groups = [{ heading: "Frequently Ordered", parent_category_id: null, items: json }];
                                } else {
                                    // last fallback: call flat endpoint
                                    const flatUrl = new URL(API.frequentFlat, window.location.origin);
                                    flatUrl.searchParams.set("limit", String(limit));
                                    const flatJson = await apiFetch(flatUrl.toString(), "GET", null);
                                    const arr = Array.isArray(flatJson?.data) ? flatJson.data : (Array.isArray(flatJson) ? flatJson : []);
                                    groups = [{ heading: "Frequently Ordered", parent_category_id: null, items: arr }];
                                }

                                // normalize group items, update stock and variant map
                                lastFetchedGroups = (groups || []).map(g => ({
                                    heading: g.heading || "Uncategorized",
                                    parent_category_id: g.parent_category_id ?? null,
                                    items: Array.isArray(g.items) ? g.items : []
                                }));

                                lastFetchedGroups.forEach(g => {
                                    g.items.forEach(v => {
                                        try { setStock(Number(v.id), Number(v.stock ?? v.available_stock ?? 0)); } catch (e) { }
                                        try { if (v.product_id) window.variantToMasterMap[Number(v.id)] = Number(v.product_id); } catch (e) { }
                                    });
                                });

                                return lastFetchedGroups;
                            } catch (err) {
                                console.error("fetchFrequentProducts failed", err);
                                showDiagBanner("Failed to fetch frequent products", "Click Retry or check console for diagnostics.", { error: String(err) });
                                return [];
                            }
                        }

                        function buildCartPayloadVariantOnly(variant_id, quantity = 1) {
                            const payload = {};
                            if (variant_id !== null && typeof variant_id !== "undefined") payload.variant_id = Number(variant_id);
                            payload.quantity = Number(quantity || 1);
                            return payload;
                        }

                        function findVariantForProduct(masterId) {
                            if (!masterId) return null;
                            const pidStr = String(masterId);
                            for (const g of lastFetchedGroups) {
                                const found = g.items.find(v => String(v.product_id ?? v.productId ?? "") === pidStr);
                                if (found) return Number(found.id);
                            }
                            return null;
                        }

                        async function addToCartVariant(sourceEl = null, explicitVariantId = null) {
                            let variantId = null;
                            if (explicitVariantId != null && explicitVariantId !== "") {
                                const n = Number(explicitVariantId);
                                if (!Number.isNaN(n)) variantId = n;
                            }
                            if (!variantId) variantId = extractVariantIdFromEl(sourceEl);
                            const cardEl = sourceEl?.closest?.('.item') ?? (sourceEl && sourceEl.closest ? sourceEl.closest('.item') : null);

                            if ((!variantId || variantId == null) && cardEl) {
                                const vidAttr = cardEl.dataset?.variantId ?? cardEl.getAttribute?.("data-variant-id");
                                if (vidAttr) { const n = Number(vidAttr); if (!Number.isNaN(n)) variantId = n; }
                            }

                            if ((!variantId || variantId == null) && cardEl) {
                                const pid = cardEl.dataset?.productId ?? cardEl.getAttribute?.("data-product-id");
                                if (pid) {
                                    const mem = findVariantForProduct(pid);
                                    if (mem) variantId = mem;
                                }
                            }

                            if ((!variantId || variantId == null) && Array.isArray(lastFetchedGroups) && lastFetchedGroups.length) {
                                // pick first available item from first group
                                const firstGroup = lastFetchedGroups[0];
                                if (firstGroup && Array.isArray(firstGroup.items) && firstGroup.items.length) variantId = Number(firstGroup.items[0].id);
                            }

                            if (!variantId || Number.isNaN(Number(variantId))) {
                                const details = {
                                    attempted_from_sourceEl: !!sourceEl,
                                    sourceEl_tag: sourceEl?.tagName,
                                    sourceEl_dataset: sourceEl?.dataset ? { ...sourceEl.dataset } : null,
                                    card_dataset: cardEl?.dataset ? { ...cardEl.dataset } : null,
                                    lastFetchedGroups_count: Array.isArray(lastFetchedGroups) ? lastFetchedGroups.length : 0,
                                };
                                showDiagBanner("Variant resolution failed", "No variant could be resolved from the clicked element or product card — see diagnostics.", details);
                                console.warn("addToCartVariant: no variant resolved", details);
                                showInlineError(cardEl?.dataset?.productId ?? "product", "No variant selected", 4000, cardEl?.dataset?.cardId ?? null);
                                return;
                            }

                            variantId = Number(variantId);
                            const key = keyFor(variantId);
                            const cardId = cardEl?.dataset?.cardId ?? null;

                            return withLock("add", key, async () => {
                                try {
                                    clearDiagBanner();
                                    const currentQty = Number(cartData.get(key) ?? 0);
                                    const stock = getStock(variantId);
                                    if (stock <= 0) {
                                        showInlineError(variantId, "Out of stock", 4000, cardId);
                                        return Promise.reject(new Error("Out of stock"));
                                    }
                                    if (currentQty + 1 > stock) {
                                        showInlineError(variantId, `Not enough stock. Available: ${stock}`, 4000, cardId);
                                        return Promise.reject(new Error("Not enough stock"));
                                    }

                                    cartData.set(key, currentQty + 1);
                                    syncControlsWithCart();
                                    const payload = buildCartPayloadVariantOnly(variantId, 1);
                                    const res = await apiFetch(API.cartAdd, "POST", payload);

                                    const serverArr = Array.isArray(res?.data) ? res.data : (Array.isArray(res) ? res : (Array.isArray(res?.items) ? res.items : (res && res.data && typeof res.data === "object" ? [res.data] : [])));
                                    if (Array.isArray(serverArr) && serverArr.length) {
                                        cartData.clear();
                                        for (const row of serverArr) {
                                            const n = normalizeCartRow(row);
                                            if (!n || n.vidN == null) continue;
                                            cartData.set(keyFor(n.vidN), Number(n.qty || 0));
                                        }
                                    } else {
                                        cartData.set(key, currentQty + 1);
                                    }

                                    await fetchCartMap().catch(() => { });
                                    await refreshGroupsAfterMutate().catch(() => { });
                                    syncControlsWithCart();
                                    return res;
                                } catch (err) {
                                    const body = err?.body ?? null;
                                    if (body && body.error_code === "VARIANT_REQUIRED" && Array.isArray(body.available_variants) && body.available_variants.length) {
                                        const first = body.available_variants[0];
                                        if (first && typeof first.variant_id !== "undefined") {
                                            try {
                                                const retryPayload = buildCartPayloadVariantOnly(Number(first.variant_id), 1);
                                                const retry = await apiFetch(API.cartAdd, "POST", retryPayload);
                                                await fetchCartMap().catch(() => { });
                                                syncControlsWithCart();
                                                return retry;
                                            } catch (retryErr) {
                                                console.warn("retry with server-provided variant failed", retryErr);
                                            }
                                        }
                                    }
                                    const errMsg = err?.body?.message || err.message || String(err);
                                    showInlineError(cardEl?.dataset?.productId ?? "product", errMsg, 7000, cardId);
                                    await fetchCartMap().catch(() => { });
                                    syncControlsWithCart();
                                    throw err;
                                }
                            });
                        }

                        async function updateCartQtyVariant(variantId, newQty, controlsEl = null) {
                            const qty = Number(newQty);
                            if (!variantId || Number.isNaN(Number(variantId))) { variantId = extractVariantIdFromEl(controlsEl); }
                            if (!variantId || Number.isNaN(Number(variantId))) { showInlineError("product", "Invalid variant", 3000); return; }
                            if (qty < 1) return removeFromCartVariant(variantId, controlsEl);
                            const key = keyFor(variantId);
                            const stock = getStock(variantId);
                            if (qty > stock) { showInlineError(variantId, `Not enough stock. Available: ${stock}`); return; }
                            return withLock("update", key, async () => {
                                try {
                                    cartData.set(key, qty);
                                    syncControlsWithCart();
                                    const payload = buildCartPayloadVariantOnly(variantId, qty);
                                    await apiFetch(API.cartUpdate, "POST", payload);
                                    await fetchCartMap();
                                } catch (err) {
                                    const msg = err?.body?.message || err.message || "";
                                    if (err.status === 404 || /product not found/i.test(msg)) await runAddDiagnostics({ variant_id: variantId, quantity: qty }, err);
                                    const userMsg = (err.body && err.body.message) ? err.body.message : (err.message || "Failed to update quantity");
                                    showInlineError("product", userMsg);
                                    await fetchCartMap().catch(() => { });
                                    throw err;
                                } finally {
                                    syncControlsWithCart();
                                }
                            });
                        }

                        async function removeFromCartVariant(variantId, controlsEl = null) {
                            if (!variantId || Number.isNaN(Number(variantId))) { variantId = extractVariantIdFromEl(controlsEl); }
                            if (!variantId || Number.isNaN(Number(variantId))) { showInlineError("product", "Invalid variant", 3000); return; }
                            const key = keyFor(variantId);
                            const cardId = controlsEl?.closest?.('.item')?.dataset?.cardId ?? null;
                            return withLock("remove", key, async () => {
                                try {
                                    cartData.set(key, 0);
                                    syncControlsWithCart();
                                    const payload = { variant_id: Number(variantId) };
                                    await apiFetch(API.cartRemove, "POST", payload);
                                    await fetchCartMap();
                                } catch (err) {
                                    const userMsg = (err.body && err.body.message) ? err.body.message : (err.message || "Failed to remove item");
                                    if (err.status === 404 || /product not found/i.test(userMsg)) await runAddDiagnostics({ variant_id: variantId }, err);
                                    showInlineError("product", userMsg);
                                    await fetchCartMap().catch(() => { });
                                    throw err;
                                } finally {
                                    syncControlsWithCart();
                                }
                            });
                        }

                        function showInlineError(pid, message, timeout = 4500, cardId = null) {
                            try {
                                const item = findItemElement(pid, cardId);
                                if (!item) return;
                                let errEl = item.querySelector(".recent-inline-error");
                                if (!errEl) {
                                    errEl = document.createElement("div");
                                    errEl.className = "recent-inline-error";
                                    errEl.setAttribute("role", "status");
                                    errEl.style.cssText = "color:#b00020;font-size:12px;margin-top:6px";
                                    const actions = item.querySelector(".product-actions");
                                    if (actions) actions.insertAdjacentElement("afterend", errEl);
                                    else item.appendChild(errEl);
                                }
                                errEl.textContent = message;
                                if (timeout > 0) { setTimeout(() => { if (errEl && errEl.parentNode) errEl.parentNode.removeChild(errEl); }, timeout); }
                            } catch (e) { console.warn("showInlineError failed", e); }
                        }

                        async function runAddDiagnostics(payload, serverError) {
                            try {
                                const diag = {
                                    timestamp: new Date().toISOString(),
                                    attempted_payload: payload,
                                    server_error: serverError && (serverError.body || serverError.message || serverError.status) ? (serverError.body || serverError.message || serverError.status) : serverError,
                                    last_fetched_groups_count: lastFetchedGroups.length
                                };
                                showDiagBanner("Cart Diagnostic", "See details below.", diag);
                                return diag;
                            } catch (e) { console.warn("runAddDiagnostics failed", e); return { error: String(e) }; }
                        }

                        async function fetchWishlistMap() {
                            try {
                                for (const k of Object.keys(wishlistMap)) delete wishlistMap[k];
                                const json = await apiFetch(API.wishlistGet, "GET", null);
                                if (json?.success && Array.isArray(json.data)) {
                                    for (const vid of json.data) wishlistMap[String(vid)] = true;
                                    return true;
                                } else return false;
                            } catch (e) { return false; }
                        }

                        function hasJQuery() { return typeof window.$ === "function" && typeof window.$.fn !== "undefined"; }

                        // Init a single owl container element
                        function initOwlForContainer(containerEl) {
                            if (!hasJQuery()) return;
                            try {
                                const $c = $(containerEl);
                                if ($c.hasClass("owl-loaded")) {
                                    try { $c.trigger("destroy.owl.carousel"); } catch (e) { }
                                    $c.removeClass("owl-loaded owl-hidden").attr("style", "");
                                }
                                const itemCount = $c.find(".item").length;
                                $c.owlCarousel({ loop: itemCount > MIN_LOOP_ITEMS, margin: 12, nav: false, dots: false, smartSpeed: 450, slideBy: 1, responsive: { 0: { items: 2 }, 480: { items: 2 }, 768: { items: 4 }, 992: { items: 6 } } });
                                // wire nav
                                const parentSection = containerEl.closest(".frequent-orders-section");
                                if (parentSection) {
                                    $(parentSection).find(".orders-freq-prev").off("click.orders").on("click.orders", () => $c.trigger("prev.owl.carousel"));
                                    $(parentSection).find(".orders-freq-next").off("click.orders").on("click.orders", () => $c.trigger("next.owl.carousel"));
                                }
                            } catch (e) { console.warn("initOwlForContainer failed", e); }
                        }

                        function initAllOwls() {
                            if (!hasJQuery()) return;
                            try {
                                const containers = WRAPPER.querySelectorAll(".orders-freq-active");
                                containers.forEach(c => initOwlForContainer(c));
                            } catch (e) { console.warn("initAllOwls failed", e); }
                        }

                        function refreshOwlForContainer(containerEl) {
                            if (!hasJQuery()) return;
                            try {
                                const $c = $(containerEl);
                                if ($c.length && $c.hasClass("owl-loaded")) $c.trigger("refresh.owl.carousel");
                                else initOwlForContainer(containerEl);
                            } catch (e) { initOwlForContainer(containerEl); }
                        }

                        function refreshAllOwls() {
                            const containers = WRAPPER.querySelectorAll(".orders-freq-active");
                            containers.forEach(c => refreshOwlForContainer(c));
                        }

                        function initSocket() {
                            if (typeof io === "undefined") { console.debug("Socket.IO not present — realtime skipped"); return; }
                            try {
                                const SOCKET_URL = window.SOCKET_URL || null;
                                const socket = SOCKET_URL ? io(SOCKET_URL, { transports: ["websocket"], withCredentials: true }) : io({ transports: ["websocket"], withCredentials: true });

                                const triggerRefresh = () => {
                                    if (socketRefreshTimer) clearTimeout(socketRefreshTimer);
                                    socketRefreshTimer = setTimeout(async () => { await refreshFromServer({ limit: 12, resetToFirst: false }); }, REFRESH_DEBOUNCE_MS);
                                };

                                socket.on("connect", () => console.debug("socket connected", socket.id));
                                socket.on("disconnect", (reason) => console.debug("socket disconnected", reason));

                                // Controller event names
                                socket.on("recentProductsUpdated", (data) => {
                                    if (!data) return;
                                    // data may be grouped array (controller) or flat array; we'll normalize via refreshFromServer rather than relying on payload shape
                                    try {
                                        // If controller emits grouped array: use it directly
                                        if (Array.isArray(data) && data.length && data[0] && (data[0].items || data[0].heading)) {
                                            lastFetchedGroups = data.map(g => ({ heading: g.heading || "Uncategorized", parent_category_id: g.parent_category_id ?? null, items: Array.isArray(g.items) ? g.items : [] }));
                                            lastFetchedGroups.forEach(g => g.items.forEach(v => { try { setStock(Number(v.id), Number(v.stock ?? 0)); if (v.product_id) window.variantToMasterMap[Number(v.id)] = Number(v.product_id); } catch (e) { } }));
                                            renderAndShow(lastFetchedGroups);
                                        } else {
                                            // fallback: refresh from server
                                            triggerRefresh();
                                        }
                                    } catch (e) {
                                        console.warn("recentProductsUpdated handler error", e);
                                    }
                                });

                                socket.on("recentProductAdded", (variant) => { if (!variant) return; upsertItem(variant); });
                                socket.on("recentProductUpdated", (variant) => { if (!variant) return; upsertItem(variant); });
                                socket.on("recentProductDeleted", (vidOrMaster) => { if (!vidOrMaster) return; removeItem(vidOrMaster); });

                                // existing app events
                                socket.on("orderAdded", async (orderPayload) => {
                                    try {
                                        await fetchCartMap().catch(() => { });
                                        await fetchWishlistMap().catch(() => { });
                                        await refreshFromServer({ limit: 12, resetToFirst: false });
                                    } catch (e) { console.warn("orderAdded handler error", e); }
                                });

                                socket.on("wishlistUpdated", (payload) => {
                                    try {
                                        if (!payload || typeof payload.variant_id === "undefined") return;
                                        const vid = String(payload.variant_id);
                                        const isFav = !!payload.is_fav;
                                        if (isFav) wishlistMap[vid] = true; else delete wishlistMap[vid];
                                        const items = Array.from(WRAPPER.querySelectorAll(`.item[data-variant-id="${escapeHtml(vid)}"]`));
                                        items.forEach(item => {
                                            const btn = item.querySelector(".btn-fav");
                                            if (btn) { btn.classList.toggle("is-fav", isFav); btn.setAttribute("aria-pressed", String(!!isFav)); }
                                        });
                                    } catch (e) { console.warn("wishlistUpdated handler failed", e); }
                                });

                                socket.on("cartUpdated", triggerRefresh);

                            } catch (e) { console.warn("initSocket failed", e); }
                        }

                        function upsertItem(variant) {
                            try {
                                const vid = String(variant.id ?? variant.variant_id ?? "");
                                if (!vid) return;
                                setStock(Number(variant.id), Number(variant.stock ?? 0));
                                if (variant.product_id) try { window.variantToMasterMap[Number(variant.id)] = Number(variant.product_id); } catch (e) { }
                                variant.in_cart_qty = Number(cartData.get(keyFor(variant.id ?? 0)) ?? variant.in_cart_qty ?? 0);

                                // locate group: find group that contains the variant (by product_id) or create Uncategorised
                                let targetSection = null;
                                const productIdStr = String(variant.product_id ?? "");
                                // try existing groups
                                const sections = Array.from(WRAPPER.querySelectorAll(".frequent-orders-section"));
                                for (const s of sections) {
                                    const items = s.querySelectorAll(".item");
                                    for (const it of items) {
                                        if (String(it.dataset?.productId ?? it.getAttribute("data-product-id")) === productIdStr) { targetSection = s; break; }
                                    }
                                    if (targetSection) break;
                                }
                                // if not found, try find a section whose heading matches parent_category_name
                                if (!targetSection && variant.parent_category_name) {
                                    const header = Array.from(WRAPPER.querySelectorAll(".section-title")).find(h => h.textContent.trim() === String(variant.parent_category_name));
                                    if (header) targetSection = header.closest(".frequent-orders-section");
                                }

                                // if still not found, append to top (Uncategorized or first section)
                                if (!targetSection) {
                                    const first = WRAPPER.querySelector(".frequent-orders-section");
                                    targetSection = first || null;
                                }

                                const html = buildItemHtml(variant);
                                const wrapper = document.createElement("div"); wrapper.innerHTML = html; const newEl = wrapper.firstElementChild;
                                if (!newEl) return;

                                // try replace existing
                                const existing = WRAPPER.querySelector(`.item[data-variant-id="${escapeHtml(vid)}"], .item[data-card-id="${escapeHtml(vid)}"], .item[data-product-id="${escapeHtml(String(variant.product_id ?? ""))}"]`);
                                if (existing) { existing.replaceWith(newEl); refreshAllOwls(); }
                                else if (targetSection) {
                                    const container = targetSection.querySelector(".orders-freq-active");
                                    if (container) container.insertAdjacentElement("afterbegin", newEl);
                                    else WRAPPER.insertAdjacentElement("afterbegin", newEl);
                                    initAllOwls();
                                } else {
                                    // fallback: append to wrapper
                                    WRAPPER.insertAdjacentElement("afterbegin", newEl);
                                    initAllOwls();
                                }
                                syncControlsWithCart();
                                showWidget();
                            } catch (e) { console.warn("upsertItem error", e); }
                        }

                        function removeItem(vidOrCard) {
                            try {
                                const elByCard = WRAPPER.querySelector(`.item[data-card-id="${escapeHtml(String(vidOrCard))}"]`);
                                if (elByCard) { elByCard.remove(); refreshAllOwls(); return; }
                                const el = WRAPPER.querySelector(`.item[data-variant-id="${escapeHtml(String(vidOrCard))}"], .item[data-product-id="${escapeHtml(String(vidOrCard))}"]`);
                                if (el) el.remove();
                                refreshAllOwls();
                                if (!WRAPPER.querySelector(".item")) hideWidget();
                            } catch (e) { console.warn("removeItem error", e); }
                        }

                        // refresh helper used after cart mutations: re-fetch groups and re-render but keep ux consistent
                        async function refreshGroupsAfterMutate(limit = 12) {
                            try {
                                await fetchCartMap();
                                await fetchWishlistMap();
                                const groups = await fetchFrequentProducts(limit);
                                renderAndShow(groups);
                            } catch (e) {
                                console.warn("refreshGroupsAfterMutate failed", e);
                            }
                        }

                        // Debounced public refresh
                        const debouncedRefresh = debounce(async (opts = { limit: 12, resetToFirst: true }) => { await refreshFromServer(opts); }, REFRESH_DEBOUNCE_MS);

                        async function refreshFromServer({ limit = 12, resetToFirst = true } = {}) {
                            try {
                                clearDiagBanner();
                                await fetchCartMap();
                                await fetchWishlistMap();
                                const groups = await fetchFrequentProducts(limit);
                                renderAndShow(groups);
                                if (resetToFirst && hasJQuery()) try {
                                    // move each carousel to first slide
                                    $(WRAPPER).find(".orders-freq-active").each(function () { try { $(this).trigger("to.owl.carousel", [0, 0, true]); } catch (e) { } });
                                } catch (e) { /* ignore */ }
                            } catch (e) {
                                console.error("refreshFromServer failed", e);
                                showDiagBanner("Refresh failed", "Check console for details.", { error: String(e) });
                            }
                        }

                        // Attach a broad click handler to the wrapper (delegation)
                        WRAPPER.addEventListener("click", (e) => {
                            const t = e.target;
                            if (!t) return;

                            const addBtn = t.closest?.(".btn-cart");
                            if (addBtn) {
                                e.preventDefault();
                                if (addBtn.disabled) { const idForErr = addBtn.dataset?.variantId ?? addBtn.dataset?.cardId ?? null; if (idForErr) showInlineError(idForErr, "Please wait...", 1200); return; }
                                setButtonBusyByElement(addBtn, true);
                                addToCartVariant(addBtn, addBtn.dataset?.variantId ? Number(addBtn.dataset.variantId) : null).catch(() => { }).finally(() => { setButtonBusyByElement(addBtn, false); syncControlsWithCart(); });
                                return;
                            }

                            const favBtn = t.closest?.(".btn-fav");
                            if (favBtn) {
                                e.preventDefault();
                                const card = favBtn.closest(".item");
                                const variantId = Number(card?.dataset?.variantId ?? favBtn.dataset?.variantId ?? favBtn.dataset?.cardId);
                                if (!variantId) return;
                                const key = String(variantId);
                                const was = favBtn.classList.contains("is-fav");
                                if (was) { favBtn.classList.remove("is-fav"); favBtn.setAttribute("aria-pressed", "false"); } else { favBtn.classList.add("is-fav"); favBtn.setAttribute("aria-pressed", "true"); }
                                if (!was) wishlistMap[key] = true; else delete wishlistMap[key];
                                setButtonBusyByElement(favBtn, true);
                                apiFetch(API.wishlistToggle, "POST", { variant_id: variantId })
                                    .then(json => {
                                        let serverIsFav = null;
                                        if (json?.is_fav !== undefined) serverIsFav = !!json.is_fav;
                                        else if (json?.action) serverIsFav = json.action === "added";
                                        if (serverIsFav !== null) {
                                            if (serverIsFav) { favBtn.classList.add("is-fav"); favBtn.setAttribute("aria-pressed", "true"); } else { favBtn.classList.remove("is-fav"); favBtn.setAttribute("aria-pressed", "false"); }
                                            if (serverIsFav) wishlistMap[key] = true; else delete wishlistMap[key];
                                        }
                                    })
                                    .catch(err => {
                                        favBtn.classList.toggle("is-fav", was);
                                        favBtn.setAttribute("aria-pressed", String(was));
                                        if (was) wishlistMap[key] = true; else delete wishlistMap[key];
                                        showInlineError(variantId, err?.body?.message || err.message || "Wishlist update failed", 3000);
                                    })
                                    .finally(() => { setButtonBusyByElement(favBtn, false); });
                                return;
                            }

                            const minus = t.closest?.(".qty-minus");
                            if (minus) {
                                e.preventDefault();
                                const controls = minus.closest(".qty-controls");
                                const variantId = extractVariantIdFromEl(controls);
                                if (!variantId) return;
                                const cnt = controls.querySelector(".qty-count"); let qty = toInt(cnt?.textContent ?? 0, 0);
                                if (minus.classList.contains("bin") || qty === 1) {
                                    setButtonBusyByElement(minus, true);
                                    removeFromCartVariant(variantId, controls).catch(() => { }).finally(() => { setButtonBusyByElement(minus, false); syncControlsWithCart(); });
                                } else {
                                    qty = Math.max(0, qty - 1);
                                    const key = keyFor(variantId);
                                    cartData.set(key, qty);
                                    syncControlsWithCart();
                                    setButtonBusyByElement(minus, true);
                                    updateCartQtyVariant(variantId, qty, controls).catch(() => { }).finally(() => { setButtonBusyByElement(minus, false); });
                                }
                                return;
                            }

                            const plus = t.closest?.(".qty-plus");
                            if (plus) {
                                e.preventDefault();
                                const controls = plus.closest(".qty-controls"); const variantId = extractVariantIdFromEl(controls); if (!variantId) return;
                                const cnt = controls.querySelector(".qty-count"); let qty = toInt(cnt?.textContent ?? 0, 0);
                                const key = keyFor(variantId); const stock = getStock(variantId);
                                if (qty + 1 > stock) { showInlineError(variantId, `Not enough stock. Available: ${stock}`); return; }
                                qty += 1; cartData.set(key, qty); syncControlsWithCart();
                                setButtonBusyByElement(plus, true);
                                updateCartQtyVariant(variantId, qty, controls).catch(() => { }).finally(() => { setButtonBusyByElement(plus, false); });
                                return;
                            }

                            const card = t.closest?.(".single-product-compact");
                            if (card) {
                                const href = card.getAttribute("data-href");
                                if (href && href.startsWith("/")) {
                                    if (e.metaKey || e.ctrlKey || e.shiftKey) window.open(href, "_blank");
                                    else window.location.href = href;
                                }
                            }
                        });

                        function setButtonBusyByElement(el, busy = true) {
                            if (!el) return;
                            try {
                                if (busy) {
                                    if (!el.dataset.rpOriginal) el.dataset.rpOriginal = el.innerHTML;
                                    el.classList.add("rp-busy");
                                    const spinner = el.querySelector(".btn-spinner");
                                    if (spinner) spinner.style.display = "inline-block";
                                    else { const label = el.textContent || el.innerText || ""; el.innerHTML = `<i class="fa fa-spinner fa-spin" aria-hidden="true"></i> <span class="btn-label">${escapeHtml(label)}</span>`; }
                                    el.setAttribute("disabled", "true"); el.setAttribute("aria-busy", "true");
                                } else {
                                    el.classList.remove("rp-busy");
                                    const spinner = el.querySelector(".btn-spinner"); if (spinner) spinner.style.display = "none";
                                    if (el.dataset.rpOriginal) { el.innerHTML = el.dataset.rpOriginal; delete el.dataset.rpOriginal; }
                                    el.removeAttribute("aria-busy"); if (!el.hasAttribute("aria-disabled")) el.removeAttribute("disabled");
                                }
                            } catch (e) { try { el.removeAttribute("disabled"); el.removeAttribute("aria-busy"); } catch (_) { } }
                        }

                        async function refreshFromServer({ limit = 12, resetToFirst = true } = {}) {
                            try {
                                clearDiagBanner();
                                await fetchCartMap();
                                await fetchWishlistMap();
                                const groups = await fetchFrequentProducts(limit);
                                renderAndShow(groups);
                                if (resetToFirst && hasJQuery()) try {
                                    $(WRAPPER).find(".orders-freq-active").each(function () { try { $(this).trigger("to.owl.carousel", [0, 0, true]); } catch (e) { } });
                                } catch (e) { /* ignore */ }
                            } catch (e) { console.error("refreshFromServer failed", e); showDiagBanner("Refresh failed", "Check console for details.", { error: String(e) }); }
                        }

                        async function loadInitial() {
                            try {
                                await fetchCartMap().catch(() => { });
                                await fetchWishlistMap().catch(() => { });
                                const groups = await fetchFrequentProducts(12);
                                if (Array.isArray(groups) && groups.length) renderAndShow(groups);
                                initSocket();
                                window.addEventListener("resize", () => setTimeout(initAllOwls, 200), { passive: true });
                            } catch (e) { console.error("loadInitial failed", e); }
                        }

                        // Expose diagnostics & helpers
                        Object.defineProperty(window, "__frequentOrdersDiag", {
                            configurable: true, value: {
                                refresh: () => debouncedRefresh({ limit: 12, resetToFirst: true }),
                                cartData, stockMap, wishlistMap, lastFetchedGroups,
                                runAddDiagnostics, fetchFrequentProducts, fetchCartMap,
                                addToCartVariant: (btn = null, vid = null) => addToCartVariant(btn, vid).catch(() => { }),
                                updateCartQtyVariant: (vid, q, controls = null) => updateCartQtyVariant(vid, q, controls).catch(() => { }),
                                removeFromCartVariant: (vid, controls = null) => removeFromCartVariant(vid, controls).catch(() => { })
                            }
                        });

                        document.addEventListener("DOMContentLoaded", loadInitial);

                    })();
                </script>

