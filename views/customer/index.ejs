<div class="slider-with-banner">
  <div class="container">
    <div class="row">
      <!-- Begin Category Menu Area -->
      <div class="col-lg-3">
        <div class="category-menu category-menu-2">
          <div class="category-heading">
            <h2 class="categories-toggle"><span>categories</span></h2>
          </div>
          <div id="cate-toggle"></div>
          <a id="showMoreBtn" class="d-none d-lg-flex d-xl-flex d-xxl-flex"
             style="display:none;color:rgb(132, 158, 255); font-weight: 400;cursor:pointer;float:end">Show More</a>
          <script>
            const socket = io();
            const cateToggle = document.getElementById('cate-toggle');
            const showMoreBtn = document.getElementById('showMoreBtn');
            let fullMenuHtml = '';
            let initialLimit = 9;
            let updateTimeout;

            async function fetchCategoryMenu() {
              try {
                const res = await fetch('/frontend/category/menu', { credentials: 'same-origin' });
                if (!res.ok) throw new Error('Failed to fetch category menu');
                const html = await res.text();
                fullMenuHtml = html;
                renderLimitedMenu();
              } catch (err) {
                console.error(err);
                cateToggle.innerHTML = '<p>Failed to load menu</p>';
                showMoreBtn.style.display = 'none';
              }
            }

            function renderLimitedMenu() {
              cateToggle.innerHTML = fullMenuHtml;
              const menuUL = cateToggle.querySelector('ul');
              if (!menuUL) return;
              const allCategories = Array.from(menuUL.children);
              if (allCategories.length <= initialLimit) {
                showMoreBtn.style.display = 'none';
              } else {
                allCategories.forEach((item, index) => {
                  item.style.display = index < initialLimit ? '' : 'none';
                });
                showMoreBtn.style.display = 'block';
                showMoreBtn.textContent = 'Show More';
              }
            }

            showMoreBtn.addEventListener('click', () => {
              const menuUL = cateToggle.querySelector('ul');
              if (!menuUL) return;
              const allItems = Array.from(menuUL.children);
              const hiddenItems = allItems.filter((item, index) => index >= initialLimit && item.style.display === 'none');
              if (hiddenItems.length > 0) {
                hiddenItems.forEach(item => item.style.display = '');
                showMoreBtn.textContent = 'Show Less';
              } else {
                allItems.forEach((item, index) => {
                  if (index >= initialLimit) item.style.display = 'none';
                });
                showMoreBtn.textContent = 'Show More';
              }
            });

            function scheduleUpdate() {
              if (updateTimeout) clearTimeout(updateTimeout);
              updateTimeout = setTimeout(fetchCategoryMenu, 200);
            }

            fetchCategoryMenu();
            socket.on('categoryAddedOrUpdated', scheduleUpdate);
            socket.on('categoryDeleted', scheduleUpdate);
          </script>
        </div>
      </div>
      <!-- Category Menu Area End Here -->

      <!-- Begin Slider Area -->
      <div class="col-lg-6 col-md-8">
        <div class="slider-area slider-area-3 pt-sm-30 pt-xs-30 pb-xs-30">
          <div class="slider-active owl-carousel">
            <% if (carouselViewItems.length > 0) { %>
              <% carouselViewItems.forEach(function (item, index) { %>
                <% const pid = item.product_id ?? item.master_id ?? item.productId ?? ''; %>
                <% const vid = item.id ?? item.variant_id ?? item.variantId ?? ''; %>
                <% const href = productDetailUrl(item); %>
                <% const anim = (index % 2) + 1; %>
                <div class="single-slide align-center-left animation-style-0<%= anim %> js-discount-card discount-slide-card"
                     data-href="<%= href %>"
                     data-product-id="<%= pid %>"
                     data-variant-id="<%= vid %>">
                  <img class="discount-slide-img" src="<%= getImage(item) %>" alt="<%= getTitle(item) %>" loading="lazy" onerror="this.src='/customer/images/banner/placeholder.jpg'">
                  <div class="discount-overlay"></div>
                  <div class="slider-progress"></div>
                  <div class="slider-content">
                    <h5>Sale Offer <span><%= getDiscountLabel(item) %></span> This Week</h5>
                    <h2><%= getTitle(item) %></h2>
                    <h3>Starting at <span>AED <%= money(getFinalPrice(item)) %></span></h3>
                    <div class="default-btn slide-btn">
                      <a class="links" href="<%= href %>">Shopping Now</a>
                    </div>
                  </div>
                </div>
              <% }); %>
            <% } else { %>
              <div class="single-slide align-center-left animation-style-01 bg-7 discount-slide-card">
