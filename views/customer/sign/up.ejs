<!DOCTYPE html>
<html lang="en">

<head>
  <title>SignUp - JOOD | Quality Goods & Products</title>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <meta name="description"
    content="Create your JOOD account to start shopping premium lifestyle and digital products. Enjoy secure payments, fast delivery, and exclusive member benefits.">

  <meta name="keywords"
    content="JOOD signup, create account, register ecommerce account, online shopping registration, secure signup">

  <meta name="robots" content="noindex, follow">

  <link rel="canonical" href="https://jood.com/customer/sign/up">
  <link rel="shortcut icon" href="/customer/images/web-img-vid/favicon.png" type="image/x-icon">


  <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,400,600,700" rel="stylesheet" />
  <link href="/customer/assets/css/nucleo-icons.css" rel="stylesheet" />
  <link href="/customer/assets/css/nucleo-svg.css" rel="stylesheet" />
  <script src="https://kit.fontawesome.com/42d5adcbca.js" crossorigin="anonymous"></script>
  <link id="pagestyle" href="/customer/assets/css/soft-ui-dashboard.css?v=1.0.3" rel="stylesheet" />
</head>

<body class="g-sidenav-show bg-gray-100">

  <section class="min-vh-100 mb-8">
    <div class="page-header align-items-start min-vh-50 pt-5 pb-11 m-3 border-radius-lg"
      style="background-image: url('/customer/assets/img/curved-images/s.png'); background-size: cover; background-position: center;">
      <span class="mask bg-gradient-dark opacity-6"></span>
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-lg-5 text-center mx-auto">

            <!-- Logo -->
            <div class="logo mb-4">
              <a href="/">
                <img src="/customer/images/web-img-vid/logo.png" width="120" alt="logo">
              </a>
            </div>

            <!-- Heading -->
            <h1 class="text-white mb-2">Welcome!</h1>

            <!-- Subtext -->
            <p class="text-lead text-white">
              Create your account to continue shopping with JOOD
            </p>

          </div>
        </div>
      </div>
    </div>

    <div class="container">
      <div class="row mt-lg-n10 mt-md-n11 mt-n10">
        <div class="col-xl-4 col-lg-5 col-md-7 mx-auto">
          <div class="card z-index-0">
            <div class="card-header text-center pt-4">
              <h5>Register with</h5>
            </div>

            <div class="row px-xl-5 px-sm-4 px-3">
              <div class="col-12 me-auto px-1">
                <a class="btn btn-outline-light w-100" href="/customer/auth/google">
                  <svg width="24px" height="32px" viewBox="0 0 64 64">
                    <g transform="translate(3,2)">
                      <path fill="#4285F4"
                        d="M57.81,30.15c0-2.43-0.2-4.2-0.62-6.03H29.5v10.95h16.25c-0.33,2.72-2.1,6.82-6.03,9.57l-0.06,0.37l8.75,6.78l0.61,0.06C54.6,46.7,57.81,39.13,57.81,30.15z" />
                      <path fill="#34A853"
                        d="M29.5,58.99c7.96,0,14.65-2.62,19.53-7.15l-9.31-7.21c-2.49,1.74-5.83,2.95-10.22,2.95
                        c-7.8,0-14.42-5.14-16.78-12.26l-0.35,0.03l-9.1,7.05l-0.12,0.33C8,52.37,17.96,58.99,29.5,58.99z" />
                      <path fill="#FBBC05" d="M12.71,35.33c-0.62-1.84-0.98-3.8-0.98-5.83c0-2.03,0.36-4,0.95-5.83l-0.02-0.39l-9.22-7.16l-0.3,0.14
                        C1.15,20.25,0,24.74,0,29.5c0,4.75,1.15,9.24,3.15,13.24L12.71,35.33z" />
                      <path fill="#EB4335" d="M29.5,11.4c5.54,0,9.27,2.39,11.4,4.39l8.32-8.13C44.11,2.91,37.46,0,29.5,0
                        C17.96,0,8,6.62,3.15,16.25l9.53,7.4C15.08,16.55,21.7,11.4,29.5,11.4z" />
                    </g>
                  </svg>
                  OOGLE
                </a>
              </div>

              <div class="text-center my-2">
                <span class="border-top d-inline-block" style="width:40px;"></span>
                <span class="mx-2 text-secondary">or</span>
                <span class="border-top d-inline-block" style="width:40px;"></span>
              </div>
            </div>

            <div class="card-body">
              <% if (typeof error !=='undefined' && error) { %>
                <div class="alert alert-danger text-white" role="alert">
                  <%= error %>
                </div>
                <% } %>

                  <% if (typeof success !=='undefined' && success) { %>
                    <div class="alert alert-success text-white" role="alert">
                      <%= success %>
                    </div>
                    <% } %>

                      <form role="form text-left" action="/customer/sign/up" method="POST" autocomplete="off">
                        <% if (csrfToken) { %>
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <% } %>

                            <div class="mb-3">
                              <input type="text" name="full_name" class="form-control" placeholder="Name"
                                aria-label="Name" minlength="2" maxlength="80"
                                value="<%= old && old.fullName ? old.fullName : '' %>" required>
                            </div>

                            <div class="mb-3">
                              <input type="email" name="email" class="form-control" placeholder="Email"
                                aria-label="Email" value="<%= old && old.email ? old.email : '' %>" required>
                            </div>

                            <div class="mb-3">
                              <input type="text" name="phone" class="form-control" placeholder="Phone Number"
                                aria-label="Phone Number" maxlength="20"
                                value="<%= old && old.phone ? old.phone : '' %>">
                            </div>

                            <div class="mb-3">
                              <input type="password" name="password" class="form-control" placeholder="Password"
                                aria-label="Password" minlength="8" maxlength="128" required>
                            </div>

                            <div class="mb-3">
                              <input type="password" name="confirm_password" class="form-control"
                                placeholder="Confirm Password" aria-label="Confirm Password" minlength="8"
                                maxlength="128" required>
                            </div>

                            <div class="form-check form-check-info text-left">
                              <input class="form-check-input" type="checkbox" name="agree_terms" value="1"
                                id="agree_terms" <%=!old || old.agreeTerms !==false ? 'checked' : '' %>
                              >
                              <label class="form-check-label" for="agree_terms">
                                I agree to the
                                <a href="/terms" class="text-dark font-weight-bolder">Terms and Conditions</a>
                              </label>
                            </div>

                            <div class="text-center">
                              <button type="submit" class="btn bg-gradient-dark w-100 my-4 mb-2">Sign up</button>
                            </div>

                            <p class="text-sm mt-3 mb-0">
                              Already have an account?
                              <a href="/customer/sign/in" class="text-dark font-weight-bolder">Sign in</a>
                            </p>
                      </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script src="/customer/assets/js/core/popper.min.js"></script>
  <script src="/customer/assets/js/core/bootstrap.min.js"></script>
  <script src="/customer/assets/js/plugins/perfect-scrollbar.min.js"></script>
  <script src="/customer/assets/js/plugins/smooth-scrollbar.min.js"></script>
  <script async defer src="https://buttons.github.io/buttons.js"></script>
  <script src="/customer/assets/js/soft-ui-dashboard.min.js?v=1.0.3"></script>
  <!-- Guest Token Manager (handles cart persistence for non-logged-in users) -->
  <script src="/js/guest-token-manager.js"></script>
</body>

</html>