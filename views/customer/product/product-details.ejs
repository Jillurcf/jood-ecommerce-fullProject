<style>
  :root {
    --ap-bg: #ffffff;
    --ap-card: #ffffff;
    --ap-text: #0f1111;
    --ap-muted: #565959;
    --ap-border: #d5d9d9;
    --ap-blue: #007185;
    --ap-yellow: #ffd814;
    --ap-yellow-dark: #f7ca00;
    --ap-green: #067d62;
    --ap-red: #b12704;
    --ap-radius: 12px;
    --ap-btn-h: 38px;
    --ap-btn-radius: 8px;
  }

  .amazon-pdp {
    background: var(--ap-bg);
    color: var(--ap-text);
    padding: 0 0 32px;
  }

  .amazon-pdp * {
    box-sizing: border-box;
  }

  .ap-wrap {
    margin: 0 auto;
    padding: 16px;
  }

  .ap-breadcrumbs {
    font-size: 12px;
    color: var(--ap-muted);
    margin: 0 0 12px;
  }

  .ap-breadcrumbs a {
    color: var(--ap-blue);
    text-decoration: none;
  }

  .ap-breadcrumbs span {
    margin: 0 4px;
  }

  .ap-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 16px;
    align-items: start;
  }

  .ap-main,
  .ap-buybox,
  .ap-section {
    background: var(--ap-card);
    border-radius: var(--ap-radius);
    border: 1px solid rgba(213, 217, 217, 0.6);
  }

  .ap-main {
    padding: 16px;
    width: 100%;
  }

  .ap-buybox {
    padding: 16px;
    position: sticky;
    top: 12px;
  }

  .ap-grid {
    display: grid;
    grid-template-columns: 86px minmax(0, 1fr);
    gap: 18px;
  }

  .ap-thumbs {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-height: 680px;
    overflow: auto;
    padding-right: 2px;
  }

  .ap-thumb {
    border: 1px solid var(--ap-border);
    border-radius: 10px;
    overflow: hidden;
    background: #fff;
    padding: 0;
    cursor: pointer;
    aspect-ratio: 1 / 1;
    transition: 0.18s ease;
  }

  .ap-thumb.is-active {
    outline: 2px solid var(--ap-yellow);
    border-color: var(--ap-yellow);
  }

  .ap-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ap-main-image {
    border: 1px solid var(--ap-border);
    border-radius: 14px;
    overflow: hidden;
    background: #fff;
    min-height: 420px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ap-main-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    max-height: 620px;
    display: block;
  }

  .ap-image-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 5;
    width: 38px;
    height: 38px;
    border-radius: 999px;
    border: 1px solid var(--ap-border);
    background: rgba(255, 255, 255, 0.96);
    color: var(--ap-text);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(15, 17, 17, 0.08);
  }

  .ap-image-prev {
    left: 10px;
  }

  .ap-image-next {
    right: 10px;
  }

  .ap-title {
    font-size: 28px;
    line-height: 1.25;
    font-weight: 400;
    margin: 0;
  }

  .ap-brand {
    margin-top: 8px;
    color: var(--ap-blue);
    font-size: 14px;
    font-weight: 600;
  }

  .ap-rating-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin: 10px 0 12px;
    font-size: 14px;
    color: var(--ap-muted);
  }

  .ap-stars {
    color: #ffa41c;
    letter-spacing: 1px;
  }

  .ap-price {
    margin: 14px 0 10px;
  }

  .ap-price-now {
    font-size: 28px;
    font-weight: 400;
    line-height: 1.1;
  }

  .ap-price-old {
    font-size: 14px;
    color: var(--ap-muted);
    text-decoration: line-through;
    margin-top: 4px;
  }

  .ap-save {
    font-size: 13px;
    color: var(--ap-green);
    margin-top: 4px;
    font-weight: 700;
  }

  .ap-note {
    font-size: 13px;
    color: var(--ap-muted);
    margin-top: 6px;
  }

  .ap-badges {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin: 12px 0;
  }

  .ap-badge {
    border-radius: 999px;
    padding: 6px 10px;
    font-size: 12px;
    font-weight: 700;
    border: 1px solid var(--ap-border);
    background: #f7fafa;
  }

  .ap-badge.success {
    background: #f0f8f7;
    color: var(--ap-green);
    border-color: rgba(6, 125, 98, 0.2);
  }

  .ap-badge.danger {
    background: #fff4f0;
    color: var(--ap-red);
    border-color: rgba(177, 39, 4, 0.2);
  }

  .ap-badge.primary {
    background: #f0f8ff;
    color: var(--ap-blue);
    border-color: rgba(0, 113, 133, 0.2);
  }

  .ap-box {
    border: 1px solid var(--ap-border);
    border-radius: 14px;
    padding: 14px;
    margin-top: 14px;
    background: #fff;
  }

  .ap-box h3 {
    margin: 0 0 12px;
    font-size: 16px;
    line-height: 1.25;
  }

  .ap-about {
    font-size: 14px;
    line-height: 1.7;
    color: var(--ap-text);
    white-space: pre-wrap;
  }

  .ap-list {
    display: grid;
    gap: 10px;
  }

  .ap-row {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 12px;
    padding: 10px 0;
    border-top: 1px solid var(--ap-border);
  }

  .ap-row:first-child {
    border-top: 0;
  }

  .ap-row .k {
    font-size: 13px;
    color: var(--ap-muted);
  }

  .ap-row .v {
    font-size: 13px;
    color: var(--ap-text);
    word-break: break-word;
    white-space: pre-wrap;
  }

  .ap-attr-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .ap-attr {
    border: 1px solid var(--ap-border);
    border-radius: 12px;
    padding: 12px;
    background: #fff;
  }

  .ap-attr .k {
    font-size: 12px;
    color: var(--ap-muted);
    margin-bottom: 4px;
  }

  .ap-attr .v {
    font-size: 14px;
    font-weight: 600;
  }

  .ap-actions {
    display: flex;
    gap: 8px;
    margin-top: 14px;
    align-items: center;
    flex-wrap: wrap;
  }

  .ap-buy-inline {
    display: flex;
    gap: 8px;
    align-items: center;
    flex: 1;
    min-width: 260px;
  }

  .ap-btn,
  .btn-cart,
  .btn-fav {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: var(--ap-btn-h);
    border-radius: var(--ap-btn-radius);
    cursor: pointer;
    border: 0;
    transition: all 0.2s ease;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    line-height: 1;
  }

  .ap-btn-primary,
  .btn-cart {
    background: var(--ap-yellow);
    color: #111;
  }

  .ap-btn-primary:hover,
  .btn-cart:hover {
    background: var(--ap-yellow-dark);
  }

  .ap-btn-secondary,
  .btn-fav {
    background: #fff;
    color: var(--ap-text);
    border: 1px solid var(--ap-border);
  }

  .ap-btn-secondary:hover,
  .btn-fav:hover {
    background: #f7fafa;
  }

  .ap-btn,
  .btn-cart {
    padding: 0 14px;
  }

  .btn-cart {
    min-width: 110px;
  }

  .btn-fav {
    width: var(--ap-btn-h);
    min-width: var(--ap-btn-h);
    padding: 0;
  }

  .btn-fav.is-fav {
    background: var(--ap-red);
    color: #fff;
    border-color: var(--ap-red);
  }

  .btn-fav.is-fav:hover {
    background: #bb2d3b;
  }

  .ap-btn[disabled],
  .btn-cart[disabled],
  .btn-fav[disabled] {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .ap-inline-error {
    margin-top: 10px;
    color: var(--ap-red);
    font-size: 13px;
    min-height: 18px;
  }

  .ap-empty {
    border: 1px dashed var(--ap-border);
    border-radius: 12px;
    padding: 18px;
    text-align: center;
    color: var(--ap-muted);
    background: #fff;
  }

  .ap-hidden {
    display: none !important;
  }

  .ap-carousel-shell {
    position: relative;
    margin-top: 16px;
  }

  .ap-carousel-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
  }

  .ap-carousel-head h2 {
    margin: 0;
    font-size: 20px;
    font-weight: 700;
  }

  .ap-carousel-controls {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .ap-carousel-btn {
    width: 38px;
    height: 38px;
    border-radius: 999px;
    border: 1px solid var(--ap-border);
    background: #fff;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    color: var(--ap-text);
  }

  .ap-carousel-btn:hover {
    background: #f7fafa;
  }

  .ap-carousel-track {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-behavior: smooth;
    padding-bottom: 6px;
    scrollbar-width: none;
  }

  .ap-carousel-track::-webkit-scrollbar {
    display: none;
  }

  .ap-card {
    flex: 0 0 calc((100% - 36px) / 4);
    min-width: 220px;
    background: #fff;
    border: 1px solid #ececec;
    border-radius: 12px;
    padding: 10px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    cursor: pointer;
    transition: all 0.25s ease;
    font-family: Inter, system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
    color: #111;
    will-change: transform;
    text-decoration: none;
  }

  .ap-card:hover {
    transform: translateY(-4px);
    border-color: rgba(13, 110, 253, 0.2);
  }

  .ap-card:active {
    transform: scale(0.98);
  }

  .compact-image {
    height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fafafa;
    border-radius: 8px;
    overflow: hidden;
    position: relative;
  }

  .compact-image img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    transition: transform 0.3s ease;
  }

  .ap-card:hover .compact-image img {
    transform: scale(1.08);
  }

  .badges {
    position: absolute;
    top: 8px;
    left: 8px;
    display: flex;
    gap: 6px;
    z-index: 3;
    flex-wrap: wrap;
  }

  .badge-green,
  .badge-red {
    color: #fff;
    padding: 4px 7px;
    font-size: 11px;
    border-radius: 4px;
    font-weight: 700;
  }

  .badge-green {
    background: var(--ap-green);
  }

  .badge-red {
    background: var(--ap-red);
  }

  .prod-title {
    font-weight: 700;
    font-size: 13px;
    line-height: 1.2;
    margin-bottom: 6px;
    max-height: 2.6em;
    overflow: hidden;
  }

  .price-line {
    display: flex;
    align-items: flex-end;
    gap: 8px;
    margin: 6px 0;
  }

  .price-current {
    font-weight: 800;
    font-size: 13px;
  }

  .price-old {
    font-size: 11px;
    color: var(--ap-muted);
    text-decoration: line-through;
  }

  .saved-small {
    font-size: 10px;
    color: var(--ap-muted);
  }

  .stock-line {
    font-size: 11px;
    margin-top: 6px;
  }

  .stock-available {
    color: var(--ap-green);
    font-weight: 700;
  }

  .stock-limited {
    color: var(--ap-red);
    font-weight: 700;
  }

  .stock-out {
    color: var(--ap-muted);
    font-weight: 700;
  }

  .product-actions {
    display: flex;
    gap: 8px;
    align-items: center;
    margin-top: 8px;
    justify-content: space-between;
  }

  .ap-qty {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: var(--ap-btn-h);
    border: 1px solid #e8e8e8;
    padding: 0 4px;
    border-radius: 999px;
    background: #fff;
    white-space: nowrap;
  }

  .ap-qty button {
    border: 0;
    background: transparent;
    font-size: 18px;
    cursor: pointer;
    width: 30px;
    height: 30px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  .ap-qty span {
    min-width: 22px;
    text-align: center;
    font-weight: 700;
    font-size: 14px;
  }

  .ap-sticky-mobile {
    display: none;
    position: sticky;
    bottom: 0;
    z-index: 20;
    padding: 10px 16px;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(8px);
    border-top: 1px solid rgba(255, 255, 255, 0.8);
  }

  .ap-mobile-bar {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .ap-mobile-bar .ap-btn {
    flex: 1;
    margin: 0;
  }

  .ap-cart-slot {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .ap-swipe-hint {
    display: none;
    gap: 8px;
    font-size: 12px;
    color: var(--ap-muted);
    align-items: center;
    user-select: none;
    margin-top: 8px;
  }

  .ap-section {
    padding: 16px;
    margin-top: 16px;
  }

  .ap-section-title {
    margin: 0 0 12px;
    font-size: 20px;
    font-weight: 700;
  }

  @media (max-width: 1200px) {
    .ap-buybox {
      display: none;
    }

    .ap-sticky-mobile {
      display: block;
    }
  }

  @media (max-width: 900px) {
    .ap-layout {
      grid-template-columns: 1fr;
    }

    .ap-grid {
      grid-template-columns: 1fr;
    }

    .ap-thumbs {
      flex-direction: row;
      max-height: none;
      overflow-x: auto;
      overflow-y: hidden;
      padding-bottom: 2px;
    }

    .ap-thumb {
      width: 74px;
      min-width: 74px;
    }

    .ap-main-image {
      min-height: 300px;
    }

    .ap-attr-grid {
      grid-template-columns: 1fr;
    }

    .ap-row {
      grid-template-columns: 1fr;
      gap: 4px;
    }

    .ap-carousel-btn {
      display: none;
    }

    .ap-swipe-hint {
      display: flex;
    }

    .ap-card {
      flex: 0 0 78%;
      min-width: 78%;
      scroll-snap-align: start;
    }

    .ap-carousel-track {
      scroll-snap-type: x mandatory;
    }

    .ap-sticky-mobile {
      display: block;
    }
  }

  @media (max-width: 600px) {
    .ap-title {
      font-size: 22px;
    }

    .ap-price-now {
      font-size: 24px;
    }

    .ap-section-title {
      font-size: 18px;
    }

    .ap-card {
      flex-basis: 86%;
      min-width: 86%;
    }

    .ap-mobile-bar {
      flex-direction: column;
      align-items: stretch;
    }

    .ap-actions {
      align-items: stretch;
    }

    .ap-buy-inline {
      min-width: 0;
      width: 100%;
    }

    .btn-cart,
    .btn-fav {
      width: auto;
    }
  }
</style>

<section class="amazon-pdp" data-product-id="<%= pageProductId %>" data-variant-id="<%= pageVariantId %>">
  <div class="ap-wrap">
    <div class="ap-breadcrumbs">
      <a href="/">Home</a> <span>›</span> <span><%= currentBrand || 'Product' %></span>
    </div>

    <% if (!pageProductId && !pageVariantId) { %>
      <div class="ap-empty">Product not found.</div>
    <% } else { %>
      <div class="ap-layout">
        <main class="ap-main">
          <div class="ap-grid">
            <div>
              <div class="ap-thumbs" id="pd-thumbs">
                <% currentMedia.forEach(function (url, idx) { %>
                  <button type="button" class="ap-thumb <%= idx === 0 ? 'is-active' : '' %>" data-image="<%= url %>">
                    <img src="<%= url %>" alt="<%= currentTitle %> thumbnail <%= idx + 1 %>" loading="lazy">
                  </button>
                <% }) %>
              </div>
            </div>

            <div>
              <div class="ap-main-image">
                <button type="button" class="ap-image-nav ap-image-prev" id="pd-image-prev" aria-label="Previous image">
                  <i class="fa fa-chevron-left"></i>
                </button>
                <img id="pd-main-image" src="<%= currentPrimaryImage %>" alt="<%= currentTitle %>" loading="eager">
                <button type="button" class="ap-image-nav ap-image-next" id="pd-image-next" aria-label="Next image">
                  <i class="fa fa-chevron-right"></i>
                </button>
              </div>

              <div class="ap-badges">
                <% if (currentBrand) { %>
                  <span class="ap-badge primary" id="pd-brand"><%= currentBrand %></span>
                <% } %>
                <span class="ap-badge <%= currentStock > 0 ? 'success' : 'danger' %>" id="pd-stock-badge">
                  <%= currentStock > 0 ? 'In Stock' : 'Out of Stock' %>
                </span>
                <% if (currentDiscountMeta.label) { %>
                  <span class="ap-badge danger" id="pd-discount-badge"><%= currentDiscountMeta.label %></span>
                <% } else { %>
                  <span class="ap-badge danger ap-hidden" id="pd-discount-badge"></span>
                <% } %>
              </div>
            </div>
          </div>

          <div style="margin-top:18px;">
            <h1 class="ap-title" id="pd-title"><%= currentTitle %></h1>
            <div class="ap-brand">Visit the <span id="pd-brand-text"><%= currentBrand || 'brand' %></span> store</div>

            <div class="ap-rating-row">
              <span class="ap-stars">★★★★★</span>
              <a href="#ap-review-summary" style="color:var(--ap-blue);text-decoration:none;">See reviews</a>
              <span>|</span>
              <span id="pd-stock-text"><%= currentStock %> in stock</span>
            </div>

            <div class="ap-price">
              <div class="ap-price-now" id="pd-final-price">AED <%= currentFinalPrice.toFixed(2) %></div>
              <% if (currentOriginalPrice > currentFinalPrice) { %>
                <div class="ap-price-old" id="pd-original-price">AED <%= currentOriginalPrice.toFixed(2) %></div>
                <div class="ap-save" id="pd-save-amount"><%= currentDiscountMeta.label ? currentDiscountMeta.label : ('Save AED ' + (currentOriginalPrice - currentFinalPrice).toFixed(2)) %></div>
              <% } else { %>
                <div class="ap-price-old ap-hidden" id="pd-original-price"></div>
                <div class="ap-save ap-hidden" id="pd-save-amount"></div>
              <% } %>
              <div class="ap-note" id="pd-price-note"><%= currentVariant.vat_included ? 'Includes VAT' : 'Excludes VAT' %></div>
            </div>

            <div class="ap-actions" style="display:none">
              <div class="ap-buy-inline">
                <button class="ap-btn ap-btn-primary btn-cart pd-add-cart" id="pd-add-cart-btn" type="button" data-variant-id="<%= pageVariantId %>">
                  <i class="fa fa-shopping-cart" aria-hidden="true"></i>
                  Add
                </button>

                <div class="ap-qty ap-hidden" id="pd-qty-controls" data-variant-id="<%= pageVariantId %>">
                  <button type="button" id="pd-qty-minus" aria-label="Decrease quantity">−</button>
                  <span id="pd-qty-count">0</span>
                  <button type="button" id="pd-qty-plus" aria-label="Increase quantity">+</button>
                </div>
              </div>

              <button class="ap-btn ap-btn-secondary btn-fav pd-fav <%= currentVariant.is_fav ? 'is-fav' : '' %>" id="pd-wishlist-btn" type="button" data-variant-id="<%= pageVariantId %>">
                <i class="fa fa-heart" aria-hidden="true"></i>
                
              </button>
            </div>

            <div class="ap-inline-error ap-hidden" id="pd-inline-error"></div>
   <style>
  :root {
    --ap-bg: #ffffff;
    --ap-card: #ffffff;
    --ap-text: #0f1111;
    --ap-muted: #565959;
    --ap-border: #d5d9d9;
    --ap-blue: #007185;
    --ap-yellow: #ffd814;
    --ap-yellow-dark: #f7ca00;
    --ap-green: #067d62;
    --ap-red: #b12704;
    --ap-radius: 12px;
    --ap-btn-h: 38px;
    --ap-btn-radius: 8px;
  }

  .amazon-pdp {
    background: var(--ap-bg);
    color: var(--ap-text);
    padding: 0 0 32px;
  }

  .amazon-pdp * {
    box-sizing: border-box;
  }

  .ap-wrap {
    margin: 0 auto;
    padding: 16px;
  }

  .ap-breadcrumbs {
    font-size: 12px;
    color: var(--ap-muted);
    margin: 0 0 12px;
  }

  .ap-breadcrumbs a {
    color: var(--ap-blue);
    text-decoration: none;
  }

  .ap-breadcrumbs span {
    margin: 0 4px;
  }

  .ap-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 16px;
    align-items: start;
  }

  .ap-main,
  .ap-buybox,
  .ap-section {
    background: var(--ap-card);
    border-radius: var(--ap-radius);
    border: 1px solid rgba(213, 217, 217, 0.6);
  }

  .ap-main {
    padding: 16px;
    width: 100%;
  }

  .ap-buybox {
    padding: 16px;
    position: sticky;
    top: 12px;
  }

  .ap-grid {
    display: grid;
    grid-template-columns: 86px minmax(0, 1fr);
    gap: 18px;
  }

  .ap-thumbs {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-height: 680px;
    overflow: auto;
    padding-right: 2px;
  }

  .ap-thumb {
    border: 1px solid var(--ap-border);
    border-radius: 10px;
    overflow: hidden;
    background: #fff;
    padding: 0;
    cursor: pointer;
    aspect-ratio: 1 / 1;
    transition: 0.18s ease;
  }

  .ap-thumb.is-active {
    outline: 2px solid var(--ap-yellow);
    border-color: var(--ap-yellow);
  }

  .ap-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ap-main-image {
    border: 1px solid var(--ap-border);
    border-radius: 14px;
    overflow: hidden;
    background: #fff;
    min-height: 420px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ap-main-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    max-height: 620px;
    display: block;
  }

  .ap-image-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 5;
    width: 38px;
    height: 38px;
    border-radius: 999px;
    border: 1px solid var(--ap-border);
    background: rgba(255, 255, 255, 0.96);
    color: var(--ap-text);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(15, 17, 17, 0.08);
  }

  .ap-image-prev {
    left: 10px;
  }

  .ap-image-next {
    right: 10px;
  }

  .ap-title {
    font-size: 28px;
    line-height: 1.25;
    font-weight: 400;
    margin: 0;
  }

  .ap-brand {
    margin-top: 8px;
    color: var(--ap-blue);
    font-size: 14px;
    font-weight: 600;
  }

  .ap-rating-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin: 10px 0 12px;
    font-size: 14px;
    color: var(--ap-muted);
  }

  .ap-stars {
    color: #ffa41c;
    letter-spacing: 1px;
  }

  .ap-price {
    margin: 14px 0 10px;
  }

  .ap-price-now {
    font-size: 28px;
    font-weight: 400;
    line-height: 1.1;
  }

  .ap-price-old {
    font-size: 14px;
    color: var(--ap-muted);
    text-decoration: line-through;
    margin-top: 4px;
  }

  .ap-save {
    font-size: 13px;
    color: var(--ap-green);
    margin-top: 4px;
    font-weight: 700;
  }

  .ap-note {
    font-size: 13px;
    color: var(--ap-muted);
    margin-top: 6px;
  }

  .ap-badges {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin: 12px 0;
  }

  .ap-badge {
    border-radius: 999px;
    padding: 6px 10px;
    font-size: 12px;
    font-weight: 700;
    border: 1px solid var(--ap-border);
    background: #f7fafa;
  }

  .ap-badge.success {
    background: #f0f8f7;
    color: var(--ap-green);
    border-color: rgba(6, 125, 98, 0.2);
  }

  .ap-badge.danger {
    background: #fff4f0;
    color: var(--ap-red);
    border-color: rgba(177, 39, 4, 0.2);
  }

  .ap-badge.primary {
    background: #f0f8ff;
    color: var(--ap-blue);
    border-color: rgba(0, 113, 133, 0.2);
  }

  .ap-box {
    position: relative;
    border: 1px solid var(--ap-border);
    border-radius: 14px;
    padding: 14px;
    margin-top: 14px;
    background: #fff;
  }

  .ap-box h3 {
    margin: 0 0 12px;
    font-size: 16px;
    line-height: 1.25;
  }

  .ap-about {
    font-size: 14px;
    line-height: 1.7;
    color: var(--ap-text);
    white-space: pre-wrap;
  }

  .ap-list {
    display: grid;
    gap: 10px;
  }

  .ap-row {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 12px;
    padding: 10px 0;
    border-top: 1px solid var(--ap-border);
  }

  .ap-row:first-child {
    border-top: 0;
  }

  .ap-row .k {
    font-size: 13px;
    color: var(--ap-muted);
  }

  .ap-row .v {
    font-size: 13px;
    color: var(--ap-text);
    word-break: break-word;
    white-space: pre-wrap;
  }

  .ap-attr-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .ap-attr {
    border: 1px solid var(--ap-border);
    border-radius: 12px;
    padding: 12px;
    background: #fff;
  }

  .ap-attr .k {
    font-size: 12px;
    color: var(--ap-muted);
    margin-bottom: 4px;
  }

  .ap-attr .v {
    font-size: 14px;
    font-weight: 600;
  }

  /* Keep buttons inline, compact, and professionally balanced */
  .ap-actions {
    display: flex;
    gap: 8px;
    margin-top: 14px;
    align-items: center;
    flex-wrap: nowrap;
    width: 100%;
  }

  .ap-buy-inline {
    display: flex;
    gap: 8px;
    align-items: center;
    flex: 1 1 auto;
    min-width: 0;
  }

  .ap-btn,
  .btn-cart,
  .btn-fav {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: var(--ap-btn-h);
    border-radius: var(--ap-btn-radius);
    cursor: pointer;
    border: 0;
    transition: all 0.2s ease;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    line-height: 1;
    flex: 0 0 auto;
  }

  .ap-btn-primary,
  .btn-cart {
    background: var(--ap-yellow);
    color: #111;
  }

  .ap-btn-primary:hover,
  .btn-cart:hover {
    background: var(--ap-yellow-dark);
  }

  .ap-btn-secondary,
  .btn-fav {
    background: #fff;
    color: var(--ap-text);
    border: 1px solid var(--ap-border);
  }

  .ap-btn-secondary:hover,
  .btn-fav:hover {
    background: #f7fafa;
  }

  .ap-btn,
  .btn-cart {
    padding: 0 12px;
  }

  .btn-cart {
    min-width: 96px;
  }

  .btn-fav {
    width: var(--ap-btn-h);
    min-width: var(--ap-btn-h);
    padding: 0;
    flex: 0 0 var(--ap-btn-h);
  }

  .btn-fav.is-fav {
    background: var(--ap-red);
    color: #fff;
    border-color: var(--ap-red);
  }

  .btn-fav.is-fav:hover {
    background: #bb2d3b;
  }

  .ap-btn[disabled],
  .btn-cart[disabled],
  .btn-fav[disabled] {
    opacity: 0.55;
    cursor: not-allowed;
  }

  /* Quantity controller: same height, compact, inline */
  .ap-qty {
    display: inline-flex;
    align-items: center;
    height: var(--ap-btn-h);
    border: 1px solid var(--ap-border);
    padding: 0 4px;
    border-radius: 999px;
    background: #fff;
    white-space: nowrap;
    flex: 0 0 auto;
  }

  .ap-qty button {
    border: 0;
    background: transparent;
    font-size: 18px;
    cursor: pointer;
    width: 30px;
    height: 30px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
    flex: 0 0 auto;
  }

  .ap-qty span {
