}

/* =========================
   ACTION BUTTONS
========================= */

.product-actions {
  display: flex;
  gap: 8px;
  align-items: center;
  margin-top: 8px;
  justify-content: space-between;
}

.btn-cart,
.btn-fav,
.btn-select {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 8px 10px;
