}

/* =========================
   TEXT
========================= */

.prod-title {
  font-weight: 700;
  font-size: 13px;
  line-height: 1.2;
  margin-bottom: 6px;
  max-height: 2.6em;
  overflow: hidden;
}

/* =========================
   PRICE
========================= */

.price-line {
  display: flex;
  align-items: flex-end;
  gap: 8px;
  margin: 6px 0;
}

.price-current {
  font-weight: 800;
  font-size: 13px;
}

.price-old {
  font-size: 11px;
