}

.btn-fav.is-fav:hover {
  background: #bb2d3b;
}

/* Select */
.btn-select {
  background: var(--accent);
  color: #fff;
}

/* =========================
   QUANTITY
========================= */

.qty-controls {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  border: 1px solid #e8e8e8;
  padding: 4px;
  border-radius: 8px;
