        <script>
          (function () {
            "use strict";

            /* --------------------------------------------------------------------------
               CONFIG
            -------------------------------------------------------------------------- */
            const CONTAINER_ID = "relevant-products-container";
            const PREV_BTN_ID = "relevant-prev";
            const NEXT_BTN_ID = "relevant-next";

            const CONTAINER = document.getElementById(CONTAINER_ID);
            const CSRF = document.querySelector('meta[name="csrf-token"]')?.content || null;
            const GUEST_KEY = "guest_wishlist_token";
            const CURRENT_PRODUCT_ID = document.body.dataset.productId;

            const API = {
              cartGet: "/customer/cart/api",
              cartAdd: "/customer/cart/add",
              cartUpdate: "/customer/cart/update",
              cartRemove: "/customer/cart/remove",

              recent: `/customer/product/product-detail/api/${CURRENT_PRODUCT_ID}`,
              wishlistToggle: "/wishlist/toggle",
              wishlistGet: "/wishlist"
            };

            const REQUEST_TIMEOUT = 15000;
            const REFRESH_DEBOUNCE_MS = 250;
            const MIN_LOOP_ITEMS = 6;

            if (!CONTAINER) {
              console.warn("relevant-products: container not found:", CONTAINER_ID);
              return;
            }

            /* --------------------------------------------------------------------------
               STATE
            -------------------------------------------------------------------------- */
            const cartData = new Map(); // key: v:<variantId> -> qty
            const stockMap = new Map(); // key: variantId -> stock
            const wishlistMap = Object.create(null); // key: variantId -> true
            const requestLocks = new Map();

            let lastFetchedProducts = [];
            let socketRefreshTimer = null;

            window.variantToMasterMap = window.variantToMasterMap || Object.create(null);

            /* --------------------------------------------------------------------------
               HELPERS
            -------------------------------------------------------------------------- */
            const escapeHtml = (v) => {
              if (v == null) return "";
              return String(v)
                .replaceAll("&", "&amp;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;")
                .replaceAll('"', "&quot;")
                .replaceAll("'", "&#39;");
            };

            const toInt = (v, d = 0) => {
              const n = parseInt(String(v ?? ""), 10);
              return Number.isFinite(n) ? n : d;
            };

            const toNum = (v, d = 0) => {
              const n = Number(v);
              return Number.isFinite(n) ? n : d;
            };

            const debounce = (fn, ms) => {
              let t = null;
              return (...args) => {
                if (t) clearTimeout(t);
                t = setTimeout(() => fn(...args), ms);
              };
            };

            const isVatIncludedFlag = (v) => {
              if (v === true || v === 1) return true;
              if (v === false || v === 0) return false;
              if (typeof v === "string") {
                const s = v.trim().toLowerCase();
                return s === "true" || s === "t" || s === "1" || s === "yes";
              }
              return false;
            };

            const normalizeImageSrc = (value) => {
              if (!value) return "/assets/img/default-product.jpg";
              const str = String(value).trim();

              if (/^https?:\/\//i.test(str) || str.startsWith("/") || str.startsWith("data:")) {
                return str;
              }

              return `/uploads/products/${str}`;
            };

            const getGuestToken = (() => {
              try {
                const existing = localStorage.getItem(GUEST_KEY);
                if (existing) return existing;
                const token = "guest_" + Math.random().toString(36).slice(2, 12);
                localStorage.setItem(GUEST_KEY, token);
                return token;
              } catch (_) {
                return "guest_" + Math.random().toString(36).slice(2, 12);
              }
            })();

            /* --------------------------------------------------------------------------
               DIAGNOSTICS
            -------------------------------------------------------------------------- */
            function showDiagBanner(title, message, details = {}) {
              try {
                let banner = document.getElementById("rp-diag-banner");
                if (!banner) {
                  banner = document.createElement("div");
                  banner.id = "rp-diag-banner";
                  banner.style.cssText = [
                    "background:#fff4e5",
                    "color:#6a3b00",
                    "padding:10px 12px",
                    "border-radius:8px",
                    "margin-bottom:10px",
                    "font-size:13px",
                    "border:1px solid #f0c27a"
                  ].join(";");
                  CONTAINER.parentNode?.insertBefore(banner, CONTAINER);
                }

                banner.innerHTML = `
                <div style="font-weight:700">${escapeHtml(title)}</div>
                <div style="margin-top:6px">${escapeHtml(message)}</div>
                <details style="margin-top:8px">
                    <summary>Details</summary>
                    <pre style="white-space:pre-wrap;margin-top:6px;font-size:12px">${escapeHtml(JSON.stringify(details, null, 2))}</pre>
                </details>
            `;

                setTimeout(() => {
                  try { banner.remove(); } catch (_) { }
                }, 30000);
              } catch (err) {
                console.warn("showDiagBanner failed", err);
              }
            }

            function clearDiagBanner() {
              const banner = document.getElementById("rp-diag-banner");
              if (banner) banner.remove();
            }

            function showInlineError(key, message, timeout = 4500, cardId = null) {
              try {
                const item = findItemElement(key, cardId);
                if (!item) return;

                let errEl = item.querySelector(".recent-inline-error");
                if (!errEl) {
                  errEl = document.createElement("div");
                  errEl.className = "recent-inline-error";
                  errEl.setAttribute("role", "status");
                  errEl.style.cssText = "color:#b00020;font-size:12px;margin-top:6px";

                  const actions = item.querySelector(".product-actions");
                  if (actions) actions.insertAdjacentElement("afterend", errEl);
                  else item.appendChild(errEl);
                }

                errEl.textContent = message;

                if (timeout > 0) {
                  setTimeout(() => {
                    if (errEl && errEl.parentNode) errEl.parentNode.removeChild(errEl);
                  }, timeout);
                }
              } catch (err) {
                console.warn("showInlineError failed", err);
              }
            }

            /* --------------------------------------------------------------------------
               NETWORK
            -------------------------------------------------------------------------- */
            async function apiFetch(url, method = "GET", body = null, timeout = REQUEST_TIMEOUT) {
              const headers = {};

              if (getGuestToken) headers["x-guest-token"] = getGuestToken;

              if (method !== "GET") {
                headers["Content-Type"] = "application/json";
                if (CSRF) headers["x-csrf-token"] = CSRF;
              }

              const controller = new AbortController();
              const timer = setTimeout(() => controller.abort(), timeout);

              const init = {
                method,
                headers,
                credentials: "same-origin",
                signal: controller.signal
              };

              if (method !== "GET" && body != null) {
                init.body = JSON.stringify(body);
              }

              try {
                const res = await fetch(url, init);
                clearTimeout(timer);

                if (res.status === 204) return null;

                let json = null;
                try { json = await res.json(); } catch (_) { }

                if (!res.ok) {
                  const msg = (json && json.message) ? `${res.status} ${json.message}` : `HTTP ${res.status}`;
                  const err = new Error(msg);
                  err.status = res.status;
                  err.body = json;
                  throw err;
                }

                if (json && typeof json === "object" && ("success" in json) && json.success === false) {
                  const err = new Error(json.message || "Server rejected request");
                  err.status = res.status;
                  err.body = json;
                  throw err;
                }

                return json;
              } catch (err) {
                if (err.name === "AbortError") throw new Error("Request timeout");
                throw err;
              }
            }

            /* --------------------------------------------------------------------------
               CART / WISHLIST KEYS
            -------------------------------------------------------------------------- */
            function keyFor(variantId) {
              return `v:${String(variantId)}`;
            }

            function parseKey(key) {
              const s = String(key || "");
              if (!s.startsWith("v:")) return { variant: Number(s) || 0 };
              return { variant: Number(s.slice(2) || 0) };
            }

            function lockKey(action, key) {
              return `${action}:${key}`;
            }

            async function withLock(action, key, fn) {
              const k = lockKey(action, key);
              if (requestLocks.has(k)) return requestLocks.get(k);

              const p = (async () => {
                try {
                  return await fn();
                } finally {
                  requestLocks.delete(k);
                }
              })();

              requestLocks.set(k, p);
              return p;
            }

            /* --------------------------------------------------------------------------
               STOCK
            -------------------------------------------------------------------------- */
            function setStock(variantId, stockNum) {
              if (variantId == null) return;
              stockMap.set(String(variantId), Number(stockNum || 0));
            }

            function getStock(variantId) {
              if (variantId == null && variantId !== 0) return 0;
              const idStr = String(variantId);
              if (stockMap.has(idStr)) return Number(stockMap.get(idStr) ?? 0);
              return 0;
            }

            /* --------------------------------------------------------------------------
               DOM HELPERS
            -------------------------------------------------------------------------- */
            function findItemElement(variantIdOrCardId, cardId = null) {
              try {
                if (cardId) {
                  return CONTAINER.querySelector(`.item[data-card-id="${escapeHtml(String(cardId))}"]`);
                }

                const byCard = CONTAINER.querySelector(`.item[data-card-id="${escapeHtml(String(variantIdOrCardId))}"]`);
                if (byCard) return byCard;

                const byVariant = CONTAINER.querySelector(`.item[data-variant-id="${escapeHtml(String(variantIdOrCardId))}"]`);
                if (byVariant) return byVariant;

                return CONTAINER.querySelector(`.item[data-product-id="${escapeHtml(String(variantIdOrCardId))}"]`);
              } catch (_) {
                return null;
              }
            }

            function extractVariantIdFromEl(el) {
              if (!el) return null;

              const parse = (raw) => {
                if (raw == null) return null;
                const n = Number(raw);
                return Number.isFinite(n) ? n : null;
              };

              const candidates = [];

              try {
                const ds = el.dataset ?? {};
                candidates.push(ds.variantId ?? ds.variant_id ?? ds.cardId ?? ds.card_id ?? null);

                if (el.getAttribute) {
                  candidates.push(el.getAttribute("data-variant-id"));
                  candidates.push(el.getAttribute("data-card-id"));
                }

                const item = el.closest && el.closest(".item, .variant-item");
                if (item) {
                  candidates.push(item.dataset?.variantId ?? item.getAttribute("data-variant-id"));
                }

                const qtyControls = el.closest && el.closest(".qty-controls");
                if (qtyControls) {
                  candidates.push(
                    qtyControls.dataset?.variantId ??
                    qtyControls.getAttribute("data-variant-id") ??
                    qtyControls.getAttribute("data-card-id")
                  );
                }
              } catch (_) { }

              for (const c of candidates) {
                const v = parse(c);
                if (v) return v;
              }

              return null;
            }

            function getCartQtyByVariant(variantId) {
              if (variantId == null) return 0;
              return Number(cartData.get(keyFor(variantId)) ?? 0);
            }

            /* --------------------------------------------------------------------------
               CONTROLS
            -------------------------------------------------------------------------- */
            function createQtyControls(variantId, qty, cardId) {
              const wrapper = document.createElement("div");
              wrapper.className = "qty-controls";
              wrapper.dataset.variantId = String(variantId);
              wrapper.dataset.managed = "true";
              if (cardId != null) wrapper.dataset.cardId = String(cardId);

              const minus = document.createElement("button");
              minus.className = "qty-minus";
              if (qty === 1) minus.classList.add("bin");
              minus.setAttribute("aria-label", qty === 1 ? "Remove item" : "Decrease quantity");
              minus.dataset.variantId = String(variantId);
              minus.innerHTML = qty === 1 ? `<i class="fa fa-trash"></i>` : "–";

              const span = document.createElement("span");
              span.className = "qty-count";
              span.setAttribute("aria-live", "polite");
              span.textContent = String(qty);

              const plus = document.createElement("button");
              plus.className = "qty-plus";
              plus.setAttribute("aria-label", "Increase quantity");
              plus.dataset.variantId = String(variantId);
              plus.textContent = "+";

              wrapper.appendChild(minus);
              wrapper.appendChild(span);
              wrapper.appendChild(plus);

              return wrapper;
            }

            function createAddButton(variantId, cardId, label = "Add") {
              const btn = document.createElement("button");
              btn.className = "btn-cart";
              btn.type = "button";
              if (variantId != null) btn.dataset.variantId = String(variantId);
              if (cardId != null) btn.dataset.cardId = String(cardId);

              btn.innerHTML = `
            <span class="btn-content">
                <i class="fa fa-shopping-cart" aria-hidden="true"></i> ${escapeHtml(label)}
            </span>
            <span class="btn-spinner" style="display:none;margin-left:6px">
                <i class="fa fa-spinner fa-spin" aria-hidden="true"></i>
            </span>
        `;

              return btn;
            }

            function syncControlsForElement(itemEl) {
              if (!itemEl) return;

              const variantId = Number(itemEl.dataset?.variantId ?? itemEl.getAttribute("data-variant-id"));
              if (!variantId || Number.isNaN(variantId)) return;

              const key = keyFor(variantId);
              const displayQty = Number(cartData.get(key) ?? 0);
              const actionsArea = itemEl.querySelector(".product-actions") || itemEl;
              const existing = actionsArea.querySelector(".qty-controls, .btn-cart");

              if (displayQty > 0) {
                if (existing?.dataset?.managed === "true" && existing.classList.contains("qty-controls")) {
                  const cnt = existing.querySelector(".qty-count");
                  if (cnt) cnt.textContent = String(displayQty);

                  const minusBtn = existing.querySelector(".qty-minus");
                  if (minusBtn) {
                    if (displayQty === 1) {
                      minusBtn.classList.add("bin");
                      minusBtn.innerHTML = "<i class='fa fa-trash'></i>";
                      minusBtn.setAttribute("aria-label", "Remove item");
                    } else {
                      minusBtn.classList.remove("bin");
                      minusBtn.textContent = "–";
                      minusBtn.setAttribute("aria-label", "Decrease quantity");
                    }
                  }
                  return;
                }

                const newControls = createQtyControls(variantId, displayQty, itemEl.dataset?.cardId ?? null);
                if (existing) existing.replaceWith(newControls);
                else actionsArea.appendChild(newControls);
              } else {
                const addBtn = createAddButton(variantId, itemEl.dataset?.cardId ?? null);
                if (existing) existing.replaceWith(addBtn);
                else actionsArea.appendChild(addBtn);
              }
            }

            function syncControlsWithCart() {
              try {
                Array.from(CONTAINER.querySelectorAll(".item")).forEach(syncControlsForElement);
              } catch (err) {
                console.warn("syncControlsWithCart failed", err);
              }
            }

            /* --------------------------------------------------------------------------
               RENDER
            -------------------------------------------------------------------------- */
            function buildItemHtml(variant) {
              const vid = Number(variant.id);
              const pid = String(variant.product_id ?? variant.productId ?? variant.master_id ?? "");
              const cardUniqueId = String(vid);

              const name = escapeHtml(variant.variant_name ?? variant.name ?? variant.title ?? "");
              const img = normalizeImageSrc(variant.image ?? variant.main_image ?? variant.images?.[0] ?? "");
              const final = Number(variant.final_price ?? variant.price ?? 0);
              const base = Number(variant.original_price ?? variant.price ?? 0);
              const discountVal = Number(variant.discount_value ?? 0);
              const discountPct = Number(variant.discount_percent ?? 0);
              const priceNote = String(variant.price_note ?? "");
              const vatIncluded = isVatIncludedFlag(variant.vat_included ?? variant.vatIncluded ?? priceNote);
              const priceNoteClass = vatIncluded ? "vat" : "no-vat";
              const vatBadge = vatIncluded ? `<span class="badge-vat" title="Price includes VAT">VAT included</span>` : "";
              const discountBadge = discountPct > 0
                ? `<span class="badge-red" title="${escapeHtml(String(discountPct))}% off">${escapeHtml(String(discountPct))}%</span>`
                : "";

              const priceBlock = `
            <div class="price-line">
                <div class="price-current">AED ${final.toFixed(2)}</div>
                ${discountVal > 0
                  ? `
                            <div>
                                <div class="price-old">AED ${base.toFixed(2)}</div>
                                <div class="saved-small">(-${discountVal.toFixed(2)} AED)</div>
                            </div>
                          `
                  : ""
                }
            </div>
        `;

              const stock = Number(variant.stock ?? variant.available_stock ?? 0);
              const productStockHtml =
                stock <= 0
                  ? '<div class="stock-line"><span class="stock-out">Out of Stock</span></div>'
                  : stock <= 5
                    ? `<div class="stock-line"><span class="stock-limited">${escapeHtml(String(stock))} (Limited)</span></div>`
                    : `<div class="stock-line"><span class="stock-available">${escapeHtml(String(stock))} available</span></div>`;

              const isFavOnRender =
                typeof wishlistMap[String(vid)] !== "undefined"
                  ? !!wishlistMap[String(vid)]
                  : !!variant.is_fav;

              const favClass = isFavOnRender ? "btn-fav is-fav" : "btn-fav";
              const favHtml = `
            <button class="${favClass}"
                    data-variant-id="${vid}"
                    aria-pressed="${isFavOnRender ? "true" : "false"}"
                    title="">
                <i class="fa fa-heart"></i>
            </button>
        `;

              try {
                setStock(vid, stock);
                if (pid) window.variantToMasterMap[vid] = Number(pid);
              } catch (_) { }

              return `
            <div class="item"
                 data-variant-id="${escapeHtml(String(vid))}"
                 data-product-id="${escapeHtml(String(pid))}"
                 data-card-id="${escapeHtml(cardUniqueId)}">

                <div class="single-product-compact"
                     data-href="/customer/product/product-details/${pid}/${vid}"
                     role="group"
                     aria-labelledby="prod-${escapeHtml(cardUniqueId)}"
                     tabindex="0"
                     style="position:relative;">

                    <div style="position:relative;">
                        <div class="compact-image">
                            <img src="${img}" alt="${name}" loading="lazy">
                        </div>
                        <div class="badges">
                            <span class="badge-green">New</span>
                            ${discountBadge}
                        </div>
                    </div>

                    <div style="padding:8px 4px;">
                        <div id="prod-${escapeHtml(cardUniqueId)}" class="prod-title">${name}</div>
                        ${priceBlock}
                        <div style="display:flex; justify-content:space-between; align-items:center;" class="small">
                            ${productStockHtml}
                            ${priceNote ? `<div class="price-note ${priceNoteClass}">${escapeHtml(priceNote)}</div>` : ""}
                            ${vatBadge ? `<div class="vat-badge-small">${vatBadge}</div>` : ""}
                        </div>
                        <div class="product-actions">${favHtml}</div>
                    </div>
                </div>
            </div>
        `;
            }

            function buildHtml(variants) {
              if (!Array.isArray(variants) || variants.length === 0) {
                return `
                <div class="item">
                    <div class="single-product-compact" style="padding:20px;text-align:center;">
                        No products available
                    </div>
                </div>
            `;
              }

              return variants.map(buildItemHtml).join("");
            }

            function render(variants) {
              try {
                CONTAINER.innerHTML = buildHtml(variants);
                syncControlsWithCart();
                initOwl();
              } catch (err) {
                console.error("render error", err);
                CONTAINER.innerHTML = `
                <div class="item">
                    <div class="single-product-compact" style="padding:20px;text-align:center;">
                        Rendering error
                    </div>
                </div>
            `;
                showDiagBanner("Render failed", "Check console for details.", { error: String(err) });
              }
            }

            /* --------------------------------------------------------------------------
               CART NORMALIZATION
            -------------------------------------------------------------------------- */
            function normalizeCartRow(row) {
              if (!row || typeof row !== "object") return null;

              let vid = null;
              vid = (row.variant_id != null) ? row.variant_id
                : (row.variantId != null) ? row.variantId
                  : (row.vid != null) ? row.vid
                    : (row.variant != null) ? row.variant
                      : null;

              if (vid == null && typeof row.cart_key === "string" && row.cart_key.length) {
                const m = row.cart_key.match(/(\d+)/);
                if (m) vid = Number(m[1]);
              }

              const vidNum = (vid == null || vid === "" || Number.isNaN(Number(vid))) ? null : Number(vid);
              if (vidNum == null) return null;

              const qty = Number(row.quantity ?? row.qty ?? row.in_cart_qty ?? row.qty_in_cart ?? 0) || 0;

              return { vidN: vidNum, qty };
            }

            async function fetchCartMap() {
              try {
                const json = await apiFetch(API.cartGet, "GET", null);

                let arr = [];
                if (Array.isArray(json?.data)) arr = json.data;
                else if (Array.isArray(json)) arr = json;
                else if (Array.isArray(json?.items)) arr = json.items;
                else if (Array.isArray(json?.cart)) arr = json.cart;
                else if (json && typeof json === "object" && json.data && !Array.isArray(json.data) && typeof json.data === "object") arr = [json.data];
                else arr = [];

                cartData.clear();

                for (const row of arr) {
                  const n = normalizeCartRow(row);
                  if (!n || n.vidN == null) continue;
                  cartData.set(keyFor(n.vidN), Number(n.qty || 0));
                }

                syncControlsWithCart();
                return cartData;
              } catch (err) {
                console.warn("fetchCartMap failed", err);
                showDiagBanner("Cart fetch failed", "Unable to fetch cart data. Check console for details.", { error: String(err) });
                return cartData;
              }
            }

            async function fetchRecentProducts(limit = 12) {
              try {
                const url = new URL(API.recent, window.location.origin);
                url.searchParams.set("limit", String(limit));

                const json = await apiFetch(url.toString(), "GET", null);
                const arr = Array.isArray(json?.data) ? json.data : (Array.isArray(json) ? json : []);

                lastFetchedProducts = (arr || []).map((v) => (typeof v === "object" ? v : {}));

                lastFetchedProducts.forEach((v) => {
                  try {
                    setStock(Number(v.id), Number(v.stock ?? v.available_stock ?? 0));
                    if (v.product_id) window.variantToMasterMap[Number(v.id)] = Number(v.product_id);
                  } catch (_) { }
                });

                return lastFetchedProducts;
              } catch (err) {
                console.error("fetchRecentProducts failed", err);
                showDiagBanner("Failed to fetch relevant products", "Check console for details.", { error: String(err) });
                return [];
              }
            }

            async function fetchWishlistMap() {
              try {
                for (const k of Object.keys(wishlistMap)) delete wishlistMap[k];

                const json = await apiFetch(API.wishlistGet, "GET", null);
                if (json?.success && Array.isArray(json.data)) {
                  for (const vid of json.data) wishlistMap[String(vid)] = true;
                  return true;
                }

                return false;
              } catch (_) {
                return false;
              }
            }

            /* --------------------------------------------------------------------------
               PAYLOAD BUILDERS
            -------------------------------------------------------------------------- */
            function buildCartPayloadVariantOnly(variantId, quantity = 1) {
              const payload = {};
              if (variantId != null && variantId !== undefined) payload.variant_id = Number(variantId);
              payload.quantity = Number(quantity || 1);
              return payload;
            }

            function findVariantForProduct(masterId) {
              if (!masterId) return null;
              const pidStr = String(masterId);
              const found = lastFetchedProducts.find((v) => String(v.product_id ?? v.productId ?? "") === pidStr);
              return found ? Number(found.id) : null;
            }

            /* --------------------------------------------------------------------------
               CART OPERATIONS
            -------------------------------------------------------------------------- */
            async function addToCartVariant(sourceEl = null, explicitVariantId = null) {
              let variantId = null;

              if (explicitVariantId != null && explicitVariantId !== "") {
                const n = Number(explicitVariantId);
                if (!Number.isNaN(n)) variantId = n;
              }

              if (!variantId) variantId = extractVariantIdFromEl(sourceEl);

              const cardEl = sourceEl?.closest?.(".item") ?? (sourceEl && sourceEl.closest ? sourceEl.closest(".item") : null);

              if ((!variantId || variantId == null) && cardEl) {
                const vidAttr = cardEl.dataset?.variantId ?? cardEl.getAttribute?.("data-variant-id");
                if (vidAttr) {
                  const n = Number(vidAttr);
                  if (!Number.isNaN(n)) variantId = n;
                }
              }

              if ((!variantId || variantId == null) && cardEl) {
                const pid = cardEl.dataset?.productId ?? cardEl.getAttribute?.("data-product-id");
                if (pid) {
                  const mem = findVariantForProduct(pid);
                  if (mem) variantId = mem;
                }
              }

              if ((!variantId || variantId == null) && Array.isArray(lastFetchedProducts) && lastFetchedProducts.length) {
                variantId = Number(lastFetchedProducts[0].id);
              }

              if (!variantId || Number.isNaN(Number(variantId))) {
                const details = {
                  attempted_from_sourceEl: !!sourceEl,
                  sourceEl_tag: sourceEl?.tagName,
                  sourceEl_dataset: sourceEl?.dataset ? { ...sourceEl.dataset } : null,
                  card_dataset: cardEl?.dataset ? { ...cardEl.dataset } : null,
                  lastFetchedProducts_count: Array.isArray(lastFetchedProducts) ? lastFetchedProducts.length : 0
                };

                showDiagBanner(
                  "Variant resolution failed",
                  "No variant could be resolved from the clicked element or card.",
                  details
                );

                console.warn("addToCartVariant: no variant resolved", details);
                showInlineError(cardEl?.dataset?.productId ?? "product", "No variant selected", 4000, cardEl?.dataset?.cardId ?? null);
                return;
              }

              variantId = Number(variantId);
              const key = keyFor(variantId);
              const cardId = cardEl?.dataset?.cardId ?? null;

              return withLock("add", key, async () => {
                try {
                  clearDiagBanner();

                  const currentQty = Number(cartData.get(key) ?? 0);
                  const stock = getStock(variantId);

                  if (stock <= 0) {
                    showInlineError(variantId, "Out of stock", 4000, cardId);
                    throw new Error("Out of stock");
                  }

                  if (currentQty + 1 > stock) {
                    showInlineError(variantId, `Not enough stock. Available: ${stock}`, 4000, cardId);
                    throw new Error("Not enough stock");
                  }

                  cartData.set(key, currentQty + 1);
                  syncControlsWithCart();

                  const payload = buildCartPayloadVariantOnly(variantId, 1);
                  const res = await apiFetch(API.cartAdd, "POST", payload);

                  const serverArr = Array.isArray(res?.data)
                    ? res.data
                    : (Array.isArray(res) ? res : (Array.isArray(res?.items) ? res.items : (res && res.data && typeof res.data === "object" ? [res.data] : [])));

                  if (Array.isArray(serverArr) && serverArr.length) {
                    cartData.clear();
                    for (const row of serverArr) {
                      const n = normalizeCartRow(row);
                      if (!n || n.vidN == null) continue;
                      cartData.set(keyFor(n.vidN), Number(n.qty || 0));
                    }
                  } else {
                    cartData.set(key, currentQty + 1);
                  }

                  await fetchCartMap().catch(() => { });
                  await fetchRecentProducts(lastFetchedProducts.length || 12).catch(() => { });
                  syncControlsWithCart();
                  return res;
                } catch (err) {
                  const body = err?.body ?? null;

                  if (body && body.error_code === "VARIANT_REQUIRED" && Array.isArray(body.available_variants) && body.available_variants.length) {
                    const first = body.available_variants[0];
                    if (first && typeof first.variant_id !== "undefined") {
                      try {
                        const retryPayload = buildCartPayloadVariantOnly(Number(first.variant_id), 1);
                        const retry = await apiFetch(API.cartAdd, "POST", retryPayload);
                        await fetchCartMap().catch(() => { });
                        syncControlsWithCart();
                        return retry;
                      } catch (retryErr) {
                        console.warn("retry with server-provided variant failed", retryErr);
                      }
                    }
                  }

                  const errMsg = err?.body?.message || err.message || String(err);
                  showInlineError(cardEl?.dataset?.productId ?? "product", errMsg, 7000, cardId);
                  await fetchCartMap().catch(() => { });
                  syncControlsWithCart();
                  throw err;
                }
              });
            }

            async function updateCartQtyVariant(variantId, newQty, controlsEl = null) {
              const qty = Number(newQty);

              if (!variantId || Number.isNaN(Number(variantId))) {
                variantId = extractVariantIdFromEl(controlsEl);
              }

              if (!variantId || Number.isNaN(Number(variantId))) {
                showInlineError("product", "Invalid variant", 3000);
                return;
              }

              if (qty < 1) return removeFromCartVariant(variantId, controlsEl);

              const key = keyFor(variantId);
              const stock = getStock(variantId);

              if (qty > stock) {
                showInlineError(variantId, `Not enough stock. Available: ${stock}`);
                return;
              }

              return withLock("update", key, async () => {
                try {
                  cartData.set(key, qty);
                  syncControlsWithCart();

                  const payload = buildCartPayloadVariantOnly(variantId, qty);
                  await apiFetch(API.cartUpdate, "POST", payload);
                  await fetchCartMap();
                } catch (err) {
                  const msg = err?.body?.message || err.message || "";
                  if (err.status === 404 || /product not found/i.test(msg)) {
                    await runAddDiagnostics({ variant_id: variantId, quantity: qty }, err);
                  }

                  const userMsg = (err.body && err.body.message) ? err.body.message : (err.message || "Failed to update quantity");
                  showInlineError("product", userMsg);
                  await fetchCartMap().catch(() => { });
                  throw err;
                } finally {
                  syncControlsWithCart();
                }
              });
            }

            async function removeFromCartVariant(variantId, controlsEl = null) {
              if (!variantId || Number.isNaN(Number(variantId))) {
                variantId = extractVariantIdFromEl(controlsEl);
              }

              if (!variantId || Number.isNaN(Number(variantId))) {
                showInlineError("product", "Invalid variant", 3000);
                return;
              }

              const key = keyFor(variantId);
              const cardId = controlsEl?.closest?.(".item")?.dataset?.cardId ?? null;

              return withLock("remove", key, async () => {
                try {
                  cartData.set(key, 0);
                  syncControlsWithCart();

                  await apiFetch(API.cartRemove, "POST", { variant_id: Number(variantId) });
                  await fetchCartMap();
                } catch (err) {
                  const userMsg = (err.body && err.body.message) ? err.body.message : (err.message || "Failed to remove item");
                  if (err.status === 404 || /product not found/i.test(userMsg)) {
                    await runAddDiagnostics({ variant_id: variantId }, err);
                  }
                  showInlineError("product", userMsg);
                  await fetchCartMap().catch(() => { });
                  throw err;
                } finally {
                  syncControlsWithCart();
                }
              });
            }

            /* --------------------------------------------------------------------------
               WISHLIST
            -------------------------------------------------------------------------- */
            async function runAddDiagnostics(payload, serverError) {
              try {
                const diag = {
                  timestamp: new Date().toISOString(),
                  attempted_payload: payload,
                  server_error: serverError && (serverError.body || serverError.message || serverError.status)
                    ? (serverError.body || serverError.message || serverError.status)
                    : serverError,
                  last_fetched_products_count: lastFetchedProducts.length
                };

                showDiagBanner("Cart Diagnostic", "See details below.", diag);
                return diag;
              } catch (err) {
                console.warn("runAddDiagnostics failed", err);
                return { error: String(err) };
              }
            }

            /* --------------------------------------------------------------------------
               OWL CAROUSEL
            -------------------------------------------------------------------------- */
            function hasJQuery() {
              return typeof window.jQuery === "function" && typeof window.jQuery.fn !== "undefined";
            }

            function initOwl() {
              if (!hasJQuery()) return;

              try {
                const $c = window.jQuery(`#${CONTAINER_ID}`);

                if ($c.hasClass("owl-loaded")) {
                  try { $c.trigger("destroy.owl.carousel"); } catch (_) { }
                  $c.removeClass("owl-loaded owl-hidden").attr("style", "");
                }

                const itemCount = $c.find(".item").length;

                $c.owlCarousel({
                  loop: itemCount > MIN_LOOP_ITEMS,
                  margin: 12,
                  nav: false,
                  dots: false,
                  smartSpeed: 450,
                  slideBy: 1,
                  responsive: {
                    0: { items: 2 },
                    480: { items: 2 },
                    768: { items: 4 },
                    992: { items: 6 }
                  }
                });

                window.jQuery(`#${PREV_BTN_ID}`).off("click.relevant").on("click.relevant", () => {
                  $c.trigger("prev.owl.carousel");
                });

                window.jQuery(`#${NEXT_BTN_ID}`).off("click.relevant").on("click.relevant", () => {
                  $c.trigger("next.owl.carousel");
                });
              } catch (err) {
                console.warn("initOwl failed", err);
              }
            }

            function refreshOwl() {
              if (!hasJQuery()) return;

              try {
                const $c = window.jQuery(`#${CONTAINER_ID}`);
                if ($c.length && $c.hasClass("owl-loaded")) {
                  $c.trigger("refresh.owl.carousel");
                } else {
                  initOwl();
                }
              } catch (err) {
                initOwl();
              }
            }

            /* --------------------------------------------------------------------------
               SOCKETS
            -------------------------------------------------------------------------- */
            function initSocket() {
              if (typeof io === "undefined") {
                console.debug("Socket.IO not present — realtime skipped");
                return;
              }

              try {
                const SOCKET_URL = window.SOCKET_URL || null;
                const socket = SOCKET_URL
                  ? io(SOCKET_URL, { transports: ["websocket"], withCredentials: true })
                  : io({ transports: ["websocket"], withCredentials: true });

                const triggerRefresh = () => {
                  if (socketRefreshTimer) clearTimeout(socketRefreshTimer);
                  socketRefreshTimer = setTimeout(async () => {
                    await refreshFromServer({ limit: 12, resetToFirst: false });
                  }, REFRESH_DEBOUNCE_MS);
                };

                socket.on("connect", () => console.debug("socket connected", socket.id));
                socket.on("disconnect", (reason) => console.debug("socket disconnected", reason));

                socket.on("recentProductsUpdated", (data) => {
                  if (!Array.isArray(data)) return;
                  lastFetchedProducts = data.map(v => v);
                  data.forEach(v => {
                    try {
                      setStock(Number(v.id), Number(v.stock ?? 0));
                      if (v.product_id) window.variantToMasterMap[Number(v.id)] = Number(v.product_id);
                    } catch (_) { }
                  });
                  render(data);
                });

                socket.on("recentProductAdded", (variant) => {
                  if (!variant) return;
                  upsertItem(variant);
                });

                socket.on("recentProductUpdated", (variant) => {
                  if (!variant) return;
                  upsertItem(variant);
                });

                socket.on("recentProductDeleted", (vid) => {
                  if (!vid) return;
                  removeItem(vid);
                });

                socket.on("wishlistUpdated", (payload) => {
                  try {
                    if (!payload || typeof payload.variant_id === "undefined") return;

                    const vid = String(payload.variant_id);
                    const isFav = !!payload.is_fav;

                    if (isFav) wishlistMap[vid] = true;
                    else delete wishlistMap[vid];

                    const items = Array.from(CONTAINER.querySelectorAll(`.item[data-variant-id="${escapeHtml(vid)}"]`));
                    items.forEach(item => {
                      const btn = item.querySelector(".btn-fav");
                      if (btn) {
                        btn.classList.toggle("is-fav", isFav);
                        btn.setAttribute("aria-pressed", String(!!isFav));
                      }
                    });
                  } catch (err) {
                    console.warn("wishlistUpdated handler failed", err);
                  }
                });

                socket.on("cartUpdated", triggerRefresh);
              } catch (err) {
                console.warn("initSocket failed", err);
              }
            }

            function upsertItem(variant) {
              try {
                const vid = String(variant.id ?? variant.variant_id ?? "");
                if (!vid) return;

                setStock(Number(variant.id), Number(variant.stock ?? 0));
                if (variant.product_id) {
                  try { window.variantToMasterMap[Number(variant.id)] = Number(variant.product_id); } catch (_) { }
                }

                variant.in_cart_qty = Number(cartData.get(keyFor(variant.id ?? 0)) ?? variant.in_cart_qty ?? 0);

                const existing = findItemElement(variant.id, vid);
                const html = buildItemHtml(variant);

                const wrapper = document.createElement("div");
                wrapper.innerHTML = html;

                const newEl = wrapper.firstElementChild;
                if (!newEl) return;

                if (existing) {
                  existing.replaceWith(newEl);
                  refreshOwl();
                } else {
                  CONTAINER.insertAdjacentElement("afterbegin", newEl);
                  initOwl();
                }

                syncControlsWithCart();
              } catch (err) {
                console.warn("upsertItem error", err);
              }
            }

            function removeItem(vidOrCard) {
              try {
                const elByCard = CONTAINER.querySelector(`.item[data-card-id="${escapeHtml(String(vidOrCard))}"]`);
                if (elByCard) {
                  elByCard.remove();
                  refreshOwl();
                  return;
                }

                const el = CONTAINER.querySelector(
                  `.item[data-variant-id="${escapeHtml(String(vidOrCard))}"], .item[data-product-id="${escapeHtml(String(vidOrCard))}"]`
                );

                if (el) el.remove();
                refreshOwl();
              } catch (err) {
                console.warn("removeItem error", err);
              }
            }

            /* --------------------------------------------------------------------------
               REFRESH
            -------------------------------------------------------------------------- */
            const debouncedRefresh = debounce(async (opts = { limit: 12, resetToFirst: true }) => {
              await refreshFromServer(opts);
            }, REFRESH_DEBOUNCE_MS);

            async function refreshFromServer({ limit = 12, resetToFirst = true } = {}) {
              try {
                clearDiagBanner();
                await fetchCartMap();
                await fetchWishlistMap();

                const variants = await fetchRecentProducts(limit);

                variants.forEach(v => {
                  try {
                    setStock(Number(v.id), Number(v.stock ?? v.available_stock ?? 0));
                    if (v.product_id) window.variantToMasterMap[Number(v.id)] = Number(v.product_id);
                  } catch (_) { }
                });

                render(variants);

                if (resetToFirst && hasJQuery()) {
                  try {
                    window.jQuery(`#${CONTAINER_ID}`).trigger("to.owl.carousel", [0, 0, true]);
                  } catch (_) { }
                }
              } catch (err) {
                console.error("refreshFromServer failed", err);
                showDiagBanner("Refresh failed", "Check console for details.", { error: String(err) });
              }
            }

            async function loadInitial() {
              try {
                await refreshFromServer({ limit: 12, resetToFirst: true });
                initSocket();
                window.addEventListener("resize", () => setTimeout(initOwl, 200), { passive: true });
              } catch (err) {
                console.error("loadInitial failed", err);
              }
            }

            /* --------------------------------------------------------------------------
               EVENT DELEGATION
            -------------------------------------------------------------------------- */
            CONTAINER.addEventListener("click", (e) => {
              const t = e.target;
              if (!t) return;

              const addBtn = t.closest?.(".btn-cart");
              if (addBtn) {
                e.preventDefault();

                if (addBtn.disabled) {
                  const idForErr = addBtn.dataset?.variantId ?? addBtn.dataset?.cardId ?? null;
                  if (idForErr) showInlineError(idForErr, "Please wait...", 1200);
                  return;
                }

                setButtonBusyByElement(addBtn, true);
                addToCartVariant(addBtn, addBtn.dataset?.variantId ? Number(addBtn.dataset.variantId) : null)
                  .catch(() => { })
                  .finally(() => {
                    setButtonBusyByElement(addBtn, false);
                    syncControlsWithCart();
                  });

                return;
              }

              const favBtn = t.closest?.(".btn-fav");
              if (favBtn) {
                e.preventDefault();

                const card = favBtn.closest(".item");
                const variantId = Number(card?.dataset?.variantId ?? favBtn.dataset?.variantId ?? favBtn.dataset?.cardId);

                if (!variantId) return;

                const key = String(variantId);
                const was = favBtn.classList.contains("is-fav");

                if (was) {
                  favBtn.classList.remove("is-fav");
                  favBtn.setAttribute("aria-pressed", "false");
                } else {
                  favBtn.classList.add("is-fav");
                  favBtn.setAttribute("aria-pressed", "true");
                }

                if (!was) wishlistMap[key] = true;
                else delete wishlistMap[key];

                setButtonBusyByElement(favBtn, true);

                apiFetch(API.wishlistToggle, "POST", { variant_id: variantId })
                  .then((json) => {
                    let serverIsFav = null;

                    if (json?.is_fav !== undefined) {
                      serverIsFav = !!json.is_fav;
                    } else if (json?.action) {
                      serverIsFav = json.action === "added";
                    }

                    if (serverIsFav !== null) {
                      if (serverIsFav) {
                        favBtn.classList.add("is-fav");
                        favBtn.setAttribute("aria-pressed", "true");
                        wishlistMap[key] = true;
                      } else {
                        favBtn.classList.remove("is-fav");
                        favBtn.setAttribute("aria-pressed", "false");
                        delete wishlistMap[key];
                      }
                    }
                  })
                  .catch((err) => {
                    favBtn.classList.toggle("is-fav", was);
                    favBtn.setAttribute("aria-pressed", String(was));

                    if (was) wishlistMap[key] = true;
                    else delete wishlistMap[key];

                    showInlineError(
                      variantId,
                      err?.body?.message || err.message || "Wishlist update failed",
                      3000
                    );
                  })
                  .finally(() => {
                    setButtonBusyByElement(favBtn, false);
                  });

                return;
              }

              const minus = t.closest?.(".qty-minus");
              if (minus) {
                e.preventDefault();

                const controls = minus.closest(".qty-controls");
                const variantId = extractVariantIdFromEl(controls);
                if (!variantId) return;

                const cnt = controls.querySelector(".qty-count");
                let qty = toInt(cnt?.textContent ?? 0, 0);

                if (minus.classList.contains("bin") || qty === 1) {
                  setButtonBusyByElement(minus, true);
                  removeFromCartVariant(variantId, controls)
                    .catch(() => { })
                    .finally(() => {
                      setButtonBusyByElement(minus, false);
                      syncControlsWithCart();
                    });
                } else {
                  qty = Math.max(0, qty - 1);
                  const key = keyFor(variantId);
                  cartData.set(key, qty);
                  syncControlsWithCart();

                  setButtonBusyByElement(minus, true);
                  updateCartQtyVariant(variantId, qty, controls)
                    .catch(() => { })
                    .finally(() => {
                      setButtonBusyByElement(minus, false);
                    });
                }

                return;
              }

              const plus = t.closest?.(".qty-plus");
              if (plus) {
                e.preventDefault();

                const controls = plus.closest(".qty-controls");
                const variantId = extractVariantIdFromEl(controls);
                if (!variantId) return;

                const cnt = controls.querySelector(".qty-count");
                let qty = toInt(cnt?.textContent ?? 0, 0);
                const key = keyFor(variantId);
                const stock = getStock(variantId);

                if (qty + 1 > stock) {
                  showInlineError(variantId, `Not enough stock. Available: ${stock}`);
                  return;
                }

                qty += 1;
                cartData.set(key, qty);
                syncControlsWithCart();

                setButtonBusyByElement(plus, true);
                updateCartQtyVariant(variantId, qty, controls)
                  .catch(() => { })
                  .finally(() => {
                    setButtonBusyByElement(plus, false);
                  });

                return;
              }

              const card = t.closest?.(".single-product-compact");
              if (card) {
                const href = card.getAttribute("data-href");
                if (href && href.startsWith("/")) {
                  if (e.metaKey || e.ctrlKey || e.shiftKey) window.open(href, "_blank");
                  else window.location.href = href;
                }
              }
            });

            /* --------------------------------------------------------------------------
               BUSY STATE
            -------------------------------------------------------------------------- */
            function setButtonBusyByElement(el, busy = true) {
              if (!el) return;

              try {
                if (busy) {
                  if (!el.dataset.rpOriginal) el.dataset.rpOriginal = el.innerHTML;
                  el.classList.add("rp-busy");

                  const spinner = el.querySelector(".btn-spinner");
                  if (spinner) {
                    spinner.style.display = "inline-block";
                  } else {
                    const label = el.textContent || el.innerText || "";
                    el.innerHTML = `<i class="fa fa-spinner fa-spin" aria-hidden="true"></i> <span class="btn-label">${escapeHtml(label)}</span>`;
                  }

                  el.setAttribute("disabled", "true");
                  el.setAttribute("aria-busy", "true");
                } else {
                  el.classList.remove("rp-busy");

                  const spinner = el.querySelector(".btn-spinner");
                  if (spinner) spinner.style.display = "none";

                  if (el.dataset.rpOriginal) {
                    el.innerHTML = el.dataset.rpOriginal;
                    delete el.dataset.rpOriginal;
                  }

                  el.removeAttribute("aria-busy");
                  el.removeAttribute("disabled");
                }
              } catch (_) {
                try {
                  el.removeAttribute("disabled");
                  el.removeAttribute("aria-busy");
                } catch (__) { }
              }
            }

            /* --------------------------------------------------------------------------
               PUBLIC DIAGNOSTICS
            -------------------------------------------------------------------------- */
            Object.defineProperty(window, "__relevantProductsDiag", {
              configurable: true,
              value: {
                refresh: () => debouncedRefresh({ limit: 12, resetToFirst: true }),
                cartData,
                stockMap,
                wishlistMap,
                lastFetchedProducts,
                runAddDiagnostics,
                fetchRecentProducts,
                fetchCartMap,
                addToCartVariant: (btn = null, vid = null) => addToCartVariant(btn, vid).catch(() => { }),
                updateCartQtyVariant: (vid, q, controls = null) => updateCartQtyVariant(vid, q, controls).catch(() => { }),
                removeFromCartVariant: (vid, controls = null) => removeFromCartVariant(vid, controls).catch(() => { })
              }
            });

            /* --------------------------------------------------------------------------
               INIT
            -------------------------------------------------------------------------- */
            document.addEventListener("DOMContentLoaded", loadInitial);
          })();
        </script>
        
      </div>


