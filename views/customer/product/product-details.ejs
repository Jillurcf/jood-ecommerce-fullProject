        <div class="ap-box">
  <div class="ap-variant-header">
    <h3>Variant options</h3>

    <% if (pdVariantsSource.length > 1) { %>
      <div class="ap-nav-group">
        <button type="button" class="ap-nav" id="pd-variant-prev">‹</button>
        <button type="button" class="ap-nav" id="pd-variant-next">›</button>
      </div>
    <% } %>
  </div>

  <% if (pdVariantsSource.length > 1) { %>

    <div class="ap-variant-wrap">

      <div class="ap-variants" id="pd-variants">
        <% pdVariantsSource.forEach(function (v, idx) {
            var media = __pdNormalizeVariantMedia(v);
            var thumb = media[0] || __pdNormalizeUrl(v.image || v.product_main_image || v.product?.main_image || currentProduct.main_image || "");
            var stock = __pdNum(v.stock, 0);
            var label = "Option " + (idx + 1);
        %>

          <button
            type="button"
            class="ap-variant <%= String(v.id) === String(pageVariantId) ? 'is-active' : '' %>"
            data-variant-id="<%= String(v.id) %>"
            data-variant-json="<%- __pdSafeJson(v) %>"
          >
            <div class="ap-variant-name"><%= label %></div>

            <div class="ap-variant-meta">
              <%= stock > 0 ? (stock <= 5 ? stock + ' left' : 'In stock') : 'Out of stock' %>
            </div>

            <% if (thumb) { %>
              <div class="ap-variant-thumb">
                <img src="<%= thumb %>" alt="">
              </div>
            <% } %>
          </button>

        <% }) %>
      </div>

    </div>

    <div class="ap-swipe-hint">
      Swipe to see more
    </div>

  <% } else { %>
    <div class="ap-empty">Only one variant is available.</div>
  <% } %>
</div>
<script>
(function () {
  const container = document.getElementById("pd-variants");
  const prev = document.getElementById("pd-variant-prev");
  const next = document.getElementById("pd-variant-next");

  if (!container) return;

  const scrollAmount = 260;

  prev?.addEventListener("click", () => {
    container.scrollBy({ left: -scrollAmount, behavior: "smooth" });
  });

  next?.addEventListener("click", () => {
    container.scrollBy({ left: scrollAmount, behavior: "smooth" });
  });
})();
</script>
            <div class="ap-box" id="ap-review-summary">
              <h3>Product details</h3>
              <div class="ap-list" id="pd-product-fields">
                <% currentProductFields.forEach(function (row) { %>
                  <div class="ap-row">
                    <div class="k"><%= row[1] %></div>
                    <div class="v" data-product-field="<%= row[0] %>"><%= __pdSafeText(row[2]) %></div>
                  </div>
                <% }) %>
              </div>
            </div>

            <div class="ap-box">
              <h3>Variant details</h3>
              <div class="ap-list" id="pd-variant-fields">
                <% if (currentVariantFields.length) { %>
                  <% currentVariantFields.forEach(function (row) { %>
                    <div class="ap-row">
                      <div class="k"><%= row.label %></div>
                      <div class="v" data-variant-field="<%= row.key %>"><%= __pdSafeText(row.value) %></div>
                    </div>
                  <% }) %>
                <% } else { %>
                  <div class="ap-empty">No dimension data available.</div>
                <% } %>
              </div>
            </div>

            <div class="ap-box">
              <h3>Technical attributes</h3>
              <% if (dimensionAttrs.length) { %>
                <div class="ap-attr-grid" id="pd-attributes">
                  <% dimensionAttrs.forEach(function (attr) { %>
                    <div class="ap-attr">
                      <div class="k"><%= __pdSafeText(attr.attribute_name || attr.attribute || attr.attribute_slug) %></div>
                      <div class="v"><%= __pdSafeText(attr.value_name || attr.value || attr.value_slug) %></div>
                    </div>
                  <% }) %>
                </div>
              <% } else { %>
                <div class="ap-empty">No attributes found.</div>
              <% } %>
            </div>
          </div>

          <% (pdRecommendationSections.length ? pdRecommendationSections : [
              { key: 'fbt', title: 'Frequently bought together', items: pdFrequentlyBoughtTogether },
              { key: 'viewed', title: 'Customers who viewed this item also viewed', items: pdCustomersAlsoViewed },
              { key: 'model', title: 'More from this model family', items: pdSameModelVariants },
              { key: 'compare', title: 'Compare with similar products', items: pdCompareItems },
              { key: 'related', title: 'Related products', items: pdRelatedProducts }
            ]).forEach(function (section) { %>
            <section class="ap-carousel-shell" data-carousel-section="<%= section.key %>">
              <div class="ap-carousel-head">
                <h2><%= section.title %></h2>
                <div class="ap-carousel-controls">
                  <button type="button" class="ap-carousel-btn ap-carousel-prev" aria-label="Previous">
                    <i class="fa fa-chevron-left"></i>
                  </button>
                  <button type="button" class="ap-carousel-btn ap-carousel-next" aria-label="Next">
                    <i class="fa fa-chevron-right"></i>
                  </button>
                </div>
              </div>

              <% if (section.items && section.items.length) { %>
                <div class="ap-carousel-track">
                  <% section.items.slice(0, 12).forEach(function (item, idx) {
                      var title = cardTitle(item, idx);
                      var brand = cardBrand(item);
                      var priceMeta = cardPriceMeta(item);
                      var price = __pdNum(item && (item.final_price ?? item.price ?? item.min_price), 0);
                      var original = __pdNum(item && (item.original_price ?? item.price), 0);
                      var stock = cardStock(item);
                      var image = cardImage(item);
                      var href = cardHref(item);
                      var isFav = !!(item && item.is_fav);
                      var itemVid = cardVariantId(item);
                  %>
                    <a class="ap-card" href="<%= href %>" data-variant-id="<%= itemVid %>" data-card-id="<%= itemVid || idx %>">
                      <div style="position:relative;">
                        <div class="compact-image">
                          <img src="<%= image %>" alt="<%= title %>" loading="lazy">
                        </div>
                        <div class="badges">
                          <span class="badge-green">New</span>
                          <% if (priceMeta.label) { %>
                            <span class="badge-red"><%= priceMeta.label %></span>
                          <% } %>
                        </div>
                      </div>

                      <div style="padding:8px 4px 0;">
                        <div id="prod-<%= itemVid || idx %>" class="prod-title"><%= title %></div>

                        <div class="price-line">
                          <div class="price-current">AED <%= price.toFixed(2) %></div>
                          <% if (original > price) { %>
                            <div>
                              <div class="price-old">AED <%= original.toFixed(2) %></div>
                              <div class="saved-small"><%= priceMeta.label ? priceMeta.label : ('Save AED ' + (original - price).toFixed(2)) %></div>
                            </div>
                          <% } %>
                        </div>

                        <div class="stock-line">
                          <span class="<%= stock > 0 ? (stock <= 5 ? 'stock-limited' : 'stock-available') : 'stock-out' %>">
                            <%= stock > 0 ? (stock <= 5 ? stock + ' left' : 'In stock') : 'Out of stock' %>
                          </span>
                        </div>

                        <% if (brand) { %>
                          <div class="price-note"><%= brand %></div>
                        <% } %>

                        <div class="product-actions">
                          <button type="button" class="btn-cart ap-card-add-cart" data-variant-id="<%= itemVid %>">
                            <i class="fa fa-shopping-cart" aria-hidden="true"></i>
                            Add
                          </button>
                          <button type="button" class="btn-fav ap-card-fav <%= isFav ? 'is-fav' : '' %>" data-variant-id="<%= itemVid %>" aria-pressed="<%= isFav ? 'true' : 'false' %>">
                            <i class="fa fa-heart" aria-hidden="true"></i>
                          </button>
                        </div>
                      </div>
                    </a>
                  <% }) %>
                </div>
                <div class="ap-swipe-hint" aria-hidden="true">
                  <span>Swipe to see more</span>
                  <i class="fa fa-arrow-right"></i>
                </div>
              <% } else { %>
                <div class="ap-empty">No items available in this section.</div>
              <% } %>
            </section>
          <% }) %>
        </main>

        <aside class="ap-buybox">
          <div style="font-size:18px;font-weight:700;line-height:1.3;">Buy now</div>
          <div style="margin-top:8px;font-size:13px;color:var(--ap-muted);">Delivered securely with cart and wishlist actions.</div>

          <div style="margin-top:14px;">
            <div class="ap-price-now" style="font-size:24px;" id="pd-final-price-aside">AED <%= currentFinalPrice.toFixed(2) %></div>
            <% if (currentOriginalPrice > currentFinalPrice) { %>
              <div class="ap-price-old" id="pd-original-price-aside">AED <%= currentOriginalPrice.toFixed(2) %></div>
            <% } %>
            <div class="ap-note" style="margin-top:6px;" id="pd-price-note-aside"><%= currentVariant.vat_included ? 'Includes VAT' : 'Excludes VAT' %></div>
          </div>
