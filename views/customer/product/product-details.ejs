  text-align: center;
  font-weight: 700;
}

/* =========================
   NAVIGATION
========================= */

.relevant-nav-btn {
  background: var(--accent);
  color: #fff;
  border: 0;
  padding: 8px 10px;
  border-radius: 8px;
  cursor: pointer;
}

/* =========================
   CAROUSEL
========================= */

.owl-stage-outer {
  overflow: visible;
  padding-bottom: 8px;
}

.owl-dots {
  display: none;
}

/* =========================
   SECTION WRAPPER
========================= */

.relevant-products-section {
  position: relative;
}

/* =========================
   SKELETON LOADER
========================= */

.skeleton-card {
  background: #f3f3f3;
  border-radius: 12px;
  height: 180px;
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0% { opacity: 0.6; }
  50% { opacity: 1; }
  100% { opacity: 0.6; }
}

/* =========================
   RESPONSIVE
========================= */

@media (max-width: 576px) {
  .compact-image { height: 92px; }
  .single-product-compact { padding: 8px; }
  .price-current { font-size: 12px; }

  .relevant-nav { display: none !important; }

  .swipe-hint {
    display: flex;
    animation: fadeHint 3s ease-in-out 2;
  }

  .swipe-hint i {
    animation: swipeArrow 1.2s infinite;
  }

  @keyframes swipeArrow {
    0% { transform: translateX(0); opacity: .4 }
    50% { transform: translateX(6px); opacity: 1 }
    100% { transform: translateX(0); opacity: .4 }
  }

  @keyframes fadeHint {
    0% { opacity: 0 }
    20% { opacity: 1 }
    80% { opacity: 1 }
    100% { opacity: 0 }
  }
}

@media (min-width: 577px) and (max-width: 991px) {
  .compact-image { height: 110px; }
}

@media (min-width: 992px) {
  .compact-image { height: 120px; }
}
