            </button>

            <div class="ap-qty ap-hidden" id="pd-qty-controls-mobile" data-variant-id="<%= pageVariantId %>">
              <button type="button" id="pd-qty-minus-mobile" aria-label="Decrease quantity">−</button>
              <span id="pd-qty-count-mobile">0</span>
              <button type="button" id="pd-qty-plus-mobile" aria-label="Increase quantity">+</button>
            </div>
          </div>
        </div>
      </div>
    <% } %>
  </div>
</section>

<script>
(function () {
  "use strict";

  const page = document.querySelector(".amazon-pdp");
  if (!page) return;

  const PRODUCT_ID = String(page.dataset.productId || "");
  const INITIAL_VARIANT_ID = String(page.dataset.variantId || "");
  const CSRF = document.querySelector('meta[name="csrf-token"]')?.content || null;
  const GUEST_KEY = "guest_wishlist_token";

  const API = {
    cartGet: "/customer/cart/api",
    cartAdd: "/customer/cart/add",
    cartUpdate: "/customer/cart/update",
    cartRemove: "/customer/cart/remove",
    wishlistToggle: "/wishlist/toggle",
    wishlistGet: "/wishlist",
    detail: PRODUCT_ID
      ? (INITIAL_VARIANT_ID
          ? `/customer/product/product-detail/api/${PRODUCT_ID}/${INITIAL_VARIANT_ID}`
          : `/customer/product/product-detail/api/${PRODUCT_ID}`)
      : "/customer/product/product-detail/api"
  };

  const state = {
    currentVariantId: INITIAL_VARIANT_ID,
    product: <%- __pdSafeJson(pdProduct || {}) %>,
    variants: <%- __pdSafeJson(pdVariantsSource || []) %>,
    cart: new Map(),
    stock: new Map(),
    wishlist: Object.create(null),
    imageIndex: 0
  };

  const el = {
    mainImage: document.getElementById("pd-main-image"),
    prevImage: document.getElementById("pd-image-prev"),
    nextImage: document.getElementById("pd-image-next"),
    thumbs: document.getElementById("pd-thumbs"),
    title: document.getElementById("pd-title"),
    brand: document.getElementById("pd-brand"),
    brandText: document.getElementById("pd-brand-text"),
    stockBadge: document.getElementById("pd-stock-badge"),
    discountBadge: document.getElementById("pd-discount-badge"),
    finalPrice: document.getElementById("pd-final-price"),
    finalPriceAside: document.getElementById("pd-final-price-aside"),
    originalPrice: document.getElementById("pd-original-price"),
    originalPriceAside: document.getElementById("pd-original-price-aside"),
    saveAmount: document.getElementById("pd-save-amount"),
    priceNote: document.getElementById("pd-price-note"),
    priceNoteAside: document.getElementById("pd-price-note-aside"),
    stockText: document.getElementById("pd-stock-text"),
    description: document.getElementById("pd-description"),
    addCartBtn: document.getElementById("pd-add-cart-btn"),
    addCartBtnAside: document.getElementById("pd-add-cart-btn-aside"),
    addCartBtnMobile: document.getElementById("pd-add-cart-btn-mobile"),
    wishlistBtn: document.getElementById("pd-wishlist-btn"),
    wishlistBtnAside: document.getElementById("pd-wishlist-btn-aside"),
    wishlistBtnMobile: document.getElementById("pd-wishlist-btn-mobile"),
    qtyControls: document.getElementById("pd-qty-controls"),
    qtyControlsAside: document.getElementById("pd-qty-controls-aside"),
    qtyControlsMobile: document.getElementById("pd-qty-controls-mobile"),
    qtyMinus: document.getElementById("pd-qty-minus"),
    qtyMinusAside: document.getElementById("pd-qty-minus-aside"),
    qtyMinusMobile: document.getElementById("pd-qty-minus-mobile"),
    qtyPlus: document.getElementById("pd-qty-plus"),
    qtyPlusAside: document.getElementById("pd-qty-plus-aside"),
    qtyPlusMobile: document.getElementById("pd-qty-plus-mobile"),
    qtyCount: document.getElementById("pd-qty-count"),
    qtyCountAside: document.getElementById("pd-qty-count-aside"),
    qtyCountMobile: document.getElementById("pd-qty-count-mobile"),
    inlineError: document.getElementById("pd-inline-error"),
    inlineErrorAside: document.getElementById("pd-inline-error-aside"),
    variants: document.getElementById("pd-variants")
  };

  const esc = (v) =>
    String(v ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#39;");

  const toNum = (v, d = 0) => {
    const n = Number(v);
    return Number.isFinite(n) ? n : d;
  };

  const getGuestToken = (() => {
    try {
      const existing = localStorage.getItem(GUEST_KEY);
      if (existing) return existing;
      const token = "guest_" + Math.random().toString(36).slice(2, 12);
      localStorage.setItem(GUEST_KEY, token);
      return token;
    } catch (_) {
      return "guest_" + Math.random().toString(36).slice(2, 12);
    }
  })();

  function normalizeImageSrc(value) {
    if (!value) return "/assets/img/default-product.jpg";
    const str = String(value).trim();
    if (!str) return "/assets/img/default-product.jpg";
    if (/^https?:\/\//i.test(str) || str.startsWith("/") || str.startsWith("data:")) return str;
    return `/uploads/products/${str}`;
  }

  function normalizeMediaList(v) {
    if (!v || typeof v !== "object") return [];
    const list = [
      ...(Array.isArray(v.images) ? v.images : []),
      ...(Array.isArray(v.variant_media) ? v.variant_media : []),
      v.image,
      v.main_image,
      v.product_main_image,
      v.product?.main_image
    ];
    return [...new Set(
      list.map((m) => {
        if (!m) return "";
        if (typeof m === "string") return normalizeImageSrc(m);
        if (m.filename) return normalizeImageSrc(m.filename);
        return normalizeImageSrc(m?.url || m?.path || m?.src || m?.originalname);
      }).filter(Boolean)
    )];
  }

  function normalizeProductFromVariant(v) {
    const product = { ...(v?.product || {}) };
    if (!product.id) product.id = v?.product_id || v?.master_id || v?.product_id_master || "";
    if (!product.name) product.name = v?.product_name || v?.name || "";
    if (!product.brand) product.brand = v?.brand || "";
    if (!product.short_description) product.short_description = v?.short_description || "";
    if (!product.description) product.description = v?.product_description || v?.description || "";
    if (!product.key_features) product.key_features = v?.key_features || v?.bullets || "";
    if (!product.main_image) product.main_image = v?.product_main_image || v?.image || "";
    return product;
  }

  function normalizeVariantFromAny(v) {
    if (!v || typeof v !== "object") return null;
    const product = normalizeProductFromVariant(v);
    const images = normalizeMediaList(v);
    const price = toNum(v?.price ?? 0, 0);
    const finalPrice = toNum(v?.final_price ?? v?.sale_price ?? price, price);
    const originalPrice = toNum(v?.original_price ?? v?.price ?? price, price);

    return {
      ...v,
      product,
      images,
      image: images[0] || normalizeImageSrc(v?.image || v?.product_main_image || product.main_image || ""),
      price,
      final_price: finalPrice,
      original_price: originalPrice,
      discount_value: toNum(v?.discount_value ?? Math.max(0, originalPrice - finalPrice), 0),
      stock: toNum(v?.stock ?? 0, 0),
      variant_options: v?.variant_options || {},
      is_fav: !!v?.is_fav
    };
  }

  function normalizeDiscountType(v) {
    const t = String(v || "").trim().toLowerCase();
    if (t === "percentage") return "percent";
    if (t === "amount") return "fixed";
    if (t === "percent" || t === "fixed") return t;
    return "none";
  }

  function computeDiscountMeta(v) {
    const base = toNum(v?.price ?? v?.original_price, 0);
    const final = toNum(v?.final_price ?? base, base);
    const type = normalizeDiscountType(v?.discount_type);
    let value = toNum(v?.discount_value, 0);
    const pct = toNum(v?.discount_percent, 0);

    if (type === "percent") {
      if (!value && base > 0 && final < base) value = Math.round(((base - final) / base) * 100);
      return { type, value, label: value > 0 ? `Save ${value.toFixed(0)}%` : "" };
    }

    if (type === "fixed") {
      if (!value && base > 0 && final < base) value = Math.max(0, base - final);
      return { type, value, label: value > 0 ? `Save AED ${value.toFixed(2)}` : "" };
    }

    if (pct > 0) return { type: "percent", value: pct, label: `Save ${pct.toFixed(0)}%` };
    return { type: "none", value: 0, label: "" };
  }

  function formatDim(value, unit) {
    const n = toNum(value, 0);
    if (!n) return "";
    const s = n.toFixed(2).replace(/\.00$/, "");
    return unit ? `${s} ${unit}` : s;
  }

  function dimensionRows(v) {
    const dimUnit = String(v?.dimension_unit || v?.product?.dimension_unit || "").trim();
    const weightUnit = String(v?.weight_unit || v?.product?.weight_unit || "").trim();
    return [
      { key: "length", label: "Length", value: formatDim(v?.length, dimUnit) },
      { key: "width", label: "Width", value: formatDim(v?.width, dimUnit) },
      { key: "height", label: "Height", value: formatDim(v?.height, dimUnit) },
      { key: "weight", label: "Weight", value: formatDim(v?.weight, weightUnit) }
    ].filter((r) => r.value);
  }

  function getVariantById(variantId) {
    return state.variants.find((v) => String(v.id) === String(variantId)) || null;
  }

  function currentVariant() {
    return getVariantById(state.currentVariantId) || getVariantById(INITIAL_VARIANT_ID) || state.variants[0] || null;
  }

  function getCartQty(variantId) {
    return Number(state.cart.get(`v:${String(variantId)}`) ?? 0);
  }

  function getStock(variantId) {
    return Number(state.stock.get(String(variantId)) ?? 0);
  }

  function syncStockFromVariant(v) {
    if (!v || v.id == null) return;
    state.stock.set(String(v.id), Number(v.stock ?? 0));
  }

  function setText(target, value) {
    if (!target) return;
    target.textContent = value === null || value === undefined || value === "" ? "—" : String(value);
  }

  function setBusy(target, busy = true) {
    if (!target) return;
    target.disabled = !!busy;
  }

  function showInlineError(message, timeout = 4500) {
    [el.inlineError, el.inlineErrorAside].forEach((node) => {
      if (!node) return;
      node.textContent = message || "";
      node.classList.toggle("ap-hidden", !message);
    });

    if (message && timeout > 0) {
      setTimeout(() => {
        [el.inlineError, el.inlineErrorAside].forEach((node) => {
          if (!node) return;
          node.textContent = "";
          node.classList.add("ap-hidden");
        });
      }, timeout);
    }
  }

  function clearInlineError() {
    [el.inlineError, el.inlineErrorAside].forEach((node) => {
      if (!node) return;
      node.textContent = "";
      node.classList.add("ap-hidden");
    });
  }

  async function apiFetch(url, method = "GET", body = null, timeout = 15000) {
    const headers = { "x-guest-token": getGuestToken };
    if (method !== "GET") {
      headers["Content-Type"] = "application/json";
      if (CSRF) headers["x-csrf-token"] = CSRF;
    }

    const controller = new AbortController();
    const timer = setTimeout(() => controller.abort(), timeout);

    try {
      const res = await fetch(url, {
        method,
        headers,
        credentials: "same-origin",
        signal: controller.signal,
        body: method !== "GET" && body != null ? JSON.stringify(body) : undefined
      });

      clearTimeout(timer);
      if (res.status === 204) return null;

      let json = null;
      try { json = await res.json(); } catch (_) {}

      if (!res.ok) {
        const err = new Error((json && json.message) ? json.message : `HTTP ${res.status}`);
        err.status = res.status;
        err.body = json;
        throw err;
      }

      if (json && typeof json === "object" && json.success === false) {
        const err = new Error(json.message || "Server rejected request");
        err.status = res.status;
        err.body = json;
        throw err;
      }

      return json;
    } catch (err) {
      if (err.name === "AbortError") throw new Error("Request timeout");
      throw err;
    }
  }

  function renderThumbs(images, title) {
    if (!el.thumbs) return;
    const unique = Array.from(new Set((images || []).filter(Boolean)));
    el.thumbs.innerHTML = unique.map((img, idx) => `
      <button type="button" class="ap-thumb ${idx === 0 ? "is-active" : ""}" data-image="${esc(img)}">
        <img src="${esc(img)}" alt="${esc(title)} thumbnail ${idx + 1}" loading="lazy">
      </button>
    `).join("");
    state.imageIndex = 0;
  }

  function setMainImageByIndex(index) {
    const images = currentVariantImages();
    if (!images.length || !el.mainImage) return;
    const safeIndex = ((index % images.length) + images.length) % images.length;
    state.imageIndex = safeIndex;
    el.mainImage.src = images[safeIndex];
    syncThumbActive();
  }

  function currentVariantImages() {
    const v = currentVariant();
    const images = normalizeMediaList(v || {});
    return images.length ? images : [normalizeImageSrc(v?.image || v?.product?.main_image || "")];
  }

  function syncThumbActive() {
    if (!el.thumbs) return;
    const images = currentVariantImages();
    const current = images[state.imageIndex] || images[0];
    el.thumbs.querySelectorAll(".ap-thumb").forEach((btn) => {
      btn.classList.toggle("is-active", btn.dataset.image === current);
    });
  }

  function renderVariantCards() {
    if (!el.variants) return;
    const current = String(state.currentVariantId);
    el.variants.innerHTML = state.variants.map((raw, idx) => {
      const v = raw || {};
      const title = String(v.variant_name || v.name || v.display_name || `Option ${idx + 1}`);
      const stock = Number(v.stock || 0);
      const meta = computeDiscountMeta(v);
      const thumb = normalizeMediaList(v)[0] || normalizeImageSrc(v.image || v.product?.main_image || "");
      return `
        <button type="button"
                class="ap-variant ${String(v.id) === current ? "is-active" : ""}"
                data-variant-id="${esc(String(v.id || ""))}"
                data-variant-json="${esc(encodeURIComponent(JSON.stringify(v)))}"
                style="text-align:left;border:1px solid var(--ap-border);border-radius:12px;padding:12px;background:#fff;cursor:pointer;">
          <div class="ap-variant-name" style="font-weight:700;">${esc(title)}</div>
          <div class="ap-variant-meta" style="font-size:12px;color:var(--ap-muted);margin-top:4px;">${stock > 0 ? (stock <= 5 ? `${stock} left` : "In stock") : "Out of stock"}</div>
          ${meta.label ? `<div class="ap-variant-meta" style="font-size:12px;color:var(--ap-green);margin-top:4px;">${esc(meta.label)}</div>` : ""}
          ${thumb ? `<div style="margin-top:10px;border:1px solid var(--ap-border);border-radius:12px;overflow:hidden;aspect-ratio:1/1;"><img src="${esc(thumb)}" alt="" style="width:100%;height:100%;object-fit:cover;display:block;"></div>` : ""}
        </button>
      `;
    }).join("");
  }

  function syncVariantButtons() {
    if (!el.variants) return;
    const current = String(state.currentVariantId);
    el.variants.querySelectorAll(".ap-variant").forEach((btn) => {
      btn.classList.toggle("is-active", String(btn.dataset.variantId) === current);
    });
  }

  function syncPurchaseControls() {
    const v = currentVariant();
    if (!v) return;

    const qty = getCartQty(v.id);
    const stock = getStock(v.id) || toNum(v.stock ?? 0, 0);

    const addBtns = [el.addCartBtn, el.addCartBtnAside, el.addCartBtnMobile].filter(Boolean);
    const qtyBlocks = [el.qtyControls, el.qtyControlsAside, el.qtyControlsMobile].filter(Boolean);
    const qtyCountNodes = [el.qtyCount, el.qtyCountAside, el.qtyCountMobile].filter(Boolean);
    const minusNodes = [el.qtyMinus, el.qtyMinusAside, el.qtyMinusMobile].filter(Boolean);
    const plusNodes = [el.qtyPlus, el.qtyPlusAside, el.qtyPlusMobile].filter(Boolean);

    qtyCountNodes.forEach((node) => { node.textContent = String(qty); });

    minusNodes.forEach((node) => {
      node.disabled = qty <= 0;
      node.setAttribute("aria-label", qty <= 1 ? "Remove item" : "Decrease quantity");
    });

    plusNodes.forEach((node) => {
      node.disabled = stock <= 0;
    });

    addBtns.forEach((btn) => btn.classList.toggle("ap-hidden", qty > 0));
    qtyBlocks.forEach((block) => block.classList.toggle("ap-hidden", qty <= 0));
  }

  function renderVariant(variant) {
    if (!variant) return;
    const v = normalizeVariantFromAny(variant);
    if (!v) return;

    state.currentVariantId = String(v.id);
    syncStockFromVariant(v);

    const title = v.name || v.variant_name || v.display_name || "Product Details";
    const images = Array.isArray(v.images) && v.images.length ? v.images : normalizeMediaList(v);
    const primary = images[0] || normalizeImageSrc(v.image || v.product?.main_image || "");

    if (el.mainImage) {
      el.mainImage.src = primary;
      el.mainImage.alt = title;
    }

    renderThumbs(images.length ? images : [primary], title);

    setText(el.title, title);
    setText(el.brand, v.brand || v.product?.brand || "Product");
    setText(el.brandText, v.brand || v.product?.brand || "—");
    setText(el.stockText, String(toNum(v.stock ?? 0, 0)));
    setText(el.description, v.product?.short_description || v.product?.description || "No description available.");

    const stock = toNum(v.stock ?? 0, 0);
    if (el.stockBadge) {
      el.stockBadge.textContent = stock > 0 ? "In Stock" : "Out of Stock";
      el.stockBadge.className = `ap-badge ${stock > 0 ? "success" : "danger"}`;
    }

    const meta = computeDiscountMeta(v);
    if (el.discountBadge) {
      el.discountBadge.textContent = meta.label || "";
      el.discountBadge.classList.toggle("ap-hidden", !meta.label);
    }

    const finalPrice = toNum(v.final_price ?? v.price ?? 0, 0);
    const originalPrice = toNum(v.original_price ?? v.price ?? 0, 0);
    const saveValue = originalPrice > finalPrice ? (originalPrice - finalPrice) : 0;

    [el.finalPrice, el.finalPriceAside].filter(Boolean).forEach((node) => {
      node.textContent = `AED ${finalPrice.toFixed(2)}`;
    });

    [el.originalPrice, el.originalPriceAside].filter(Boolean).forEach((node) => {
      if (originalPrice > finalPrice) {
        node.textContent = `AED ${originalPrice.toFixed(2)}`;
        node.classList.remove("ap-hidden");
      } else {
        node.classList.add("ap-hidden");
      }
    });

    if (el.saveAmount) {
      if (meta.label) {
        el.saveAmount.textContent = meta.label;
        el.saveAmount.classList.remove("ap-hidden");
      } else if (saveValue > 0) {
        el.saveAmount.textContent = `Save AED ${saveValue.toFixed(2)}`;
        el.saveAmount.classList.remove("ap-hidden");
      } else {
        el.saveAmount.classList.add("ap-hidden");
      }
    }

    if (el.priceNote) el.priceNote.textContent = v.vat_included ? "Includes VAT" : "Excludes VAT";
    if (el.priceNoteAside) el.priceNoteAside.textContent = v.vat_included ? "Includes VAT" : "Excludes VAT";

    const productMap = {
      name: v.product?.name || v.product_name || "",
      brand: v.brand || v.product?.brand || "",
      short_description: v.product?.short_description || v.short_description || "",
      description: v.product?.description || v.product_description || "",
      key_features: v.product?.key_features || v.key_features || v.bullets || ""
    };

    Object.entries(productMap).forEach(([key, value]) => {
      const node = document.querySelector(`[data-product-field="${CSS.escape(key)}"]`);
      if (node) node.textContent = value || "—";
    });

    const dims = dimensionRows(v);
    ["length", "width", "height", "weight"].forEach((key) => {
      const node = document.querySelector(`[data-variant-field="${CSS.escape(key)}"]`);
      if (node) {
        const row = dims.find((r) => r.key === key);
        node.textContent = row ? row.value : "—";
      }
    });

    updateVariantUrl(v.id);
    syncVariantButtons();
    syncPurchaseControls();

    const isFav = !!state.wishlist[String(v.id)] || !!v.is_fav;
    [el.wishlistBtn, el.wishlistBtnAside, el.wishlistBtnMobile].filter(Boolean).forEach((btn) => {
      btn.classList.toggle("is-fav", isFav);
      const label = btn.id === "pd-wishlist-btn-mobile" ? "Wishlist" : (isFav ? "In Wishlist" : "");
      btn.innerHTML = `<i class="fa fa-heart" aria-hidden="true"></i> `;
    });
  }

  function updateVariantUrl(variantId) {
    if (!PRODUCT_ID || !variantId) return;
    const next = `/customer/product/product-details/${PRODUCT_ID}/${variantId}`;
    try { history.replaceState({}, "", next); } catch (_) {}
  }

  function buildCartPayloadVariantOnly(variantId, quantity = 1) {
    return { variant_id: Number(variantId), quantity: Number(quantity || 1) };
  }

  function normalizeCartRow(row) {
    if (!row || typeof row !== "object") return null;
    let vid = row.variant_id ?? row.variantId ?? row.vid ?? row.variant ?? null;
    if (vid == null && typeof row.cart_key === "string" && row.cart_key.length) {
      const m = row.cart_key.match(/(\d+)/);
      if (m) vid = Number(m[1]);
    }
    const vidNum = (vid == null || vid === "" || Number.isNaN(Number(vid))) ? null : Number(vid);
    if (vidNum == null) return null;
    const qty = Number(row.quantity ?? row.qty ?? row.in_cart_qty ?? row.qty_in_cart ?? 0) || 0;
    return { vidN: vidNum, qty };
  }

  async function fetchCartMap() {
    try {
      const json = await apiFetch(API.cartGet, "GET", null);
      let arr = [];
      if (Array.isArray(json?.data)) arr = json.data;
      else if (Array.isArray(json)) arr = json;
      else if (Array.isArray(json?.items)) arr = json.items;
      else if (Array.isArray(json?.cart)) arr = json.cart;
      else if (json && typeof json === "object" && json.data && !Array.isArray(json.data) && typeof json.data === "object") arr = [json.data];

      state.cart.clear();
      for (const row of arr) {
        const n = normalizeCartRow(row);
        if (!n || n.vidN == null) continue;
        state.cart.set(`v:${n.vidN}`, Number(n.qty || 0));
      }
      syncPurchaseControls();
      return state.cart;
    } catch (err) {
      console.warn("fetchCartMap failed", err);
      return state.cart;
    }
  }

  async function fetchWishlistMap() {
    try {
      const json = await apiFetch(API.wishlistGet, "GET", null);
      for (const k of Object.keys(state.wishlist)) delete state.wishlist[k];
      if (json?.success && Array.isArray(json.data)) {
        for (const vid of json.data) state.wishlist[String(vid)] = true;
      }
      renderVariant(currentVariant());
      return true;
    } catch (_) {
      return false;
    }
  }

  async function refreshProductDetailFromServer() {
    try {
      const json = await apiFetch(API.detail, "GET", null);
      const payload = json?.data || json || {};
      const serverProduct = payload.product || {};
      const serverVariants = Array.isArray(payload.variants) ? payload.variants : [];
      const serverSelected = payload.selectedVariant || serverVariants[0] || null;

      if (serverProduct && typeof serverProduct === "object") state.product = serverProduct;

      if (serverVariants.length) {
        state.variants = serverVariants.map((v) => normalizeVariantFromAny(v)).filter(Boolean);
      } else if (serverSelected) {
        state.variants = [normalizeVariantFromAny(serverSelected)].filter(Boolean);
      }

      renderVariantCards();

      const found =
        getVariantById(payload.selectedVariant?.id || state.currentVariantId) ||
        getVariantById(INITIAL_VARIANT_ID) ||
        state.variants[0];

      if (found) renderVariant(found);
      else if (serverSelected) renderVariant(serverSelected);

      await Promise.all([fetchCartMap(), fetchWishlistMap()]);
    } catch (err) {
      console.warn("refreshProductDetailFromServer failed", err);
    }
  }

  async function toggleWishlist(variantId) {
    if (!variantId) return;

    const wasFav = !!state.wishlist[String(variantId)];
    if (wasFav) delete state.wishlist[String(variantId)];
    else state.wishlist[String(variantId)] = true;

    renderVariant(currentVariant());
    setBusy(el.wishlistBtn, true);
    setBusy(el.wishlistBtnAside, true);
    setBusy(el.wishlistBtnMobile, true);

    try {
      const json = await apiFetch(API.wishlistToggle, "POST", { variant_id: Number(variantId) });

      let serverIsFav = null;
      if (json?.is_fav !== undefined) serverIsFav = !!json.is_fav;
      else if (json?.action) serverIsFav = json.action === "added";

      if (serverIsFav !== null) {
        if (serverIsFav) state.wishlist[String(variantId)] = true;
        else delete state.wishlist[String(variantId)];
      }

      renderVariant(currentVariant());
    } catch (err) {
      if (wasFav) state.wishlist[String(variantId)] = true;
      else delete state.wishlist[String(variantId)];
      renderVariant(currentVariant());
      showInlineError(err?.body?.message || err.message || "Wishlist update failed", 3500);
    } finally {
      setBusy(el.wishlistBtn, false);
      setBusy(el.wishlistBtnAside, false);
      setBusy(el.wishlistBtnMobile, false);
    }
  }

  async function updateCartQtyVariant(variantId, newQty) {
    if (!variantId) return;

    let qty = Number(newQty);
    if (Number.isNaN(qty)) return;
    if (qty < 0) qty = 0;

    const key = `v:${String(variantId)}`;
    const stock = getStock(variantId);
    if (qty > stock) {
      showInlineError(`Not enough stock. Available: ${stock}`, 3500);
      return;
    }

    try {
      state.cart.set(key, qty);
      syncPurchaseControls();
      await apiFetch(API.cartUpdate, "POST", buildCartPayloadVariantOnly(variantId, qty));
      await fetchCartMap();
      syncPurchaseControls();
    } catch (err) {
      await fetchCartMap().catch(() => {});
      syncPurchaseControls();
      showInlineError(err?.body?.message || err.message || "Failed to update quantity", 4500);
      throw err;
    }
  }

  async function addToCartVariant(variantId) {
    if (!variantId) return;
    const key = `v:${String(variantId)}`;
    const v = getVariantById(variantId) || currentVariant();
    const stock = getStock(variantId) || toNum(v?.stock ?? 0, 0);
    const currentQty = Number(state.cart.get(key) ?? 0);

    if (stock <= 0) {
      showInlineError("Out of stock", 3500);
      return;
    }
    if (currentQty + 1 > stock) {
      showInlineError(`Not enough stock. Available: ${stock}`, 3500);
      return;
    }

    try {
      clearInlineError();
      state.cart.set(key, currentQty + 1);
      syncPurchaseControls();
      await apiFetch(API.cartAdd, "POST", buildCartPayloadVariantOnly(variantId, 1));
      await fetchCartMap();
      syncPurchaseControls();
    } catch (err) {
      await fetchCartMap().catch(() => {});
      syncPurchaseControls();
      showInlineError(err?.body?.message || err.message || "Failed to Add", 4500);
      throw err;
    }
  }

  async function removeFromCartVariant(variantId) {
    if (!variantId) return;
    const key = `v:${String(variantId)}`;

    try {
      state.cart.set(key, 0);
      syncPurchaseControls();
      await apiFetch(API.cartRemove, "POST", { variant_id: Number(variantId) });
      await fetchCartMap();
      syncPurchaseControls();
    } catch (err) {
      await fetchCartMap().catch(() => {});
      syncPurchaseControls();
      showInlineError(err?.body?.message || err.message || "Failed to remove item", 4500);
      throw err;
    }
  }

  function bindThumbs() {
    if (!el.thumbs) return;
    el.thumbs.addEventListener("click", (e) => {
      const btn = e.target.closest(".ap-thumb");
      if (!btn) return;
      const img = btn.dataset.image;
      if (!img || !el.mainImage) return;
      state.imageIndex = Array.from(el.thumbs.querySelectorAll(".ap-thumb")).findIndex((n) => n === btn);
      el.mainImage.src = img;
      syncThumbActive();
    });
  }

  function bindImageNavigation() {
    if (el.prevImage) {
      el.prevImage.addEventListener("click", () => {
        setMainImageByIndex(state.imageIndex - 1);
      });
    }
    if (el.nextImage) {
      el.nextImage.addEventListener("click", () => {
        setMainImageByIndex(state.imageIndex + 1);
      });
    }
  }

  function bindVariantSelector() {
    if (!el.variants) return;
    el.variants.addEventListener("click", (e) => {
      const btn = e.target.closest(".ap-variant");
      if (!btn) return;

      const json = btn.dataset.variantJson;
      let found = null;

      if (json) {
        try {
          found = JSON.parse(decodeURIComponent(json));
        } catch (_) {
          found = getVariantById(btn.dataset.variantId);
        }
      } else {
        found = getVariantById(btn.dataset.variantId);
      }

      if (!found) return;
      renderVariant(found);
    });
  }

  function bindQtyControls() {
    const minusButtons = [el.qtyMinus, el.qtyMinusAside, el.qtyMinusMobile].filter(Boolean);
    const plusButtons = [el.qtyPlus, el.qtyPlusAside, el.qtyPlusMobile].filter(Boolean);

    minusButtons.forEach((btn) => btn.addEventListener("click", async () => {
      const v = currentVariant();
      if (!v) return;

      const currentQty = getCartQty(v.id);
      if (currentQty <= 1) {
        setBusy(el.qtyMinus, true);
        setBusy(el.qtyMinusAside, true);
        setBusy(el.qtyMinusMobile, true);
        try {
          await removeFromCartVariant(v.id);
        } finally {
          setBusy(el.qtyMinus, false);
          setBusy(el.qtyMinusAside, false);
          setBusy(el.qtyMinusMobile, false);
        }
      } else {
        setBusy(el.qtyMinus, true);
        setBusy(el.qtyMinusAside, true);
        setBusy(el.qtyMinusMobile, true);
        try {
          await updateCartQtyVariant(v.id, currentQty - 1);
        } finally {
          setBusy(el.qtyMinus, false);
          setBusy(el.qtyMinusAside, false);
          setBusy(el.qtyMinusMobile, false);
        }
      }
    }));

    plusButtons.forEach((btn) => btn.addEventListener("click", async () => {
      const v = currentVariant();
      if (!v) return;

      const currentQty = getCartQty(v.id);
      setBusy(el.qtyPlus, true);
      setBusy(el.qtyPlusAside, true);
      setBusy(el.qtyPlusMobile, true);

      try {
        await updateCartQtyVariant(v.id, currentQty + 1);
      } finally {
        setBusy(el.qtyPlus, false);
        setBusy(el.qtyPlusAside, false);
        setBusy(el.qtyPlusMobile, false);
      }
    }));
  }

  function bindAddCartButtons() {
    [el.addCartBtn, el.addCartBtnAside, el.addCartBtnMobile].filter(Boolean).forEach((btn) => {
      btn.addEventListener("click", async () => {
        const v = currentVariant();
        if (!v) return;
        await addToCartVariant(v.id);
      });
    });
  }

  function bindWishlistButtons() {
    [el.wishlistBtn, el.wishlistBtnAside, el.wishlistBtnMobile].filter(Boolean).forEach((btn) => {
      btn.addEventListener("click", async () => {
        const v = currentVariant();
        if (!v) return;
        await toggleWishlist(v.id);
      });
    });
  }

  function bindCardActions() {
    document.addEventListener("click", (e) => {
      const addBtn = e.target.closest(".ap-card-add-cart");
      if (addBtn) {
        e.preventDefault();
        e.stopPropagation();
        const vid = addBtn.dataset.variantId;
        if (vid) addToCartVariant(vid);
        return;
      }

      const favBtn = e.target.closest(".ap-card-fav");
      if (favBtn) {
        e.preventDefault();
        e.stopPropagation();
        const vid = favBtn.dataset.variantId;
        if (vid) toggleWishlist(vid);
      }
    });
  }

  function bindCarousels() {
    document.querySelectorAll(".ap-carousel-shell").forEach((shell) => {
      const track = shell.querySelector(".ap-carousel-track");
      const prev = shell.querySelector(".ap-carousel-prev");
      const next = shell.querySelector(".ap-carousel-next");
      if (!track) return;

      const step = () => Math.max(240, Math.round(track.clientWidth * 0.86));

      if (prev) prev.addEventListener("click", () => track.scrollBy({ left: -step(), behavior: "smooth" }));
      if (next) next.addEventListener("click", () => track.scrollBy({ left: step(), behavior: "smooth" }));
    });
  }

  function init() {
    state.variants = (state.variants || []).map((v) => normalizeVariantFromAny(v)).filter(Boolean);

    const found = getVariantById(state.currentVariantId) || getVariantById(INITIAL_VARIANT_ID) || state.variants[0];
    if (found) renderVariant(found);

    renderVariantCards();
    bindThumbs();
    bindImageNavigation();
    bindVariantSelector();
    bindQtyControls();
    bindAddCartButtons();
    bindWishlistButtons();
    bindCardActions();
    bindCarousels();

    Promise.all([fetchCartMap(), fetchWishlistMap()]).then(() => {
      if (found) renderVariant(found);
      refreshProductDetailFromServer();
    });
  }

  window.__productDetailDiag = {
    refresh: async () => {
      await Promise.all([fetchCartMap(), fetchWishlistMap(), refreshProductDetailFromServer()]);
    },
    cart: state.cart,
    stock: state.stock,
    wishlist: state.wishlist,
    variants: state.variants
  };

  document.addEventListener("DOMContentLoaded", init);
})();
</script>  <div class="container my-4">
