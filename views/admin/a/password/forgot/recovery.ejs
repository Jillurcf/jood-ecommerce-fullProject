<!DOCTYPE html>
<html lang="en">
<head>
  <title>Forgot Password - JOOD | Account Recovery</title>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Recover your JOOD account securely by resetting your password.">
  <meta name="robots" content="noindex, follow">

    <link rel="shortcut icon" href="/customer/images/web-img-vid/favicon.png" type="image/x-icon">


  <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,400,600,700" rel="stylesheet" />
  <link href="/customer/assets/css/nucleo-icons.css" rel="stylesheet" />
  <link href="/customer/assets/css/nucleo-svg.css" rel="stylesheet" />
  <script src="https://kit.fontawesome.com/42d5adcbca.js" crossorigin="anonymous"></script>
  <link id="pagestyle" href="/customer/assets/css/soft-ui-dashboard.css?v=1.0.3" rel="stylesheet" />

  <style>
    .wizard-step {
      display: none;
      animation: fadeInUp .25s ease;
    }

    .wizard-step.active {
      display: block;
    }

    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .choice-card {
      border: 1px solid #dee2e6;
      border-radius: 16px;
      padding: 16px;
      cursor: pointer;
      transition: all .2s ease;
      background: #fff;
      height: 100%;
      min-height: 120px;
      user-select: none;
    }

    .choice-card:hover {
      border-color: #8392ab;
      transform: translateY(-1px);
    }

    .choice-card.active {
      border-color: #344767;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
    }

    .choice-card input {
      margin-right: 10px;
      transform: translateY(1px);
    }

    .mini-pill {
      display: inline-flex;
      align-items: center;
      gap: .35rem;
      border-radius: 999px;
      padding: .35rem .7rem;
      font-size: .75rem;
      background: #f8f9fa;
      border: 1px solid #e9ecef;
      color: #344767;
      max-width: 100%;
    }

    .summary-box {
      border: 1px solid #e9ecef;
      border-radius: 16px;
      background: #fbfcfe;
      padding: 16px;
    }

    .soft-divider {
      height: 1px;
      background: linear-gradient(90deg, rgba(0, 0, 0, 0.04), rgba(0, 0, 0, 0.12), rgba(0, 0, 0, 0.04));
      margin: 16px 0;
    }

    .step-badge {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      background: #fe9d00;
      color: #fff;
      margin-right: 10px;
      flex: 0 0 auto;
    }

    .step-title {
      display: flex;
      align-items: flex-start;
      gap: 8px;
      margin-bottom: 8px;
    }

    .step-muted {
      color: #67748e;
      font-size: .92rem;
    }

    .btn-recovery {
      background-color: #fe9d00;
      color: #fff;
      border: 1px solid #fe9d00;
    }

    .btn-recovery:hover,
    .btn-recovery:focus {
      background-color: #e98d00;
      color: #fff;
      border-color: #e98d00;
    }

    .btn-outline-soft {
      border: 1px solid #d2d6da;
      background: #fff;
      color: #344767;
    }

    .btn-outline-soft:hover {
      background: #f8f9fa;
      color: #344767;
    }

    .help-text {
      font-size: .88rem;
      color: #6c757d;
    }

    .form-control-lg {
      border-radius: 14px;
    }
  </style>
</head>

<body class="g-sidenav-show bg-gray-100">
  <section class="min-vh-100 mb-8">
    <div
      class="page-header align-items-start min-vh-50 pt-5 pb-11 m-3 border-radius-lg bg-warning"
      style="background-image: url('/customer/assets/img/curved-images/s.png'); background-size: cover; background-position: center;"
    >
      <span class="mask bg-gradient-dark opacity-6"></span>

      <div class="container position-relative">
        <div class="row justify-content-center">
          <div class="col-lg-6 text-center mx-auto">
            <div class="logo mb-4">
              <a href="/">
                <img src="/customer/images/web-img-vid/logo.png" width="150" alt="logo">
              </a>
            </div>

            <h1 class="text-white mb-2">Forgot Password?</h1>
            <p class="text-lead text-white mb-0">
              Start with your email, then choose OTP or a reset link.
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="container">
      <div class="row mt-lg-n10 mt-md-n11 mt-n10">
        <div class="col-xl-6 col-lg-8 col-md-10 mx-auto">
          <div class="card z-index-0 shadow-sm">
            <div class="card-header text-center pt-4 pb-2">
              <h5 class="mb-1">Account Recovery</h5>
              <p class="text-sm text-muted mb-0">Complete the steps below</p>
            </div>

            <div class="card-body p-4 p-md-5">
              <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-danger text-white">
                  <%= error %>
                </div>
              <% } %>

              <% if (typeof success !== 'undefined' && success) { %>
                <div class="alert alert-success text-white">
                  <%= success %>
                </div>
              <% } %>

              <%
                const oldIdentifier = (typeof old !== 'undefined' && old && old.identifier) ? old.identifier : '';
                const oldRecoveryMode = (typeof old !== 'undefined' && old && old.recovery_mode) ? old.recovery_mode : 'otp';
                const isOtp = oldRecoveryMode === 'otp';
                const isLink = oldRecoveryMode === 'link';
              %>

              <form
                id="recoveryForm"
                action="/admin/a/password/forgot/recovery"
                method="POST"
                autocomplete="off"
                novalidate
              >
                <% if (csrfToken) { %>
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <% } %>

                <div id="step1" class="wizard-step active">
                  <div class="step-title">
                    <span class="step-badge">1</span>
                    <div>
                      <div class="fw-bold">Enter your email</div>
                      <div class="step-muted">We will use this to find your account.</div>
                    </div>
                  </div>

                  <div class="mb-3">
                    <label class="form-label fw-bold">Email</label>
                    <input
                      type="email"
                      name="identifier"
                      id="identifierInput"
                      class="form-control form-control-lg"
                      placeholder="Enter your email"
                      value="<%= oldIdentifier %>"
                      required
                      autocomplete="username"
                    >
                  </div>

                  <div class="d-flex justify-content-end">
                    <button type="button" id="toStep2Btn" class="btn btn-recovery px-5">
                      Continue
                    </button>
                  </div>
                </div>

                <div id="step2" class="wizard-step">
                  <div class="step-title">
                    <span class="step-badge">2</span>
                    <div>
                      <div class="fw-bold">Choose recovery method</div>
                      <div class="step-muted">Pick OTP or a reset link.</div>
                    </div>
                  </div>

                  <div class="mb-3">
                    <div class="mini-pill mb-2">
                      <i class="fa-solid fa-user"></i>
                      <span id="chosenIdentifier"><%= oldIdentifier || 'No account selected yet' %></span>
                    </div>
                  </div>

                  <div class="mb-3">
                    <label class="form-label fw-bold">Recovery type</label>
                    <div class="row g-3">
                      <div class="col-6">
                        <label class="choice-card <%= isOtp ? 'active' : '' %>">
                          <input type="radio" name="recovery_mode" value="otp" <%= isOtp ? 'checked' : '' %>>
                          <div class="fw-bold">OTP</div>
                          <div class="text-sm text-muted mt-1">Receive a one-time code</div>
                        </label>
                      </div>
                      <div class="col-6">
                        <label class="choice-card <%= isLink ? 'active' : '' %>">
                          <input type="radio" name="recovery_mode" value="link" <%= isLink ? 'checked' : '' %>>
                          <div class="fw-bold">Reset Link</div>
                          <div class="text-sm text-muted mt-1">Receive a secure password reset link</div>
                        </label>
                      </div>
                    </div>
                  </div>

                  <div class="alert alert-info text-white mb-0">
                    Your selected method will be sent to your email address.
                  </div>

                  <div class="d-flex gap-2 justify-content-between mt-4">
                    <button type="button" id="backToStep1Btn" class="btn btn-outline-soft px-5">
                      Back
                    </button>
                    <button type="button" id="toStep3Btn" class="btn btn-recovery px-5">
                      Review
                    </button>
                  </div>
                </div>

                <div id="step3" class="wizard-step">
                  <div class="step-title">
                    <span class="step-badge">3</span>
                    <div>
                      <div class="fw-bold">Review and send</div>
                      <div class="step-muted">Confirm everything before we send the recovery message.</div>
                    </div>
                  </div>

                  <div class="summary-box mb-3">
                    <div class="d-flex justify-content-between align-items-center">
                      <span class="text-sm text-muted">Recovery type</span>
                      <strong id="reviewMode">OTP</strong>
                    </div>

                    <div class="soft-divider"></div>

                    <div class="d-flex justify-content-between align-items-center">
                      <span class="text-sm text-muted">Send to</span>
                      <strong>Email</strong>
                    </div>

                    <div class="soft-divider"></div>

                    <div class="d-flex justify-content-between align-items-center">
                      <span class="text-sm text-muted">Account</span>
                      <strong id="reviewIdentifier"><%= oldIdentifier || 'Not entered yet' %></strong>
                    </div>
                  </div>

                  <div id="recoveryHint" class="alert alert-warning text-dark">
                    We will send a one-time password to your email.
                  </div>

                  <div class="d-flex gap-2 justify-content-between">
                    <button type="button" id="backToStep2Btn" class="btn btn-outline-soft px-5">
                      Back
                    </button>
                    <button type="submit" id="submitBtn" class="btn btn-recovery px-5">
                      Send OTP
                    </button>
                  </div>
                </div>

                <p class="text-sm text-center mt-4 mb-0">
                  Remember your password?
                  <a href="/admin/a/sign/in" class="text-dark font-weight-bolder">Sign in</a>
                </p>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script src="/customer/assets/js/core/popper.min.js"></script>
  <script src="/customer/assets/js/core/bootstrap.min.js"></script>
  <script src="/customer/assets/js/plugins/perfect-scrollbar.min.js"></script>
  <script src="/customer/assets/js/plugins/smooth-scrollbar.min.js"></script>
  <script src="/customer/assets/js/soft-ui-dashboard.min.js?v=1.0.3"></script>

  <script>
    (function () {
      const form = document.getElementById("recoveryForm");
      const step1 = document.getElementById("step1");
      const step2 = document.getElementById("step2");
      const step3 = document.getElementById("step3");

      const toStep2Btn = document.getElementById("toStep2Btn");
      const toStep3Btn = document.getElementById("toStep3Btn");
      const backToStep1Btn = document.getElementById("backToStep1Btn");
      const backToStep2Btn = document.getElementById("backToStep2Btn");

      const chosenIdentifier = document.getElementById("chosenIdentifier");
      const reviewMode = document.getElementById("reviewMode");
      const reviewIdentifier = document.getElementById("reviewIdentifier");
      const recoveryHint = document.getElementById("recoveryHint");
      const submitBtn = document.getElementById("submitBtn");
      const identifierInput = document.getElementById("identifierInput");

      function setActiveStep(stepNumber) {
        step1.classList.remove("active");
        step2.classList.remove("active");
        step3.classList.remove("active");

        if (stepNumber === 1) step1.classList.add("active");
        if (stepNumber === 2) step2.classList.add("active");
        if (stepNumber === 3) step3.classList.add("active");
      }

      function checkedValue(name) {
        const el = form.querySelector(`input[name="${name}"]:checked`);
        return el ? el.value : "";
      }

      function labelForMode(value) {
        return value === "link" ? "Reset Link" : "OTP";
      }

      function syncSummary() {
        const identifier = identifierInput.value.trim();
        const mode = checkedValue("recovery_mode") || "otp";

        chosenIdentifier.textContent = identifier || "No account selected yet";
        reviewIdentifier.textContent = identifier || "Not entered yet";
        reviewMode.textContent = labelForMode(mode);

        form.querySelectorAll(".choice-card").forEach((card) => card.classList.remove("active"));
        form.querySelectorAll('input[name="recovery_mode"]:checked').forEach((input) => {
          const card = input.closest(".choice-card");
          if (card) card.classList.add("active");
        });

        if (mode === "link") {
          recoveryHint.textContent = "We will send a secure password reset link to your email.";
          submitBtn.textContent = "Send Reset Link";
        } else {
          recoveryHint.textContent = "We will send a one-time password to your email.";
          submitBtn.textContent = "Send OTP";
        }
      }

      function requireIdentifier() {
        const identifier = identifierInput.value.trim();
        if (!identifier) {
          alert("Please enter your email.");
          identifierInput.focus();
          return false;
        }
        return true;
      }

      toStep2Btn.addEventListener("click", function () {
        if (!requireIdentifier()) return;
        syncSummary();
        setActiveStep(2);
      });

      toStep3Btn.addEventListener("click", function () {
        if (!requireIdentifier()) return;
        syncSummary();
        setActiveStep(3);
      });

      backToStep1Btn.addEventListener("click", function () {
        setActiveStep(1);
      });

      backToStep2Btn.addEventListener("click", function () {
        setActiveStep(2);
      });

      form.querySelectorAll('input[name="recovery_mode"]').forEach((el) => {
        el.addEventListener("change", syncSummary);
      });

      identifierInput.addEventListener("input", syncSummary);

      form.addEventListener("submit", function () {
        syncSummary();
      });

      syncSummary();
    })();
  </script>
</body>
</html>