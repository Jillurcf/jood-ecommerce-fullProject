  .billing-results-list::-webkit-scrollbar-thumb,
  .orders-table-wrap::-webkit-scrollbar-thumb {
    background: transparent;
    border-radius: 999px;
    transition: background 0.2s ease;
  }


  .account-content-wrap:hover::-webkit-scrollbar-thumb,
  .billing-results-list:hover::-webkit-scrollbar-thumb,
  .orders-table-wrap:hover::-webkit-scrollbar-thumb {
    background: rgba(100, 116, 139, 0.5);
  }


  .account-content-wrap::-webkit-scrollbar-track,
  .billing-results-list::-webkit-scrollbar-track,
  .orders-table-wrap::-webkit-scrollbar-track {
    background: transparent;
  }

  .details-grid {
    margin-top: 0;
  }
</style>
</head>
<body class="billing-page">
  <style>
    .billing-subsidebar {
      position: sticky;
      top: calc(var(--topbar-height) + 18px);
      align-self: start;
      overflow: hidden;
      min-width: 0;
    }

    .billing-subsidebar-body {
      display: block;
    }

    .billing-nav {
      display: flex;
      flex-direction: column;
      gap: 8px;
      padding: 14px;
      border-bottom: 1px solid var(--border);
      background: #fff;
    }

    .billing-nav-link {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 12px;
      border-radius: 12px;
      color: var(--text);
      font-weight: 700;
      transition: 0.2s ease;
      border: 1px solid transparent;
    }

    .billing-nav-link:hover {
      background: rgba(245, 158, 11, 0.08);
      border-color: rgba(245, 158, 11, 0.12);
      transform: translateX(2px);
    }

    .billing-nav-link.active {
      background: var(--primary-soft);
      border-color: rgba(245, 158, 11, 0.18);
    }

    .billing-nav-link i {
      width: 22px;
      text-align: center;
      color: var(--primary);
      flex: 0 0 auto;
    }

    .billing-nav-link .txt {
      min-width: 0;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .billing-snapshot {
      padding: 14px;
      background: #fff;
      display: grid;
      gap: 10px;
    }

    .billing-snapshot .detail-box {
      background: #fff;
    }

    .billing-subsidebar.mobile-closed .billing-subsidebar-body {
      display: none;
    }

    .export-drawer-overlay {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.35);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease;
      z-index: 1040;
    }

    .export-drawer-overlay.show {
      opacity: 1;
      pointer-events: auto;
    }

    .export-drawer {
      position: fixed;
      top: 0;
      right: 0;
      width: min(520px, 100%);
      height: 100vh;
      background: #fff;
      transform: translateX(100%);
      transition: transform 0.25s ease;
      z-index: 1050;
      display: flex;
      flex-direction: column;
    }

    .export-drawer.show {
      transform: translateX(0);
    }

    .history-sidepanel-title {
        margin: 0;
        font-size: 16px;
        font-weight: 900;
        color: var(--text);
        line-height: 1.2;
      }

  </style>

  <div class="account-layout sidebar-collapsed" id="accountLayout">
      <aside class="account-sidebar collapsed" id="accountSidebar" aria-label="Account Sidebar">
        <%- include('../../includes/account-sidebar', { user: adminData, admin: adminData, activePage: 'billing' }) %>
      </aside>

    <div class="account-right">
      <header class="account-topbar" aria-label="Account Topbar">
        <div class="topbar-left">
          <button
            type="button"
            class="account-toggle-btn"
            id="accountToggleBtn"
            aria-label="Toggle sidebar"
            aria-controls="accountSidebar"
            aria-expanded="false"
          >
            <i class="fa fa-bars"></i>
          </button>

          <div class="topbar-title">
            <div class="title">JOOD Billing</div>
            <div class="sub">Admin billing operations and live analytics</div>
          </div>
        </div>

        <div class="topbar-right">
          <div class="billing-live-clock" id="liveClockTopbar">
            <small>Live time</small>
            <span id="liveClockValue">--:--:--</span>
          </div>

          <button
            type="button"
            class="btn-export-wide"
            id="openExportDrawerBtn"
            aria-label="Open filter drawer"
          >
            <i class="fa fa-filter"></i> Filter
          </button>

          <button
            type="button"
            class="btn-export-wide"
            id="exportPdfBtn"
            aria-label="Export billing PDF"
          >
            <i class="fa fa-file-pdf-o"></i> PDF
          </button>

          <div class="account-user-mini">
            <i class="fa fa-user-circle"></i>
            <span><%= fullNameValue %></span>
          </div>
        </div>
      </header>

      <div class="account-backdrop" id="accountBackdrop" aria-hidden="true"></div>

      <div class="account-content-wrap">
        <div class="billing-page-shell">
          <aside class="billing-subsidebar" id="billingSubsidebar">
            <div class="billing-subsidebar-body" id="billingSubsidebarBody">
              <h3 class="history-sidepanel-title">Transaction Navigation</h3>
              <nav class="billing-nav" aria-label="Billing section navigation">
                <a href="#billingSummarySection" class="billing-nav-link active">
                  <i class="fa fa-bar-chart"></i>
                  <span class="txt">Billing Summary</span>
                </a>
                <a href="/admin/a/account/transaction-history" class="billing-nav-link">
                  <i class="fa fa-exchange"></i>
                  <span class="txt">Transactions</span>
                </a>
              </nav>
            </div>
          </aside>

          <main class="billing-main">
            <section class="account-page-header" id="billingSummarySection">
              <div class="card-panel pad account-hero">
                <div class="header-row" style="margin-bottom:0; align-items:flex-start;">
                  <div>
                    <h3 class="section-title" style="font-size:1.25rem;">Admin Billing Overview</h3>
                    <p class="section-subtitle">
                      Complete billing visibility for customer accounts, payment activity, exports, and live reporting.
                    </p>
                  </div>

                  <span class="pill pill-neutral">
                    <i class="fa fa-shield"></i>
                    Admin Access
                  </span>
                </div>
              </div>
            </section>

            <section class="card-panel pad fixed-card mt-3">
              <div class="header-row" style="align-items:flex-start;">
                <div>
                  <h3 class="section-title">Billing Summary & Analytics</h3>
                  <p class="section-subtitle">
                    Live revenue totals, payment insights, refunds, and system-wide activity.
                  </p>
                </div>

                <div class="status-line">
                  <span class="saving-dot" id="savingDot"></span>
                  <span id="savingText">All data loaded</span>
                </div>
              </div>

              <div class="summary-grid">
                <div class="summary-box summary-income">
                  <div class="label">Total Revenue</div>
                  <div class="value" id="totalRevenueValue"><%= totalRevenue.toFixed(2) %> <%= currency %></div>
                  <div class="hint">Paid revenue across all orders.</div>
                </div>

                <div class="summary-box summary-success">
                  <div class="label">Total Orders</div>
                  <div class="value" id="totalOrdersValue"><%= totalOrders %></div>
                  <div class="hint">Total billing records available.</div>
                </div>

                <div class="summary-box summary-warning">
                  <div class="label">Pending Payments</div>
                  <div class="value" id="pendingPaymentsValue"><%= pendingPayments %></div>
                  <div class="hint">Pending or initiated payment rows.</div>
                </div>

                <div class="summary-box summary-danger">
                  <div class="label">Refunds</div>
                  <div class="value" id="refundTotalValue"><%= totalRefunds.toFixed(2) %> <%= currency %></div>
                  <div class="hint">Refunded and reversed totals.</div>
                </div>
              </div>

              <div class="summary-grid mt-3">
                <div class="summary-box">
                  <div class="label">Users With Orders</div>
                  <div class="value"><%= usersWithOrders %></div>
                  <div class="hint">Accounts with billing history.</div>
                </div>

                <div class="summary-box">
                  <div class="label">Paid Users</div>
                  <div class="value"><%= paidUsers %></div>
                  <div class="hint">Accounts with successful payments.</div>
                </div>

                <div class="summary-box">
                  <div class="label">Addresses</div>
                  <div class="value"><%= totalAddresses %></div>
                  <div class="hint">Saved billing and shipping addresses.</div>
                </div>

                <div class="summary-box">
                  <div class="label">This Month Revenue</div>
                  <div class="value"><%= thisMonthRevenue.toFixed(2) %> <%= currency %></div>
                  <div class="hint">Current monthly revenue snapshot.</div>
                </div>
              </div>
            </section>

            <div class="analytics-grid mt-3" id="billingAnalyticsSection">
              <section class="card-panel chart-card fixed-card">
                <div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-2">
                  <div>
                    <h4 class="section-title" style="font-size:1rem;">Revenue Trend</h4>
                    <p class="section-subtitle mb-0">
                      Monthly revenue and payment trend across live records.
                    </p>
                  </div>

                  <div class="billing-badges">
                    <span class="billing-chip">
                      Last refresh:
                      <strong id="lastRefreshLabel">Just now</strong>
                    </span>

                    <span class="billing-chip">
                      Rows:
                      <strong id="matchedCountLabel"><%= billingRowsSafe.length %></strong>
                    </span>
                  </div>
                </div>

                <div class="billing-search-grid mb-2">
                  <select class="form-select" id="graphRange">
                    <option value="recent">Recent</option>
                    <option value="1w">1 Week</option>
                    <option value="2w">2 Weeks</option>
                    <option value="3w">3 Weeks</option>
                    <option value="month" selected>Monthly</option>
                    <option value="year">Yearly</option>
                    <option value="custom">Custom Range</option>
                  </select>

                  <button type="button" class="btn-export-wide" id="refreshLiveBtn">
                    <i class="fa fa-refresh"></i> Refresh
                  </button>
                </div>

                <div class="chart-wrap">
                  <canvas id="billingTrendChart"></canvas>
                </div>

                <div class="analytics-note mt-2">
                  Trend data refreshes automatically from the realtime endpoint.
                </div>
              </section>

              <section class="card-panel chart-card fixed-card">
                <div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-2">
                  <div>
                    <h4 class="section-title" style="font-size:1rem;">Payment Distribution</h4>
                    <p class="section-subtitle mb-0">
                      Current billing rows grouped by payment and status.
                    </p>
                  </div>
                </div>

                <div class="chart-wrap" style="height:220px;">
                  <canvas id="paymentMixChart"></canvas>
                </div>

                <div class="mini-stat-list mt-3">
                  <div class="mini-stat">
                    <div>
                      <div class="k">Billing Snapshot</div>
                      <div class="s">Revenue, orders, users</div>
                    </div>

                    <div>
                      <div class="v"><%= totalUsers %> users</div>
                      <div class="s">Live controller data</div>
                    </div>
                  </div>

                  <div class="mini-stat">
                    <div>
                      <div class="k">Pagination</div>
                      <div class="s">Current / total pages</div>
                    </div>

                    <div>
                      <div class="v"><%= paginationSafe.page || 1 %> / <%= paginationSafe.totalPages || 1 %></div>
                      <div class="s"><%= paginationSafe.total || billingRowsSafe.length %> records</div>
                    </div>
                  </div>
                </div>
              </section>
            </div>

            <section class="card-panel billing-results-card mt-3" id="billingRecordsSection">
              <div class="billing-results-header">
                <div>
                  <h3 class="section-title">Billing Records</h3>
                  <p class="billing-results-meta mb-0">
                    Search results update instantly from the filter drawer.
                  </p>
                </div>

                <div class="billing-badges">
                  <span class="billing-chip">
                    Visible:
                    <strong id="visibleCountLabelBottom"><%= billingRowsSafe.length %></strong>
                  </span>

                  <span class="billing-chip">
                    Total:
                    <strong><%= billingRowsSafe.length %></strong>
                  </span>
                </div>
              </div>

              <div class="billing-results-list">
                <div id="billingResultsEmpty" class="billing-results-empty d-none">
                  No billing records found.
                </div>

                <table class="table billing-results-table d-none" id="billingResultsTable">
                  <thead>
                    <tr>
                      <th>Name</th>
                      <th>Email</th>
                      <th>City</th>
                      <th>Revenue</th>
                      <th>Last Order</th>
                      <th>Status</th>
                      <th>Updated</th>
                      <th>Action</th>
                    </tr>
                  </thead>
                  <tbody id="billingResultsBody"></tbody>
                </table>
              </div>
            </section>

          </main>
        </div>
      </div>
    </div>
  </div>

  <div class="export-drawer-overlay" id="exportDrawerOverlay" aria-hidden="true"></div>

  <aside class="export-drawer" id="exportDrawer" aria-label="Filter drawer">
    <div class="export-drawer-header">
      <div>
        <h3 class="export-drawer-title">Filter & Export</h3>
        <p class="export-drawer-subtitle">
          Configure the current report range and export the filtered billing data.
        </p>
      </div>

      <button type="button" class="btn-ghost" id="closeExportDrawerBtn" aria-label="Close filter drawer">
        <i class="fa fa-times"></i>
      </button>
    </div>

    <div class="export-drawer-body">
      <div class="export-field">
        <label for="searchQuery">Search</label>
        <input
          type="text"
          id="searchQuery"
          class="form-control"
          placeholder="Search name, email, order, phone..."
          autocomplete="off"
        />
      </div>

      <div class="export-field">
        <label for="statusFilter">Payment Status</label>
        <select id="statusFilter" class="form-select">
          <option value="all">All Status</option>
          <option value="paid">Paid</option>
          <option value="pending">Pending</option>
          <option value="failed">Failed</option>
          <option value="refunded">Refunded</option>
          <option value="cancelled">Cancelled</option>
        </select>
      </div>

      <div class="export-field">
        <label for="typeFilter">Payment Type</label>
        <select id="typeFilter" class="form-select">
          <option value="all">All Methods</option>
          <option value="card">Card</option>
          <option value="cash">Cash</option>
          <option value="bank">Bank Transfer</option>
          <option value="wallet">Wallet</option>
          <option value="online">Online</option>
        </select>
      </div>

      <div class="export-field">
        <label for="exportRange">Export Range</label>
        <select id="exportRange" class="form-select">
          <option value="all">All Data</option>
          <option value="recent">Recent</option>
          <option value="1w">1 Week</option>
          <option value="2w">2 Weeks</option>
          <option value="3w">3 Weeks</option>
          <option value="month" selected>Monthly</option>
          <option value="year">Yearly</option>
          <option value="custom">Custom Range</option>
        </select>
      </div>

      <div class="export-field">
        <label for="exportFromDate">From Date</label>
        <input id="exportFromDate" type="date" class="form-control" />
      </div>

      <div class="export-field">
        <label for="exportToDate">To Date</label>
        <input id="exportToDate" type="date" class="form-control" />
      </div>

      <div class="export-preview">
        <div class="export-preview-head">
          <div class="export-preview-title">Preview</div>
          <div class="export-preview-count" id="exportPreviewCount">0 records</div>
        </div>

        <div class="export-preview-list" id="exportPreviewList">
          <div class="export-preview-item">
            <div class="k">Selected range</div>
            <div class="v">Monthly</div>
          </div>
        </div>

        <div class="export-note">
          The PDF export uses the same current filters as the billing table.
        </div>
      </div>

      <div class="export-actions-row mt-3">
        <button type="button" class="btn-export-wide" id="applyExportFiltersBtn">
          <i class="fa fa-filter"></i> Apply
        </button>

        <button type="button" class="btn-secure" id="exportDrawerPdfBtn">
          <i class="fa fa-file-pdf-o"></i> Export PDF
        </button>
      </div>
    </div>
  </aside>

  <div class="toast-mini" id="toastMini" role="status" aria-live="polite"></div>



  <script>
    (function () {
      "use strict";

      const billingRoute = <%- JSON.stringify(typeof currentBillingRouteSafe !== "undefined" ? currentBillingRouteSafe : "/admin/a/account/billing") %>;
      const realtimeEndpoint = <%- JSON.stringify(typeof realtimeEndpointSafe !== "undefined" ? realtimeEndpointSafe : "/admin/a/account/billing/realtime") %>;
      const exportEndpoint = <%- JSON.stringify(typeof exportEndpointSafe !== "undefined" ? exportEndpointSafe : "/admin/a/account/billing/export/pdf") %>;
      const initialRows = <%- JSON.stringify(typeof initialRows !== "undefined" ? initialRows : []) %>;
      const initialOverview = {
        totalUsers: <%= typeof totalUsers !== "undefined" ? totalUsers : 0 %>,
        usersWithOrders: <%= typeof usersWithOrders !== "undefined" ? usersWithOrders : 0 %>,
        paidUsers: <%= typeof paidUsers !== "undefined" ? paidUsers : 0 %>,
        totalRevenue: <%= typeof totalRevenue !== "undefined" ? totalRevenue : 0 %>,
        totalRefunds: <%= typeof totalRefunds !== "undefined" ? totalRefunds : 0 %>,
        pendingPayments: <%= typeof pendingPayments !== "undefined" ? pendingPayments : 0 %>,
        totalOrders: <%= typeof totalOrders !== "undefined" ? totalOrders : 0 %>,
        totalAddresses: <%= typeof totalAddresses !== "undefined" ? totalAddresses : 0 %>,
        thisMonthRevenue: <%= typeof thisMonthRevenue !== "undefined" ? thisMonthRevenue : 0 %>
      };
      const initialChartData = <%- JSON.stringify(typeof chartDataSafe !== "undefined" ? chartDataSafe : { monthly: [], byStatus: [], byMethod: [] }) %>;
      const currencyFallback = "AED";

      const layout = document.getElementById("accountLayout");
      const sidebar = document.getElementById("accountSidebar");
      const toggleBtn = document.getElementById("accountToggleBtn");
      const closeBtn = document.getElementById("accountSidebarClose");
      const backdrop = document.getElementById("accountBackdrop");

      const savingDot = document.getElementById("savingDot");
      const savingText = document.getElementById("savingText");
      const liveClockValue = document.getElementById("liveClockValue");
      const lastRefreshLabel = document.getElementById("lastRefreshLabel");

      const billingResultsBody = document.getElementById("billingResultsBody");
      const billingResultsEmpty = document.getElementById("billingResultsEmpty");
      const billingResultsTable = document.getElementById("billingResultsTable");
      const selectedBillingDetail = document.getElementById("selectedBillingDetail");

      const searchQuery = document.getElementById("searchQuery");
      const statusFilter = document.getElementById("statusFilter");
      const typeFilter = document.getElementById("typeFilter");
      const exportRange = document.getElementById("exportRange");
      const exportFromDate = document.getElementById("exportFromDate");
      const exportToDate = document.getElementById("exportToDate");

      const clearLiveFiltersBtn = document.getElementById("clearLiveFiltersBtn");
      const matchedCountLabel = document.getElementById("matchedCountLabel");
      const visibleCountLabel = document.getElementById("visibleCountLabel");
      const visibleCountLabelBottom = document.getElementById("visibleCountLabelBottom");
      const graphRange = document.getElementById("graphRange");
      const graphRangeLabel = document.getElementById("graphRangeLabel");
      const refreshLiveBtn = document.getElementById("refreshLiveBtn");
      const chartCanvas = document.getElementById("billingTrendChart");
      const mixCanvas = document.getElementById("paymentMixChart");

      const openExportDrawerBtn = document.getElementById("openExportDrawerBtn");
      const exportPdfBtn = document.getElementById("exportPdfBtn");
      const exportDrawerOverlay = document.getElementById("exportDrawerOverlay");
      const exportDrawer = document.getElementById("exportDrawer");
      const closeExportDrawerBtn = document.getElementById("closeExportDrawerBtn");
      const applyExportFiltersBtn = document.getElementById("applyExportFiltersBtn");
      const exportDrawerPdfBtn = document.getElementById("exportDrawerPdfBtn");
      const exportPreviewCount = document.getElementById("exportPreviewCount");
      const exportPreviewList = document.getElementById("exportPreviewList");

      const billingSubsidebar = document.getElementById("billingSubsidebar");
      const billingSubsidebarBody = document.getElementById("billingSubsidebarBody");
      const billingSubsidebarToggle = document.getElementById("billingSubsidebarToggle");

      if (!layout || !sidebar || !toggleBtn) return;

      let currentRows = Array.isArray(initialRows) ? [...initialRows] : [];
      let currentOverview = { ...initialOverview };
      let currentChartData = { ...initialChartData };

      let chartTrend = null;
      let chartMix = null;
      let clockTimer = null;
      let refreshTimer = null;

      function escapeHtml(value) {
        return String(value ?? "")
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#39;");
      }

      function money(value, currency = currencyFallback) {
        return `${Number(value || 0).toFixed(2)} ${currency}`;
      }

      function formatDate(value) {
        if (!value) return "—";
        const d = new Date(value);
        if (Number.isNaN(d.getTime())) return "—";
        return d.toLocaleDateString("en-GB", {
          day: "2-digit",
          month: "short",
          year: "numeric"
        });
      }

      function formatDateTime(value) {
        if (!value) return "—";
        const d = new Date(value);
        if (Number.isNaN(d.getTime())) return "—";
        return d.toLocaleString("en-GB", {
          day: "2-digit",
          month: "short",
          year: "numeric",
          hour: "2-digit",
          minute: "2-digit"
        });
      }

      function toDateKey(value) {
        const d = new Date(value);
        if (Number.isNaN(d.getTime())) return "";
        return d.toISOString().slice(0, 10);
      }

      function showToast(message) {
        if (!toast) return;
        toast.textContent = message;
        toast.classList.add("show");
        clearTimeout(showToast._timer);
        showToast._timer = setTimeout(() => {
          toast.classList.remove("show");
        }, 2500);
      }

      function setSavingState(type, message) {
        if (!savingDot || !savingText) return;

        savingDot.classList.remove("is-saving", "is-saved", "is-error");

        if (type === "saving") savingDot.classList.add("is-saving");
        if (type === "saved") savingDot.classList.add("is-saved");
        if (type === "error") savingDot.classList.add("is-error");

        savingText.textContent = message || "";
      }

      function isMobile() {
        return window.innerWidth <= 991;
      }

      function openSidebarMobile() {
        sidebar.classList.add("open");
        backdrop?.classList.add("show");
        document.body.style.overflow = "hidden";
        toggleBtn.setAttribute("aria-expanded", "true");
      }

      function closeSidebarMobile() {
        sidebar.classList.remove("open");
        backdrop?.classList.remove("show");
        document.body.style.overflow = "";
        toggleBtn.setAttribute("aria-expanded", "false");
      }

      function applySidebarMode() {
        if (isMobile()) {
          layout.classList.add("sidebar-collapsed");
          layout.classList.remove("sidebar-expanded");
          sidebar.classList.add("collapsed");
          sidebar.classList.remove("expanded");
          toggleBtn.setAttribute("aria-expanded", "false");
          closeSidebarMobile();

          if (billingSubsidebar) {
            billingSubsidebar.classList.add("mobile-closed");
            if (billingSubsidebarToggle) billingSubsidebarToggle.setAttribute("aria-expanded", "false");
          }
        } else {
          layout.classList.add("sidebar-collapsed");
          layout.classList.remove("sidebar-expanded");
          sidebar.classList.add("collapsed");
          sidebar.classList.remove("expanded");
          toggleBtn.setAttribute("aria-expanded", "false");

          if (billingSubsidebar) {
            billingSubsidebar.classList.remove("mobile-closed");
            if (billingSubsidebarToggle) billingSubsidebarToggle.setAttribute("aria-expanded", "true");
          }
        }
      }

      function startClock() {
        function tick() {
          if (!liveClockValue) return;
          liveClockValue.textContent = new Date().toLocaleTimeString("en-GB", {
            hour: "2-digit",
            minute: "2-digit",
            second: "2-digit"
          });
        }

        tick();
        clearInterval(clockTimer);
        clockTimer = setInterval(tick, 1000);
      }

      function normalizeRows(rows) {
        return (Array.isArray(rows) ? rows : []).map((row, index) => {
          const searchBlob = [
            row.id,
            row.full_name,
            row.email,
            row.phone,
            row.city,
            row.country,
            row.last_order_number,
            row.last_payment_status,
            row.last_payment_method
          ]
            .filter(Boolean)
            .join(" ")
            .toLowerCase();

          return {
            _key: `${row.id || index}-${index}`,
            id: row.id || "",
            full_name: row.full_name || "—",
            email: row.email || "—",
            phone: row.phone || "—",
            city: row.city || "—",
            country: row.country || "—",
            total_spent: Number(row.total_spent || 0),
            total_orders_paid: Number(row.total_orders_paid || 0),
            pending_payments: Number(row.pending_payments || 0),
            refund_total: Number(row.refund_total || 0),
            this_month_spent: Number(row.this_month_spent || 0),
            last_order_number: row.last_order_number || row.last_tracking_id || "—",
            last_payment_status: row.last_payment_status || "—",
            last_payment_method: row.last_payment_method || "—",
            updated_at: row.updated_at || row.created_at || null,
            created_at: row.created_at || null,
            search_blob: searchBlob
          };
        });
      }

      function getRows() {
        return normalizeRows(currentRows);
      }

      function getGraphCutoffDate() {
        const range = String(graphRange?.value || "month");
        const today = new Date();
        const cutoff = new Date(today);

        if (range === "recent" || range === "1w") cutoff.setDate(today.getDate() - 7);
        else if (range === "2w") cutoff.setDate(today.getDate() - 14);
        else if (range === "3w") cutoff.setDate(today.getDate() - 21);
        else if (range === "year") cutoff.setFullYear(today.getFullYear() - 1);
        else if (range === "month") cutoff.setMonth(today.getMonth() - 1);
        else return null;

        cutoff.setHours(0, 0, 0, 0);
        return cutoff;
      }

      function filterRows() {
        const rows = getRows();

        const q = String(searchQuery?.value || "").trim().toLowerCase();
        const status = String(statusFilter?.value || "all").toLowerCase();
        const type = String(typeFilter?.value || "all").toLowerCase();
        const from = exportFromDate?.value || "";
        const to = exportToDate?.value || "";
        const cutoff = getGraphCutoffDate();

        return rows.filter((row) => {
          const textMatch = !q || row.search_blob.includes(q);

          const statusMatch =
            status === "all" ||
            String(row.last_payment_status).toLowerCase().includes(status);

          const typeMatch =
            type === "all" ||
            String(row.last_payment_method).toLowerCase().includes(type);

          const rowDate = toDateKey(row.updated_at || row.created_at);
          const fromMatch = !from || rowDate >= from;
          const toMatch = !to || rowDate <= to;
          const graphMatch = !cutoff || (row.updated_at || row.created_at) >= cutoff.toISOString();

          return textMatch && statusMatch && typeMatch && fromMatch && toMatch && graphMatch;
        });
      }

      function updateOverview(filtered) {
        const totalRevenue = filtered.reduce((sum, row) => sum + Number(row.total_spent || 0), 0);
        const refundTotal = filtered.reduce((sum, row) => sum + Number(row.refund_total || 0), 0);
        const pending = filtered.reduce((sum, row) => sum + Number(row.pending_payments || 0), 0);

        const totalRevenueValue = document.getElementById("totalRevenueValue");
        const refundTotalValue = document.getElementById("refundTotalValue");
        const pendingPaymentsValue = document.getElementById("pendingPaymentsValue");
        const totalOrdersValue = document.getElementById("totalOrdersValue");

        if (totalRevenueValue) totalRevenueValue.textContent = money(totalRevenue);
        if (refundTotalValue) refundTotalValue.textContent = money(refundTotal);
        if (pendingPaymentsValue) pendingPaymentsValue.textContent = pending;
        if (totalOrdersValue) totalOrdersValue.textContent = filtered.length;
      }

      function renderDetails(row) {
        if (!selectedBillingDetail) return;

        if (!row) {
          selectedBillingDetail.innerHTML = `<div class="empty-state">Select a billing record.</div>`;
          return;
        }

        selectedBillingDetail.innerHTML = `
          <div class="details-grid">
            <div class="detail-box">
              <div class="k">User ID</div>
              <div class="v">${escapeHtml(row.id)}</div>
            </div>

            <div class="detail-box">
              <div class="k">Name</div>
              <div class="v">${escapeHtml(row.full_name)}</div>
            </div>

            <div class="detail-box">
              <div class="k">Email</div>
              <div class="v">${escapeHtml(row.email)}</div>
            </div>

            <div class="detail-box">
              <div class="k">Phone</div>
              <div class="v">${escapeHtml(row.phone)}</div>
            </div>

            <div class="detail-box">
              <div class="k">City</div>
              <div class="v">${escapeHtml(row.city)}</div>
            </div>

            <div class="detail-box">
              <div class="k">Country</div>
              <div class="v">${escapeHtml(row.country)}</div>
            </div>

            <div class="detail-box">
              <div class="k">Revenue</div>
              <div class="v">${escapeHtml(money(row.total_spent))}</div>
            </div>

            <div class="detail-box">
              <div class="k">Paid Orders</div>
              <div class="v">${escapeHtml(row.total_orders_paid)}</div>
            </div>

            <div class="detail-box">
              <div class="k">Pending</div>
              <div class="v">${escapeHtml(row.pending_payments)}</div>
            </div>

            <div class="detail-box">
              <div class="k">Refunds</div>
              <div class="v">${escapeHtml(money(row.refund_total))}</div>
            </div>

            <div class="detail-box">
              <div class="k">Last Order</div>
              <div class="v">${escapeHtml(row.last_order_number)}</div>
            </div>

            <div class="detail-box">
              <div class="k">Payment Method</div>
              <div class="v">${escapeHtml(row.last_payment_method)}</div>
            </div>

            <div class="detail-box">
              <div class="k">Payment Status</div>
              <div class="v">${escapeHtml(row.last_payment_status)}</div>
            </div>

            <div class="detail-box">
              <div class="k">Updated</div>
              <div class="v">${escapeHtml(formatDateTime(row.updated_at))}</div>
            </div>
          </div>
        `;
      }

      function updatePreviewPanel(filtered) {
        if (exportPreviewCount) {
          exportPreviewCount.textContent = `${filtered.length} records`;
        }

        if (!exportPreviewList) return;

        const rangeValue = String(graphRange?.value || "month");
        const fromValue = exportFromDate?.value || "Any";
        const toValue = exportToDate?.value || "Any";
        const statusValue = String(statusFilter?.value || "all");
        const typeValue = String(typeFilter?.value || "all");

        exportPreviewList.innerHTML = `
          <div class="export-preview-item">
            <div class="k">Selected range</div>
            <div class="v">${escapeHtml(rangeValue)}</div>
          </div>
          <div class="export-preview-item">
            <div class="k">From date</div>
            <div class="v">${escapeHtml(fromValue)}</div>
          </div>
          <div class="export-preview-item">
            <div class="k">To date</div>
            <div class="v">${escapeHtml(toValue)}</div>
          </div>
          <div class="export-preview-item">
            <div class="k">Status</div>
            <div class="v">${escapeHtml(statusValue)}</div>
          </div>
          <div class="export-preview-item">
            <div class="k">Type</div>
            <div class="v">${escapeHtml(typeValue)}</div>
          </div>
        `;
      }

      function renderResults() {
        const filtered = filterRows();

        if (matchedCountLabel) matchedCountLabel.textContent = filtered.length;
        if (visibleCountLabel) visibleCountLabel.textContent = filtered.length;
        if (visibleCountLabelBottom) visibleCountLabelBottom.textContent = filtered.length;

        updateOverview(filtered);

        if (!billingResultsBody || !billingResultsEmpty || !billingResultsTable) return;

        if (!filtered.length) {
          billingResultsTable.classList.add("d-none");
          billingResultsEmpty.classList.remove("d-none");
          billingResultsBody.innerHTML = "";
          renderDetails(null);
          updatePreviewPanel(filtered);
          return;
        }

        billingResultsEmpty.classList.add("d-none");
        billingResultsTable.classList.remove("d-none");

        billingResultsBody.innerHTML = filtered
          .map((row, index) => `
            <tr>
              <td><strong>${escapeHtml(row.full_name)}</strong></td>
              <td>${escapeHtml(row.email)}</td>
              <td>${escapeHtml(row.city)}</td>
              <td>${escapeHtml(money(row.total_spent))}</td>
              <td>${escapeHtml(row.last_order_number)}</td>
              <td>${escapeHtml(row.last_payment_status)}</td>
              <td>${escapeHtml(formatDate(row.updated_at))}</td>
              <td>
                <button type="button" class="btn btn-sm btn-dark js-view-row" data-index="${index}">
                  View
                </button>
              </td>
            </tr>
          `)
          .join("");

        renderDetails(filtered[0]);
        updatePreviewPanel(filtered);
      }

      function updateTrendChart() {
        if (!chartCanvas || typeof Chart === "undefined") return;

        const rows = filterRows();
        const labels = rows.map((r) => formatDate(r.updated_at));
        const values = rows.map((r) => Number(r.total_spent || 0));
        const ctx = chartCanvas.getContext("2d");

        if (chartTrend) chartTrend.destroy();

        chartTrend = new Chart(ctx, {
          type: "line",
          data: {
            labels,
            datasets: [
              {
                label: "Revenue",
                data: values,
                borderWidth: 3,
                tension: 0.35,
                fill: true
              }
            ]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: { display: false }
            },
            scales: {
              x: { ticks: { maxRotation: 0, autoSkip: true } },
              y: { beginAtZero: true }
            }
          }
        });
      }

      function updateMixChart() {
        if (!mixCanvas || typeof Chart === "undefined") return;

        const rows = filterRows();
        const paid = rows.filter((r) => String(r.last_payment_status).toLowerCase().includes("paid")).length;
        const pending = rows.filter((r) => String(r.last_payment_status).toLowerCase().includes("pending")).length;
        const failed = rows.filter((r) => String(r.last_payment_status).toLowerCase().includes("failed")).length;
        const ctx = mixCanvas.getContext("2d");

        if (chartMix) chartMix.destroy();

        chartMix = new Chart(ctx, {
          type: "doughnut",
          data: {
            labels: ["Paid", "Pending", "Failed"],
            datasets: [
              {
                data: [paid, pending, failed]
              }
            ]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: { position: "bottom" }
            }
          }
        });
      }

      async function refreshLiveData(showMessage = true) {
        try {
          setSavingState("saving", "Refreshing...");

          const response = await fetch(realtimeEndpoint, {
            headers: {
              Accept: "application/json",
              "X-Requested-With": "XMLHttpRequest"
            },
            cache: "no-store"
          });

          if (!response.ok) {
            throw new Error("Refresh failed");
          }

          const data = await response.json();
          const payload = data.data || data;

          if (Array.isArray(payload)) {
            currentRows = payload;
          } else {
            if (Array.isArray(payload.data)) currentRows = payload.data;
            if (payload.overview) currentOverview = payload.overview;
            if (payload.chartData) currentChartData = payload.chartData;
          }

          renderResults();
          updateTrendChart();
          updateMixChart();

          if (lastRefreshLabel) {
            lastRefreshLabel.textContent = new Date().toLocaleTimeString("en-GB", {
              hour: "2-digit",
              minute: "2-digit",
              second: "2-digit"
            });
          }

          setSavingState("saved", "Up to date");

          if (showMessage) {
            showToast("Billing data refreshed");
          }
        } catch (err) {
          console.error(err);
          setSavingState("error", "Refresh failed");

          if (showMessage) {
            showToast("Refresh failed");
          }
        }
      }

      function scheduleRefresh() {
        clearInterval(refreshTimer);
        refreshTimer = setInterval(() => {
          refreshLiveData(false);
        }, 20000);
      }

      function buildExportUrl() {
        const url = new URL(exportEndpoint, window.location.origin);

        if (graphRange?.value) url.searchParams.set("range", graphRange.value);
        if (searchQuery?.value) url.searchParams.set("q", searchQuery.value.trim());
        if (statusFilter?.value) url.searchParams.set("status", statusFilter.value);
        if (typeFilter?.value) url.searchParams.set("type", typeFilter.value);
        if (exportFromDate?.value) url.searchParams.set("from", exportFromDate.value);
        if (exportToDate?.value) url.searchParams.set("to", exportToDate.value);

        return url.toString();
      }

      function openExportDrawer() {
        exportDrawer?.classList.add("show");
        exportDrawerOverlay?.classList.add("show");
        document.body.style.overflow = "hidden";
      }

      function closeExportDrawer() {
        exportDrawer?.classList.remove("show");
        exportDrawerOverlay?.classList.remove("show");
        document.body.style.overflow = isMobile() && sidebar.classList.contains("open") ? "hidden" : "";
      }

      function applyExportFiltersToMainUI() {
        renderResults();
        updateTrendChart();
        updateMixChart();
      }

      function syncExportDrawerFromCurrentFilters() {
        if (exportRange && graphRange) exportRange.value = graphRange.value;
        if (exportFromDate && graphRange && graphRange.value === "custom") exportFromDate.value = exportFromDate.value || "";
        if (exportToDate && graphRange && graphRange.value === "custom") exportToDate.value = exportToDate.value || "";
        if (exportPreviewCount) {
          updatePreviewPanel(filterRows());
        }
      }

      function setGraphRangePreset() {
        const value = String(graphRange?.value || "month");
        const now = new Date();

        if (value === "custom" || value === "all") {
          if (graphRangeLabel) graphRangeLabel.textContent = value;
          return;
        }

        const from = new Date(now);
        if (value === "recent" || value === "1w") from.setDate(now.getDate() - 7);
        if (value === "2w") from.setDate(now.getDate() - 14);
        if (value === "3w") from.setDate(now.getDate() - 21);
        if (value === "month") from.setMonth(now.getMonth() - 1);
        if (value === "year") from.setFullYear(now.getFullYear() - 1);

        from.setHours(0, 0, 0, 0);

        if (exportFromDate) exportFromDate.value = from.toISOString().slice(0, 10);
        if (exportToDate) exportToDate.value = now.toISOString().slice(0, 10);

        if (graphRangeLabel) graphRangeLabel.textContent = value;
      }

      function wireEvents() {
        [
          searchQuery,
          statusFilter,
          typeFilter,
          exportFromDate,
          exportToDate
        ].forEach((el) => {
          el?.addEventListener("input", handleFilter);
          el?.addEventListener("change", handleFilter);
        });

        function handleFilter() {
          renderResults();
          updateTrendChart();
          updateMixChart();
          syncExportDrawerFromCurrentFilters();
        }

        clearLiveFiltersBtn?.addEventListener("click", () => {
          if (searchQuery) searchQuery.value = "";
          if (statusFilter) statusFilter.value = "all";
          if (typeFilter) typeFilter.value = "all";
          if (exportFromDate) exportFromDate.value = "";
          if (exportToDate) exportToDate.value = "";
          if (graphRange) graphRange.value = "month";
          if (graphRangeLabel) graphRangeLabel.textContent = "month";

          renderResults();
          updateTrendChart();
          updateMixChart();
          syncExportDrawerFromCurrentFilters();
        });

        graphRange?.addEventListener("change", () => {
          setGraphRangePreset();
          handleFilter();
        });

        refreshLiveBtn?.addEventListener("click", () => {
          refreshLiveData(true);
        });

        billingResultsBody?.addEventListener("click", (e) => {
          const btn = e.target.closest(".js-view-row");
          if (!btn) return;

          const index = Number(btn.dataset.index);
          const row = filterRows()[index];
          if (!row) return;

          renderDetails(row);
          showToast(`Selected ${row.full_name}`);
        });

        toggleBtn.addEventListener("click", () => {
          if (isMobile()) {
            const open = sidebar.classList.contains("open");
            if (open) closeSidebarMobile();
            else openSidebarMobile();
            return;
          }

          const expanded = layout.classList.toggle("sidebar-expanded");
          layout.classList.toggle("sidebar-collapsed", !expanded);
          sidebar.classList.toggle("collapsed", !expanded);
          sidebar.classList.toggle("expanded", expanded);
          toggleBtn.setAttribute("aria-expanded", expanded ? "true" : "false");
        });

        backdrop?.addEventListener("click", closeSidebarMobile);
        closeBtn?.addEventListener("click", closeSidebarMobile);

        document.addEventListener("click", (e) => {
          const link = e.target.closest(".account-nav-link");
          if (link && isMobile()) closeSidebarMobile();
        });

        window.addEventListener("resize", applySidebarMode);

        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") {
            closeSidebarMobile();
            closeExportDrawer();
          }
        });

        openExportDrawerBtn?.addEventListener("click", () => {
          openExportDrawer();
        });

        exportPdfBtn?.addEventListener("click", () => {
          window.location.href = buildExportUrl();
        });

        exportDrawerOverlay?.addEventListener("click", closeExportDrawer);
        closeExportDrawerBtn?.addEventListener("click", closeExportDrawer);

        applyExportFiltersBtn?.addEventListener("click", () => {
          applyExportFiltersToMainUI();
          closeExportDrawer();
          showToast("Filters applied");
        });

        exportDrawerPdfBtn?.addEventListener("click", () => {
          applyExportFiltersToMainUI();
          window.location.href = buildExportUrl();
        });

        billingSubsidebarToggle?.addEventListener("click", () => {
          const mobile = isMobile();
          const open = !billingSubsidebar?.classList.contains("mobile-closed");

          if (mobile) {
            billingSubsidebar.classList.toggle("mobile-closed", open);
            billingSubsidebarToggle.setAttribute("aria-expanded", open ? "false" : "true");
          } else {
            billingSubsidebar.classList.toggle("mobile-closed", open);
            billingSubsidebarToggle.setAttribute("aria-expanded", open ? "false" : "true");
          }
        });
      }

      function init() {
        startClock();
        applySidebarMode();
        wireEvents();

        setGraphRangePreset();
        renderResults();
        updateTrendChart();
        updateMixChart();
        syncExportDrawerFromCurrentFilters();

        setSavingState("saved", "All data loaded");
        scheduleRefresh();

        if (graphRangeLabel) {
          graphRangeLabel.textContent = graphRange?.value || "month";
        }

        if (typeof Chart === "undefined") {
          console.warn("Chart.js is not loaded.");
        }
      }

      init();
    })();
  </script>

  <script src="/customer/js/vendor/popper.min.js"></script>
  <script src="/customer/js/bootstrap.min.js"></script>
  <script src="/customer/js/main.js"></script>
</body>
</html>

