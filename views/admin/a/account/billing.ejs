      ? d.toLocaleDateString("en-GB", {
          day: "2-digit",
          month: "short",
          year: "numeric",
        })
      : "Not available";
  };

  const safeJson = (v, fallback = {}) => {
    try {
      return JSON.stringify(v ?? fallback);
    } catch (err) {
      return JSON.stringify(fallback);
    }
  };

  const normalizeRole = (role = "") => {
    return String(role)
