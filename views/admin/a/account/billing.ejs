  const safeDate = (v) => {
    const d = new Date(v);
    return Number.isNaN(d.getTime()) ? null : d;
  };

  const fmtDateTime = (v) => {
    const d = safeDate(v);

    return d
      ? d.toLocaleString("en-GB", {
          day: "2-digit",
          month: "short",
          year: "numeric",
          hour: "2-digit",
          minute: "2-digit",
        })
      : "Not available";
  };

  const fmtDate = (v) => {
    const d = safeDate(v);

