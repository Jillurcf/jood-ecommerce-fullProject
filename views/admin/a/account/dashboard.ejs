                      <th width="130">Visits</th>
                      <th width="170">First Visit</th>
                      <th width="170">Last Visit</th>
                      <th width="140">IP</th>
                      <th width="120">Action</th>
                    </tr>
                  </thead>

                  <tbody id="visitorTableBody">
                    <tr>
                      <td colspan="7" class="text-center text-muted py-4">No data loaded yet.</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>

          <div class="modal-footer d-flex justify-content-between">
            <div class="text-muted small" id="visitorListFooter">Ready</div>
            <div class="page-nav">
              <button type="button" class="btn btn-outline-secondary btn-sm" id="visitorPrevBtn" disabled>Prev</button>
              <button type="button" class="btn btn-outline-secondary btn-sm" id="visitorNextBtn" disabled>Next</button>
              <button type="button" class="btn btn-outline-secondary btn-sm" id="reloadVisitorsBtn">Reload</button>
              <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="modal fade" id="visitorDetailModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered modal-xxl modal-xxl-custom">
        <div class="modal-content">
          <div class="modal-header">
            <div>
              <h5 class="modal-title mb-1">Visitor Detail</h5>
              <div class="text-muted small" id="visitorDetailSubtitle">
                Select a visitor to see their visit timeline.
              </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>

          <div class="modal-body">
            <div id="visitorDetailLoading" class="dashboard-empty d-none">
              <i class="fa fa-spinner fa-spin fa-2x mb-3"></i>
              <div>Loading visit history...</div>
            </div>

            <div id="visitorDetailEmpty" class="dashboard-empty">
              <i class="fa fa-user fa-2x mb-3"></i>
              <div>Open a visitor from the list to display the full visit history.</div>
            </div>

            <div id="visitorDetailContent" class="d-none">
              <div class="row g-3 mb-3">
                <div class="col-12 col-md-3">
                  <div class="summary-card">
                    <h6>Visitor Key</h6>
                    <div class="value" style="font-size:18px; word-break: break-all;" id="detailVisitorKey">—</div>
                  </div>
                </div>

                <div class="col-12 col-md-3">
                  <div class="summary-card">
                    <h6>Total Visits</h6>
                    <div class="value" id="detailTotalVisits">0</div>
                  </div>
                </div>

                <div class="col-12 col-md-3">
                  <div class="summary-card">
                    <h6>First Visit</h6>
                    <div class="value" style="font-size:16px;" id="detailFirstVisit">—</div>
                  </div>
                </div>

                <div class="col-12 col-md-3">
                  <div class="summary-card">
                    <h6>Last Visit</h6>
                    <div class="value" style="font-size:16px;" id="detailLastVisit">—</div>
                  </div>
                </div>
              </div>

              <div class="summary-card mb-3">
                <h6>Summary</h6>
                <div class="detail-pill"><i class="fa fa-globe"></i> IP: <span id="detailIp">—</span></div>
                <div class="detail-pill"><i class="fa fa-link"></i> Last URL: <span id="detailLastUrl">—</span></div>
                <div class="detail-pill"><i class="fa fa-desktop"></i> User Agent: <span id="detailUserAgent">—</span></div>
              </div>

              <div class="summary-card">
                <h6>Pages Visited</h6>
                <div class="table-responsive">
                  <table class="table table-striped table-hover table-visits align-middle mb-0">
                    <thead>
                      <tr>
                        <th width="90">#</th>
                        <th width="180">Visited At</th>
                        <th width="110">Method</th>
                        <th width="320">URL</th>
                        <th>User Agent</th>
                      </tr>
                    </thead>
                    <tbody id="detailVisitsBody">
                      <tr>
                        <td colspan="5" class="text-center text-muted py-4">No data loaded yet.</td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>

          <div class="modal-footer d-flex justify-content-between">
            <div class="text-muted small" id="detailFooterText">Ready</div>
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
          </div>
        </div>
      </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>

    <script>
      (() => {
          "use strict";

          const $ = (selector, root = document) => root.querySelector(selector);
          const $$ = (selector, root = document) => Array.from(root.querySelectorAll(selector));

          const els = {
            layout: $("#accountLayout"),
            sidebar: $("#accountSidebar"),
            toggleBtn: $("#accountToggleBtn"),
            backdrop: $("#accountBackdrop"),
            topbar: $(".account-topbar"),

            visitorTrendChart: $("#visitorTrendChart"),
            chartRangeSwitcher: $("#rangeSwitcher"),
            chartRangeLabel: $("#chartRangeLabel"),
            chartSummaryText: $("#chartSummaryText"),
            chartLiveState: $("#chartLiveState"),
            chartUpdatedAt: $("#chartUpdatedAt"),
            refreshChartBtn: $("#refreshChartBtn"),
            tinyGraph: $("#tinyGraph"),

            openVisitorListBtn: $("#openVisitorListBtn"),
            visitorListModalEl: $("#visitorListModal"),
            visitorDetailModalEl: $("#visitorDetailModal"),

            visitorListCountText: $("#visitorListCountText"),
            visitorListLoading: $("#visitorListLoading"),
            visitorListError: $("#visitorListError"),
            visitorListEmpty: $("#visitorListEmpty"),
            visitorListWrap: $("#visitorListWrap"),
            visitorTableBody: $("#visitorTableBody"),
            visitorPrevBtn: $("#visitorPrevBtn"),
            visitorNextBtn: $("#visitorNextBtn"),
            reloadVisitorsBtn: $("#reloadVisitorsBtn"),
            visitorListFooter: $("#visitorListFooter"),
            modalTotalVisitors: $("#modalTotalVisitors"),
            modalTotalPageVisits: $("#modalTotalPageVisits"),
            modalPage: $("#modalPage"),
            modalTotalPages: $("#modalTotalPages"),
            modalRowsCount: $("#modalRowsCount"),

            visitorDetailLoading: $("#visitorDetailLoading"),
            visitorDetailEmpty: $("#visitorDetailEmpty"),
            visitorDetailContent: $("#visitorDetailContent"),
            visitorDetailSubtitle: $("#visitorDetailSubtitle"),
            detailVisitorKey: $("#detailVisitorKey"),
            detailTotalVisits: $("#detailTotalVisits"),
            detailFirstVisit: $("#detailFirstVisit"),
            detailLastVisit: $("#detailLastVisit"),
            detailIp: $("#detailIp"),
            detailLastUrl: $("#detailLastUrl"),
            detailUserAgent: $("#detailUserAgent"),
            detailVisitsBody: $("#detailVisitsBody"),
            detailFooterText: $("#detailFooterText"),

            orderSearchInput: $("#orderSearchInput"),
            orderFilterBar: $("#orderFilterBar"),
            ordersTableBody: $("#ordersTableBody"),
            ordersShown: $("#ordersShown"),
            ordersRefreshState: $("#ordersRefreshState"),
            ordersPagination: $("#ordersPagination"),
            orderChartRange: $("#orderChartRange"),
            ordersChart: $("#ordersChart"),
            ordersChartState: $("#ordersChartState"),

            txSearch: $("#txSearch"),
            txStatus: $("#txStatus"),
            txFrom: $("#txFrom"),
            txTo: $("#txTo"),
            txApply: $("#txApply"),
            txTableBody: $("#txTableBody"),
            txMeta: $("#txMeta"),
            txRefreshState: $("#txRefreshState"),
            txPagination: $("#txPagination"),
            txChartRange: $("#txChartRange"),
            txChart: $("#txChart"),
            txChartState: $("#txChartState"),
          };

          if (!els.layout || !els.sidebar || !els.toggleBtn) return;

          const CFG = {
            sidebarWide: 280,
            sidebarCollapsed: 78,
            mobileBreakpoint: 991,
            ordersPageSize: 8,
            txPageSize: 8,
            visitorPageSize: 10,
            refreshIntervalMs: 20000,
            currencyFallback: "AED",
            visitorListApi: window.__VISITOR_LIST_API__ || window.__VISITOR_API__ || "",
            visitorDetailApi: window.__VISITOR_DETAIL_API__ || "",
            dashboardRefreshApi: window.__DASHBOARD_REFRESH_API__ || "",
          };

          const state = {
            orders: {
              all: normalizeOrders(window.__INITIAL_ORDERS__ || []),
              filtered: [],
              page: 1,
              pageSize: CFG.ordersPageSize,
              section: "all",
              search: "",
            },
            tx: {
              all: normalizeTransactions(window.__TX_INITIAL_ROWS__ || []),
              filtered: [],
              page: 1,
              pageSize: CFG.txPageSize,
              search: "",
              status: "",
              from: "",
              to: "",
            },
            visitors: {
              rows: [],
              page: 1,
              totalPages: 1,
              totalRows: 0,
              totalVisitors: Number($("#modalTotalVisitors")?.textContent || 0) || 0,
              totalPageVisits: Number($("#modalTotalPageVisits")?.textContent || 0) || 0,
              activeKey: "",
              activeRow: null,
            },
            charts: {
              visitorRange: "day",
              ordersRange: String(els.orderChartRange?.value || "week"),
              txRange: String(els.txChartRange?.value || "week"),
              visitorChart: null,
              ordersChart: null,
              txChart: null,
            },
            timers: {
              refresh: null,
              clock: null,
              orderSearch: null,
              txSearch: null,
            },
            ui: {
              mobileSidebarOpen: false,
              detailModalOpen: false,
              listModalOpen: false,
            },
          };

          const visitorListModal = getBootstrapModal(els.visitorListModalEl);
          const visitorDetailModal = getBootstrapModal(els.visitorDetailModalEl);


          init();

          function init() {
            initLayout();
            initClock();
            initOrders();
            initTransactions();
            initCharts();
            initVisitors();
            initGlobalEvents();
            scheduleAutoRefresh();

            renderOrders();
            renderTransactions();
            renderVisitorChart(state.charts.visitorRange);
            renderOrdersChart(state.charts.ordersRange);
            renderTxChart(state.charts.txRange);

            updateClockLabels();
          }

          function initLayout() {
            const mobile = isMobile();
            if (mobile) {
              els.layout.classList.remove("sidebar-expanded");
              els.layout.classList.remove("sidebar-collapsed");
              els.sidebar.classList.remove("collapsed");
              els.sidebar.classList.remove("open");
              els.backdrop?.classList.remove("show");
              els.toggleBtn.setAttribute("aria-expanded", "false");
              document.body.style.overflow = "";
            } else {
              els.layout.classList.add("sidebar-expanded");
              els.layout.classList.remove("sidebar-collapsed");
              els.sidebar.classList.remove("open");
              els.sidebar.classList.remove("collapsed");
              els.backdrop?.classList.remove("show");
              els.toggleBtn.setAttribute("aria-expanded", "true");
              document.body.style.overflow = "";
            }

            els.toggleBtn.addEventListener("click", () => {
              if (isMobile()) {
                if (els.sidebar.classList.contains("open")) {
                  closeMobileSidebar();
                } else {
                  openMobileSidebar();
                }
                return;
              }

              const collapsed = els.layout.classList.contains("sidebar-collapsed");
              if (collapsed) {
                els.layout.classList.remove("sidebar-collapsed");
                els.layout.classList.add("sidebar-expanded");
                els.sidebar.classList.remove("collapsed");
                els.toggleBtn.setAttribute("aria-expanded", "true");
              } else {
                els.layout.classList.add("sidebar-collapsed");
                els.layout.classList.remove("sidebar-expanded");
                els.sidebar.classList.add("collapsed");
                els.toggleBtn.setAttribute("aria-expanded", "false");
              }
            });

            els.backdrop?.addEventListener("click", closeMobileSidebar);

            window.addEventListener("resize", () => {
              if (isMobile()) {
                els.layout.classList.remove("sidebar-collapsed");
                els.layout.classList.remove("sidebar-expanded");
                els.sidebar.classList.remove("collapsed");
                els.sidebar.classList.remove("open");
                els.backdrop?.classList.remove("show");
                document.body.style.overflow = "";
                els.toggleBtn.setAttribute("aria-expanded", "false");
              } else {
                els.sidebar.classList.remove("open");
                els.backdrop?.classList.remove("show");
                document.body.style.overflow = "";
                if (!els.layout.classList.contains("sidebar-collapsed")) {
                  els.layout.classList.add("sidebar-expanded");
                }
                els.toggleBtn.setAttribute("aria-expanded", els.layout.classList.contains("sidebar-collapsed") ? "false" : "true");
              }
            });

            document.addEventListener("keydown", (e) => {
              if (e.key === "Escape") {
                closeMobileSidebar();
                if (visitorListModal?.isShown()) visitorListModal.hide();
                if (visitorDetailModal?.isShown()) visitorDetailModal.hide();
              }
            });
          }

          function openMobileSidebar() {
            els.sidebar.classList.add("open");
            els.backdrop?.classList.add("show");
            document.body.style.overflow = "hidden";
            els.toggleBtn.setAttribute("aria-expanded", "true");
          }

          function closeMobileSidebar() {
            els.sidebar.classList.remove("open");
            els.backdrop?.classList.remove("show");
            if (!document.querySelector(".modal.show")) {
              document.body.style.overflow = "";
            }
            els.toggleBtn.setAttribute("aria-expanded", "false");
          }

          function initClock() {
            const tick = () => {
              updateClockLabels();
            };
            tick();
            clearInterval(state.timers.clock);
            state.timers.clock = setInterval(tick, 1000);
          }

          function updateClockLabels() {
            if (els.chartUpdatedAt) {
              els.chartUpdatedAt.textContent = `Last updated: ${new Date().toLocaleTimeString("en-GB", {
        hour: "2-digit",
        minute: "2-digit",
        second: "2-digit",
      })}`;
            }
          }

          function initOrders() {
            state.orders.filtered = [...state.orders.all];

            els.orderSearchInput?.addEventListener("input", debounce(() => {
              state.orders.search = String(els.orderSearchInput.value || "").trim().toLowerCase();
              state.orders.page = 1;
              renderOrders();
              renderOrdersChart(state.charts.ordersRange);
            }, 150));

            els.orderFilterBar?.addEventListener("click", (e) => {
              const btn = e.target.closest(".filter-chip");
              if (!btn) return;

              $$(".filter-chip", els.orderFilterBar).forEach((chip) => chip.classList.remove("is-active"));
              btn.classList.add("is-active");

              state.orders.section = String(btn.dataset.section || "all");
              state.orders.page = 1;
              renderOrders();
              renderOrdersChart(state.charts.ordersRange);
            });

            els.ordersPagination?.addEventListener("click", (e) => {
              const btn = e.target.closest("[data-page]");
              if (!btn) return;
              const page = Number(btn.dataset.page || 1);
              if (!Number.isFinite(page)) return;
              state.orders.page = page;
              renderOrders();
            });

            els.orderChartRange?.addEventListener("change", () => {
              state.charts.ordersRange = String(els.orderChartRange.value || "week");
              renderOrdersChart(state.charts.ordersRange);
            });
          }

          function initTransactions() {
            state.tx.filtered = [...state.tx.all];

            const applyTxFilters = () => {
              state.tx.search = String(els.txSearch?.value || "").trim().toLowerCase();
              state.tx.status = String(els.txStatus?.value || "").trim().toLowerCase();
              state.tx.from = String(els.txFrom?.value || "").trim();
              state.tx.to = String(els.txTo?.value || "").trim();
              state.tx.page = 1;
              renderTransactions();
              renderTxChart(state.charts.txRange);
            };

            els.txSearch?.addEventListener("input", debounce(applyTxFilters, 150));
            els.txStatus?.addEventListener("change", applyTxFilters);
            els.txFrom?.addEventListener("change", applyTxFilters);
            els.txTo?.addEventListener("change", applyTxFilters);
            els.txApply?.addEventListener("click", applyTxFilters);

            els.txPagination?.addEventListener("click", (e) => {
              const btn = e.target.closest("[data-page]");
              if (!btn) return;
              const page = Number(btn.dataset.page || 1);
              if (!Number.isFinite(page)) return;
              state.tx.page = page;
              renderTransactions();
            });

            els.txChartRange?.addEventListener("change", () => {
              state.charts.txRange = String(els.txChartRange.value || "week");
              renderTxChart(state.charts.txRange);
            });
          }

          function initCharts() {
            els.refreshChartBtn?.addEventListener("click", async () => {
              await refreshDashboardSnapshot();
              renderVisitorChart(state.charts.visitorRange);
              renderOrdersChart(state.charts.ordersRange);
              renderTxChart(state.charts.txRange);
              flashChartStatus("Chart refreshed");
            });

            els.chartRangeSwitcher?.addEventListener("click", (e) => {
              const btn = e.target.closest(".range-btn");
              if (!btn) return;

              $$(".range-btn", els.chartRangeSwitcher).forEach((b) => b.classList.remove("active"));
              btn.classList.add("active");

              state.charts.visitorRange = String(btn.dataset.range || "day");
              renderVisitorChart(state.charts.visitorRange);
            });
          }

          function initVisitors() {
            els.openVisitorListBtn?.addEventListener("click", async () => {
              showVisitorListModal();
              await loadVisitorPage(1);
            });

            els.reloadVisitorsBtn?.addEventListener("click", async () => {
              await loadVisitorPage(state.visitors.page || 1);
            });

            els.visitorPrevBtn?.addEventListener("click", async () => {
              if (state.visitors.page > 1) {
                await loadVisitorPage(state.visitors.page - 1);
              }
            });

            els.visitorNextBtn?.addEventListener("click", async () => {
              if (state.visitors.page < state.visitors.totalPages) {
                await loadVisitorPage(state.visitors.page + 1);
              }
            });

            els.visitorTableBody?.addEventListener("click", (e) => {
              const btn = e.target.closest("[data-visitor-key]");
              if (!btn) return;
              const key = String(btn.dataset.visitorKey || "");
              const row = state.visitors.rows.find((r) => String(r.visitorKey) === key) || null;
              if (!row) return;
              openVisitorDetail(row);
            });

            if (visitorListModal) {
              const modalEl = els.visitorListModalEl;
              modalEl?.addEventListener("hidden.bs.modal", () => {
                state.ui.listModalOpen = false;
              });
              modalEl?.addEventListener("shown.bs.modal", () => {
                state.ui.listModalOpen = true;
              });
            }

            if (visitorDetailModal) {
              const modalEl = els.visitorDetailModalEl;
              modalEl?.addEventListener("hidden.bs.modal", () => {
                state.ui.detailModalOpen = false;
                state.visitors.activeKey = "";
                state.visitors.activeRow = null;
                if (els.visitorDetailEmpty) els.visitorDetailEmpty.classList.remove("d-none");
                if (els.visitorDetailContent) els.visitorDetailContent.classList.add("d-none");
              });
              modalEl?.addEventListener("shown.bs.modal", () => {
                state.ui.detailModalOpen = true;
              });
            }
          }

          function initGlobalEvents() {
            document.addEventListener("click", (e) => {
              const rowBtn = e.target.closest(".js-open-visitor-detail");
              if (rowBtn) {
                const key = String(rowBtn.dataset.visitorKey || "");
                const row = state.visitors.rows.find((r) => String(r.visitorKey) === key) || null;
                if (row) openVisitorDetail(row);
              }
            });
          }

          async function refreshDashboardSnapshot() {
