  function getVisitorSeries(range) {
    const serverSeries = window.__VISITOR_TREND__ || window.__VISITOR_SERIES__ || null;

    if (serverSeries && typeof serverSeries === "object") {
      const candidate = serverSeries[range] || serverSeries[String(range)] || serverSeries.default;
      const normalized = normalizeSeries(candidate);
      if (normalized.values.length) return normalized;
    }

    const tinyValues = readTinyGraphValues();
    const fallback = tinyValues.length ? tinyValues : [5, 12, 18, 14, 20, 16, 22];
    return {
      labels: buildGenericLabels(range, fallback.length),
      values: fallback,
    };
  }

  function getOrdersSeries(range, rows) {
    const serverWeekly = normalizeSeries(window.__ORDER_WEEKLY_SERIES__);
    const serverMonthly = normalizeSeries(window.__ORDER_MONTHLY_SERIES__);
    const serverYearly = normalizeSeries(window.__ORDER_YEARLY_SERIES__);

    if (range === "week" && serverWeekly.values.length) return serverWeekly;
    if (range === "month" && serverMonthly.values.length) return serverMonthly;
    if (range === "year" && serverYearly.values.length) return serverYearly;

    return aggregateRevenueSeries(rows, range);
  }

  function getTxSeries(range, rows) {
    const serverDaily = normalizeSeries(window.__TX_DAILY_SERIES__);
    const serverWeekly = normalizeSeries(window.__TX_WEEKLY_SERIES__);
    const serverMonthly = normalizeSeries(window.__TX_MONTHLY_SERIES__);
    const serverYearly = normalizeSeries(window.__TX_YEARLY_SERIES__);

    if (range === "day" && serverDaily.values.length) return serverDaily;
    if (range === "week" && serverWeekly.values.length) return serverWeekly;
    if (range === "month" && serverMonthly.values.length) return serverMonthly;
    if (range === "year" && serverYearly.values.length) return serverYearly;

    return aggregateRevenueSeries(rows, range);
  }

  function aggregateRevenueSeries(rows, range) {
    const items = rows
      .map((row) => ({
        amount: Number(getRowAmount(row)),
        date: toDateObject(getRowDate(row)),
      }))
      .filter((item) => item.date && !Number.isNaN(item.date.getTime()));

    if (!items.length) {
      return {
        labels: buildGenericLabels(range, 7),
        values: new Array(7).fill(0),
      };
    }

    let bucketFn;
    let labels = [];
    let values = [];

    if (range === "year") {
      const map = new Map();
      items.forEach(({ amount, date }) => {
        const key = `
      $ {
        date.getFullYear()
      } - $ {
        String(date.getMonth() + 1).padStart(2, "0")
      }
      `;
        map.set(key, (map.get(key) || 0) + amount);
      });

      const sorted = [...map.entries()].sort((a, b) => a[0].localeCompare(b[0]));
      labels = sorted.map(([key]) => key);
      values = sorted.map(([, value]) => Number(value.toFixed(2)));
      return { labels, values };
    }

    if (range === "month") {
      const map = new Map();
      items.forEach(({ amount, date }) => {
        const key = date.toISOString().slice(0, 10);
        map.set(key, (map.get(key) || 0) + amount);
      });

      const sorted = [...map.entries()].sort((a, b) => a[0].localeCompare(b[0])).slice(-31);
      labels = sorted.map(([key]) => key.slice(5));
      values = sorted.map(([, value]) => Number(value.toFixed(2)));
      return { labels, values };
    }

    if (range === "week") {
      const map = new Map();
      items.forEach(({ amount, date }) => {
        const key = date.toISOString().slice(0, 10);
        map.set(key, (map.get(key) || 0) + amount);
      });

      const sorted = [...map.entries()].sort((a, b) => a[0].localeCompare(b[0])).slice(-7);
      labels = sorted.map(([key]) => key.slice(5));
      values = sorted.map(([, value]) => Number(value.toFixed(2)));
      return { labels, values };
    }

    bucketFn = (date) => {
      const hour = date.getHours();
      return `
      $ {
        String(hour).padStart(2, "0")
      }: 00`;
    };

    const map = new Map();
    items.forEach(({ amount, date }) => {
      const key = bucketFn(date);
      map.set(key, (map.get(key) || 0) + amount);
    });

    const sorted = [...map.entries()].sort((a, b) => a[0].localeCompare(b[0]));
    labels = sorted.map(([key]) => key);
    values = sorted.map(([, value]) => Number(value.toFixed(2)));

    if (!labels.length) {
      return {
        labels: buildGenericLabels(range, 7),
        values: new Array(7).fill(0),
      };
    }

    return { labels, values };
  }

  async function loadVisitorPage(page = 1) {
    if (!CFG.visitorListApi) {
      renderVisitorListError("Visitor list API is not configured.");
      return;
    }

    renderVisitorListLoading(true);

    try {
      const url = new URL(CFG.visitorListApi, window.location.origin);
      url.searchParams.set("page", String(page));

      const res = await fetch(url.toString(), {
        headers: {
          Accept: "application/json",
          "X-Requested-With": "XMLHttpRequest",
        },
        cache: "no-store",
      });

      if (!res.ok) throw new Error(`
      Visitor list request failed($ {
        res.status
      })`);

      const json = await res.json();
      const payload = json.data || json;

      const rows = extractRows(payload);
      const pagination = payload.pagination || json.pagination || {};
      const summary = payload.summary || json.summary || {};

      state.visitors.rows = normalizeVisitorRows(rows);
      state.visitors.page = Number(pagination.page || page || 1);
      state.visitors.totalPages = Number(pagination.totalPages || pagination.total_pages || 1);
      state.visitors.totalRows = Number(pagination.total || pagination.totalRows || state.visitors.rows.length);
      state.visitors.totalVisitors = Number(summary.totalVisitors || summary.total_visitors || state.visitors.totalVisitors);
      state.visitors.totalPageVisits = Number(summary.totalPageVisits || summary.total_page_visits || state.visitors.totalPageVisits);

      renderVisitorListRows();
      renderVisitorSummaryCards();

      if (els.visitorListFooter) {
        els.visitorListFooter.textContent = `
      Page $ {
        state.visitors.page
      } of $ {
        state.visitors.totalPages
      }
      `;
      }

      renderVisitorListLoading(false);
      renderVisitorListError("");
      renderVisitorListEmptyIfNeeded();

    } catch (err) {
      console.error(err);
      renderVisitorListLoading(false);
      renderVisitorListError("Failed to load visitor data.");
    }
  }

