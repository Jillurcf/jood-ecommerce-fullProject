        <
        button
      type = "button"
      class = "btn btn-sm btn-dark js-open-visitor-detail"
      data - visitor - key = "${escapeHtml(row.visitorKey)}" >
        View <
        /button> <
        /td> <
        /tr>
      `).join("");

    if (els.visitorPrevBtn) els.visitorPrevBtn.disabled = state.visitors.page <= 1;
    if (els.visitorNextBtn) els.visitorNextBtn.disabled = state.visitors.page >= state.visitors.totalPages;
  }

  function renderVisitorSummaryCards() {
    if (els.modalTotalVisitors) els.modalTotalVisitors.textContent = String(state.visitors.totalVisitors || 0);
    if (els.modalTotalPageVisits) els.modalTotalPageVisits.textContent = String(state.visitors.totalPageVisits || 0);
    if (els.modalPage) els.modalPage.textContent = String(state.visitors.page || 1);
    if (els.modalTotalPages) els.modalTotalPages.textContent = String(state.visitors.totalPages || 1);
  }

  function renderVisitorListLoading(show) {
    els.visitorListLoading?.classList.toggle("d-none", !show);
  }

  function renderVisitorListError(message) {
    if (!els.visitorListError) return;
    if (message) {
      els.visitorListError.textContent = message;
      els.visitorListError.classList.remove("d-none");
    } else {
      els.visitorListError.textContent = "";
      els.visitorListError.classList.add("d-none");
    }
  }

  function renderVisitorListEmptyIfNeeded() {
    const hasData = state.visitors.rows.length > 0;
    els.visitorListWrap?.classList.toggle("d-none", !hasData);
    els.visitorListEmpty?.classList.toggle("d-none", hasData);
  }

  function renderVisitorDetailLoading(show) {
    els.visitorDetailLoading?.classList.toggle("d-none", !show);
  }

  function renderVisitorDetailEmpty(show) {
    els.visitorDetailEmpty?.classList.toggle("d-none", !show);
    els.visitorDetailContent?.classList.toggle("d-none", show);
  }

  async function loadVisitorListIfNeeded() {
    if (state.visitors.rows.length) {
      renderVisitorListRows();
      renderVisitorSummaryCards();
      renderVisitorListEmptyIfNeeded();
      return;
    }
    await loadVisitorPage(1);
  }

  function flashChartStatus(text) {
    if (els.chartLiveState) els.chartLiveState.textContent = text;
    updateClockLabels();
    window.clearTimeout(flashChartStatus._timer);
    flashChartStatus._timer = window.setTimeout(() => {
      if (els.chartLiveState) els.chartLiveState.textContent = "Live updating";
    }, 1800);
  }

  function scheduleAutoRefresh() {
    clearInterval(state.timers.refresh);
    state.timers.refresh = setInterval(async () => {
      await refreshDashboardSnapshot();
      renderOrders();
      renderTransactions();
    }, CFG.refreshIntervalMs);
  }

  function matchesOrderSection(row, section) {
    if (!section || section === "all") return true;
    const status = getOrderStatus(row);
    const payment = String(row.payment_status || row.payment_method || "").toLowerCase();

    if (section === "pending" || section === "new") {
      return status.includes("pending") || payment.includes("pending") || payment.includes("new");
    }

    return status.includes(section) || payment.includes(section);
  }

  function isUnseenOrder(row) {
    return toBool(row.is_unseen ?? row.unseen ?? row.seen ?? row.viewed);
  }

  function isUnseenTx(row) {
    return toBool(row.is_unseen ?? row.unseen ?? row.seen ?? row.viewed);
  }

  function getOrderRef(row) {
    return String(row.ref || row.order_ref || row.order_number || row.reference || row.id || row.order_id || "—");
  }

  function getTxRef(row) {
    return String(row.ref || row.tx_ref || row.transaction_ref || row.order_number || row.order_ref || row.id || row.transaction_id || "—");
  }

  function getOrderAmount(row) {
    return Number(row.amount ?? row.total ?? row.grand_total ?? row.total_amount ?? row.subtotal ?? 0);
  }

  function getTxAmount(row) {
    return Number(row.amount ?? row.total ?? row.grand_total ?? row.total_amount ?? 0);
  }

  function getOrderCurrency(row) {
    return String(row.currency || row.currency_code || row.payment_currency || CFG.currencyFallback);
  }

  function getTxCurrency(row) {
    return String(row.currency || row.currency_code || row.payment_currency || CFG.currencyFallback);
  }

  function getOrderDate(row) {
    return formatDateTime(getRowDate(row));
  }

  function getTxDate(row) {
    return formatDateTime(getRowDate(row));
  }

  function getOrderStatus(row) {
    return normalizeStatus(row.status || row.order_status || row.delivery_status || row.state || row.payment_status || "pending");
  }

  function getTxStatus(row) {
    return normalizeStatus(row.status || row.payment_status || row.tx_status || "pending");
  }

  function normalizeStatus(value) {
    const s = String(value || "").trim().toLowerCase();
    if (!s) return "pending";
    if (s.includes("complete")) return "completed";
    if (s.includes("cancel")) return "cancelled";
    if (s.includes("refund")) return "refunded";
    if (s.includes("process")) return "processing";
    if (s.includes("paid")) return "paid";
    if (s.includes("pending")) return "pending";
    return s.replace(/\s+/g, "-");
  }

  function normalizeOrders(rows) {
    return (Array.isArray(rows) ? rows : []).map((row, index) => {
      const date = getRowDate(row);
      const searchBlob = [
        row.id,
        row.order_id,
        row.order_number,
        row.order_ref,
        row.ref,
        row.customer_name,
        row.full_name,
        row.email,
        row.phone,
        row.status,
        row.order_status,
        row.payment_status,
        row.payment_method,
      ].filter(Boolean).join(" ").toLowerCase();

      return {
        ...row,
        __index: index,
        searchBlob,
        dateKey: toDateKey(date),
        statusKey: getOrderStatus(row),
        paymentStatusKey: normalizeStatus(row.payment_status || ""),
      };
    });
  }

  function normalizeTransactions(rows) {
    return (Array.isArray(rows) ? rows : []).map((row, index) => {
      const date = getRowDate(row);
      const searchBlob = [
        row.id,
        row.tx_ref,
        row.transaction_ref,
        row.order_number,
        row.order_ref,
        row.ref,
        row.customer_name,
        row.full_name,
        row.email,
        row.phone,
        row.status,
        row.payment_status,
        row.payment_method,
      ].filter(Boolean).join(" ").toLowerCase();

      return {
        ...row,
        __index: index,
        searchBlob,
        dateKey: toDateKey(date),
        statusKey: getTxStatus(row),
        paymentStatusKey: normalizeStatus(row.payment_status || ""),
      };
    });
  }

  function normalizeVisitorRows(rows) {
    return (Array.isArray(rows) ? rows : []).map((row, index) => {
      const visitorKey = String(row.visitor_key || row.visitorKey || row.key || row.id || `
      visitor - $ {
        index + 1
      }
      `);
      const visits = Number(row.visits || row.total_visits || row.totalVisits || 0);
      return {
        ...row,
        visitorKey,
        visits,
        firstVisit: row.first_visit || row.firstVisit || row.created_at || row.first_seen || null,
        lastVisit: row.last_visit || row.lastVisit || row.updated_at || row.last_seen || null,
        ip: row.ip || row.last_ip || row.ip_address || "—",
        userAgent: row.user_agent || row.userAgent || "—",
      };
    });
  }

  function getRowDate(row) {
    return row.created_at || row.updated_at || row.date || row.order_date || row.transaction_date || row.paid_at || row.createdAt || "";
  }

  function getRowAmount(row) {
    return row.amount ?? row.total ?? row.grand_total ?? row.total_amount ?? 0;
  }

  function toDateObject(value) {
    if (!value) return null;
    const d = new Date(value);
    return Number.isNaN(d.getTime()) ? null : d;
  }

  function toDateKey(value) {
    const d = toDateObject(value);
    if (!d) return "";
    return d.toISOString().slice(0, 10);
  }

  function formatDate(value) {
    const d = toDateObject(value);
    if (!d) return "—";
    return d.toLocaleDateString("en-GB", {
      day: "2-digit",
      month: "short",
      year: "numeric",
    });
  }

  function formatDateTime(value) {
    const d = toDateObject(value);
    if (!d) return "—";
    return d.toLocaleString("en-GB", {
      day: "2-digit",
      month: "short",
      year: "numeric",
      hour: "2-digit",
      minute: "2-digit",
    });
  }

  function formatMoney(value, currency = CFG.currencyFallback) {
    return `
      $ {
        Number(value || 0).toFixed(2)
      }
      $ {
        currency
      }
      `;
  }

  function extractRows(payload) {
    if (!payload) return [];
    if (Array.isArray(payload)) return payload;
    return payload.rows || payload.data || payload.items || payload.results || [];
  }

  function normalizeSeries(input) {
    if (!input) return { labels: [], values: [] };

    if (Array.isArray(input)) {
      if (!input.length) return { labels: [], values: [] };

      if (typeof input[0] === "number") {
        return {
          labels: input.map((_, i) => String(i + 1)),
          values: input.map((n) => Number(n || 0)),
        };
      }

      if (typeof input[0] === "object") {
        return {
          labels: input.map((item, i) => String(item.label ?? item.name ?? item.month ?? item.day ?? item.date ?? i + 1)),
          values: input.map((item) => Number(item.value ?? item.total ?? item.amount ?? item.count ?? 0)),
        };
      }
    }

    if (typeof input === "object") {
      const labels = Array.isArray(input.labels) ? input.labels.map(String) : [];
      const values = Array.isArray(input.values || input.data) ? (input.values || input.data).map((n) => Number(n || 0)) : [];
      return { labels, values };
    }

    return { labels: [], values: [] };
  }

  function buildGenericLabels(range, count) {
    const n = Math.max(1, count || 7);
    if (range === "year") {
      return ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"].slice(0, n);
    }
    if (range === "month") {
      return Array.from({ length: n }, (_, i) => `
      Day $ {
        i + 1
      }
      `);
    }
    if (range === "week") {
      return ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"].slice(0, n);
    }
    return Array.from({ length: n }, (_, i) => `
      $ {
        i + 1
      }
      `);
  }

  function readTinyGraphValues() {
    if (!els.tinyGraph) return [];
    return $$(".tiny-graph span", els.tinyGraph)
      .map((span) => {
        const h = span.style.height || "0%";
        return Number.parseFloat(h) || 0;
      })
      .filter((n) => n > 0);
  }

  function getBootstrapModal(el) {
    if (!el || !window.bootstrap || !bootstrap.Modal) return null;
    return bootstrap.Modal.getOrCreateInstance(el);
  }

  function showModal(modal) {
    if (modal) modal.show();
  }

  function hideModal(modal) {
    if (modal) modal.hide();
  }

  function isMobile() {
    return window.innerWidth <= CFG.mobileBreakpoint;
  }

  function debounce(fn, delay = 150) {
    let timer = null;
    return (...args) => {
      clearTimeout(timer);
      timer = setTimeout(() => fn(...args), delay);
    };
  }

  function clamp(value, min, max) {
    return Math.max(min, Math.min(max, Number(value || 0)));
  }

  function toBool(value) {
    if (value === true) return true;
    if (value === false) return false;
    if (value == null) return false;
    const s = String(value).trim().toLowerCase();
    return ["1", "true", "yes", "y", "seen", "viewed", "opened"].includes(s);
  }

  function escapeHtml(value) {
    return String(value ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }
})();
    </script>
  </body>

  </html>
