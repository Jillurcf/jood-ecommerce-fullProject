        flex-wrap: wrap;
      }

      .order-number {
        font-weight: 800;
        color: #111827;
      }

      .customer-block {
        display: flex;
        flex-direction: column;
        gap: 4px;
      }

      .customer-block strong {
        color: #111827;
      }

      .customer-block span {
        color: #667085;
        font-size: 13px;
      }

      /* =========================================================
   BADGES
========================================================= */

      .badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 6px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        line-height: 1;
        white-space: nowrap;
      }

      .badge-unseen {
        background: #fff1f2;
        border: 1px solid #fecdd3;
        color: #be123c;
      }

      .badge-status {
        background: #f3f4f6;
        color: #374151;
      }

      .badge-new,
      .badge-pending {
        background: #fff7ed;
        color: #c2410c;
      }

      .badge-in-progress,
      .badge-processing,
      .badge-ongoing {
        background: #eff6ff;
        color: #1d4ed8;
      }

      .badge-complete,
      .badge-completed {
        background: #ecfdf3;
        color: #027a48;
      }

      .badge-cancelled,
      .badge-canceled {
        background: #fef2f2;
        color: #b91c1c;
      }

      .badge-refunded {
        background: #f5f3ff;
        color: #6d28d9;
      }

      /* =========================================================
   ACTIONS
========================================================= */

      .action-link {
        color: #7c3aed;
        font-weight: 700;
        text-decoration: none;
      }

      .action-link:hover {
        text-decoration: underline;
      }

      /* =========================================================
   EMPTY
========================================================= */

      .empty-state {
        padding: 40px 20px;
        text-align: center;
        color: #667085;
        font-size: 14px;
      }

      /* =========================================================
   FOOTER
========================================================= */

      .table-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        padding: 16px 18px;
        border-top: 1px solid #f1f3f5;
        flex-wrap: wrap;
      }

      .table-meta {
        font-size: 14px;
        color: #667085;
      }

      /* =========================================================
   PAGINATION
========================================================= */

      .pagination {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
      }

      .page-btn {
        min-width: 38px;
        height: 38px;
        border: 1px solid #d0d5dd;
        background: #fff;
        color: #344054;
        border-radius: 10px;
        padding: 0 12px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s ease;
      }

      .page-btn:hover:not(:disabled) {
        border-color: #7c3aed;
        color: #7c3aed;
      }

      .page-btn.is-active {
        background: #111827;
        border-color: #111827;
        color: #fff;
      }

      .page-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
      }

      .tx-page {
        padding: 20px;
      }

      .tx-grid {
        display: grid;
        grid-template-columns: 8fr 4fr;
        gap: 18px;
        align-items: start;
      }

      @media (max-width: 992px) {
        .tx-grid {
          grid-template-columns: 1fr;
        }
      }

      .tx-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 20px;
        overflow: hidden;
      }

      .tx-card__head {
        display:flex;
        flex-wrap: wrap;
        justify-content: space-between;
        padding: 18px 18px 12px;
        border-bottom: 1px solid #eef2f7;
      }

      .tx-title {
        margin: 0;
        font-size: 22px;
        font-weight: 800;
        color: #111827;
      }

      .tx-subtitle {
        margin: 6px 0 0;
        color: #6b7280;
        font-size: 14px;
      }

      .tx-filters {
        display: grid;
        grid-template-columns: 1.6fr 1fr 1fr 1fr auto;
        gap: 10px;
        margin-top: 14px;
      }

      @media (max-width: 992px) {
        .tx-filters {
          grid-template-columns: 1fr 1fr;
        }
      }

      @media (max-width: 640px) {
        .tx-filters {
          grid-template-columns: 1fr;
        }
      }

      .tx-input,
      .tx-select,
      .tx-date,
      .tx-btn {
        width: 100%;
        border-radius: 14px;
        border: 1px solid #d1d5db;
        background: #fff;
        padding: 11px 14px;
        font-size: 14px;
        outline: none;
      }

      .tx-input:focus,
      .tx-select:focus,
      .tx-date:focus {
        border-color: #7c3aed;
      }

      .tx-btn {
        border: 1px solid #111827;
        background: #111827;
        color: #fff;
        font-weight: 700;
        cursor: pointer;
        transition: 0.2s ease;
      }

      .tx-btn:hover {
        transform: translateY(-1px);
        opacity: 0.95;
      }

      .tx-kpis {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
        padding: 18px;
      }

      @media (max-width: 992px) {
        .tx-kpis {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      .kpi {
        border: 1px solid #eef2f7;
        border-radius: 16px;
        padding: 14px;
        background: #fafafa;
      }

      .kpi__label {
        font-size: 12px;
        color: #6b7280;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
      }

      .kpi__value {
        margin-top: 8px;
        font-size: 20px;
        font-weight: 800;
        color: #111827;
      }

      .tx-table-wrap {
        padding: 0 18px 18px;
      }

      .tx-table-scroll {
        overflow-x: auto;
      }

      .tx-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 980px;
      }

      .tx-table th {
        text-align: left;
        font-size: 12px;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: #6b7280;
        padding: 14px 12px;
        border-bottom: 1px solid #eef2f7;
        background: #fcfcfd;
      }

      .tx-table td {
        padding: 14px 12px;
        border-bottom: 1px solid #f1f5f9;
        vertical-align: middle;
        font-size: 14px;
        color: #111827;
      }

      .tx-row-unseen {
        background: #fffdf7;
        font-weight: 700;
      }

      .tx-order-main {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
      }

      .tx-ref {
        font-weight: 800;
        color: #111827;
      }

      .badge {
        display: inline-flex;
        align-items: center;
        padding: 6px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 800;
        line-height: 1;
        white-space: nowrap;
      }

      .badge-unseen {
        background: #fff1f2;
        color: #be123c;
        border: 1px solid #fecdd3;
      }

      .badge-paid {
        background: #ecfdf3;
        color: #027a48;
      }

      .badge-pending {
        background: #fff7ed;
        color: #c2410c;
      }

      .badge-processing {
        background: #eff6ff;
        color: #1d4ed8;
      }

      .badge-refunded {
        background: #f5f3ff;
        color: #6d28d9;
      }

      .badge-cancelled {
        background: #fef2f2;
        color: #b91c1c;
      }

      .tx-customer {
        display: flex;
        flex-direction: column;
        gap: 4px;
      }

      .tx-customer span {
        color: #6b7280;
        font-size: 13px;
        font-weight: 500;
      }

      .tx-action {
        color: #7c3aed;
        font-weight: 800;
        text-decoration: none;
      }

      .tx-action:hover {
        text-decoration: underline;
      }

      .tx-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        padding: 0 18px 18px;
      }

      .tx-meta {
        color: #6b7280;
        font-size: 14px;
      }

      .tx-pagination {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
      }

      .page-btn {
        border: 1px solid #d1d5db;
        background: #fff;
        color: #111827;
        border-radius: 12px;
        padding: 8px 12px;
        cursor: pointer;
        font-weight: 700;
        font-size: 13px;
      }

      .page-btn.is-active {
        background: #111827;
        color: #fff;
        border-color: #111827;
      }

      .page-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
      }

      .tx-chart-card {
        padding: 18px;
      }

      .tx-chart-box {
        position: relative;
        min-height: 330px;
      }

      .tx-refresh {
        margin-top: 10px;
        font-size: 12px;
        color: #6b7280;
      }

      .empty-state {
        padding: 30px 12px;
        text-align: center;
        color: #6b7280;
      }
    </style>
  </head>

  <body>
    <div class="account-layout" id="accountLayout">
      <aside class="account-sidebar" id="accountSidebar" aria-label="Account Sidebar">
        <%- include('../../includes/account-sidebar', { user: adminData, admin: adminData, activePage: 'dashboard' }) %>
      </aside>

      <div class="account-right">
        <header class="account-topbar" aria-label="Account Topbar">
          <div class="account-topbar-left">
            <button type="button" class="account-toggle-btn" id="accountToggleBtn" aria-label="Toggle sidebar" aria-controls="accountSidebar" aria-expanded="false"><i class="fa fa-bars"></i></button>
          </div>
          <div class="account-topbar-right">
            <div class="account-user-mini"><i class="fa fa-user-circle"></i><span id="topbarUserName"><%= fullNameValue %></span></div>
          </div>
        </header>

        <div class="account-backdrop" id="accountBackdrop" aria-hidden="true"></div>
        <main class="account-content">

          <section class="account-page-header">
            <div class="account-hero">
              <div class="account-hero-text">
                <h1 class="account-title">Dashboard</h1>
              </div>
            </div>
          </section>

          <section class="dashboard-top-grid">
            <div class="dashboard-stat-card">
              <div class="icon"><i class="fa fa-eye"></i></div>
              <div class="k">Visitors</div>
              <div class="v" id="statVisitors"><%= seedTotalVisitors %></div>
              <div class="s">Unique visitors from page activity.</div>
            </div>

            <div class="dashboard-stat-card">
              <div class="icon"><i class="fa fa-users"></i></div>
              <div class="k">Users</div>
              <div class="v" id="statUsers"><%= seedTotalUsers %></div>
              <div class="s">Registered users in the system.</div>
            </div>

            <div class="dashboard-stat-card">
              <div class="icon"><i class="fa fa-shopping-cart"></i></div>
              <div class="k">Orders</div>
              <div class="v" id="statOrders"><%= seedTotalOrders %></div>
              <div class="s">Total orders received.</div>
            </div>

            <div class="dashboard-stat-card">
              <div class="icon"><i class="fa-solid fa-money-check-dollar"></i></div>
              <div class="k">Total Income</div>
              <div class="v" id="statIncome"><%= seedTotalIncome %></div>
              <div class="s">Revenue overview.</div>
            </div>

            <div class="dashboard-stat-card">
              <div class="icon"><i class="fa fa-cubes"></i></div>
              <div class="k">Items / Products</div>
              <div class="v" id="statItems"><%= seedTotalItems %></div>
              <div class="s">Inventory or product count.</div>
            </div>
          </section>

          <section class="dashboard-merged-row">
            <div class="dashboard-left">
              <div class="chart-card">
                <div class="chart-head">
                  <div>
                    <h3>Visitor Trend</h3>
                    <p>Live visitor activity grouped by time range.</p>
                  </div>

                  <div class="range-switcher" id="rangeSwitcher">
                    <button type="button" class="range-btn active" data-range="day">Day</button>
                    <button type="button" class="range-btn" data-range="week">Week</button>
                    <button type="button" class="range-btn" data-range="month">Month</button>
                    <button type="button" class="range-btn" data-range="year">Year</button>
                  </div>
                </div>

                <div class="chart-toolbar">
                  <div class="live-badge">
                    <i class="fa fa-rss"></i>
                    <span id="chartLiveState">Live updating</span>
                  </div>

                  <div class="live-badge">
                    <i class="fa fa-clock-o"></i>
                    <span id="chartUpdatedAt">Last updated: —</span>
                  </div>

                  <button type="button" class="btn btn-sm btn-outline-primary" id="refreshChartBtn">
                    Refresh
                  </button>
                </div>

                <div class="chart-wrap">
                  <canvas id="visitorTrendChart"></canvas>
                </div>

                <div class="chart-foot">
                  <div id="chartRangeLabel">Showing day view</div>
                  <div id="chartSummaryText">Loading visitor chart...</div>
                </div>
              </div>
            </div>

            <div class="dashboard-right">
              <div class="visitor-summary-grid">
                <div class="visitor-card-shell">
                  <button type="button" class="visitor-card" id="openVisitorListBtn" aria-label="Open visitor dashboard details">
                    <div class="visitor-card-top">
                      <div style="flex:1 1 auto; min-width:0;">
                        <div class="visitor-card-title">Visitors</div>
                        <div class="visitor-card-count" id="totalVisitorsText"><%= seedTotalVisitors %></div>

                        <p class="visitor-card-subtitle">
                          Unique visitors tracked from <strong>page_visits</strong>
                        </p>

                        <div class="visitor-card-badges">
                          <span class="visitor-chip">
                            <i class="fa fa-eye"></i>
                            <span id="totalPageVisitsText"><%= seedTotalPageVisits %></span> page visits
                          </span>
                          <span class="visitor-chip">
                            <i class="fa fa-clock-o"></i>
                            Latest activity first
                          </span>
                        </div>

                        <div class="visitor-click-hint">
                          <i class="fa fa-search"></i>
                          Click to open visitor list and detail history
                        </div>
                      </div>

                      <div class="text-end" style="flex:0 0 auto;">
                        <div class="tiny-graph" id="tinyGraph" aria-hidden="true">
                          <% if (seedGraphValues.length) { %>
                          <% seedGraphValues.forEach((value) => { %>
                          <span style="height:<%= Math.max(18, Math.round((value / seedGraphMax) * 100)) %>%;"></span>
                          <% }); %>
                          <% } else { %>
                          <span style="height:20%;"></span>
                          <span style="height:35%;"></span>
                          <span style="height:55%;"></span>
                          <span style="height:42%;"></span>
                          <% } %>
                        </div>
                        <div class="small-note">Tap to open full visitor view</div>
                      </div>
                    </div>
                  </button>
                </div>
              </div>
            </div>
          </section>

          <section class="dashboard-row">
            <div class="dash-panel">
              <div class="dash-panel__head">
                <div>
                  <h2 class="dash-title">Orders</h2>
                  <p class="dash-subtitle">Search, filter, and review the latest orders.</p>
                </div>

                <div class="dash-actions">
                 <button id="viewMoreOrders" class="tx-btn" type="button">View more</button>
                </div>
              </div>

              <div class="filter-bar" id="orderFilterBar">
                <button type="button" class="filter-chip is-active" data-section="all">All</button>
                <button type="button" class="filter-chip" data-section="pending">New</button>
                <button type="button" class="filter-chip" data-section="processing">In Progress</button>
                <button type="button" class="filter-chip" data-section="completed">Complete</button>
                <button type="button" class="filter-chip" data-section="cancelled">Cancelled</button>
                <button type="button" class="filter-chip" data-section="refunded">Refunded</button>
              </div>

              <div class="table-card">
                <div class="table-scroll">
                  <table class="dash-table">
                    <thead>
                      <tr>
                        <th>Order</th>
                        <th>Customer</th>
                        <th>Status</th>
                        <th>Payment</th>
                        <th>Total</th>
                        <th>Date</th>
                        <th>Action</th>
                      </tr>
                    </thead>

                    <tbody id="ordersTableBody">
                      <% if (ordersRows.length) { %>
                      <% ordersRows.forEach((order) => {
                        const unseen = isUnseenOrderFn(order);
                        const status = getStatusFn(order);
                        const ref = getRefFn(order);
                        const amount = getAmountFn(order);
                        const currency = getCurrencyFn(order);
                        const dateLabel = getDateFn(order);
                    %>
                      <tr class="<%= unseen ? 'row-unseen' : '' %>">
                        <td>
                          <div class="order-main">
                            <div class="order-number"><%= ref %></div>
                            <% if (unseen) { %>
                            <span class="badge badge-unseen">Unseen</span>
                            <% } %>
                          </div>
                        </td>

                        <td>
                          <div class="customer-block">
                            <strong><%= order.customer_name || 'Guest' %></strong>
                            <span><%= order.email || order.phone || '—' %></span>
                          </div>
                        </td>

                        <td>
                          <span class="badge badge-status badge-<%= status.replace(/\s+/g, '-') %>">
                            <%= status %>
                          </span>
                        </td>

                        <td><%= order.payment_status || '—' %></td>

                        <td><strong><%= currency %> <%= amount.toFixed(2) %></strong></td>

                        <td><%= dateLabel %></td>

                        <td>
                          <a class="action-link" href="/admin/a/orders/<%= encodeURIComponent(ref) %>">View</a>
                        </td>
                      </tr>
                      <% }) %>
                      <% } else { %>
                      <tr>
                        <td colspan="7">
                          <div class="empty-state">No orders found.</div>
                        </td>
                      </tr>
                      <% } %>
                    </tbody>
                  </table>
                </div>

                <div class="table-footer">
                  <div class="table-meta" id="ordersMeta">
                    Showing <span id="ordersShown"><%= ordersRows.length %></span> orders
                    <span id="ordersRefreshState" style="margin-left:10px;"></span>
                  </div>

                  <div class="pagination" id="ordersPagination"></div>
                </div>
              </div>
            </div>

            <div class="dash-panel">
              <div class="graph-card">
                <div class="card-head">
                  <div>
                    <h3>Orders Graph</h3>
                    <p>Revenue trend from your order history.</p>
                  </div>

                  <div class="graph-controls">
                    <select id="orderChartRange" class="graph-select">
                      <option value="week" selected>Weekly</option>
                      <option value="month">Monthly</option>
                      <option value="year">Yearly</option>
                    </select>
                  </div>
                </div>

                <div class="graph-box">
                  <canvas id="ordersChart"></canvas>
                </div>

                <div style="padding: 0 16px 16px; color: #667085; font-size: 13px;" id="ordersChartState">
                  Chart loading...
                </div>
              </div>
            </div>
          </section>

          <section class="tx-page">
            <div class="tx-card">
              <div class="tx-card__head">
                <h2 class="tx-title">Transaction History</h2>
                <p class="tx-subtitle">Track orders, payments, refunds, and live status updates.</p>

                <div class="tx-filters">
                  <input id="txSearch" class="tx-input" type="text" placeholder="Search order, customer, email, phone..." value="<%= txSafeText(txQuery.q || '') %>">

                  <select id="txStatus" class="tx-select">
                    <option value="" <%= !txQueryStatus ? "selected" : "" %>>All Status</option>
                    <option value="paid" <%= txQueryStatus === "paid" ? "selected" : "" %>>Paid</option>
                    <option value="pending" <%= txQueryStatus === "pending" ? "selected" : "" %>>Pending</option>
                    <option value="processing" <%= txQueryStatus === "processing" ? "selected" : "" %>>Processing</option>
                    <option value="refunded" <%= txQueryStatus === "refunded" ? "selected" : "" %>>Refunded</option>
                    <option value="cancelled" <%= txQueryStatus === "cancelled" ? "selected" : "" %>>Cancelled</option>
                  </select>

                  <input id="txFrom" class="tx-date" type="date" value="<%= txSafeText(txQuery.from || '') %>">

                  <input id="txTo" class="tx-date" type="date" value="<%= txSafeText(txQuery.to || '') %>">

                  <button id="txApply" class="tx-btn" type="button">Apply</button>
                </div>
              </div>

              <div class="tx-kpis">
                <div class="kpi">
                  <div class="kpi__label">Total Transactions</div>
                  <div class="kpi__value"><%= txSummary.totalCount || txPagination.total || txRows.length %></div>
                </div>

                <div class="kpi">
                  <div class="kpi__label">Paid</div>
                  <div class="kpi__value"><%= txSummary.paidCount || 0 %></div>
                </div>

                <div class="kpi">
                  <div class="kpi__label">Pending</div>
                  <div class="kpi__value"><%= txSummary.pendingCount || 0 %></div>
                </div>

                <div class="kpi">
                  <div class="kpi__label">Refunded</div>
                  <div class="kpi__value"><%= txSummary.refundedCount || 0 %></div>
                </div>
              </div>
            </div>

            <div class="tx-grid" style="margin-top:18px;">
              <div class="tx-card">
                <div class="tx-card__head">
                  <div>
                    <h3 class="tx-title" style="font-size:18px;">Transactions Table</h3>
                    <p class="tx-subtitle">Rows are sorted with new transactions at the top.</p>
                  </div>
                  
                  <div class="dash-actions">
                    <button id="viewMoreTransactions" class="tx-btn" type="button">View more</button>
                  </div>
                </div>
                

                <div class="tx-table-wrap">
                  <div class="tx-table-scroll">
                    <table class="tx-table">
                      <thead>
                        <tr>
                          <th>Transaction</th>
                          <th>Customer</th>
                          <th>Status</th>
                          <th>Payment</th>
                          <th>Total</th>
                          <th>Date</th>
                          <th>Action</th>
                        </tr>
                      </thead>

                      <tbody id="txTableBody">
                        <% if (txRows.length) { %>
                        <% txRows.forEach((row) => {
                           const txUnseen = txIsUnseen(row);
                           const txStatus = txGetStatus(row);
                      %>
                        <tr class="<%= txUnseen ? 'tx-row-unseen' : '' %>">
                          <td>
                            <div class="tx-order-main">
                              <span class="tx-ref"><%= txGetRef(row) %></span>
                              <% if (txUnseen) { %>
                              <span class="badge badge-unseen">Unseen</span>
                              <% } %>
                            </div>
                          </td>

                          <td>
                            <div class="tx-customer">
                              <strong><%= row.customer_name || 'Guest' %></strong>
                              <span><%= row.email || row.phone || '—' %></span>
                            </div>
                          </td>

                          <td>
                            <span class="badge badge-<%= txStatus %>"><%= txStatus %></span>
                          </td>

                          <td><%= row.payment_method || '—' %></td>

                          <td>
                            <strong><%= txGetCurrency(row) %> <%= txGetAmount(row).toFixed(2) %></strong>
                          </td>

                          <td><%= txGetDate(row) %></td>

                          <td>
                            <a class="tx-action" href="/admin/a/orders/<%= encodeURIComponent(txGetRef(row)) %>"> View </a>
                          </td>
                        </tr>
                        <% }) %>
                        <% } else { %>
                        <tr>
                          <td colspan="7">
                            <div class="empty-state">No transactions found.</div>
                          </td>
                        </tr>
                        <% } %>
                      </tbody>
                    </table>
                  </div>
                </div>

                <div class="tx-footer">
                  <div class="tx-meta" id="txMeta">
                    Showing <strong><%= txRows.length %></strong> transactions
                    <span id="txRefreshState" style="margin-left:10px;"></span>
                  </div>

                  <div class="tx-pagination" id="txPagination"></div>
                </div>
              </div>

              <div class="tx-card">
                <div class="tx-chart-card">
                  <div class="tx-card__head" style="padding:0 0 12px;">
                    <h3 class="tx-title" style="font-size:18px;">Revenue Graph</h3>
                    <p class="tx-subtitle">Weekly chart with live refresh.</p>
                  </div>

                  <div class="tx-filters" style="grid-template-columns: 1fr;">
                    <select id="txChartRange" class="tx-select">
                      <option value="day">Day</option>
                      <option value="week" selected>Week</option>
                      <option value="month">Month</option>
                      <option value="year">Year</option>
                    </select>
                  </div>

                  <div class="tx-chart-box" style="margin-top:14px;">
                    <canvas id="txChart"></canvas>
                  </div>

                  <div class="tx-refresh" id="txChartState">Chart loading...</div>
                </div>
              </div>
            </div>
          </section>

          <script>
            window.__TX_API__ = "<%= txApiUrl %>";
            window.__TX_INITIAL_ROWS__ = <%- JSON.stringify(txRows) %>;
            window.__TX_INITIAL_PAGINATION__ = <%- JSON.stringify(txPagination) %>;

            window.__ORDERS_API__ = "<%= ordersApi %>";
            window.__INITIAL_ORDERS__ = <%- JSON.stringify(ordersRows) %>;
            window.__INITIAL_PAGINATION__ = <%- JSON.stringify(ordersPagination) %>;
            window.__ORDER_WEEKLY_SERIES__ = <%- JSON.stringify(ordersWeeklySeries) %>;
            window.__ORDER_MONTHLY_SERIES__ = <%- JSON.stringify(ordersMonthlySeries) %>;
          </script>
        </main>
        <%- include('../../includes/account-footer') %>
      </div>
    </div>

    <div class="toast-mini" id="toastMini" role="status" aria-live="polite"></div>

    <div class="modal fade" id="visitorListModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered modal-xl modal-xl-custom">
        <div class="modal-content">
          <div class="modal-header">
            <div>
              <h5 class="modal-title mb-1">Visitor Dashboard</h5>
