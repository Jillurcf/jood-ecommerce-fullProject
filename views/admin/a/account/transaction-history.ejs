<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <title>Transaction History — JOOD | Quality Goods & Products</title>
  <meta name="description" content="Review your JOOD transaction history, search orders and products, and export payment reports securely." />
  <meta name="robots" content="noindex, nofollow" />

    <link rel="shortcut icon" href="/customer/images/web-img-vid/favicon.png" type="image/x-icon">

  <meta property="og:type" content="website" />
  <meta property="og:title" content="Transaction History — JOOD Account Dashboard" />
  <meta property="og:description" content="Search transaction records, view weekly activity, and export reports securely." />
  <meta property="og:url" content="https://jood.com/admin/a/account/transaction-history" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Transaction History — JOOD" />
  <meta name="twitter:description" content="Search and export your transaction history securely." />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="/customer/css/bootstrap.min.css" />
  <link rel="stylesheet" href="/customer/css/account.css" />
  <link rel="stylesheet" href="/customer/css/style.css" />
  <link rel="stylesheet" href="/customer/css/responsive.css" />

  <script src="/customer/js/vendor/modernizr-2.8.3.min.js"></script>
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.4/jspdf.plugin.autotable.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

<style>
    :root {
  --bg: #ffffff;
  --card: #ffffff;
  --border: #e5e7eb;
  --border-strong: #d1d5db;
  --text: #111827;
  --muted: #6b7280;
  --primary: #f8ac28;
  --primary-soft: rgba(245, 158, 11, 0.12);
  --primary-hover: #fa8806;
  --radius: 16px;
  --radius-sm: 12px;
  --sidebar-wide: 280px;
  --sidebar-collapsed: 78px;
  --topbar-height: 68px;

  --green-bg: #ecfdf5;
  --blue-bg: #eff6ff;
  --amber-bg: #fffbeb;
  --red-bg: #fef2f2;
  --success: #16a34a;
}

  * {
    box-sizing: border-box;
    min-width: 0;
  }

  html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    max-width: 100%;
    min-height: 100%;
    overflow-x: hidden;
    background: var(--bg);
  }

  body {
    font-family: system-ui, Arial, sans-serif;
    color: var(--text);
    -webkit-text-size-adjust: 100%;
    text-rendering: optimizeLegibility;
    overflow: hidden;
  }

  a {
    text-decoration: none;
    color: inherit;
  }

  img, svg, canvas, video {
    max-width: 100%;
    height: auto;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }

  .account-layout {
    width: 100%;
    max-width: 100%;
    min-height: 100vh;
    display: block;
    position: relative;
    background: #fff;
    overflow: hidden;
  }

  /* Sidebar */
  .account-sidebar {
    position: fixed;
    top: 0;
    left: 0;
    width: var(--sidebar-collapsed);
    height: 100vh;
    background: var(--card);
    border-right: 1px solid var(--border);
    z-index: 1040;
    overflow-x: hidden;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: transparent transparent;
    transition: width 0.25s ease, transform 0.25s ease;
  }

  .account-sidebar::-webkit-scrollbar {
    width: 6px;
  }

  .account-sidebar::-webkit-scrollbar-thumb {
    background: transparent;
    border-radius: 999px;
  }

  .account-sidebar:hover::-webkit-scrollbar-thumb {
    background: rgba(17, 24, 39, 0.25);
  }

  .account-sidebar-brand {
    padding: 14px 16px 8px;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .account-brand-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    max-width: 100%;
  }

  .account-logo {
    display: block;
    width: 100%;
    max-width: 150px;
    height: auto;
  }

  .account-sidebar-top {
    padding: 18px 16px;
    text-align: center;
    border-bottom: 1px solid var(--border);
  }

  .account-profile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .account-avatar {
    width: 45px;
    height: 45px;
    border-radius: 50%;
    overflow: hidden;
    background: #f3f4f6;
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
  }

  .account-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .avatar-initials {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: #2d6cdf;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 15px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .account-name {
    font-weight: 700;
    font-size: 15px;
    line-height: 1.3;
    margin: 0;
    word-break: break-word;
  }

  .account-email {
    font-size: 13px;
    color: var(--muted);
    margin-top: 3px;
    word-break: break-word;
  }

  .account-nav {
    padding: 12px;
  }

  .account-nav-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border-radius: 12px;
    text-decoration: none;
    color: var(--text);
    font-weight: 600;
    transition: background 0.2s ease, transform 0.2s ease, color 0.2s ease;
    margin-bottom: 4px;
    min-width: 0;
  }

  .account-nav-link:hover {
    background: rgba(245, 158, 11, 0.10);
    transform: translateX(2px);
    color: #000;
  }

  .account-nav-link.active {
    background: var(--primary-soft);
    color: var(--text);
  }

  .account-nav-link i {
    width: 22px;
    text-align: center;
    color: var(--primary);
    font-size: 16px;
    flex: 0 0 auto;
  }

  .account-nav-link.logout i {
    color: #ef4444;
  }

  /* Sidebar states */
  .account-layout.sidebar-collapsed .account-sidebar,
  .account-sidebar.collapsed {
    width: var(--sidebar-collapsed);
  }

  .account-layout.sidebar-expanded .account-sidebar,
  .account-sidebar.expanded {
    width: var(--sidebar-wide);
  }

  .account-layout.sidebar-collapsed .account-name,
  .account-layout.sidebar-collapsed .account-email,
  .account-layout.sidebar-collapsed .link-text,
  .account-sidebar.collapsed .account-name,
  .account-sidebar.collapsed .account-email,
  .account-sidebar.collapsed .link-text {
    display: none;
  }

  .account-layout.sidebar-collapsed .account-nav-link,
  .account-sidebar.collapsed .account-nav-link {
    justify-content: center;
    padding-left: 0;
    padding-right: 0;
  }

  .account-layout.sidebar-collapsed .account-nav-link i,
  .account-sidebar.collapsed .account-nav-link i {
    width: auto;
    min-width: 22px;
    font-size: 18px;
  }

  .account-layout.sidebar-collapsed .account-sidebar-brand,
  .account-sidebar.collapsed .account-sidebar-brand {
    padding-left: 0;
    padding-right: 0;
  }

  /* Main area */
  .account-right {
    min-width: 0;
    margin-left: var(--sidebar-collapsed);
    width: calc(100% - var(--sidebar-collapsed));
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: #fff;
    transition: margin-left 0.25s ease, width 0.25s ease;
  }

  .account-layout.sidebar-expanded .account-right {
    margin-left: var(--sidebar-wide);
    width: calc(100% - var(--sidebar-wide));
  }

  /* Topbar */
  .account-topbar {
    position: fixed;
    top: 0;
    left: var(--sidebar-collapsed);
    right: 0;
    height: var(--topbar-height);
    min-height: var(--topbar-height);
    padding: 10px 18px;
    background: #fff;
    border-bottom: 1px solid var(--border);
    z-index: 1030;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    width: auto;
    transition: left 0.25s ease;
  }

  .account-layout.sidebar-expanded .account-topbar {
    left: var(--sidebar-wide);
  }

  .account-topbar-left,
  .account-topbar-right, 
  .topbar-left,
  .topbar-right {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    flex-wrap: wrap;
  }

  .account-toggle-btn,
  .btn-export-wide {
    height: 44px;
    border: 1px solid var(--border);
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #fff;
    color: var(--text);
    cursor: pointer;
    padding: 0 14px;
    font-weight: 800;
    transition: border-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
    white-space: nowrap;
    max-width: 100%;
  }

  .account-toggle-btn {
    width: 44px;
    padding: 0;
    flex: 0 0 auto;
  }

  .account-toggle-btn:hover,
  .btn-export-wide:hover {
    border-color: var(--border-strong);
  }

  .account-toggle-btn i,
  .btn-export-wide i {
    font-size: 16px;
    flex: 0 0 auto;
  }

  .topbar-title {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    overflow: hidden;
  }

  .topbar-title .title {
    font-size: 1rem;
    font-weight: 900;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .topbar-title .sub {
    font-size: 0.8rem;
    color: var(--muted);
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .billing-live-clock {
    font-weight: 700;
    color: #334155;
  }

  .billing-live-clock small {
    color: var(--billing-muted);
    font-weight: 600;
  }

  .account-user-mini {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    color: var(--text);
    white-space: nowrap;
    min-width: 0;
    max-width: 100%;
  }

  .account-user-mini i {
    font-size: 20px;
    color: #475569;
    flex: 0 0 auto;
  }

  .account-user-mini span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    display: inline-block;
    max-width: 90px;
  }

  .account-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.22);
    z-index: 1035;
  }

  .account-backdrop.show {
    display: block;
  }

  /* Content */
  .account-content-wrap {
    flex: 1 1 auto;
    min-height: 0;
    overflow: auto;
    overflow-x: hidden;
    padding: calc(var(--topbar-height) + 18px) 18px 18px;
    background: #fff;
    width: 100%;
    max-width: 100%;
  }

  .account-footer-wrap {
    padding: 0 18px 18px;
    margin-top: auto;
    width: 100%;
    max-width: 100%;
  }

  /* Layout sections */
  .history-page-shell {
    width: 100%;
    max-width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 280px) minmax(0, 1fr);
    gap: 16px;
    align-items: start;
  }

  .history-subsidebar {
        position: sticky;
        top: calc(var(--topbar-height) + 18px);
        align-self: start;
        overflow: hidden;
        min-width: 0;
        background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
  }


  .history-sidepanel {
    display:block;
    padding: 20px;
  }

  .history-sidepanel-title {
    margin: 0;
    font-size: 16px;
    font-weight: 900;
    color: var(--text);
    line-height: 1.2;
  }


  .history-main {
    min-width: 0;
    max-width: 100%;
  }

  /* Panels */
  .card-panel {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }

  .card-panel.pad {
    padding: 20px;
  }

  .header-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 16px;
    width: 100%;
    max-width: 100%;
  }

  .section-title {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 900;
    color: var(--text);
    letter-spacing: -0.01em;
    word-break: break-word;
  }

  .section-subtitle {
    margin: 6px 0 0;
    color: var(--muted);
    font-size: 0.88rem;
    line-height: 1.5;
    word-break: break-word;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 11px;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 700;
    border: 1px solid transparent;
    white-space: nowrap;
    line-height: 1;
    max-width: 100%;
  }

  .pill-verified {
    background: var(--green-bg);
    color: var(--success);
    border-color: #c7eed6;
  }

  .pill-unverified,
  .pill-neutral {
    background: #f8fafc;
    color: #64748b;
    border-color: #e2e8f0;
  }

  .status-line {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: #fff;
    font-size: 0.82rem;
    color: #334155;
    white-space: nowrap;
    max-width: 100%;
  }

  .saving-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #94a3b8;
    flex: 0 0 auto;
  }

  .saving-dot.is-saving {
    background: #0f172a;
    animation: pulse 1.2s infinite;
  }

  .saving-dot.is-saved {
    background: #16a34a;
  }

  .saving-dot.is-error {
    background: #dc2626;
  }

  /* Summary cards */
  .summary-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 15px;
    width: 100%;
    max-width: 100%;
  }

  .summary-box {
    padding: 18px;
    border-radius: 12px;
    background: #fff;
    border: 1px solid #e5e7eb;
    transition: 0.2s ease;
    min-width: 0;
    overflow: hidden;
  }

  .summary-box:hover {
    transform: translateY(-3px);
  }

  .summary-box .label {
    font-size: 13px;
    color: #6b7280;
  }

  .summary-box .value {
    font-size: 20px;
    font-weight: 700;
    margin-top: 6px;
    color: #111827;
  }

  .summary-box .hint {
    font-size: 12px;
    color: #9ca3af;
    margin-top: 5px;
  }

  .summary-income {
    background: #eff6ff;
  }

  .summary-success {
    background: #ecfdf5;
  }

  .summary-warning {
    background: #fffbeb;
  }

  .summary-danger {
    background: #fef2f2;
  }

  /* Analytics */
  .analytics-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: 16px;
    width: 100%;
    max-width: 100%;
  }

  .chart-card {
    padding: 20px;
    min-height: 360px;
    min-width: 0;
    border-radius: var(--radius);
    background: #fff;
    border: 1px solid var(--border);
  }

  .chart-wrap {
    position: relative;
    height: 280px;
    width: 100%;
    max-width: 100%;
  }

  .mini-stat-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }

  .mini-stat {
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 14px;
    background: #fff;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    min-width: 0;
  }

  .mini-stat .k {
    font-size: 0.8rem;
    color: var(--muted);
    font-weight: 800;
    word-break: break-word;
  }

  .mini-stat .v {
    font-size: 0.95rem;
    font-weight: 900;
    color: var(--text);
    text-align: right;
    word-break: break-word;
  }

  .mini-stat .s {
    font-size: 0.78rem;
    color: var(--muted);
    margin-top: 4px;
    text-align: right;
    word-break: break-word;
  }

  /* Filters */
  .filters-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    width: 100%;
    max-width: 100%;
  }

  .filter-box {
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 14px;
    background: #fff;
    min-width: 0;
  }

  .form-label {
    font-weight: 800;
    color: var(--text);
    margin-bottom: 6px;
    font-size: 0.86rem;
    display: block;
    word-break: break-word;
  }

  .form-control,
  .form-select {
    width: 100%;
    max-width: 100%;
    min-height: 46px;
    border-radius: 14px;
    border: 1px solid #dbe3ec;
    font-size: 0.92rem;
  }

  .form-control:focus,
  .form-select:focus {
    border-color: #b8c4d1;
  }

  .helper-text {
    display: block;
    margin-top: 6px;
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.4;
    word-break: break-word;
  }

  /* Buttons */
  .btn-secure,
  .btn-ghost,
  .btn-export-wide,
  .btn-filter {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border-radius: 12px;
    padding: 10px 14px;
    font-weight: 800;
    border: 1px solid var(--border);
    background: #fff;
    color: var(--text);
    transition: 0.2s ease;
    max-width: 100%;
    white-space: nowrap;
  }

  .btn-secure,
  .btn-filter {
    border-color: var(--primary);
    background: var(--primary);
    color: #fff;
  }

  .btn-secure:hover,
  .btn-filter:hover {
    background: var(--primary-hover);
    color: #fff;
  }

  .btn-ghost:hover,
  .btn-export-wide:hover {
    border-color: var(--border-strong);
    color: var(--text);
  }

  .action-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  /* Tabs */
  .tab-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .tab-btn {
    border: 1px solid var(--border);
    background: #fff;
    color: #334155;
    font-weight: 800;
    border-radius: 999px;
    padding: 10px 14px;
  }

  .tab-btn.active {
    background: var(--primary-soft);
    border-color: #f2d08a;
    color: #111827;
  }

  .tab-panel {
    display: none;
    margin-top: 16px;
  }

  .tab-panel.active {
    display: block;
  }

  /* Search cards */
  .search-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .search-card {
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 16px;
    background: #fff;
  }

  .search-card h4 {
    margin: 0 0 6px;
    font-size: 1rem;
    font-weight: 900;
  }

  .search-card p {
    margin: 0 0 12px;
    color: var(--muted);
    font-size: .88rem;
    line-height: 1.5;
  }

  /* Details */
  .detail-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    width: 100%;
    max-width: 100%;
  }

  .detail-box {
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 14px;
    background: #fff;
    min-width: 0;
    overflow: hidden;
  }

  .detail-box .k {
    font-size: 0.78rem;
    color: var(--muted);
    margin-bottom: 6px;
    font-weight: 800;
    word-break: break-word;
  }

  .detail-box .v {
    font-size: 0.92rem;
    color: var(--text);
    font-weight: 900;
    word-break: break-word;
  }

  /* Table */
  .orders-table-wrap {
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: #fff;
  }

  .orders-table {
    width: 100%;
    margin: 0;
    min-width: 860px;
  }

  .orders-table th,
  .orders-table td {
    padding: 12px 14px;
    vertical-align: top;
    border-top: 1px solid #eef2f7;
    font-size: 0.88rem;
    word-break: break-word;
  }

  .orders-table thead th {
    border-top: 0;
    background: #f8fafc;
    color: #334155;
    font-weight: 900;
    white-space: nowrap;
  }

  .orders-table td {
    color: #1f2937;
  }

  .orders-table .muted {
    color: var(--muted);
    word-break: break-word;
  }

  .orders-table .amount {
    font-weight: 900;
    white-space: nowrap;
  }

  .orders-table .order-link {
    font-weight: 800;
    color: #0f172a;
  }

  .orders-table .order-link:hover {
    text-decoration: underline;
  }

  /* Quick actions */
  .quick-action-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: #fff;
    color: var(--text);
    transition: 0.2s ease;
    min-height: 54px;
    font-weight: 700;
    min-width: 0;
  }

  .quick-action-item:hover {
    border-color: var(--border-strong);
    color: var(--text);
  }

  .quick-action-item i {
    width: 34px;
    height: 34px;
    border-radius: 11px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f8fafc;
    color: #0f172a;
    flex: 0 0 auto;
  }

  .quick-action-item span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .actions-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    width: 100%;
    max-width: 100%;
  }

  /* Empty / toast / notes */
  .empty-state {
    border: 1px dashed #d8e0ea;
    border-radius: 16px;
    padding: 18px;
    text-align: center;
    color: var(--muted);
    background: #fff;
    width: 100%;
    max-width: 100%;
  }

  .toast-mini {
    position: fixed;
    right: 18px;
    bottom: 18px;
    z-index: 1060;
    min-width: 220px;
    max-width: calc(100vw - 36px);
    padding: 12px 14px;
    border-radius: 13px;
    background: #0f172a;
    color: #fff;
    font-size: 0.86rem;
    transform: translateY(18px);
    opacity: 0;
    pointer-events: none;
    transition: 0.25s ease;
  }

  .toast-mini.show {
    transform: translateY(0);
    opacity: 1;
  }

  .analytics-note {
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.5;
    margin-top: 10px;
    word-break: break-word;
  }

  /* Animation */
  @keyframes pulse {
    0% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.2); opacity: .6; }
    100% { transform: scale(1); opacity: 1; }
  }

  /* Responsive */
  @media (max-width: 1199px) {
    .billing-page-shell,
    .analytics-grid,
    .search-grid {
      grid-template-columns: 1fr;
    }

    .summary-grid,
    .filters-grid,
    .detail-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .history-page-shell {
      grid-template-columns: 1fr;
    }

    .account-user-mini span {
      max-width: 180px;
    }

    .history-subsidebar {
      position: relative;
      top: auto;
    }
  }

  @media (max-width: 991px) {
    body {
      overflow: hidden;
    }

    .account-layout {
      display: block;
      min-height: 100vh;
    }

    .account-sidebar {
      width: 290px;
      transform: translateX(-100%);
      height: 100vh;
      max-width: 100vw;
    }

    .account-sidebar.open {
      transform: translateX(0);
    }

    .account-right {
      margin-left: 0;
      width: 100%;
    }

    .account-topbar {
      left: 0 !important;
      width: 100%;
    }

    .topbar-left {
      width: 100%;
    }

    .topbar-right {
      width: 100%;
      justify-content: space-between;
    }

    .account-content-wrap {
      padding: calc(var(--topbar-height) + 14px) 14px 14px;
      overflow: auto;
      -webkit-overflow-scrolling: touch;
    }

    .account-user-mini {
      display: inline-flex;
      max-width: 180px;
    }

    .account-user-mini span {
      max-width: 120px;
    }

    .filters-grid,
    .detail-grid,
    .summary-grid {
      grid-template-columns: 1fr;
    }

    .actions-grid {
      grid-template-columns: 1fr;
    }

    .history-page-shell {
      gap: 12px;
      grid-template-columns: 1fr;
    }


    
    .billing-shell,
    .billing-page-shell {
        gap: 12px;
        grid-template-columns: 1fr;
      }

    .history-subsidebar {
      position: relative !important;
        top: auto !important;
        padding: 0;
        border: 1px solid var(--border);
        border-radius: 18px;
        overflow: hidden;
    }

    .account-sidebar-close {
      display: flex;
    }
  }

  @media (max-width: 768px) {
    .card-panel.pad,
    .chart-card {
      padding: 16px;
    }

    .chart-wrap {
      height: 260px;
    }

    .status-line {
      width: 100%;
      justify-content: center;
    }

    .account-footer-wrap {
      padding: 0 14px 14px;
    }

    .account-topbar {
      gap: 10px;
      padding: 10px 12px;
    }

    .account-user-mini span {
      max-width: 90px;
    }

    .btn-export-wide {
      padding: 0 12px;
      font-size: 0.84rem;
    }

    .topbar-title .title {
      font-size: 0.95rem;
    }

    .topbar-title .sub {
      font-size: 0.75rem;
    }
  }

  @media (max-width: 575px) {
    .account-content-wrap {
      padding: calc(var(--topbar-height) + 12px) 12px 12px;
    }

    .account-topbar {
      padding: 10px 10px;
    }

    .account-user-mini {
      gap: 8px;
    }

    .account-user-mini i {
      font-size: 18px;
    }

    .account-user-mini span {
      max-width: 78px;
      font-size: 0.85rem;
    }

    .summary-box .value {
      font-size: 1.1rem;
    }

    .section-title {
      font-size: 1rem;
    }

    .section-subtitle {
      font-size: 0.84rem;
    }

    .btn-export-wide {
      padding: 0 10px;
    }
  }

  /* Sidebar close button */
  .account-sidebar-close {
    position: absolute;
    top: 12px;
    right: 12px;
    background: #ffffff;
    border: 1px solid var(--border);
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: none;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    transition: 0.2s;
  }

  .account-sidebar-close:hover {
    background: #f3f4f6;
  }

  .account-sidebar-close i {
    font-size: 16px;
    color: #111827;
  }


  .filters-grid {
    display: flex;
    gap: 12px;
    flex-wrap: nowrap;       /* ❗ prevents wrapping */
    overflow-x: auto;        /* ✅ scroll if too many filters */
    padding-bottom: 4px;
  }

  .filters-grid::-webkit-scrollbar {
    height: 6px;
  }

  .filters-grid::-webkit-scrollbar-thumb {
    background: rgba(0,0,0,0.2);
    border-radius: 999px;
  }

  .filter-box {
    min-width: 220px;        /* ✅ keeps each filter usable */
    flex: 0 0 auto;
    
  }

  .billing-shell,
  .billing-page-shell {
      width: 100%;
      max-width: 100%;
      display: grid;
      grid-template-columns: minmax(0, 280px) minmax(0, 1fr);
      gap: 16px;
      align-items: start;
    }

  .billing-nav {
      display: flex;
      flex-direction: column;
      gap: 8px;
      padding: 14px;
      border-bottom: 1px solid var(--border);
      background: #fff;
    }

    .billing-nav-link {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 12px;
      border-radius: 12px;
      color: var(--text);
      font-weight: 700;
      transition: 0.2s ease;
      border: 1px solid transparent;
    }

    .billing-nav-link:hover {
      background: rgba(245, 158, 11, 0.08);
      border-color: rgba(245, 158, 11, 0.12);
      transform: translateX(2px);
    }

    .billing-nav-link.active {
      background: var(--primary-soft);
      border-color: rgba(245, 158, 11, 0.18);
    }

    .billing-nav-link i {
      width: 22px;
      text-align: center;
      color: var(--primary);
      flex: 0 0 auto;
    }

    .billing-nav-link .txt {
      min-width: 0;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
</style>
</head>

<body class="billing-page">
<%
  const safeDate = (v) => {
    const d = new Date(v);
    return Number.isNaN(d.getTime()) ? null : d;
  };

  const fmtDateTime = (v) => {
    const d = safeDate(v);
    return d
      ? d.toLocaleString('en-GB', {
          day: '2-digit',
          month: 'short',
          year: 'numeric',
          hour: '2-digit',
          minute: '2-digit',
        })
      : 'Not available';
  };

  const fmtDate = (v) => {
    const d = safeDate(v);
    return d
      ? d.toLocaleDateString('en-GB', {
          day: '2-digit',
          month: 'short',
          year: 'numeric',
        })
      : 'Not available';
  };

  const statusText = (tx) =>
    String(tx?.order_status || tx?.payment_status || tx?.status || '').toLowerCase();

  const isCompletedTx = (tx) => {
    const s = statusText(tx);
    return ['completed', 'paid', 'confirmed', 'captured', 'success', 'successful', 'delivered', 'fulfilled'].includes(s);
  };

  const cleanName = (v) =>
    String(v || 'Customer')
      .trim()
      .replace(/\s+/g, ' ');

  const normalizeAmount = (v) => Number(v || 0);

  /* =========================
     SAFE DATA INITIALIZATION
  ========================== */

  const summary = (locals && locals.transactionSummary)
    ? locals.transactionSummary
    : (locals && locals.summaryData)
      ? locals.summaryData
      : {};

  const transactions = Array.isArray(locals?.transactionRows)
    ? locals.transactionRows
    : Array.isArray(locals?.transactionsData)
      ? locals.transactionsData
      : [];

  const recentTransactions = Array.isArray(locals?.recentTransactionsData)
    ? locals.recentTransactionsData
    : Array.isArray(locals?.recentTransactions)
      ? locals.recentTransactions
      : [];

  const completedTransactions = transactions.filter(isCompletedTx);

  const orderSearchResult =
    (locals && Object.prototype.hasOwnProperty.call(locals, 'orderSearchResult'))
      ? locals.orderSearchResult
      : null;

  const productSearchResult =
    (locals && Object.prototype.hasOwnProperty.call(locals, 'productSearchResult'))
      ? locals.productSearchResult
      : null;

  const queryOrderNumber =
    (locals && locals.queryOrderNumber)
      ? locals.queryOrderNumber
      : '';

  const queryProductId =
    (locals && locals.queryProductId)
      ? locals.queryProductId
      : '';

  /* =========================
     SUMMARY VALUES
  ========================== */

  const totalCount = Number(summary.totalCount || transactions.length || 0);
  const totalAmount = Number(summary.totalAmount || transactions.reduce((sum, tx) => sum + normalizeAmount(tx.amount || tx.grand_total), 0) || 0);
  const paidCount = Number(summary.paidCount || completedTransactions.length || 0);
  const refundedCount = Number(summary.refundedCount || 0);
  const pendingCount = Number(summary.pendingCount || 0);

  const currency = summary.currency || (locals.user && locals.user.currency) || 'AED';

  const userName = cleanName((locals.user && (locals.user.full_name || locals.user.name)) || 'Customer');
  const userEmail = (locals.user && locals.user.email) || 'Not available';

  /* =========================
     ROW MAPPERS
  ========================== */

  const mapTxRow = (tx) => ({
    transaction: tx.order_number || tx.transaction_reference || tx.title || '—',
    tracking: tx.tracking_id || tx.payment_reference || '—',
    date: tx.created_at ? fmtDateTime(tx.created_at) : 'Not available',
    status: tx.order_status || tx.payment_status || tx.status || '—',
    amount: Number(tx.amount || tx.grand_total || 0).toFixed(2),
    currency: tx.currency || currency,
    method: tx.payment_method || '—',
    gateway: tx.gateway_provider || '—',
    type: tx.transaction_type || 'transaction',
    detail_url: tx.detail_url || ''
  });

  const allRows = transactions.map(mapTxRow);
  const recentRows = recentTransactions.map(mapTxRow);
  const completedRows = completedTransactions.map(mapTxRow);

  const reportUser = userName;

    const adminData =
    (typeof admin !== 'undefined' && admin) ||
    (typeof user !== 'undefined' && user) ||
    (typeof sessionAdmin !== 'undefined' && sessionAdmin) ||
    {};

  const fullNameValue = adminData?.full_name || 'Admin';
%>

<div class="account-layout sidebar-collapsed" id="accountLayout">

  <aside class="account-sidebar collapsed" id="accountSidebar" aria-label="Account Sidebar">
    <%- include('../../includes/account-sidebar', { user: adminData, admin: adminData, activePage: 'transaction-history' }) %>
  </aside>

  <div class="account-right">
    <header class="account-topbar" aria-label="Account Topbar">
      <div class="topbar-left" >
        <button
          type="button"
          class="account-toggle-btn"
          id="accountToggleBtn"
          aria-label="Toggle account sidebar"
          aria-controls="accountSidebar"
          aria-expanded="false"
        >
          <i class="fa fa-bars"></i>
        </button>

        <div class="topbar-title" >
          <div class="title">Transaction History</div>
          <div class="sub">Professional transaction detail, recent orders, and export-ready records</div>
        </div>
      </div>

      <div class="topbar-right">
        <div class="billing-live-clock" id="liveClockTopbar">
            <small>Live time</small>
            <span id="liveClockValue">--:--:--</span>
        </div>
        <button type="button" class="btn-export-wide" id="exportAllPdfBtn" aria-label="Export all transactions as PDF">
          <i class="fa fa-file-pdf-o"></i> All PDF
        </button>
        <button type="button" class="btn-export-wide" id="exportAllExcelBtn" aria-label="Export all transactions as Excel">
          <i class="fa fa-file-excel-o"></i> All Excel
        </button>
        <button type="button" class="btn-export-wide" id="exportRecentPdfBtn" aria-label="Export recent transactions as PDF">
          <i class="fa fa-file-pdf-o"></i> Recent PDF
        </button>
        <button type="button" class="btn-export-wide" id="exportRecentExcelBtn" aria-label="Export recent transactions as Excel">
          <i class="fa fa-file-excel-o"></i> Recent Excel
        </button>

        <div class="account-user-mini">
          <i class="fa fa-user-circle"></i>
          <span id="topbarUserName"><%= fullNameValue %></span>
        </div>
      </div>
    </header>

    <div class="account-backdrop" id="accountBackdrop" aria-hidden="true"></div>

    <div class="account-content-wrap"> 
      <div class="billing-page-shell">
          <aside class="history-subsidebar" id="historySubSidebarInner">
            <div class="history-sidepanel" >
              <h3 class="history-sidepanel-title">Transaction Navigation</h3>
              <nav class="billing-nav" aria-label="Billing section navigation">
                <a href="/admin/a/account/billing" class="billing-nav-link">
                  <i class="fa fa-bar-chart"></i>
                  <span class="txt">Billing Summary</span>
                </a>
                <a href="/admin/a/account/transaction-history"  class="billing-nav-link active">
                  <i class="fa fa-exchange"></i>
                  <span class="txt">Transactions</span>
                </a>
              </nav>
            </div>
          </aside>

          <main class="history-main">

            <section class="card-panel pad mt-3">
              <div class="header-row">
                <div>
                  <h3 class="section-title">Transaction Summary</h3>
                  <p class="section-subtitle">A clean snapshot of total records, completed payments, pending items, and refunds.</p>
                </div>
                <div class="status-line">
                  <span class="saving-dot is-saved" id="savingDot"></span>
                  <span id="savingText">All changes saved</span>
                </div>
              </div>

              <div class="summary-grid">
                <div class="summary-box summary-income">
                  <div class="label">Total Transactions</div>
                  <div class="value"><%= totalCount %></div>
                  <div class="hint">All accessible transaction records.</div>
                </div>

                <div class="summary-box summary-success">
                  <div class="label">Completed / Paid</div>
                  <div class="value"><%= paidCount %></div>
                  <div class="hint">Successful and completed transactions.</div>
                </div>

                <div class="summary-box summary-warning">
                  <div class="label">Pending</div>
                  <div class="value"><%= pendingCount %></div>
                  <div class="hint">Pending or initiated items.</div>
                </div>

                <div class="summary-box summary-danger">
                  <div class="label">Refunds</div>
                  <div class="value"><%= refundedCount %></div>
                  <div class="hint">Refunded or partially refunded records.</div>
                </div>
              </div>

              <div class="header-row mt-4">
                <div>
                  <h3 class="section-title">Export Reports</h3>
                  <p class="section-subtitle">Download professional reports for all transactions, recent orders, completed payments, or one record only.</p>
                </div>
              </div>

              <div class="action-row mt-2">
                <button type="button" class="btn-export-wide" id="exportCompletedPdfBtn">
                  <i class="fa fa-file-pdf-o"></i> Completed PDF
                </button>
                <button type="button" class="btn-export-wide" id="exportCompletedExcelBtn">
                  <i class="fa fa-file-excel-o"></i> Completed Excel
                </button>
                <button type="button" class="btn-export-wide" id="exportAllPdfBtn2">
                  <i class="fa fa-file-pdf-o"></i> All PDF
                </button>
                <button type="button" class="btn-export-wide" id="exportAllExcelBtn2">
                  <i class="fa fa-file-excel-o"></i> All Excel
                </button>
              </div>
            </section>

            <section class="card-panel pad mt-3">
              <div class="header-row">
                <div>
                  <h3 class="section-title">Transaction Filters</h3>
                  <p class="section-subtitle">Filter by date range, status, payment method, gateway, search keyword, and sort order.</p>
                </div>
              </div>

              <form id="filterForm" method="GET" action="/admin/a/account/transaction-history" class="filters-grid" autocomplete="off">
                <div class="filter-box">
                  <label class="form-label" for="from">From Date</label>
                  <input type="date" class="form-control" id="from" name="from" value="<%= filters?.from || '' %>">
                </div>

                <div class="filter-box">
                  <label class="form-label" for="to">To Date</label>
                  <input type="date" class="form-control" id="to" name="to" value="<%= filters?.to || '' %>">
                </div>

                <div class="filter-box">
                  <label class="form-label" for="status">Status</label>
                  <select class="form-select" id="status" name="status">
                    <option value="">All Statuses</option>
                    <option value="pending" <%= filters?.status === 'pending' ? 'selected' : '' %>>Pending</option>
                    <option value="initiated" <%= filters?.status === 'initiated' ? 'selected' : '' %>>Initiated</option>
                    <option value="placed" <%= filters?.status === 'placed' ? 'selected' : '' %>>Placed</option>
                    <option value="confirmed" <%= filters?.status === 'confirmed' ? 'selected' : '' %>>Confirmed</option>
                    <option value="processing" <%= filters?.status === 'processing' ? 'selected' : '' %>>Processing</option>
                    <option value="completed" <%= filters?.status === 'completed' ? 'selected' : '' %>>Completed</option>
                    <option value="cancelled" <%= filters?.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
                    <option value="refunded" <%= filters?.status === 'refunded' ? 'selected' : '' %>>Refunded</option>
                  </select>
                </div>

                <div class="filter-box">
                  <label class="form-label" for="payment_method">Payment Method</label>
                  <select class="form-select" id="payment_method" name="payment_method">
                    <option value="">All Methods</option>
                    <option value="cod" <%= filters?.payment_method === 'cod' ? 'selected' : '' %>>COD</option>
                    <option value="bank_transfer" <%= filters?.payment_method === 'bank_transfer' ? 'selected' : '' %>>Bank Transfer</option>
                    <option value="card" <%= filters?.payment_method === 'card' ? 'selected' : '' %>>Card</option>
                  </select>
                </div>

                <div class="filter-box">
                  <label class="form-label" for="gateway_provider">Gateway</label>
                  <select class="form-select" id="gateway_provider" name="gateway_provider">
                    <option value="">All Gateways</option>
                    <option value="manual" <%= filters?.gateway_provider === 'manual' ? 'selected' : '' %>>Manual</option>
                    <option value="stripe" <%= filters?.gateway_provider === 'stripe' ? 'selected' : '' %>>Stripe</option>
                    <option value="checkout_com" <%= filters?.gateway_provider === 'checkout_com' ? 'selected' : '' %>>Checkout.com</option>
                    <option value="telr" <%= filters?.gateway_provider === 'telr' ? 'selected' : '' %>>Telr</option>
                    <option value="paypal" <%= filters?.gateway_provider === 'paypal' ? 'selected' : '' %>>PayPal</option>
                    <option value="paytabs" <%= filters?.gateway_provider === 'paytabs' ? 'selected' : '' %>>PayTabs</option>
                  </select>
                </div>

                <div class="filter-box">
                  <label class="form-label" for="q">Search</label>
                  <input
                    type="text"
                    class="form-control"
                    id="q"
                    name="q"
                    value="<%= filters?.q || '' %>"
                    placeholder="Order number, tracking ID, reference, or name"
                  >
                </div>

                <div class="filter-box">
                  <label class="form-label" for="sort">Sort</label>
                  <select class="form-select" id="sort" name="sort">
                    <option value="desc" <%= filters?.sort !== 'asc' ? 'selected' : '' %>>Newest first</option>
                    <option value="asc" <%= filters?.sort === 'asc' ? 'selected' : '' %>>Oldest first</option>
                  </select>
                </div>
              </form>

              <div class="action-row mt-3">
                <button type="submit" form="filterForm" class="btn-filter" id="applyFiltersBtn">
                  <i class="fa fa-filter"></i> Apply Filters
                </button>
                <a class="btn-ghost" href="/admin/a/account/transaction-history">
                  <i class="fa fa-refresh"></i> Reset
                </a>
              </div>
            </section>

            <section class="card-panel pad mt-3">
              <div class="header-row">
                <div>
                  <h3 class="section-title">Search One Order / One Product</h3>
                  <p class="section-subtitle">Separate lookup fields for order history and product-specific transactions.</p>
                </div>
              </div>

              <div class="search-grid">
                <div class="search-card">
                  <h4>Search One Order</h4>
                  <p>Find one exact order and export only that transaction record.</p>
                  <form method="GET" action="/admin/a/account/transaction-history" autocomplete="off">
                    <div class="mb-2">
                      <label class="form-label" for="order_number">Order Number</label>
                      <input
                        type="text"
                        class="form-control"
                        id="order_number"
                        name="order_number"
                        value="<%= queryOrderNumber || '' %>"
                        placeholder="ORD-20260424-XXXXXXX"
                      >
                    </div>
                    <div class="action-row">
                      <button type="submit" class="btn-secure">
                        <i class="fa fa-search"></i> Search Order
                      </button>
                      <button type="button" class="btn-ghost" id="exportOrderPdfBtn">
                        <i class="fa fa-file-pdf-o"></i> PDF
                      </button>
                      <button type="button" class="btn-ghost" id="exportOrderExcelBtn">
                        <i class="fa fa-file-excel-o"></i> Excel
                      </button>
                    </div>
                  </form>
                </div>

                <div class="search-card">
                  <h4>Search One Product</h4>
                  <p>Find a product-linked transaction record by product ID or product name.</p>
                  <form method="GET" action="/admin/a/account/transaction-history" autocomplete="off">
                    <div class="mb-2">
                      <label class="form-label" for="product_query">Product Search</label>
                      <input
                        type="text"
                        class="form-control"
                        id="product_query"
                        name="product_query"
                        value="<%= queryProductId || '' %>"
                        placeholder="Product ID or product keyword"
                      >
                    </div>
                    <div class="action-row">
                      <button type="submit" class="btn-secure">
                        <i class="fa fa-search"></i> Search Product
                      </button>
                      <button type="button" class="btn-ghost" id="exportProductPdfBtn">
                        <i class="fa fa-file-pdf-o"></i> PDF
                      </button>
                      <button type="button" class="btn-ghost" id="exportProductExcelBtn">
                        <i class="fa fa-file-excel-o"></i> Excel
                      </button>
                    </div>
                  </form>
                </div>
              </div>
            </section>

            <section class="card-panel pad mt-3">
              <div class="header-row">
                <div>
                  <h3 class="section-title">All Transactions</h3>
                  <p class="section-subtitle">Detailed transaction records with status, amount, payment method, and gateway.</p>
                </div>
              </div>

              <% if (transactions && transactions.length) { %>
                <div class="orders-table-wrap">
                  <table class="table orders-table">
                    <thead>
                      <tr>
                        <th>Transaction</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Amount</th>
                        <th>Method</th>
                        <th>Gateway</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% transactions.forEach((tx) => { %>
                        <tr>
                          <td>
                            <div>
                              <a class="order-link" href="<%= tx.detail_url || '#' %>">
                                <%= tx.order_number || tx.transaction_reference || tx.title || '—' %>
                              </a>
                            </div>
                            <div class="muted"><%= tx.tracking_id || tx.payment_reference || '—' %></div>
                          </td>
                          <td><%= tx.created_at ? fmtDateTime(tx.created_at) : 'Not available' %></td>
                          <td>
                            <div><%= tx.order_status || tx.payment_status || tx.status || '—' %></div>
                            <div class="muted"><%= tx.transaction_type || 'transaction' %></div>
                          </td>
                          <td class="amount"><%= Number(tx.amount || tx.grand_total || 0).toFixed(2) %> <%= tx.currency || currency %></td>
                          <td><%= tx.payment_method || '—' %></td>
                          <td><%= tx.gateway_provider || '—' %></td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } else { %>
                <div class="empty-state">No transaction records found.</div>
              <% } %>
            </section>

            <section class="card-panel pad mt-3">
              <div class="header-row">
                <div>
                  <h3 class="section-title">Recent Transactions</h3>
                  <p class="section-subtitle">The latest loaded records for fast review and export.</p>
                </div>
              </div>

              <% if (recentTransactions && recentTransactions.length) { %>
                <div class="orders-table-wrap">
                  <table class="table orders-table">
                    <thead>
                      <tr>
                        <th>Transaction</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Amount</th>
                        <th>Method</th>
                        <th>Gateway</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% recentTransactions.forEach((tx) => { %>
                        <tr>
                          <td>
                            <div>
                              <a class="order-link" href="<%= tx.detail_url || '#' %>">
                                <%= tx.order_number || tx.transaction_reference || tx.title || '—' %>
                              </a>
                            </div>
                            <div class="muted"><%= tx.tracking_id || tx.payment_reference || '—' %></div>
                          </td>
                          <td><%= tx.created_at ? fmtDateTime(tx.created_at) : 'Not available' %></td>
                          <td>
                            <div><%= tx.order_status || tx.payment_status || tx.status || '—' %></div>
                            <div class="muted"><%= tx.transaction_type || 'transaction' %></div>
                          </td>
                          <td class="amount"><%= Number(tx.amount || tx.grand_total || 0).toFixed(2) %> <%= tx.currency || currency %></td>
                          <td><%= tx.payment_method || '—' %></td>
                          <td><%= tx.gateway_provider || '—' %></td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } else { %>
                <div class="empty-state">No recent transaction records found.</div>
              <% } %>
            </section>

            <section class="card-panel pad mt-3">
              <div class="header-row">
                <div>
                  <h3 class="section-title">Completed Transactions</h3>
                  <p class="section-subtitle">Only completed, paid, or confirmed records for clean reporting and export.</p>
                </div>
              </div>

              <% if (completedTransactions && completedTransactions.length) { %>
                <div class="orders-table-wrap">
                  <table class="table orders-table">
                    <thead>
                      <tr>
                        <th>Transaction</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Amount</th>
                        <th>Method</th>
                        <th>Gateway</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% completedTransactions.forEach((tx) => { %>
                        <tr>
                          <td>
                            <div>
                              <a class="order-link" href="<%= tx.detail_url || '#' %>">
                                <%= tx.order_number || tx.transaction_reference || tx.title || '—' %>
                              </a>
                            </div>
                            <div class="muted"><%= tx.tracking_id || tx.payment_reference || '—' %></div>
                          </td>
                          <td><%= tx.created_at ? fmtDateTime(tx.created_at) : 'Not available' %></td>
                          <td>
                            <div><%= tx.order_status || tx.payment_status || tx.status || '—' %></div>
                            <div class="muted"><%= tx.transaction_type || 'transaction' %></div>
                          </td>
                          <td class="amount"><%= Number(tx.amount || tx.grand_total || 0).toFixed(2) %> <%= tx.currency || currency %></td>
                          <td><%= tx.payment_method || '—' %></td>
                          <td><%= tx.gateway_provider || '—' %></td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } else { %>
                <div class="empty-state">No completed transaction records found.</div>
              <% } %>
            </section>

            <section class="card-panel pad mt-3">
              <div class="header-row">
                <div>
                  <h3 class="section-title">Search Results</h3>
                  <p class="section-subtitle">A single order result and a single product result shown separately for clarity.</p>
                </div>
              </div>

              <div class="search-grid">
                <div>
                  <h4 class="section-title" style="font-size:1rem;">Order Result</h4>
                  <% if (orderSearchResult) { %>
                    <div class="detail-grid mt-3">
                      <div class="detail-box">
                        <div class="k">Order Number</div>
                        <div class="v"><%= orderSearchResult.order_number || '—' %></div>
                      </div>
                      <div class="detail-box">
                        <div class="k">Tracking ID</div>
                        <div class="v"><%= orderSearchResult.tracking_id || '—' %></div>
                      </div>
                      <div class="detail-box">
                        <div class="k">Date</div>
                        <div class="v"><%= fmtDateTime(orderSearchResult.created_at) %></div>
                      </div>
                      <div class="detail-box">
                        <div class="k">Amount</div>
                        <div class="v"><%= Number(orderSearchResult.amount || orderSearchResult.grand_total || 0).toFixed(2) %> <%= orderSearchResult.currency || currency %></div>
                      </div>
                    </div>
                  <% } else { %>
                    <div class="empty-state mt-3">Search an order to see its transaction details here.</div>
                  <% } %>
                </div>

                <div>
                  <h4 class="section-title" style="font-size:1rem;">Product Result</h4>
                  <% if (productSearchResult) { %>
                    <div class="detail-grid mt-3">
                      <div class="detail-box">
                        <div class="k">Product ID</div>
                        <div class="v"><%= productSearchResult.product_id || '—' %></div>
                      </div>
                      <div class="detail-box">
                        <div class="k">Product Name</div>
                        <div class="v"><%= productSearchResult.product_name || '—' %></div>
                      </div>
                      <div class="detail-box">
                        <div class="k">Transaction Count</div>
                        <div class="v"><%= productSearchResult.count || 0 %></div>
                      </div>
                      <div class="detail-box">
                        <div class="k">Total Amount</div>
                        <div class="v"><%= Number(productSearchResult.amount || 0).toFixed(2) %> <%= productSearchResult.currency || currency %></div>
                      </div>
                    </div>
                  <% } else { %>
                    <div class="empty-state mt-3">Search a product to see matching transaction details here.</div>
                  <% } %>
                </div>
              </div>
            </section>

            <section class="card-panel pad mt-3">
              <div class="header-row">
                <div>
                  <h3 class="section-title">Quick Actions</h3>
                  <p class="section-subtitle">Fast navigation for the most used account areas.</p>
                </div>
              </div>

              <div class="actions-grid">
                <a href="/admin/a/orders" class="quick-action-item">
                  <i class="fa fa-shopping-bag"></i><span>View Orders</span>
                </a>
                <a href="/admin/a/account/billing" class="quick-action-item">
                  <i class="fa fa-credit-card"></i><span>Billing Page</span>
                </a>
                <a href="/admin/a/account/transaction-history" class="quick-action-item">
                  <i class="fa fa-refresh"></i><span>Reload Transactions</span>
                </a>
                <a href="/customer/logout" class="quick-action-item">
                  <i class="fa fa-sign-out"></i><span>Logout</span>
                </a>
              </div>
            </section>

            <div class="account-footer-wrap">
              <%- include('../../includes/account-footer') %>
            </div>
          </main>
      </div>
    </div>
  </div>
</div>

<div class="toast-mini" id="toastMini" role="status" aria-live="polite"></div>

<script src="/customer/js/account.js"></script>
<script src="/customer/js/vendor/popper.min.js"></script>
<script src="/customer/js/bootstrap.min.js"></script>
<script src="/customer/js/main.js"></script>

<script>
(function () {
  const layout = document.getElementById('accountLayout');
  const sidebar = document.getElementById('accountSidebar');
  const toggleBtn = document.getElementById('accountToggleBtn');
  const backdrop = document.getElementById('accountBackdrop');
  const toast = document.getElementById('toastMini');
  const topbarUserName = document.getElementById('topbarUserName');
  const liveClockValue = document.getElementById("liveClockValue");
  const exportAllPdfBtn = document.getElementById('exportAllPdfBtn');
  const exportAllExcelBtn = document.getElementById('exportAllExcelBtn');
  const exportAllPdfBtn2 = document.getElementById('exportAllPdfBtn2');
  const exportAllExcelBtn2 = document.getElementById('exportAllExcelBtn2');
  const exportRecentPdfBtn = document.getElementById('exportRecentPdfBtn');
  const exportRecentExcelBtn = document.getElementById('exportRecentExcelBtn');
  const exportCompletedPdfBtn = document.getElementById('exportCompletedPdfBtn');
  const exportCompletedExcelBtn = document.getElementById('exportCompletedExcelBtn');
  const exportOrderPdfBtn = document.getElementById('exportOrderPdfBtn');
  const exportOrderExcelBtn = document.getElementById('exportOrderExcelBtn');
  const exportProductPdfBtn = document.getElementById('exportProductPdfBtn');
  const exportProductExcelBtn = document.getElementById('exportProductExcelBtn');

  if (!layout || !sidebar || !toggleBtn) return;

  const report = {
    userName: <%- JSON.stringify(reportUser) %>,
    currency: <%- JSON.stringify(currency) %>,
    summary: {
      totalCount: <%- JSON.stringify(totalCount) %>,
      totalAmount: <%- JSON.stringify(totalAmount) %>,
      paidCount: <%- JSON.stringify(paidCount) %>,
      refundedCount: <%- JSON.stringify(refundedCount) %>,
      pendingCount: <%- JSON.stringify(pendingCount) %>
    },
    allTransactions: <%- JSON.stringify(allRows) %>,
    recentTransactions: <%- JSON.stringify(recentRows) %>,
    completedTransactions: <%- JSON.stringify(completedRows) %>,
    orderSearchResult: <%- JSON.stringify(orderSearchResult || {}) %>,
    productSearchResult: <%- JSON.stringify(productSearchResult || {}) %>
  };

  function showToast(message) {
    if (!toast) return;
    toast.textContent = message;
    toast.classList.add('show');
    clearTimeout(showToast._t);
    showToast._t = setTimeout(() => toast.classList.remove('show'), 2400);
  }

  function isMobile() {
    return window.innerWidth <= 991;
  }

  function closeMobileSidebar() {
    sidebar.classList.remove('open');
    backdrop?.classList.remove('show');
    document.body.style.overflow = '';
    toggleBtn.setAttribute('aria-expanded', 'false');
  }

  function applySidebarMode() {
    if (isMobile()) {
      closeMobileSidebar();
      layout.classList.remove('sidebar-expanded');
      layout.classList.add('sidebar-collapsed');
      sidebar.classList.add('collapsed');
      sidebar.classList.remove('expanded');
      return;
    }

    layout.classList.remove('sidebar-expanded');
    layout.classList.add('sidebar-collapsed');
    sidebar.classList.add('collapsed');
    sidebar.classList.remove('expanded');
    backdrop?.classList.remove('show');
    document.body.style.overflow = '';
  }

  function scheduleRefresh() {
    clearInterval(refreshTimer);
    refreshTimer = setInterval(() => {
    refreshLiveData(false);
    }, 20000);
      }

  function startClock() {
    function tick() {
      if (!liveClockValue) return;
        liveClockValue.textContent = new Date().toLocaleTimeString("en-GB", {
          hour: "2-digit",
          minute: "2-digit",
          second: "2-digit"
        }
      );
    }

      tick();
      clearInterval(clockTimer);
      clockTimer = setInterval(tick, 1000);
  }

  function safeList(v) {
    return Array.isArray(v) ? v : [];
  }

  function sanitizeFilename(name) {
    return String(name || 'report').replace(/[^a-z0-9\-\_]+/gi, '_');
  }

  function exportRowsToPdf(title, rows, columns, filename) {
    if (!window.jspdf || !window.jspdf.jsPDF) {
      showToast('PDF library is not loaded');
      return;
    }

    const doc = new window.jspdf.jsPDF({ orientation: 'l', unit: 'pt', format: 'a4' });
    const pageWidth = doc.internal.pageSize.getWidth();
    const margin = 36;
    const right = pageWidth - margin;

    doc.setFont('helvetica', 'bold');
    doc.setFontSize(18);
    doc.text(title, margin, 46);

    doc.setFont('helvetica', 'normal');
    doc.setFontSize(10);
    doc.text(`Customer: ${report.userName}`, margin, 64);
    doc.text(`Generated: ${new Date().toLocaleString('en-GB')}`, margin, 78);
    doc.text(`Currency: ${report.currency}`, margin, 92);

    doc.setDrawColor(229, 231, 235);
    doc.line(margin, 106, right, 106);

    doc.autoTable({
      startY: 120,
      head: [columns],
      body: rows.length ? rows : [['No records found']],
      theme: 'grid',
      styles: {
        font: 'helvetica',
        fontSize: 8.5,
        cellPadding: 5,
        textColor: [15, 23, 42]
      },
      headStyles: {
        fillColor: [248, 250, 252],
        textColor: [15, 23, 42],
        fontStyle: 'bold'
      }
    });

    doc.save(`${sanitizeFilename(filename)}.pdf`);
  }

  function exportRowsToExcel(sheetName, rows, filename) {
    if (!window.XLSX) {
      showToast('Excel library is not loaded');
      return;
    }

    const wb = XLSX.utils.book_new();
    const ws = XLSX.utils.json_to_sheet(safeList(rows).length ? rows : [{ Message: 'No records found' }]);
    XLSX.utils.book_append_sheet(wb, ws, sheetName);
    XLSX.writeFile(wb, `${sanitizeFilename(filename)}.xlsx`);
  }

  function exportAllPdf() {
    const rows = report.allTransactions.map(r => [
      r.transaction, r.tracking, r.date, r.status, r.amount, r.currency, r.method, r.gateway, r.type
    ]);
    exportRowsToPdf(
      'JOOD Transaction Report — All Transactions',
      rows,
      ['Transaction', 'Tracking ID', 'Date', 'Status', 'Amount', 'Currency', 'Method', 'Gateway', 'Type'],
      `JOOD_Transaction_Report_All_${report.userName}`
    );
  }

  function exportAllExcel() {
    exportRowsToExcel('All Transactions', report.allTransactions, `JOOD_Transaction_Report_All_${report.userName}`);
  }

  function exportRecentPdf() {
    const rows = report.recentTransactions.map(r => [
      r.transaction, r.tracking, r.date, r.status, r.amount, r.currency, r.method, r.gateway, r.type
    ]);
    exportRowsToPdf(
      'JOOD Transaction Report — Recent Orders',
      rows,
      ['Transaction', 'Tracking ID', 'Date', 'Status', 'Amount', 'Currency', 'Method', 'Gateway', 'Type'],
      `JOOD_Transaction_Report_Recent_${report.userName}`
    );
  }

  function exportRecentExcel() {
    exportRowsToExcel('Recent Transactions', report.recentTransactions, `JOOD_Transaction_Report_Recent_${report.userName}`);
  }

  function exportCompletedPdf() {
    const rows = report.completedTransactions.map(r => [
      r.transaction, r.tracking, r.date, r.status, r.amount, r.currency, r.method, r.gateway, r.type
    ]);
    exportRowsToPdf(
      'JOOD Transaction Report — Completed Only',
      rows,
      ['Transaction', 'Tracking ID', 'Date', 'Status', 'Amount', 'Currency', 'Method', 'Gateway', 'Type'],
      `JOOD_Transaction_Report_Completed_${report.userName}`
    );
  }

  function exportCompletedExcel() {
    exportRowsToExcel('Completed Transactions', report.completedTransactions, `JOOD_Transaction_Report_Completed_${report.userName}`);
  }

  function exportSingleOrderPdf() {
    const tx = report.orderSearchResult || {};
    if (!tx || (!tx.order_number && !tx.transaction_reference)) {
      showToast('No order result to export');
      return;
    }

    exportRowsToPdf(
      'JOOD Transaction Report — Single Order',
      [[
        tx.order_number || '—',
        tx.tracking_id || '—',
        tx.created_at ? new Date(tx.created_at).toLocaleString('en-GB') : 'Not available',
        tx.order_status || tx.payment_status || '—',
        Number(tx.amount || tx.grand_total || 0).toFixed(2),
        tx.currency || report.currency,
        tx.payment_method || '—',
        tx.gateway_provider || '—'
      ]],
      ['Order', 'Tracking ID', 'Date', 'Status', 'Amount', 'Currency', 'Method', 'Gateway'],
      `JOOD_Transaction_Order_${tx.order_number || 'result'}`
    );
  }

  function exportSingleOrderExcel() {
    const tx = report.orderSearchResult || {};
    if (!tx || (!tx.order_number && !tx.transaction_reference)) {
      showToast('No order result to export');
      return;
    }

    exportRowsToExcel('Order Result', [{
      Order: tx.order_number || '—',
      TrackingID: tx.tracking_id || '—',
      Date: tx.created_at ? new Date(tx.created_at).toLocaleString('en-GB') : 'Not available',
      Status: tx.order_status || tx.payment_status || '—',
      Amount: Number(tx.amount || tx.grand_total || 0).toFixed(2),
      Currency: tx.currency || report.currency,
      Method: tx.payment_method || '—',
      Gateway: tx.gateway_provider || '—'
    }], `JOOD_Transaction_Order_${tx.order_number || 'result'}`);
  }

  function exportSingleProductPdf() {
    const tx = report.productSearchResult || {};
    if (!tx || (!tx.product_id && !tx.product_name)) {
      showToast('No product result to export');
      return;
    }

    exportRowsToPdf(
      'JOOD Transaction Report — Single Product',
      [[
        tx.product_id || '—',
        tx.product_name || '—',
        String(tx.count || 0),
        Number(tx.amount || 0).toFixed(2),
        tx.currency || report.currency
      ]],
      ['Product ID', 'Product Name', 'Count', 'Amount', 'Currency'],
      `JOOD_Transaction_Product_${tx.product_id || 'result'}`
    );
  }

  function exportSingleProductExcel() {
    const tx = report.productSearchResult || {};
    if (!tx || (!tx.product_id && !tx.product_name)) {
      showToast('No product result to export');
      return;
    }

    exportRowsToExcel('Product Result', [{
      ProductID: tx.product_id || '—',
      ProductName: tx.product_name || '—',
      Count: Number(tx.count || 0),
      Amount: Number(tx.amount || 0).toFixed(2),
      Currency: tx.currency || report.currency
    }], `JOOD_Transaction_Product_${tx.product_id || 'result'}`);
  }

  function wireExports() {
    [exportAllPdfBtn, exportAllPdfBtn2].forEach(btn => btn?.addEventListener('click', exportAllPdf));
    [exportAllExcelBtn, exportAllExcelBtn2].forEach(btn => btn?.addEventListener('click', exportAllExcel));
    exportRecentPdfBtn?.addEventListener('click', exportRecentPdf);
    exportRecentExcelBtn?.addEventListener('click', exportRecentExcel);
    exportCompletedPdfBtn?.addEventListener('click', exportCompletedPdf);
    exportCompletedExcelBtn?.addEventListener('click', exportCompletedExcel);
    exportOrderPdfBtn?.addEventListener('click', exportSingleOrderPdf);
    exportOrderExcelBtn?.addEventListener('click', exportSingleOrderExcel);
    exportProductPdfBtn?.addEventListener('click', exportSingleProductPdf);
    exportProductExcelBtn?.addEventListener('click', exportSingleProductExcel);
  }

  toggleBtn.addEventListener('click', () => {
    if (isMobile()) {
      if (sidebar.classList.contains('open')) {
        closeMobileSidebar();
      } else {
        sidebar.classList.add('open');
        backdrop?.classList.add('show');
        document.body.style.overflow = 'hidden';
        toggleBtn.setAttribute('aria-expanded', 'true');
      }
      return;
    }

    const expanded = layout.classList.toggle('sidebar-expanded');
    layout.classList.toggle('sidebar-collapsed', !expanded);
    sidebar.classList.toggle('expanded', expanded);
    sidebar.classList.toggle('collapsed', !expanded);
    toggleBtn.setAttribute('aria-expanded', String(expanded));
  });

  backdrop?.addEventListener('click', closeMobileSidebar);
  window.addEventListener('resize', applySidebarMode);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMobileSidebar();
  });

  wireExports();
  applySidebarMode();
  startClock();


})();
</script>
</body>
</html>
