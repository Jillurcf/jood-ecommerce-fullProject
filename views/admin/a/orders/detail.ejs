<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' && csrfToken ? csrfToken : '' %>" />
  <title>Order Detail — Admin | JOOD</title>
  <meta name="robots" content="noindex, nofollow" />

  <link rel="shortcut icon" href="/customer/images/web-img-vid/favicon.png" type="image/x-icon">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <link rel="stylesheet" href="/customer/css/bootstrap.min.css" />
  <link rel="stylesheet" href="/customer/css/account.css" />
  <link rel="stylesheet" href="/customer/css/style.css" />
  <link rel="stylesheet" href="/customer/css/responsive.css" />

  <style>
    :root {
      --bg: #ffffff;
      --card: #ffffff;
      --border: #e5ebf3;
      --text: #0f172a;
      --muted: #64748b;
      --brand: #111827;
      --brand-soft: #eef2ff;
      --ok: #166534;
      --ok-bg: #ecfdf3;
      --warn: #9a3412;
      --warn-bg: #fff7ed;
      --danger: #991b1b;
      --danger-bg: #fef2f2;
      --info: #1d4ed8;
      --info-bg: #eff6ff;
      --radius: 16px;
      --shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
    }

    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      padding: 0;
      min-height: 100%;
      width: 100%;
      overflow-x: hidden;
      background: var(--bg);
      color: var(--text);
      font-family: Arial, Helvetica, sans-serif;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .account-user-mini {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      font-weight: 800;
      color: var(--text);
      white-space: nowrap;
    }

    .btn-back,
    .btn-secondary {
      height: 44px;
      border: 1px solid var(--border);
      border-radius: 12px;
      background: #fff;
      color: var(--text);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 0 14px;
      cursor: pointer;
      font-weight: 800;
    }

    .btn-back:hover,
    .btn-secondary:hover {
      border-color: #d7e0ec;
    }


    .hero {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 18px;
      align-items: flex-start;
    }

    .hero h1 {
      margin: 0;
      font-size: 1.25rem;
      font-weight: 900;
    }

    .hero p {
      margin: 6px 0 0;
      color: var(--muted);
      font-size: .92rem;
      line-height: 1.55;
    }

    .hero-meta {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      align-items: center;
      justify-content: flex-end;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 7px 11px;
      border-radius: 999px;
      font-size: .82rem;
      font-weight: 900;
      white-space: nowrap;
      border: 1px solid transparent;
    }

    .badge.pending {
      background: var(--warn-bg);
      color: var(--warn);
      border-color: #fde68a;
    }

    .badge.processing,
    .badge.ongoing {
      background: var(--info-bg);
      color: var(--info);
      border-color: #bfdbfe;
    }

    .badge.completed {
      background: var(--ok-bg);
      color: var(--ok);
      border-color: #c7eed6;
    }

    .badge.cancelled {
      background: var(--danger-bg);
      color: var(--danger);
      border-color: #f3c9c9;
    }

    .badge.refunded {
      background: #f5f3ff;
      color: #6d28d9;
      border-color: #ddd6fe;
    }

    .badge.unknown {
      background: #f8fafc;
      color: #475569;
      border-color: #e2e8f0;
    }

    .page-section {
      margin-bottom: 18px;
    }

    .section-head {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 12px;
      flex-wrap: wrap;
      margin-bottom: 12px;
    }

    .section-head h2 {
      margin: 0;
      font-size: 1rem;
      font-weight: 900;
    }

    .section-head h3 {
      margin: 0;
      font-size: 1rem;
      font-weight: 900;
    }

    .section-head p {
      margin: 4px 0 0;
      color: var(--muted);
      font-size: .9rem;
    }

    .detail-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
      margin-bottom: 18px;
    }

    .detail-box {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 16px;
      min-width: 0;
    }

    .detail-box .k {
      font-size: .78rem;
      color: var(--muted);
      margin-bottom: 8px;
      text-transform: uppercase;
      letter-spacing: .03em;
    }

    .detail-box .v {
      font-size: .92rem;
      color: var(--text);
      font-weight: 600;
      word-break: break-word;
    }

    .order-table {
      width: 100%;
      border-collapse: collapse;
      min-width: 100%;
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 16px;
      overflow: hidden;
    }

    .order-table th,
    .order-table td {
      padding: 14px 16px;
      border-bottom: 1px solid var(--border);
      text-align: left;
      font-size: .9rem;
      vertical-align: top;
    }

    .order-table th {
      background: #f8fafc;
      font-weight: 800;
      color: #334155;
      position: sticky;
      top: 0;
      z-index: 1;
    }

    .order-table tbody tr:last-child td {
      border-bottom: none;
    }

    .order-table td.amount {
      font-weight: 900;
      white-space: nowrap;
    }

    .text-muted {
      color: var(--muted);
    }

    .card {
      background: #fff;
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 18px;
    }

    .card h3 {
      margin: 0 0 8px;
      font-size: 1rem;
      font-weight: 900;
    }

    .card p {
      margin: 0;
      color: var(--muted);
      font-size: .9rem;
      line-height: 1.5;
    }

    .detail-content {
      white-space: pre-wrap;
      color: var(--text);
      font-size: .92rem;
      line-height: 1.6;
    }

    @media (max-width: 991px) {
      .detail-grid {
        grid-template-columns: 1fr;
      }

      .hero {
        align-items: flex-start;
      }

      .hero-meta {
        justify-content: flex-start;
      }
    }
  </style>
</head>

<body>
  <%
  const safeText = (v, fallback = '—') => {
    const s = String(v ?? '').trim().replace(/\s+/g, ' ');
    return s || fallback;
  };

  const safeLower = (v) => safeText(v, '').toLowerCase();

  const parseDt = (v) => {
    if (!v) return null;
    const d = new Date(v);
    return Number.isNaN(d.getTime()) ? null : d;
  };

  const fmtDt = (v) => {
    const d = parseDt(v);
    return d
      ? d.toLocaleString('en-GB', {
          day: '2-digit',
          month: 'short',
          year: 'numeric',
          hour: '2-digit',
          minute: '2-digit',
        })
      : 'Not available';
  };

  const money = (value, currency = 'AED') => {
    const amount = Number(value || 0);
    const code = String(currency || 'AED').trim() || 'AED';
    try {
      return new Intl.NumberFormat('en-AE', {
        style: 'currency',
        currency: code,
        maximumFractionDigits: 2,
      }).format(amount);
    } catch {
      return `${code} ${amount.toFixed(2)}`;
    }
  };

  const order = detail?.order || {};
  const items = Array.isArray(detail?.items) ? detail.items : [];
  const orderStatus = safeLower(order.payment_status || order.order_status || 'pending');
  const orderRef = safeText(order.order_number || order.tracking_id || order.payment_reference || order.id || 'Unknown');
  const orderTitle = `Order ${orderRef}`;
  const adminName = safeText((admin && (admin.full_name || admin.name)) || (user && (user.full_name || user.name)) || 'Admin', 'Admin');
  const paymentMethod = safeText(order.payment_method || 'Not available');
  const gateway = safeText(order.gateway_provider || 'Not available');
  const billingAddress = safeText(order.billing_address || 'Not available');
  const shippingAddress = safeText(order.shipping_address || 'Not available');
  const notes = safeText(order.notes || 'No notes provided', 'No notes provided');
  const orderTotal = money(order.grand_total || order.amount || 0, order.currency);
  const subtotal = money(order.subtotal_amount || 0, order.currency);
  const discount = money(order.discount_amount || 0, order.currency);
  const vat = money(order.vat_amount || 0, order.currency);
  const labelStatus = orderStatus || 'unknown';
  const statusClass = ['pending','confirmed'].includes(labelStatus)
    ? 'pending'
    : ['processing','ongoing'].includes(labelStatus)
      ? 'processing'
      : labelStatus === 'completed'
        ? 'completed'
        : labelStatus === 'cancelled'
          ? 'cancelled'
          : labelStatus === 'refunded'
            ? 'refunded'
            : 'unknown';
  %>

  <div class="account-layout" id="accountLayout">
    <aside class="account-sidebar" id="accountSidebar" aria-label="Account Sidebar">
      <%- include('../../includes/account-sidebar', { user: admin || user, admin: admin || user, activePage: 'orders' }) %>
    </aside>

    <div class="account-right">
      <header class="account-topbar" aria-label="Account Topbar">
        <div class="account-topbar-left">
          <button type="button" class="account-toggle-btn" id="accountToggleBtn" aria-label="Toggle sidebar" aria-controls="accountSidebar" aria-expanded="false">
            <i class="fa fa-bars"></i>
          </button>
        </div>

        <div class="account-topbar-right">
          <div class="account-user-mini">
            <i class="fa fa-user-circle"></i>
            <span id="topbarUserName"><%= adminName %></span>
          </div>
        </div>
      </header>

      <div class="account-backdrop" id="accountBackdrop" aria-hidden="true"></div>

      <main class="account-content">
        <section class="hero">
          <div>
            <h1>Order Detail</h1>
            <p>Review the selected order, customer details, payment data, and ordered items.</p>
          </div>

          <div class="hero-meta">
            <a href="/admin/a/account/Dashboard" class="btn-back"><i class="fa fa-arrow-left"></i> Dashboard</a>
            <span class="badge <%= statusClass %>"><%= orderStatus.replace(/_/g, ' ') %></span>
          </div>
        </section>

        <section class="page-section">
          <div class="section-head">
            <div>
              <h2>Order summary</h2>
              <p>Order reference, amounts, and transaction details.</p>
            </div>
          </div>

          <div class="detail-grid">
            <div class="detail-box">
              <div class="k">Order reference</div>
              <div class="v"><%= orderRef %></div>
            </div>
            <div class="detail-box">
              <div class="k">Order date</div>
              <div class="v"><%= fmtDt(order.created_at || order.created_at_label) %></div>
            </div>
            <div class="detail-box">
              <div class="k">Payment method</div>
              <div class="v"><%= paymentMethod %></div>
            </div>
            <div class="detail-box">
              <div class="k">Gateway</div>
              <div class="v"><%= gateway %></div>
            </div>
            <div class="detail-box">
              <div class="k">Customer</div>
              <div class="v"><%= safeText(order.customer_name || order.email || order.phone || 'Guest') %></div>
            </div>
            <div class="detail-box">
              <div class="k">Contact</div>
              <div class="v"><%= safeText(order.email || order.phone || 'Not available') %></div>
            </div>
          </div>
        </section>

        <section class="page-section">
          <div class="card">
            <div class="section-head">
              <div>
                <h3>Order items</h3>
                <p>Products included in this order.</p>
              </div>
            </div>
            <div class="table-wrap">
              <table class="order-table">
                <thead>
                  <tr>
                    <th>Product</th>
                    <th>Quantity</th>
                    <th>Unit price</th>
                    <th>Total</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (items.length) { %>
                  <% items.forEach((item) => { %>
                  <tr>
                    <td><%= safeText(item.product_name || item.product_catalog_name || 'Item') %></td>
                    <td><%= Number(item.quantity || 0) %></td>
                    <td><%= money(item.unit_price || 0, order.currency) %></td>
                    <td class="amount"><%= money(item.line_total || 0, order.currency) %></td>
                  </tr>
                  <% }) %>
                  <% } else { %>
                  <tr>
                    <td colspan="5" class="text-muted">No items were found for this order.</td>
                  </tr>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </section>
        
        <section class="page-section">
          <div class="section-head">
            <div>
              <h2>Amounts</h2>
              <p>Breakdown of order subtotal, discount, VAT and total.</p>
            </div>
          </div>
          <div class="detail-grid">
            <div class="detail-box">
              <div class="k">Subtotal</div>
              <div class="v"><%= subtotal %></div>
            </div>
            <div class="detail-box">
              <div class="k">Discount</div>
              <div class="v"><%= discount %></div>
            </div>
            <div class="detail-box">
              <div class="k">VAT / taxes</div>
              <div class="v"><%= vat %></div>
            </div>
            <div class="detail-box">
              <div class="k">Grand total</div>
              <div class="v"><%= orderTotal %></div>
            </div>
          </div>
        </section>

        <section class="page-section">
            <div class="section-head">
              <div>
                <h3>Billing & shipping</h3>
                <p>Addresses and shipping details associated with this order.</p>
              </div>
            </div>
            <div class="detail-grid">
              <div class="detail-box">
                <div class="k">Billing address</div>
                <div class="v"><%= safeText(order.billing_address_text || 'Not available') %></div>
                
              </div>
              <div class="detail-box">
                <div class="k">Shipping address</div>
                <div class="v"><%= safeText(order.shipping_address_text || 'Not available') %></div>
              </div>
            </div>
        </section>

        

        <section class="page-section">
          <div class="card">
            <div class="section-head">
              <div>
                <h3>Notes</h3>
                <p>Additional comments or instructions stored with the order.</p>
              </div>
            </div>
            <div class="detail-content"><%= notes %></div>
          </div>
        </section>
      </main>

      <%- include('../../includes/account-footer') %>
    </div>
  </div>

  <script>
    (() => {
      "use strict";

      const layout = document.getElementById("accountLayout");
      const sidebar = document.getElementById("accountSidebar");
      const toggleBtn = document.getElementById("accountToggleBtn");
      const backdrop = document.getElementById("accountBackdrop");

      if (!layout || !sidebar || !toggleBtn || !backdrop) return;

      const mobileQuery = window.matchMedia("(max-width: 991px)");

      const setDesktopState = () => {
        layout.classList.add("sidebar-expanded");
        layout.classList.remove("sidebar-collapsed");
        sidebar.classList.remove("collapsed");
        sidebar.classList.remove("open");
        backdrop.classList.remove("show");
        toggleBtn.setAttribute("aria-expanded", "true");
        document.body.style.overflow = "";
      };

      const setMobileState = () => {
        layout.classList.remove("sidebar-expanded");
        layout.classList.remove("sidebar-collapsed");
        sidebar.classList.remove("collapsed");
        sidebar.classList.remove("open");
        backdrop.classList.remove("show");
        toggleBtn.setAttribute("aria-expanded", "false");
        document.body.style.overflow = "";
      };

      const openMobileSidebar = () => {
        layout.classList.add("sidebar-expanded");
        sidebar.classList.add("open");
        backdrop.classList.add("show");
        toggleBtn.setAttribute("aria-expanded", "true");
        document.body.style.overflow = "hidden";
      };

      const closeMobileSidebar = () => {
        layout.classList.remove("sidebar-expanded");
        sidebar.classList.remove("open");
        backdrop.classList.remove("show");
        toggleBtn.setAttribute("aria-expanded", "false");
        document.body.style.overflow = "";
      };

      const syncLayout = () => {
        if (mobileQuery.matches) {
          setMobileState();
        } else {
          setDesktopState();
        }
      };

      toggleBtn.addEventListener("click", () => {
        if (mobileQuery.matches) {
          if (sidebar.classList.contains("open")) {
            closeMobileSidebar();
          } else {
            openMobileSidebar();
          }
          return;
        }

        const collapsed = layout.classList.contains("sidebar-collapsed");
        if (collapsed) {
          layout.classList.remove("sidebar-collapsed");
          layout.classList.add("sidebar-expanded");
          sidebar.classList.remove("collapsed");
          toggleBtn.setAttribute("aria-expanded", "true");
        } else {
          layout.classList.remove("sidebar-expanded");
          layout.classList.add("sidebar-collapsed");
          sidebar.classList.add("collapsed");
          toggleBtn.setAttribute("aria-expanded", "false");
        }
      });

      backdrop.addEventListener("click", () => {
        if (mobileQuery.matches) {
          closeMobileSidebar();
        }
      });

      if (typeof mobileQuery.addEventListener === "function") {
        mobileQuery.addEventListener("change", syncLayout);
      } else if (typeof mobileQuery.addListener === "function") {
        mobileQuery.addListener(syncLayout);
      }

      syncLayout();
    })();
  </script>
</body>

</html>
