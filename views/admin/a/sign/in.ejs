<!DOCTYPE html>
<html lang="en">
<head>
  <title>SignIn - JOOD | Quality Goods & Products</title>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta
    name="description"
    content="Login to your JOOD account to access your orders, manage your profile, and enjoy secure shopping with fast delivery and trusted service."
  >
  <meta
    name="keywords"
    content="JOOD login, ecommerce login, secure account login, customer login, online shopping account, sign in JOOD"
  >
  <meta name="robots" content="noindex, follow">

  <link rel="canonical" href="https://jood.com/customer/sign/in">
   <link rel="shortcut icon" href="/customer/images/web-img-vid/favicon.png" type="image/x-icon">


  <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,400,600,700" rel="stylesheet" />
  <link href="/customer/assets/css/nucleo-icons.css" rel="stylesheet" />
  <link href="/customer/assets/css/nucleo-svg.css" rel="stylesheet" />
  <script src="https://kit.fontawesome.com/42d5adcbca.js" crossorigin="anonymous"></script>
  <link id="pagestyle" href="/customer/assets/css/soft-ui-dashboard.css?v=1.0.3" rel="stylesheet" />
</head>

<body class="g-sidenav-show bg-gray-100">
  <style>
        .btn {
      background-color: #fe9d00;
      color: #fff;
      border: 1px solid #fe9d00;
    }
  </style>
  <section class="min-vh-100 mb-8">
    <div
      class="page-header align-items-start min-vh-50 pt-5 pb-11 m-3 border-radius-lg bg-warning"
      style="background-image: url('/customer/assets/img/curved-images/s.png');"
    >
      <span class="mask bg-gradient-dark opacity-6"></span>

      <div class="container position-relative">
        <div class="row justify-content-center">
          <div class="col-lg-5 text-center mx-auto">
            <div class="logo mb-4">
              <a href="/">
                <img src="/customer/images/web-img-vid/logo.png" width="120" alt="logo">
              </a>
            </div>

            <h1 class="text-white mb-2">Welcome Back!</h1>

            <p class="text-lead text-white">
              Sign in to access your dashboard, orders, and wishlist.
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="container">
      <div class="row mt-lg-n10 mt-md-n11 mt-n10">
        <div class="col-xl-4 col-lg-5 col-md-7 mx-auto">
          <div class="card z-index-0">
            <div class="card-header text-center pt-4">
              <h5>Sign in</h5>
            </div>

            <div class="card-body">
              <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-danger text-white" role="alert">
                  <%= error %>
                </div>
              <% } %>

              <% if (typeof success !== 'undefined' && success) { %>
                <div class="alert alert-success text-white" role="alert">
                  <%= success %>
                </div>
              <% } %>

              <form action="/admin/a/sign/in" method="POST" autocomplete="off">
                <% if (csrfToken) { %>
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <% } %>

                <div class="mb-3">
                  <input
                    type="email"
                    name="email"
                    class="form-control"
                    placeholder="Email"
                    required
                    autocomplete="email"
                    value="<%= old && old.email ? old.email : '' %>"
                  >
                </div>

                <div class="mb-3">
                  <input
                    type="password"
                    name="password"
                    class="form-control"
                    placeholder="Password"
                    required
                    autocomplete="current-password"
                  >
                </div>

                <div class="form-check form-switch mb-3">
                  <input
                    class="form-check-input"
                    type="checkbox"
                    id="rememberMe"
                    name="remember_me"
                    value="1"
                    checked
                  >
                  <label class="form-check-label" for="rememberMe">Remember me</label>
                </div>

                <div class="text-end mb-3">
                  <a href="/admin/a/password/forgot/recovery" class="text-sm text-dark font-weight-bolder">
                    Forgot password?
                  </a>
                </div>

                <div class="text-center">
                  <button type="submit" class="btn  w-100 my-4">
                    Sign In
                  </button>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script src="/customer/assets/js/core/popper.min.js"></script>
  <script src="/customer/assets/js/core/bootstrap.min.js"></script>
  <script src="/customer/assets/js/plugins/perfect-scrollbar.min.js"></script>
  <script src="/customer/assets/js/plugins/smooth-scrollbar.min.js"></script>
  <script async defer src="https://buttons.github.io/buttons.js"></script>
  <script src="/customer/assets/js/soft-ui-dashboard.min.js?v=1.0.3"></script>
</body>
</html>