<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' && csrfToken ? csrfToken : '' %>" />

  <title>My Addresses — JOOD | Quality Goods & Products</title>
  <meta name="description" content="Manage your saved delivery addresses on JOOD." />
  <meta name="robots" content="noindex, nofollow" />

  <link rel="shortcut icon" href="/customer/images/web-img-vid/favicon.png" type="image/x-icon">

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="/customer/css/material-design-iconic-font.min.css" />
  <link rel="stylesheet" href="/customer/css/bootstrap.min.css" />
  <link rel="stylesheet" href="/customer/css/account.css" />
  <link rel="stylesheet" href="/customer/css/style.css" />
  <link rel="stylesheet" href="/customer/css/responsive.css" />
  <script src="/customer/js/vendor/modernizr-2.8.3.min.js"></script>

  <style>
    :root {
      --bg: #ffffff;
      --card: #ffffff;
      --card-soft: #fbfdff;
      --border: #e5ebf3;
      --text: #0f172a;
      --muted: #64748b;
      --ok: #166534;
      --okbg: #ecfdf3;
      --danger: #991b1b;
      --dangerbg: #fef2f2;
      --shadow-soft: 0 6px 18px rgba(15, 23, 42, .04);
      --radius: 18px;
    }

    * {
      box-sizing: border-box;
    }

    body {
      background: var(--bg);
      color: var(--text);
    }

    .address-page {
      display: flex;
      flex-direction: column;
      gap: 14px;
      min-width: 0;
    }

    .address-hero,
    .address-card,
    .address-form-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }

    .address-hero {
      padding: 18px;
      display: flex;
      justify-content: space-between;
      gap: 16px;
      align-items: flex-start;
      flex-wrap: wrap;
    }

    .address-hero h2 {
      margin: 0;
      font-size: 1.05rem;
      font-weight: 800;
      letter-spacing: -.01em;
    }

    .address-hero p {
      margin: 6px 0 0;
      color: var(--muted);
      font-size: .88rem;
      line-height: 1.5;
      max-width: 760px;
    }

    .status-line {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: .82rem;
      color: #475569;
      white-space: nowrap;
      background: #f8fafc;
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 8px 12px;
    }

    .saving-dot {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: #94a3b8;
      flex: 0 0 auto;
    }

    .saving-dot.is-saving {
      background: #0f172a;
      animation: pulse 1.2s infinite;
    }

    .saving-dot.is-saved {
      background: #16a34a;
    }

    .saving-dot.is-error {
      background: #dc2626;
    }



    .address-form-card {
      padding: 18px;
    }

    .section-title {
      margin: 0 0 10px;
      font-size: .98rem;
      font-weight: 800;
      color: var(--text);
      letter-spacing: -.01em;
    }

    .section-subtitle {
      margin: 0 0 12px;
      color: var(--muted);
      font-size: .84rem;
      line-height: 1.5;
    }

    .form-label,
    .field-label {
      font-weight: 700;
      color: var(--text);
      margin-bottom: 6px;
      font-size: .84rem;
    }

    .form-control {
      min-height: 44px;
      border-radius: 11px;
      border-color: #d8e0ea;
      font-size: .88rem;
      background: #fff;
    }

    .form-control:focus {
      border-color: #cbd5e1;
    }

    .btn-darkish {
      background: #0f172a;
      border-color: #0f172a;
      color: #fff;
      border-radius: 11px;
      font-weight: 700;
      padding: 10px 14px;
      transition: .2s ease;
    }

    .btn-darkish:hover {
      background: #111827;
      color: #fff;
      transform: translateY(-1px);
    }

    .addresses-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
      min-width: 0;
    }

    .address-card {
      padding: 16px;
      min-width: 0;
    }

    .address-top {
      display: flex;
      justify-content: space-between;
      gap: 10px;
      align-items: flex-start;
      margin-bottom: 12px;
      min-width: 0;
    }

    .badge-pin,
    .badge-primary {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 7px 11px;
      border-radius: 999px;
      font-size: .78rem;
      font-weight: 800;
      white-space: nowrap;
    }

    .badge-pin {
      background: #f8fafc;
      color: #475569;
      border: 1px solid #e2e8f0;
      cursor: pointer;
      user-select: none;
    }

    .badge-pin.is-default {
      background: var(--okbg);
      color: var(--ok);
      border-color: #c7eed6;
    }

    .badge-primary {
      background: var(--okbg);
      color: var(--ok);
      border: 1px solid #c7eed6;
    }

    .mini-actions {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .mini-btn {
      border: 1px solid var(--border);
      background: #fff;
      border-radius: 10px;
      padding: 8px 10px;
      font-size: .82rem;
      font-weight: 700;
      color: var(--text);
      cursor: pointer;
      transition: .2s ease;
    }

    .mini-btn:hover {
      border-color: #cbd5e1;
      background: #f8fafc;
    }

    .mini-btn.delete {
      color: var(--danger);
      border-color: #f3c9c9;
      background: var(--dangerbg);
    }

    .mini-btn.pin {
      color: var(--ok);
      border-color: #c7eed6;
      background: var(--okbg);
    }

    .save-chip {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: .78rem;
      color: #475569;
      flex-wrap: wrap;
    }

    .save-chip b {
      color: var(--text);
      font-weight: 700;
    }

    .read-only-box {
      background: var(--card-soft);
      border: 1px solid #e2e8f0;
      border-radius: 11px;
      padding: 12px 14px;
      color: #475569;
      min-height: 42px;
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
      word-break: break-word;
      font-size: .88rem;
      line-height: 1.45;
    }

    .read-only-box strong {
      color: var(--text);
      font-weight: 700;
    }

    .toast-mini {
      position: fixed;
      right: 18px;
      bottom: 18px;
      z-index: 1060;
      min-width: 220px;
      max-width: 90vw;
      padding: 12px 14px;
      border-radius: 13px;
      background: #0f172a;
      color: #fff;
      font-size: .86rem;
      transform: translateY(18px);
      opacity: 0;
      pointer-events: none;
      transition: .25s ease;
      border: 1px solid rgba(255, 255, 255, .08);
    }

    .toast-mini.show {
      transform: translateY(0);
      opacity: 1;
    }

    .empty-state {
      padding: 16px;
      border: 1px dashed #d8e0ea;
      border-radius: 14px;
      background: #fbfdff;
      color: #64748b;
      font-size: .9rem;
      line-height: 1.5;
    }

    .field-hint {
      font-size: .78rem;
      color: #64748b;
      margin-top: 6px;
    }

    .is-invalid-field {
      border-color: #dc2626 !important;
      background: #fffafa;
    }

    .card-busy {
      opacity: .72;
      pointer-events: none;
    }

    @media (max-width: 991px) {
      .addresses-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 768px) {

      .address-hero,
      .address-form-card,
      .address-card {
        padding: 14px;
        border-radius: 15px;
      }

      .mini-actions {
        width: 100%;
        justify-content: flex-start;
      }

      .address-top {
        flex-direction: column;
      }

      .status-line {
        width: 100%;
        justify-content: flex-start;
      }
    }
  </style>
</head>

<body>
  <% const safeUser=user || null; %>
    <% const formatDate=(value)=> value
      ? new Date(value).toLocaleString('en-GB', {
      day: '2-digit',
      month: 'short',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit'
      })
      : 'Not available';

      const allAddresses = Array.isArray(addresses) ? addresses : [];
      const primaryAddress = allAddresses.find(a => a && a.is_primary) || null;
      const savedAddresses = allAddresses.filter(a => a && !a.is_primary);
      const safeCsrf = typeof csrfToken !== 'undefined' && csrfToken ? csrfToken : '';
      %>

      <div class="account-layout" id="accountLayout">
        <aside class="account-sidebar" id="accountSidebar" aria-label="Account Sidebar">
          <%- include('../includes/account-sidebar', { user, activePage: 'addresses' }) %>
        </aside>

        <div class="account-right">
          <%- include('../includes/account-topbar') %>

            <div class="account-backdrop" id="accountBackdrop" aria-hidden="true"></div>

            <main class="account-content">
              <section class="account-page-content">
                <div class="address-page">

                    <section class="account-page-header">
                      <%- include('../includes/account-header', { title: 'My Addresses' ,
                        subtitle: 'Manage saved delivery addresses from one place. You can add new addresses, edit saved ones, pin a default address, or delete old entries. Your permanent account address is shown separately and stays read-only here for safety.'
                        , primaryAction: null, secondaryAction: null }) %>
                            <div class="status-line" aria-live="polite" style="float: inline-end;">
                      <span class="saving-dot" id="savingDot"></span>
                      <span id="savingText">All changes saved</span>
                    </div>
                    </section>
                

                  <div class="address-form-card">
                    <h3 class="section-title">Add New Address</h3>
                    <div class="section-subtitle">Create a new delivery address for faster checkout.</div>

                    <form id="addAddressForm" class="row g-3" autocomplete="off" novalidate>
                      <input type="hidden" name="_csrf" value="<%= safeCsrf %>">

                      <div class="col-12 col-md-4">
                        <label class="form-label" for="new_address">Address</label>
                        <input id="new_address" name="address" class="form-control" placeholder="Enter address"
                          autocomplete="street-address" maxlength="255" required>
                        <div class="field-hint">Use a street, building, or villa address.</div>
                      </div>

                      <div class="col-12 col-md-3">
                        <label class="form-label" for="new_city">City</label>
                        <input id="new_city" name="city" class="form-control" placeholder="Enter city"
                          autocomplete="address-level2" maxlength="100" required>
                      </div>

                      <div class="col-12 col-md-3">
                        <label class="form-label" for="new_country">Country</label>
                        <input id="new_country" name="country" class="form-control" placeholder="Enter country"
                          autocomplete="country-name" maxlength="100" required>
                      </div>

                      <div class="col-12 col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-darkish w-100">
                          <i class="fa fa-plus"></i> Add
                        </button>
                      </div>
                    </form>
                  </div>

                  <div class="address-card">
                    <div class="d-flex align-items-start justify-content-between gap-2 flex-wrap mb-2">
                      <div>
                        <h3 class="section-title mb-0">Permanent Address</h3>
                        <div class="section-subtitle mb-0">
                          This address is fetched from your account and displayed in read-only mode. To update your
                          permanent address, please go to your profile settings.
                        </div>
                      </div>
                    </div>

                    <% if (primaryAddress) { %>
                      <div class="read-only-box" aria-label="Permanent address">
                        <strong>
                          <%= primaryAddress.address || '—' %>
                        </strong>
                        <span>•</span>
                        <span>
                          <%= primaryAddress.city || '—' %>
                        </span>
                        <span>•</span>
                        <span>
                          <%= primaryAddress.country || '—' %>
                        </span>
                        <span class="badge-primary ms-auto">
                          <i class="fa fa-thumb-tack"></i>
                          Permanent
                        </span>
                      </div>
                      <% } else { %>
                        <div class="empty-state">
                          No permanent address is saved in your customer account yet.
                        </div>
                        <% } %>
                  </div>

                  <div class="d-flex align-items-start justify-content-between gap-2 flex-wrap">
                    <div>
                      <h3 class="section-title mb-0">Saved Addresses</h3>
                      <div class="section-subtitle mb-0">These addresses can be edited, deleted, or pinned as default.
                      </div>
                    </div>
                  </div>

                  <div class="addresses-grid" id="addressesGrid">
                    <% if (savedAddresses.length) { %>
                      <% savedAddresses.forEach((addr)=> { %>
                        <form class="address-card js-address-card" data-id="<%= addr.id %>" autocomplete="off"
                          novalidate>
                          <input type="hidden" name="_csrf" value="<%= safeCsrf %>">
                          <input type="hidden" name="id" value="<%= addr.id %>">

                          <div class="address-top">
                            <div>
                              <div class="badge-pin <%= addr.is_default ? 'is-default' : '' %> js-pin-btn" role="button"
                                tabindex="0" aria-label="Set as default address" title="Set as default address">
                                <i class="fa fa-thumb-tack"></i>
                                <span>
                                  <%= addr.is_default ? 'PINNED' : 'SET PIN' %>
                                </span>
                              </div>
                            </div>

                            <div class="mini-actions">
                              <button type="button" class="mini-btn pin js-pin">
                                <i class="fa fa-thumb-tack"></i> PIN
                              </button>
                              <button type="button" class="mini-btn delete js-delete">
                                <i class="fa fa-trash"></i> Delete
                              </button>
                            </div>
                          </div>

                          <div class="mb-3">
                            <label class="field-label" for="address_<%= addr.id %>">Address</label>
                            <input id="address_<%= addr.id %>" name="address" class="form-control js-autosave"
                              value="<%= addr.address || '' %>" maxlength="255" autocomplete="street-address" required>
                          </div>

                          <div class="row g-3">
                            <div class="col-12 col-md-6">
                              <label class="field-label" for="city_<%= addr.id %>">City</label>
                              <input id="city_<%= addr.id %>" name="city" class="form-control js-autosave"
                                value="<%= addr.city || '' %>" maxlength="100" autocomplete="address-level2" required>
                            </div>
                            <div class="col-12 col-md-6">
                              <label class="field-label" for="country_<%= addr.id %>">Country</label>
                              <input id="country_<%= addr.id %>" name="country" class="form-control js-autosave"
                                value="<%= addr.country || '' %>" maxlength="100" autocomplete="country-name" required>
                            </div>
                          </div>

                          <div class="mt-3 save-chip">
                            <span>Updated:</span>
                            <b>
                              <%= formatDate(addr.updated_at) %>
                            </b>
                          </div>
                        </form>
                        <% }) %>
                          <% } else { %>
                            <div class="address-card">
                              <div class="empty-state">No saved addresses yet.</div>
                            </div>
                            <% } %>
                  </div>

                </div>
              </section>


            </main>
            <%- include('../includes/account-footer') %>
        </div>
      </div>

      <div class="toast-mini" id="toastMini" role="status" aria-live="polite"></div>

      <script src="/customer/js/account.js"></script>
      <script>
        (() => {
          'use strict';

          const API = {
            add: '/customer/u/addresses/add',
            update: '/customer/u/addresses/update',
            remove: '/customer/u/addresses/delete',
            pin: '/customer/u/addresses/default'
          };

          const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';
          const toast = document.getElementById('toastMini');
          const savingDot = document.getElementById('savingDot');
          const savingText = document.getElementById('savingText');
          const grid = document.getElementById('addressesGrid');
          const addForm = document.getElementById('addAddressForm');
          const debounceMap = new WeakMap();
          const pendingCards = new WeakSet();

          function setState(type = 'idle', message = 'All changes saved') {
            if (!savingDot || !savingText) return;
            savingDot.className = 'saving-dot';
            if (type === 'saving') savingDot.classList.add('is-saving');
            if (type === 'saved') savingDot.classList.add('is-saved');
            if (type === 'error') savingDot.classList.add('is-error');
            savingText.textContent = message;
          }

          function showToast(message = '') {
            if (!toast || !message) return;
            toast.textContent = message;
            toast.classList.add('show');
            clearTimeout(showToast._t);
            showToast._t = setTimeout(() => toast.classList.remove('show'), 2400);
          }

          function getTokenFromForm(form) {
            return form?.querySelector('input[name="_csrf"]')?.value || csrfToken || '';
          }

          function normalize(value) {
            return String(value ?? '').replace(/\s+/g, ' ').trim();
          }

          function getFormData(form) {
            const data = {};
            const fd = new FormData(form);
            for (const [key, value] of fd.entries()) {
              data[key] = normalize(value);
            }
            return data;
          }

          function validateAddressPayload(data) {
            for (const field of ['address', 'city', 'country']) {
              if (!normalize(data[field])) {
                return `${field.charAt(0).toUpperCase() + field.slice(1)} is required`;
              }
            }
            return '';
          }

          async function request(url, data, token) {
            if (!token) throw new Error('CSRF token missing');

            const response = await fetch(url, {
              method: 'POST',
              credentials: 'same-origin',
              headers: {
                'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
                'X-Requested-With': 'XMLHttpRequest',
                'X-CSRF-Token': token
              },
              body: new URLSearchParams({ ...data, _csrf: token })
            });

            const text = await response.text();
            let json = {};

            if (text) {
              try {
                json = JSON.parse(text);
              } catch {
                throw new Error('Invalid server response');
              }
            }

            if (!response.ok || json.success === false) {
              throw new Error(json.message || 'Request failed');
            }

            return json;
          }

          function debounce(card, fn, delay = 650) {
            clearTimeout(debounceMap.get(card));
            debounceMap.set(card, setTimeout(fn, delay));
          }

          function setBusy(card, busy) {
            if (!card) return;
            card.classList.toggle('card-busy', !!busy);
          }

          async function saveAddress(form) {
            if (!form || pendingCards.has(form)) return;
            const data = getFormData(form);
            const token = getTokenFromForm(form);
            if (!data.id) return;

            const validationError = validateAddressPayload(data);
            if (validationError) {
              setState('error', validationError);
              showToast(validationError);
              return;
            }

            try {
              pendingCards.add(form);
              setBusy(form, true);
              setState('saving', 'Saving changes...');
              const result = await request(API.update, data, token);
              setState('saved', result.message || 'Saved');
              showToast(result.message || 'Updated');
            } catch (error) {
              setState('error', error.message || 'Error');
              showToast(error.message || 'Error');
            } finally {
              setBusy(form, false);
              pendingCards.delete(form);
            }
          }

          async function pinAddress(form) {
            if (!form || pendingCards.has(form)) return;
            const data = getFormData(form);
            const token = getTokenFromForm(form);
            if (!data.id) return;

            try {
              pendingCards.add(form);
              setBusy(form, true);
              setState('saving', 'Pinning address...');
              const result = await request(API.pin, { id: data.id }, token);
              setState('saved', result.message || 'Pinned');
              showToast(result.message || 'Pinned');
              window.location.reload();
            } catch (error) {
              setState('error', error.message || 'Error');
              showToast(error.message || 'Error');
            } finally {
              setBusy(form, false);
              pendingCards.delete(form);
            }
          }

          async function deleteAddress(form) {
            if (!form || pendingCards.has(form)) return;
            const data = getFormData(form);
            const token = getTokenFromForm(form);
            if (!data.id) return;
            if (!window.confirm('Delete this address?')) return;

            try {
              pendingCards.add(form);
              setBusy(form, true);
              setState('saving', 'Deleting address...');
              const result = await request(API.remove, { id: data.id }, token);
              setState('saved', result.message || 'Deleted');
              showToast(result.message || 'Deleted');
              form.remove();

              if (grid && !grid.querySelector('.js-address-card')) {
                const empty = document.createElement('div');
                empty.className = 'address-card';
                empty.innerHTML = '<div class="empty-state">No saved addresses yet.</div>';
                grid.appendChild(empty);
              }
            } catch (error) {
              setState('error', error.message || 'Error');
              showToast(error.message || 'Error');
            } finally {
              setBusy(form, false);
              pendingCards.delete(form);
            }
          }

          function bindCard(form) {
            const inputs = form.querySelectorAll('.js-autosave');
            const pinBtn = form.querySelector('.js-pin');
            const deleteBtn = form.querySelector('.js-delete');
            const pinBadge = form.querySelector('.js-pin-btn');

            inputs.forEach((input) => {
              input.addEventListener('input', () => {
                setState('saving', 'Typing...');
                debounce(form, () => saveAddress(form));
              });

              input.addEventListener('blur', () => {
                const hasValue = normalize(input.value).length > 0;
                input.classList.toggle('is-invalid-field', !hasValue);
              });
            });

            pinBtn?.addEventListener('click', () => pinAddress(form));
            pinBadge?.addEventListener('click', () => pinAddress(form));
            pinBadge?.addEventListener('keydown', (e) => {
              if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                pinAddress(form);
              }
            });

            deleteBtn?.addEventListener('click', () => deleteAddress(form));
          }

          addForm?.addEventListener('submit', async (e) => {
            e.preventDefault();
            const data = getFormData(addForm);
            const token = getTokenFromForm(addForm);
            const validationError = validateAddressPayload(data);

            if (validationError) {
              setState('error', validationError);
              showToast(validationError);
              return;
            }

            try {
              setState('saving', 'Adding address...');
              const result = await request(API.add, data, token);
              setState('saved', result.message || 'Added');
              showToast(result.message || 'Added');
              window.location.reload();
            } catch (error) {
              setState('error', error.message || 'Error');
              showToast(error.message || 'Error');
            }
          });

          document.querySelectorAll('.js-address-card').forEach(bindCard);
          setState('saved', 'All changes saved');
        })();
      </script>
</body>

</html>