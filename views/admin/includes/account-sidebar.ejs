<%
  const fullName = (user?.full_name || 'My Account').trim();
  const initials = fullName
    ? fullName
        .split(' ')
        .filter(Boolean)
        .slice(0, 2)
        .map(word => word[0]?.toUpperCase() || '')
        .join('')
    : 'M';

  const active = (key) => activePage === key ? 'active' : '';
%>

<!-- <aside class="account-sidebar" id="accountSidebar" aria-label="Account Sidebar"> -->
<button class="account-sidebar-close" id="accountSidebarClose" aria-label="Close sidebar">
  <i class="fa fa-times"></i>
</button>
<!-- BRAND / LOGO -->
<div class="account-sidebar-brand">
  <a href="/" class="account-brand-link" aria-label="Home">
    <img src="/customer/images/web-img-vid/logo.png" class="account-logo" alt="Logo">
  </a>
</div>

<!-- SIDEBAR HEADER -->
<div class="account-sidebar-top">
  <div class="account-profile">

    <!-- AVATAR -->
    <div class="account-avatar" aria-hidden="true">
      <% if (user?.avatar) { %>
      <img src="<%= user.avatar %>" alt="<%= fullName %> avatar">
      <% } else { %>
      <div class="avatar-initials">
        <%= initials || 'M' %>
      </div>
      <% } %>
    </div>

    <!-- USER INFO -->
    <div class="account-user-info">
      <div class="account-name"><%= fullName %></div>
      <div class="account-email"><%= user?.email || '' %></div>
    </div>

  </div>
</div>

<!-- NAVIGATION -->
<nav class="account-nav" aria-label="Account navigation">

  <a href="/admin/a/account/dashboard" class="account-nav-link <%= active('dashboard') %>" data-title="Dashboard" aria-current="<%= activePage === 'dashboard' ? 'page' : 'false' %>">
    <i class="fa fa-th-large"></i>
    <span class="link-text">Dashboard</span>
  </a>
  <a href="/admin/a/profile/myprofile" class="account-nav-link <%= active('profile') %>" data-title="Profile" aria-current="<%= activePage === 'profile' ? 'page' : 'false' %>">
    <i class="fa fa-id-card"></i>
    <span class="link-text">Profiles</span>
  </a>

  <a href="/admin/a/account/billing" class="account-nav-link <%= active('billing') %>" data-title="Billing" aria-current="<%= activePage === 'billing' ? 'page' : 'false' %>">
    <i class="fa fa-credit-card"></i>
    <span class="link-text">Billing & Transactions </span>
  </a>

  <a href="/admin/a/orders" class="account-nav-link <%= active('orders') %>" data-title="Orders" aria-current="<%= activePage === 'orders' ? 'page' : 'false' %>">
    <i class="fa fa-shopping-bag"></i>
    <span class="link-text">Orders</span>
  </a>
  <li class="account-nav-dropdown">

    <a href="#" class="account-nav-link dropdown-toggle <%= ['products-items','init-parent-category','product-list','category'].includes(activePage) ? 'active' : '' %>" data-bs-toggle="collapse" data-bs-target="#productsMenu" aria-expanded="<%= ['products-items','init-parent-category','product-list','category'].includes(activePage) ? 'true' : 'false' %>">
      <i class="fa-solid fa-boxes-stacked"></i>
      <span class="link-text">Products & Items</span>
      <!-- <i class="fa fa-chevron-down dropdown-arrow ms-auto"></i> -->
    </a>

    <div id="productsMenu" class="collapse <%= ['products-items','init-parent-category','product-list','category'].includes(activePage) ? 'show' : '' %>">
      <div class="account-submenu">

        <a href="/admin/parent-category" class="account-submenu-link <%= active('init-parent-category') %>">
          <i class="fa fa-folder-tree"></i>
          <span>Parent Categories</span>
        </a>

        <a href="/admin/category" class="account-submenu-link <%= active('category') %>">
          <i class="fa fa-tags"></i>
          <span>Categories</span>
        </a>

        <a href="/admin/product-list" class="account-submenu-link <%= active('product-list') %>">
          <i class="fa fa-box"></i>
          <span>Product List</span>
        </a>

        <a href="/admin/add-product" class="account-submenu-link <%= active('add-product') %>">
          <i class="fa fa-plus-circle"></i>
          <span>Add Product</span>
        </a>

      </div>
    </div>

  </li>

  <a href="/admin/a/setting/updateEmail" class="account-nav-link <%= active('security') %>" data-title="Security" aria-current="<%= activePage === 'security' ? 'page' : 'false' %>">
    <i class="fa fa-lock"></i>
    <span class="link-text">Security</span>
  </a>


  <a href="/admin/a/logout" class="account-nav-link logout" data-title="Logout">
    <i class="fa fa-sign-out"></i>
    <span class="link-text">Logout</span>
  </a>

</nav>

<style>
  .account-submenu {
    padding: 6px 0 6px 48px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .account-submenu-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    border-radius: 10px;
    color: var(--text);
    text-decoration: none;
    transition: all .2s ease;
    font-size: .92rem;
  }

  .account-submenu-link:hover {
    background: rgba(245, 158, 11, .08);
  }

  .account-submenu-link.active {
    background: var(--primary-soft);
    color: var(--primary);
    font-weight: 600;
  }

  .account-submenu-link i {
    width: 18px;
    text-align: center;
  }

  .dropdown-arrow {
    font-size: .75rem;
    transition: transform .25s ease;
  }

  .account-nav-link[aria-expanded="true"] .dropdown-arrow {
    transform: rotate(180deg);
  }
</style>
<!-- </aside> -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>