<!-- Fonts & Icons -->
<link href="https://fonts.googleapis.com/css?family=Open+Sans:300,400,600,700" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
  :root{
    --bg:#fff;
    --text:#111827;
    --muted:#6b7280;
    --line:#e5e7eb;
    --line-strong:#d1d5db;
    --shadow:0 10px 28px rgba(15,23,42,.08);
    --sidebar-width:280px;
    --header-height:60px;
  }

  html, body{
    height:100%;
    margin:0;
    font-family:'Open Sans',system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;
    background:var(--bg);
    color:var(--text);
    -webkit-font-smoothing:antialiased;
    text-rendering:optimizeLegibility;
  }

  *{ box-sizing:border-box; }
  a{ color:inherit; text-decoration:none; }
  button{ font:inherit; }

  body{
    overflow-x:hidden;
  }

  /* Make bootstrap modals always above sidebar */
  .modal{ z-index: 2500 !important; }
  .modal-backdrop{ z-index: 2400 !important; }

  /* Sidebar */
  #sidenav-main{
    position:fixed;
    inset:0 auto 0 0;
    width:var(--sidebar-width);
    height:100vh;
    background:var(--bg);
    border-right:1px solid var(--line);
    box-shadow:var(--shadow);
    z-index:2200;
    transform:translateX(-100%);
    transition:transform .25s ease, box-shadow .2s ease;
    padding:16px 14px;
    overflow:hidden;
  }

  #sidenav-main .sidenav-scroll{
    height:100%;
    overflow-y:auto;
    padding-right:6px;
    scrollbar-width: thin;
    scrollbar-color: rgba(0,0,0,.2) transparent;
  }
  #sidenav-main .sidenav-scroll::-webkit-scrollbar{ width:6px; }
  #sidenav-main .sidenav-scroll::-webkit-scrollbar-thumb{
    background:transparent;
    border-radius:999px;
  }
  #sidenav-main:hover .sidenav-scroll::-webkit-scrollbar-thumb{
    background:rgba(0,0,0,.22);
  }
  #sidenav-main:hover .sidenav-scroll{
    scrollbar-color: rgba(0,0,0,.22) transparent;
  }

  body.show-sidenav #sidenav-main{
    transform:translateX(0);
  }

  @media (min-width:1200px){
    #sidenav-main{
      transform:translateX(0);
    }

    body.main-with-sidebar main{
      margin-left:var(--sidebar-width);
    }

    body.main-with-sidebar .topbar{
      margin-left:var(--sidebar-width);
      width:calc(100% - var(--sidebar-width));
    }

    body.desktop-collapsed #sidenav-main{
      transform:translateX(-100%);
    }

    body.desktop-collapsed main,
    body.desktop-collapsed .topbar{
      margin-left:0;
      width:100%;
    }
  }

  /* Overlay */
  #sidenav-overlay{
    position:fixed;
    inset:0;
    background:rgba(17,24,39,.38);
    opacity:0;
    pointer-events:none;
    transition:opacity .2s ease;
    z-index:2150;
  }

  body.show-sidenav #sidenav-overlay{
    opacity:1;
    pointer-events:auto;
  }

  /* Sidebar header */
  .brand{
    display:flex;
    align-items:center;
    gap:10px;
    padding:6px 6px 14px;
    margin-bottom:10px;
    border-bottom:1px solid var(--line);
  }
  .brand img{
    height:38px;
    width:auto;
    display:block;
  }
  .brand .title{
    font-weight:800;
    font-size:14px;
    color:var(--text);
    line-height:1.2;
  }
  .brand .muted{
    font-size:12px;
    color:var(--muted);
  }

  /* Close button in sidebar */
  #iconSidenav{
    display:none;
    position:absolute;
    top:12px;
    right:12px;
    width:36px;
    height:36px;
    border-radius:999px;
    border:1px solid var(--line);
    background:#fff;
    color:var(--text);
    align-items:center;
    justify-content:center;
    z-index:2;
  }

  @media (max-width:1199.98px){
    #iconSidenav{ display:inline-flex; }
  }

  /* Sidebar links */
  .nav-list{
    list-style:none;
    padding:0;
    margin:0;
  }
  .nav-item{
    margin:4px 0;
  }
  .nav-link{
    display:flex;
    align-items:center;
    gap:10px;
    padding:11px 12px;
    border-radius:12px;
    color:var(--text);
    border:1px solid transparent;
    transition:background .15s ease, border-color .15s ease, transform .15s ease;
    width:100%;
  }
  .nav-link:hover{
    background:#f9fafb;
    border-color:#f3f4f6;
    transform:translateY(-1px);
  }
  .nav-link i{
    width:18px;
    text-align:center;
    color:var(--muted);
  }
  .nav-link .nav-link-text{
    font-weight:600;
    font-size:14px;
  }

  .sidebar-submenu{
    list-style:none;
    padding-left:14px;
    margin:4px 0 6px 8px;
    border-left:1px dashed var(--line-strong);
  }
  .sidebar-submenu .nav-link{
    padding:9px 10px;
    font-size:13px;
    border-radius:10px;
  }

  /* Topbar */
  .topbar{
    position:sticky;
    top:0;
    left:0;
    right:0;
    height:var(--header-height);
    display:flex;
    align-items:center;
    justify-content:flex-start;
    gap:12px;
    padding:0 16px;
    background:rgba(255,255,255,.94);
    backdrop-filter:saturate(180%) blur(10px);
    border-bottom:1px solid rgba(229,231,235,.9);
    z-index:2100;
    transition:margin-left .25s ease, width .25s ease;
  }

  .topbar-inner{
    width:100%;
    display:flex;
    align-items:center;
    justify-content:flex-start;
    gap:12px;
  }

  .nav-brand-inline{
    display:none;
    align-items:center;
    gap:8px;
    flex:0 0 auto;
  }

  .nav-brand-inline img{
    height:40px;
    width:auto;
    display:block;
  }

  @media (min-width:1200px){
    body.desktop-collapsed .nav-brand-inline{
      display:flex;
    }
  }

  /* Hamburger button stays left */
  #iconNavbarSidenav{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    width:42px;
    height:42px;
    border-radius:12px;
    border:1px solid var(--line);
    background:#fff;
    color:var(--text);
    flex:0 0 auto;
    margin:0;
    padding:0;
    box-shadow:0 1px 2px rgba(0,0,0,.03);
  }
  #iconNavbarSidenav:hover{
    background:#f9fafb;
    border-color:#dbe0e6;
  }

  .sidenav-toggler-inner{
    display:inline-flex;
    flex-direction:column;
    justify-content:space-between;
    width:18px;
    height:14px;
  }
  .sidenav-toggler-line{
    width:100%;
    height:2px;
    background:var(--text);
    border-radius:999px;
  }

  .topbar-title{
    font-size:15px;
    font-weight:700;
    color:var(--text);
    white-space:nowrap;
  }
  .topbar-subtitle{
    font-size:12px;
    color:var(--muted);
    margin-top:2px;
  }

  /* Main content */
  main{
    display:block;
    width:100%;
    min-height:calc(100vh - var(--header-height));
    transition:margin-left .25s ease, width .25s ease;
  }

  body.main-with-sidebar main{
    margin-left:var(--sidebar-width);
    width:calc(100% - var(--sidebar-width));
  }

  body.desktop-collapsed main{
    margin-left:0;
    width:100%;
  }

  /* Optional active state */
  .nav-item .collapse.show + .nav-link,
  .nav-item .nav-link[aria-expanded="true"]{
    background:#f8fafc;
    border-color:#edf2f7;
  }

  /* Utility */
  .muted{
    color:var(--muted);
  }

  @media (max-width:1199.98px){
    .topbar{
      width:100%;
      margin-left:0;
    }
  }
</style>

