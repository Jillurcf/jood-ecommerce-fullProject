<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

  <!-- page content goes here -->

<script>
  (function () {
    'use strict';

    const toggle = document.getElementById('iconNavbarSidenav');
    const closeBtn = document.getElementById('iconSidenav');
    const overlay = document.getElementById('sidenav-overlay');
    const sidebar = document.getElementById('sidenav-main');
    const body = document.body;

    if (!toggle || !overlay || !sidebar) return;

    const isDesktop = () => window.innerWidth >= 1200;

    function setAria(open) {
      sidebar.setAttribute('aria-hidden', String(!open));
      overlay.setAttribute('aria-hidden', String(!open));
      toggle.setAttribute('aria-expanded', String(open));
    }

    function openMobile() {
      body.classList.add('show-sidenav');
      body.classList.remove('desktop-collapsed');
      setAria(true);
    }

    function closeMobile() {
      body.classList.remove('show-sidenav');
      setAria(false);
    }

    function openDesktop() {
      body.classList.remove('desktop-collapsed');
      body.classList.add('main-with-sidebar');
      setAria(true);
    }

    function collapseDesktop() {
      body.classList.add('desktop-collapsed');
      body.classList.remove('main-with-sidebar');
      setAria(false);
    }

    function initState() {
      if (isDesktop()) {
        openDesktop();
      } else {
        closeMobile();
      }
    }

    toggle.addEventListener('click', function (ev) {
      ev.preventDefault();

      if (isDesktop()) {
        if (body.classList.contains('desktop-collapsed')) {
          openDesktop();
        } else {
          collapseDesktop();
        }
      } else {
        if (body.classList.contains('show-sidenav')) {
          closeMobile();
        } else {
          openMobile();
        }
      }
    });

    overlay.addEventListener('click', closeMobile);

    if (closeBtn) {
      closeBtn.addEventListener('click', function () {
        if (isDesktop()) collapseDesktop();
        else closeMobile();
      });
    }

    document.addEventListener('keydown', function (ev) {
      if (ev.key === 'Escape' || ev.key === 'Esc') {
        if (isDesktop()) {
          if (!body.classList.contains('desktop-collapsed')) collapseDesktop();
        } else {
          if (body.classList.contains('show-sidenav')) closeMobile();
        }
      }
    });

    let resizeTimer = null;
    window.addEventListener('resize', function () {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function () {
        if (isDesktop()) {
          body.classList.remove('show-sidenav');
          if (!body.classList.contains('desktop-collapsed')) openDesktop();
        } else {
          body.classList.remove('main-with-sidebar');
          closeMobile();
        }
      }, 100);
    });

    initState();
  })();
</script>