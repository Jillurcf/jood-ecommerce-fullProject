<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <title>Add Product — Admin (Professional Rewrite)</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="csrf-token" content="<%= csrfToken %>">
  <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,400,600,700" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css"
    crossorigin="anonymous" referrerpolicy="no-referrer">
  <link href="/admin/assets/css/nucleo-icons.css" rel="stylesheet" />
  <link href="/admin/assets/css/nucleo-svg.css" rel="stylesheet" />
    <link rel="shortcut icon" href="/customer/images/web-img-vid/favicon.png" type="image/x-icon">

  <link href="/admin/assets/css/soft-ui-dashboard.css?v=1.0.3" rel="stylesheet" />
  <link rel="stylesheet" href="/customer/css/account.css" />

 <style>
      /* thumbnail container */
      .variant-media-list {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        align-items: flex-start;
      }

      /* consistent thumb wrapper */
      .thumb-wrap {
        width: 140px;
        /* fixed thumb size (adjust) */
        height: 140px;
        border-radius: 6px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fff;
      }

      /* image thumbs (cover the box, keep aspect) */
      .thumb-wrap img.variant-thumb,
      .thumb-wrap video.variant-thumb {
        width: 100%;
        height: 100%;
        object-fit: cover;
        /* crop to fit box cleanly */
        display: block;
        border: 0;
      }

      /* if you want videos slightly wider than images (optional) */
      .thumb-wrap.video-thumb {
        width: 200px;
        height: 140px;
      }

      /* main preview (edit mode) */
      #mainPreview {
        display: block;
        max-width: 520px;
        margin-top: 12px;
      }

      #mainPreviewMedia img,
      #mainPreviewMedia video {
        width: 100%;
        height: auto;
        max-height: 420px;
        object-fit: contain;
        /* preserve full media without cropping */
      }

      /* make buttons inside thumb-wrap sit below via layout change if needed */
      .thumb-wrap>.btn {
        margin-top: 6px;
        width: 100%;
      }

      /* responsive: reduce size on small screens */
      @media (max-width:600px) {
        .thumb-wrap {
          width: 96px;
          height: 96px;
        }
      }

      :root {
        --accent: #0b71d0;
        --muted: #6b7280;
        /* --card-bg: #fff; */
        --radius: 10px;
        --gap: 12px;
      }

      * {
        box-sizing: border-box
      }

      body {
        background: #ffffff;
        font-family: "Open Sans", sans-serif;
        color: #0b2540;
        margin: 0;
        padding: 18px
      }

      h1 {
        font-size: 1.25rem;
        margin: 0 0 6px
      }

      .sub {
        color: var(--muted);
        font-size: 13px;
        margin-bottom: 18px
      }

      .wizard {
        background: var(--card-bg);
        border-radius: 12px;
        padding: 18px;
        border: 1px solid #e9eef4
      }

      .wizard-top {
        display: flex;
        align-items: center;
        gap: 18px;
        flex-wrap: wrap;
        margin-bottom: 14px
      }

      .steps {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        align-items: center
      }

      .step-pill {
        background: #f1f5f9;
        padding: 8px 12px;
        border-radius: 999px;
        font-weight: 600;
        font-size: 13px;
        color: #334155;
        display: inline-flex;
        gap: 8px;
        align-items: center;
        border: 1px solid transparent;
        cursor: pointer
      }

      .step-pill[aria-selected="true"] {
        background: var(--accent);
        color: #fff
      }

      .progress-track {
        flex: 1;
        height: 8px;
        background: #edf2f7;
        border-radius: 8px;
        overflow: hidden
      }

      .progress-bar {
        height: 100%;
        background: linear-gradient(90deg, var(--accent), #2ab0ff);
        width: 0%;
        transition: width .28s
      }

      .step-content {
        padding: 8px 2px 0
      }

      .step-section {
        display: none;
        padding: 8px 0
      }

      .step-section.active {
        display: block
      }

      .grid {
        display: grid;
        grid-template-columns: 1fr 360px;
        gap: var(--gap)
      }

      @media (max-width:980px) {
        .grid {
          grid-template-columns: 1fr
        }
      }

      .card {
        background: #fff;
        border-radius: var(--radius);
        border: 1px solid #e9eef4;
        padding: 14px
      }

      .form-row {
        display: flex;
        gap: var(--gap);
        flex-wrap: wrap
      }

      .form-col {
        flex: 1;
        min-width: 220px
      }

      .form-group {
        margin-bottom: 10px
      }

      label {
        display: block;
        font-weight: 700;
        font-size: 13px;
        margin-bottom: 6px
      }

      .hint {
        font-size: 12px;
        color: var(--muted);
        margin-top: 6px
      }

      input[type="text"],
      input[type="number"],
      input[type="datetime-local"],
      textarea,
      select {
        width: 100%;
        padding: 8px;
        border: 1px solid #e6eef7;
        border-radius: 8px;
        font-size: 14px
      }

      textarea {
        min-height: 80px
      }

      .image-drop {
        border: 2px dashed #e2e8f0;
        border-radius: 8px;
        padding: 14px;
        text-align: center;
        cursor: pointer;
        background: #f8fafc
      }

      .thumb {
        width: 100px;
        height: 72px;
        object-fit: cover;
        border-radius: 8px;
        border: 1px solid #e6eef7
      }

      .thumb-wrap {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px
      }

      .variants-table {
        margin-top: 6px
      }

      .variants-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px
      }

      .variant-row {
        border: 1px solid #eef2f6;
        border-radius: 8px;
        padding: 10px;
        display: grid;
        grid-template-columns: 1fr 320px;
        gap: 12px;
        align-items: start
      }

      @media (max-width:980px) {
        .variant-row {
          grid-template-columns: 1fr
        }
      }

      .variant-left {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 8px
      }

      .variant-full {
        grid-column: 1/-1
      }

      .attributes-list .attr-pill {
        background: #f1f5f9;
        padding: 6px 8px;
        border-radius: 6px;
        display: inline-flex;
        gap: 8px;
        align-items: center;
        margin-bottom: 6px
      }

      .wizard-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 16px;
        gap: 10px;
        flex-wrap: wrap
      }

      .btn {
        padding: 8px 12px;
        border-radius: 8px;
        border: 0;
        cursor: pointer;
        font-weight: 700
      }

      .btn-primary {
        background: var(--accent);
        color: #fff
      }

      .btn-outline {
        background: #fff;
        color: var(--accent);
        border: 1px solid #cde4ff
      }

      .btn-muted {
        background: #f1f5f9;
        color: var(--muted)
      }

      .small {
        font-size: 12px;
        color: var(--muted)
      }

      .error {
        color: #b91c1c;
        font-size: 13px;
        margin-top: 6px
      }

      .success {
        color: #059669;
        font-size: 13px;
        margin-top: 6px
      }

      #toast-container {
        position: fixed;
        right: 18px;
        bottom: 18px;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        gap: 8px;
        align-items: flex-end
      }
    </style>
</head>

<body>
 <div class="account-layout" id="accountLayout">
        <aside class="account-sidebar" id="accountSidebar" aria-label="Account Sidebar">
          <%- include('includes/account-sidebar', { user, activePage: 'addresses' }) %>
        </aside>

        <div class="account-right">
          <%- include('includes/account-topbar') %>

            <div class="account-backdrop" id="accountBackdrop" aria-hidden="true"></div>
    <main class="account-content">
              <section class="account-page-content">
                <div class="address-page">

                 <section class="account-page-header">
    <%- include('includes/account-header', {
        title: 'Add New Product',
        subtitle: 'Add a new product to your inventory by providing product information, pricing, stock levels, supplier details, and images. Accurate product records help maintain inventory control, streamline sales operations, and improve reporting accuracy.',
        primaryAction: null,
        secondaryAction: null
    }) %>

    <div class="status-line" aria-live="polite" style="float: inline-end;">
        <span class="saving-dot" id="savingDot"></span>
        <span id="savingText">Product information not saved yet</span>
    </div>
        </section>
        <div class="container-fluid">
          <nav aria-label="breadcrumb" style="border-bottom: 1px solid lightgrey; padding-bottom:8px; margin-bottom:10px;">
            <ol class="breadcrumb" style="margin:0;padding:0;list-style:none;display:flex;gap:8px;align-items:center">
              <li class="breadcrumb-item text-sm"><a class="opacity-5 text-dark" href="javascript:;">Admin</a></li>
              <li class="breadcrumb-item text-sm text-dark active" aria-current="page">Add Products</li>
            </ol>
            <h1 style="margin-top:8px">Add Products</h1>
          </nav>

          <div class="sub">Create a product listing — use the stepper. You can save drafts and publish when ready.</div>

          <div class="wizard-top">
            <div class="steps" role="tablist" aria-label="Product creation steps">
              <button type="button" class="step-pill" role="tab" aria-selected="true" data-step="0">
                <i class="fa-solid fa-pen-to-square"></i> Basic
              </button>
              <button type="button" class="step-pill" role="tab" aria-selected="false" data-step="1">
                <i class="fa-solid fa-images"></i> Media
              </button>
              <button type="button" class="step-pill" role="tab" aria-selected="false" data-step="2">
                <i class="fa-solid fa-cubes"></i> Variants
              </button>
              <button type="button" class="step-pill" role="tab" aria-selected="false" data-step="3">
                <i class="fa-solid fa-earth"></i> SEO
              </button>
            </div>

            <div class="progress-track" aria-hidden="true" style="width:100%;margin-left:8px">
              <div id="progressBar" class="progress-bar" style="width:25%"></div>
            </div>
          </div>

          <div class="wizard" role="application" aria-labelledby="wizardTitle">
            <form id="productForm" method="POST" action="/admin/add-product" enctype="multipart/form-data" novalidate>

              <!-- controller-compatible hidden fields -->
              <input type="hidden" name="id" id="productId" value="<%= product?.id || '' %>">
              <input type="hidden" name="status" id="productStatus" value="<%= product?.status || 'draft' %>">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">

              <!-- preserve server filename so controller can keep it if no new file uploaded -->
              <input type="hidden" id="main_image" name="main_image" value="<%= product?.main_image ? product.main_image : '' %>">

              <!-- existing product videos / variant media state -->
              <input type="hidden" id="existing_product_videos" name="existing_product_videos" value="<%= JSON.stringify(product?.product_videos || []) %>">
              <input type="hidden" id="remove_main_image_flag" name="remove_main_image" value="0">

              <!-- variant existing media JSON -->
              <input
                type="hidden"
                id="variant_media_map"
                name="variant_media_map"
                value='<%- JSON.stringify((productVariants || []).map(v => ({
                  id: v.id || null,
                  media: (v.media || []).map(m => ({ id: m.id || null, filename: m.filename }))
                }))) %>'
              >

              <div class="step-content">

                <!-- BASIC -->
                <section class="step-section active" data-step="0" aria-hidden="false">
                  <div class="grid">
                    <div>
                      <div class="form-group">
                        <label for="name">Product Name *</label>
                        <input id="name" name="name" class="form-control" maxlength="255"
                          placeholder="Apple iPhone 15 Pro Max" required value="<%= product?.name || '' %>">
                        <div class="hint">Use clear, searchable names. Max 255 characters.</div>
                      </div>

                      <div class="form-row">
                        <div class="form-col">
                          <div class="form-group">
                            <label for="slug">Slug (auto)</label>
                            <input id="slug" name="slug" class="form-control" placeholder="auto-generated"
                              autocomplete="off" value="<%= product?.slug || '' %>">
                            <div class="hint">Auto-generated from name; you can edit.</div>
                          </div>
                        </div>

                        <div class="form-col">
                          <div class="form-group">
                            <label for="productType">Product Type</label>
                            <select id="productType" name="product_type" class="form-control">
                              <option value="simple" <%= (product?.product_type === 'simple') ? 'selected' : '' %>>Simple</option>
                              <option value="variable" <%= (product?.product_type === 'variable') ? 'selected' : '' %>>Variable / With options</option>
                            </select>
                          </div>
                        </div>
                      </div>

                      <div class="form-row">
                        <div class="form-col">
                          <div class="form-group">
                            <label for="brand">Brand</label>
                            <input id="brand" name="brand" class="form-control" placeholder="Brand name (optional)"
                              value="<%= product?.brand || '' %>">
                          </div>
                        </div>

                        <div class="form-col">
                          <div class="form-group">
                            <label for="mpn">Model / MPN</label>
                            <input id="mpn" name="mpn" class="form-control" placeholder="Manufacturer Part Number"
                              value="<%= product?.mpn || '' %>">
                          </div>
                        </div>
                      </div>

                      <div class="form-group">
                        <label for="bullets">Key Features / Bullet Points</label>
                        <textarea id="bullets" name="bullets" class="form-control" rows="3"
                          placeholder="One feature per line"><%= product?.bullets || '' %></textarea>
                        <div class="hint">One feature per line. Controller stores as string.</div>
                      </div>

                      <div class="form-group">
                        <label for="description">Product Description</label>
                        <textarea id="description" name="description" class="form-control" rows="6"
                          placeholder="Full product description (HTML allowed)"><%= product?.description || '' %></textarea>
                      </div>
                    </div>

                    <aside>
                      <div class="card">
                        <div class="form-group">
                          <label for="parent_category_id">Parent Category *</label>
                          <select class="form-control" name="parent_category_id" id="parent_category_id">
                            <option value="">Select Parent Category</option>
                            <% parentCategories.forEach(pc => { %>
                              <option value="<%= pc.id %>" <%= product?.parent_category_id == pc.id ? 'selected' : '' %>><%= pc.name %></option>
                            <% }) %>
                          </select>
                          <div class="hint">Choose the main category; subcategory will appear after selection.</div>
                        </div>

                        <div class="form-group">
                          <label for="category_id">Sub Category</label>
                          <select name="category_id" id="category_id" class="form-control" disabled>
                            <option value="">Select Category</option>
                            <% categories.forEach(c => { %>
                              <option value="<%= c.id %>" data-parent="<%= c.parent_id %>" <%= product?.category_id == c.id ? 'selected' : '' %>><%= c.name %></option>
                            <% }) %>
                          </select>
                        </div>

                        <div id="categorySpecificFields"></div>

                        <div class="form-group">
                          <label for="shortDescription">Short Description</label>
                          <input id="shortDescription" name="short_description" class="form-control"
                            placeholder="One-line summary" value="<%= product?.short_description || '' %>">
                        </div>

                        <div class="form-group">
                          <label for="visibility">Visibility</label>
                          <select id="visibility" name="visibility" class="form-control">
                            <option value="search" <%= product?.visibility === 'search' ? 'selected' : '' %>>Search + Category</option>
                            <option value="category" <%= product?.visibility === 'category' ? 'selected' : '' %>>Category only</option>
                            <option value="hidden" <%= product?.visibility === 'hidden' ? 'selected' : '' %>>Hidden (draft)</option>
                          </select>
                        </div>

                        <div class="form-group">
                          <label>Display Locations</label>
                          <div class="hint" style="margin-bottom:8px">
                            Time-based displays require start & end fields; these are included below each option when enabled.
                          </div>

                          <% const displayOptions = [
                            { value: 'home_featured', label: 'Homepage – Featured', requiresTime: false },
                            { value: 'home_discount_row', label: 'Discount / Homepage Row', requiresTime: true },
                            { value: 'flash_sale', label: 'Flash Sale', requiresTime: true },
                            { value: 'upcoming_promotion', label: 'Upcoming Promotion', requiresTime: true },
                            { value: 'home_new_arrivals', label: 'Homepage – New Arrivals', requiresTime: true },
                            { value: 'home_best_sellers', label: 'Homepage – Best Sellers', requiresTime: false },
                            { value: 'category_page', label: 'Category Pages', requiresTime: false },
                            { value: 'sub_category_page', label: 'Subcategory Pages', requiresTime: false },
                            { value: 'promotion_page', label: 'Promotion Page', requiresTime: true },
                            { value: 'top_selling_row', label: 'Top Selling Row / Section', requiresTime: false },
                            { value: 'seasonal_offers', label: 'Seasonal Offers Section', requiresTime: true }
                          ]; 
                          const selectedLocations = product?.display_locations || []; %>

                          <div style="display:grid;grid-template-columns:1fr;gap:8px">
                            <% displayOptions.forEach(opt => { 
                              const checked = selectedLocations.includes(opt.value);
                              const showTime = opt.requiresTime && checked;
                            %>
                              <div style="display:flex;flex-direction:column;gap:6px">
                                <label style="display:flex;align-items:center;gap:8px">
                                  <input type="checkbox" name="display_locations[]" value="<%= opt.value %>"
                                    class="display-location-checkbox" data-requires-time="<%= opt.requiresTime %>"
                                    <%= checked ? 'checked' : '' %> />
                                  <span><%= opt.label %></span>
                                </label>

                                <% if (opt.requiresTime) { %>
                                  <div style="display:<%= showTime ? 'flex' : 'none' %>;gap:8px;align-items:center">
                                    <input type="datetime-local" name="start_<%= opt.value %>" class="form-control"
                                      value="<%= product?.[`start_${opt.value}`] || '' %>" />
                                    <span style="color:var(--muted)">to</span>
                                    <input type="datetime-local" name="end_<%= opt.value %>" class="form-control"
                                      value="<%= product?.[`end_${opt.value}`] || '' %>" />
                                  </div>
                                <% } %>
                              </div>
                            <% }) %>
                          </div>
                        </div>

                        <div class="form-group">
                          <label for="tags">Search Keywords (comma separated)</label>
                          <input id="tags" name="meta_keywords" class="form-control" placeholder="phone, apple, iphone"
                            value="<%= product?.meta_keywords || '' %>">
                        </div>
                      </div>
                    </aside>
                  </div>
                </section>

                <!-- MEDIA -->
                <section class="step-section" data-step="1" aria-hidden="true">
                  <div class="form-row">
                    <div class="form-col">
                      <label>Main image / video *</label>
                      <div id="mainDrop" class="image-drop" tabindex="0" role="button" aria-label="Upload main image or video">
                        <input type="file" name="main_image_file" id="mainImage" accept="image/*,video/mp4,video/webm,video/ogg" hidden>
                        <div style="font-size:22px;color:#5b738f;margin-bottom:8px"><i class="fa-solid fa-camera"></i></div>
                        <div class="small">Click or drag & drop. Recommended image 1200×1200. Max 50MB for video.</div>

                        <div id="mainPreview"
                          data-server-src="<% if (product && product.main_image) { %>/uploads/products/<%= product.main_image %><% } else if (product && product.main_media_url) { %><%= product.main_media_url %><% } else { %><%='' %><% } %>"
                          style="margin-top:12px;display:none">
                          <div id="mainPreviewMedia"></div>
                        </div>
                      </div>

                      <div style="display:flex;gap:8px;margin-top:8px">
                        <% if (product && product.id) { %>
                          <button type="button" id="updateMainImageBtn" class="btn btn-primary">Update Main Image</button>
                          <button type="button" id="removeMainImageBtn" class="btn btn-outline">Remove</button>
                        <% } %>
                      </div>

                      <div id="mainError" class="error" style="display:none"></div>
                      <div class="hint" style="margin-top:8px">If you don't choose a new main image/video, the existing one will be kept.</div>
                    </div>

                    <div class="form-col">
                      <label>Product Videos (optional)</label>
                      <div class="form-group">
                        <input type="file" name="product_videos[]" id="productVideos" class="form-control"
                          accept="video/mp4,video/webm,video/ogg" multiple>

                        <% if (product && product.id) { %>
                          <button type="button" id="updateProductVideosBtn" class="btn btn-primary" style="margin-top:8px">
                            Update Videos
                          </button>
                        <% } %>

                        <div class="small hint">Upload additional product videos (MP4/WebM). Previews will show after selection.</div>

                        <div id="productVideosPreview" style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap">
                          <% (product?.product_videos || []).forEach(function(v){ %>
                            <div class="thumb-wrap">
                              <video class="variant-thumb" controls src="/uploads/products/<%= v %>"></video>
                              <button type="button" class="btn btn-muted btn-remove-video" data-filename="<%= v %>"
                                style="font-size:12px;margin-top:6px">Remove</button>
                            </div>
                          <% }) %>
                        </div>
                      </div>
                    </div>
                  </div>
                </section>

                <!-- VARIANTS -->
                <section class="step-section" data-step="2" aria-hidden="true">
                  <div class="card">
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
                      <strong>Variants</strong>
                      <div style="display:flex;gap:8px;align-items:center">
                        <button type="button" class="btn btn-muted" id="addVariantBtn">
                          <i class="fa-solid fa-plus"></i>&nbsp; Add Variant
                        </button>
                        <button type="button" class="btn btn-outline" id="optionBuilderBtn">Option Builder</button>
                      </div>
                    </div>

                    <!-- PRODUCT / ATTRIBUTE MAP -->
                    <div style="margin-bottom:12px; border:1px solid #e6eef7; background:#fff; padding:12px; border-radius:10px;">
                      <strong style="display:block;margin-bottom:6px">Product Attributes</strong>
                      <div class="hint" style="margin-bottom:10px">
                        Add attributes that belong to the product itself. Use comma-separated values and choose whether each row is for product or variant scope.
                      </div>

                      <div id="globalAttributesContainer">
                        <% if (Array.isArray(productAttributes) && productAttributes.length) { %>
                          <% productAttributes.forEach(function(a){ %>
                            <div class="global-attr-row" style="display:flex;gap:8px;margin-top:8px;align-items:center">
                              <input type="text" name="attribute_name[]" class="form-control"
                                placeholder="Attribute name (e.g., Color)" value="<%= a.attribute || a.name || '' %>">
                              <input type="text" name="attribute_values[]" class="form-control"
                                placeholder="Values (comma separated)" value="<%= a.value || '' %>">
                              <select name="scope_type[]" class="form-control" style="max-width:120px">
                                <option value="product" <%= (a.scope_type === 'product' || !a.scope_type) ? 'selected' : '' %>>Product</option>
                                <option value="variant" <%= a.scope_type === 'variant' ? 'selected' : '' %>>Variant</option>
                              </select>
                              <button type="button" class="btn btn-muted btn-remove-global-attr">Remove</button>
                            </div>
