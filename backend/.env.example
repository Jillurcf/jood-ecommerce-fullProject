# Backend — Environment Variables
# Copy to .env and fill in values. Never commit .env.

# Server
PORT=4001
NODE_ENV=development
APP_URL=http://localhost:4001
FRONTEND_URL=http://localhost:3000

# Cookies — COOKIE_SECURE controls the Secure flag on auth cookies.
#   auto  = Secure only when NODE_ENV=production (recommended)
#   true  = always Secure (force when serving over HTTPS in non-prod)
#   false = never Secure (local HTTP testing only)
COOKIE_SECURE=auto

# MySQL
DATABASE_URL="mysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/jood"

# JWT
JWT_ACCESS_SECRET=change-me-to-a-random-string-min-16-chars
JWT_REFRESH_SECRET=change-me-to-a-different-random-string-min-16-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Stripe (test keys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# SMTP (nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-pass
FROM_EMAIL=noreply@yourdomain.com

# Google OAuth
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_CALLBACK_URL=http://localhost:4001/api/auth/customer/google/callback

# Card encryption (for saved payment methods, optional in dev)
CARD_ENCRYPTION_KEY=

# Logging / observability
LOG_LEVEL=debug        # debug|info|warn|error
LOG_JSON=0             # 1 to emit JSON lines (production/aggregators)

# Seed credentials (used by `npm run seed`)
# Master admin: admin@jood.com / Admin@12345
# Test customer: customer@jood.com / Customer@12345
