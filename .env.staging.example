# Copy to .env.staging and fill in REAL staging values. NEVER COMMIT the real file.
# These are test/staging credentials — never reuse legacy production secrets.

# MySQL
MYSQL_DATABASE=jood
MYSQL_USER=jood
MYSQL_PASSWORD=change-me-staging-db-user-password
MYSQL_ROOT_PASSWORD=change-me-staging-db-root-password
DATABASE_URL="mysql://jood:change-me-staging-db-user-password@db:3306/jood"

# JWT — generate random strings (e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=change-me-staging-access-secret
JWT_REFRESH_SECRET=change-me-staging-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Public URLs
APP_URL=http://localhost:4001
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4001/api

# Stripe TEST keys (sk_test_... / whsec_...)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# SMTP (mailhog / staging relay in dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@staging.jood.example

# Google OAuth test client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4001/api/auth/customer/google/callback

# Card encryption (AES key, optional for staging)
CARD_ENCRYPTION_KEY=

# Logging
LOG_LEVEL=info
