# Frontend — Environment Variables
# Copy to .env and fill in values. Never commit .env.

# Backend API base (no trailing slash issues; the API client appends paths).
NEXT_PUBLIC_API_URL=http://localhost:4001/api

# Stripe publishable key (client-side, safe to expose).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Server-side only — used by middleware.ts to verify the backend-issued
# `jood_access` JWT cookie at the edge. MUST MATCH backend JWT_ACCESS_SECRET.
# NEVER prefix with NEXT_PUBLIC_ (it would leak the secret to the browser).
JWT_ACCESS_SECRET=change-me-to-the-same-value-as-backend-JWT_ACCESS_SECRET
